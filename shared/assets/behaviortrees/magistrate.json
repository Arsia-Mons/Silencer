      "props": { "action": "TurnAround" }
    },

    "seq_patrol": {
      "type": "Sequence",
      "label": "Normal patrol",
      "children": ["leaf_patrol_speed", "leaf_patrol_walk", "leaf_patrol_turn", "leaf_patrol_stand"],
      "props": {}
    },
    "leaf_patrol_speed": {
      "type": "Leaf",
      "label": "Set patrol speed",
      "children": [],
      "props": { "action": "SetSpeed", "speed": 3 }
    },
    "leaf_patrol_walk": {
      "type": "Leaf",
      "label": "Walk",
      "children": [],
      "props": { "action": "Walk" }
    },
    "leaf_patrol_turn": {
      "type": "Leaf",
      "label": "Turn around",
      "children": [],
      "props": { "action": "TurnAround" }

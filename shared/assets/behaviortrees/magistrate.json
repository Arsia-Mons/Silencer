    "cond_dormant": {
      "type": "Condition",
      "label": "is_dormant == true?",
      "children": [],
      "props": { "key": "is_dormant", "op": "==", "value": true }
    },
    "leaf_activate": {
      "type": "Leaf",
      "label": "CheckActivation",
      "children": [],
      "props": { "action": "CheckActivation" }
    },

    "seq_flee": {
      "type": "Sequence",
      "label": "Low-health flee",
      "children": ["cond_low_hp", "leaf_flee_speed", "leaf_flee_walk", "leaf_flee_turn"],
      "props": {}
    },
    "cond_low_hp": {
      "type": "Condition",
      "label": "health_pct < 0.4?",
      "children": [],
      "props": { "key": "health_pct", "op": "<", "value": 0.4 }
    },
    "leaf_flee_speed": {
      "type": "Leaf",
      "label": "Speed up (flee)",
      "children": [],
      "props": { "action": "SetSpeed", "speed": 6 }

{
  "version": 1,
  "id": "robot",
  "rootId": "root",
  "blackboard": [
    { "key": "patrol", "type": "bool", "default": false }
  ],
  "nodes": {
    "root": {
      "type": "Selector",
      "label": "Robot AI",
      "children": ["leaf_new", "leaf_dying", "leaf_dead", "leaf_wake_anim", "leaf_wakeup", "leaf_walk_anim", "seq_shoot", "leaf_melee", "leaf_looksides", "leaf_returntospawn", "leaf_sleep_anim", "leaf_patrol"],
      "props": {}
    },

    "leaf_new":       { "type": "Leaf", "label": "Platform find",      "children": [], "props": { "action": "New"          } },
    "leaf_dying":     { "type": "Leaf", "label": "Death animation",    "children": [], "props": { "action": "Dying"        } },
    "leaf_dead":      { "type": "Leaf", "label": "Respawn wait",       "children": [], "props": { "action": "Dead"         } },
    "leaf_wake_anim": { "type": "Leaf", "label": "Wake animation",     "children": [], "props": { "action": "WakeAnim"     } },
    "leaf_wakeup":    { "type": "Leaf", "label": "Wake up (detect)",   "children": [], "props": { "action": "WakeUp"       } },
    "leaf_walk_anim": { "type": "Leaf", "label": "Walk animation",     "children": [], "props": { "action": "WalkAnim"     } },

    "seq_shoot": {
      "type": "Sequence",
      "label": "Detect then shoot",
      "children": ["leaf_lookforward", "leaf_shoot"],
      "props": {}
    },
    "leaf_lookforward":   { "type": "Leaf", "label": "Shoot if seen",      "children": [], "props": { "action": "LookForward"    } },
    "leaf_shoot":         { "type": "Leaf", "label": "Shoot rocket",       "children": [], "props": { "action": "Shoot"          } },

    "leaf_melee":         { "type": "Leaf", "label": "Melee adjacent",     "children": [], "props": { "action": "MeleeCheck"     } },
    "leaf_looksides":     { "type": "Leaf", "label": "Orient to target",   "children": [], "props": { "action": "LookSides"      } },
    "leaf_returntospawn": { "type": "Leaf", "label": "Return to spawn",    "children": [], "props": { "action": "ReturnToSpawn"  } },
    "leaf_sleep_anim":    { "type": "Leaf", "label": "Sleep animation",    "children": [], "props": { "action": "SleepAnim"      } },
    "leaf_patrol":        { "type": "Leaf", "label": "Patrol walk",        "children": [], "props": { "action": "Patrol"         } }
  },
  "positions": {}
}

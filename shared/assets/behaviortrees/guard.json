{
  "version": 1,
  "id": "guard",
  "rootId": "root",
  "blackboard": [
    { "key": "patrol",          "type": "bool",   "default": true  },
    { "key": "target_seen",     "type": "bool",   "default": false },
    { "key": "has_target",      "type": "bool",   "default": false },
    { "key": "at_ladder",       "type": "bool",   "default": false },
    { "key": "on_ladder",       "type": "bool",   "default": false },
    { "key": "health_pct",      "type": "float",  "default": 1.0   },
    { "key": "dist_to_target",  "type": "int",    "default": -1    },
    { "key": "close_shot_hit",  "type": "bool",   "default": false }
  ],
  "nodes": {
    "root": {
      "type": "Selector",
      "label": "Guard AI",
      "children": [
        "seq_low_health",
        "seq_close_shot",
        "sel_combat",
        "leaf_uncrouch",
        "leaf_chase",
        "leaf_searchreturn",
        "seq_patrol",
        "leaf_stand"
      ],
      "props": {}
    },

    "seq_low_health": {
      "type": "Sequence",
      "label": "Low-health flee (AC2 + AC4)",
      "children": ["cond_low_hp", "leaf_speedup", "leaf_searchreturn"],
      "props": {}
    },
    "cond_low_hp": {
      "type": "Condition",
      "label": "health_pct < 0.3?",
      "children": [],
      "props": { "key": "health_pct", "op": "<", "value": 0.3 }
    },
    "leaf_speedup": {
      "type": "Leaf",
      "label": "Speed boost (flee)",
      "children": [],
      "props": { "action": "SetSpeed", "speed": 8 }
    },

    "seq_close_shot": {
      "type": "Sequence",
      "label": "Close-range SpawnProjectile (AC1 + AC3)",
      "children": ["cond_has_target", "cond_close_range", "leaf_spawn_proj"],
      "props": {}
    },
    "cond_has_target": {
      "type": "Condition",
      "label": "dist_to_target > 0?",
      "children": [],
      "props": { "key": "dist_to_target", "op": ">", "value": 0 }
    },
    "cond_close_range": {
      "type": "Condition",
      "label": "dist_to_target < 150?",
      "children": [],
      "props": { "key": "dist_to_target", "op": "<", "value": 150 }
    },
    "leaf_spawn_proj": {
      "type": "Leaf",
      "label": "SpawnProjectile forward",
      "children": [],
      "props": { "action": "SpawnProjectile", "direction": 0 }
    },

    "sel_combat": {
      "type": "Selector",
      "label": "Combat",
      "children": ["leaf_look0", "leaf_look1", "leaf_look2", "leaf_look3", "leaf_look4", "leaf_look5"],
      "props": {}
    },
    "leaf_look0": { "type": "Leaf", "label": "Look(0) forward",    "children": [], "props": { "action": "Look0" } },
    "leaf_look1": { "type": "Leaf", "label": "Look(1) low forward","children": [], "props": { "action": "Look1" } },
    "leaf_look2": { "type": "Leaf", "label": "Look(2) up",         "children": [], "props": { "action": "Look2" } },
    "leaf_look3": { "type": "Leaf", "label": "Look(3) down",       "children": [], "props": { "action": "Look3" } },
    "leaf_look4": { "type": "Leaf", "label": "Look(4) up-angle",   "children": [], "props": { "action": "Look4" } },
    "leaf_look5": { "type": "Leaf", "label": "Look(5) down-angle", "children": [], "props": { "action": "Look5" } },

    "leaf_uncrouch":     { "type": "Leaf", "label": "Uncrouch if idle",      "children": [], "props": { "action": "UncrouchIdle"   } },
    "leaf_chase":        { "type": "Leaf", "label": "Chase target (patrol)", "children": [], "props": { "action": "Chase"           } },
    "leaf_searchreturn": { "type": "Leaf", "label": "Search then return",    "children": [], "props": { "action": "SearchAndReturn" } },

    "seq_patrol": {
      "type": "Sequence",
      "label": "Patrol",
      "children": ["cond_patrol", "leaf_patrol"],
      "props": {}
    },
    "cond_patrol": { "type": "Condition", "label": "patrol?",    "children": [], "props": { "key": "patrol", "value": true } },
    "leaf_patrol": { "type": "Leaf",      "label": "Patrol walk","children": [], "props": { "action": "Patrol" } },

    "leaf_stand": { "type": "Leaf", "label": "Stand", "children": [], "props": { "action": "Stand" } }
  },
  "positions": {}
}

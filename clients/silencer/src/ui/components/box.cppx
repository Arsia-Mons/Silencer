#include "box.h"

namespace ui::components {

::ui::UiElement Box(const BoxProps &props) {
  // Box also forwards on_hover (pointer enter/leave edges on a focusable host);
  // the shared callbacks_from_props is kept hover-agnostic since not every
  // control's props carry it.
  ::ui::HostCallbacks callbacks = detail::callbacks_from_props(props);
  callbacks.on_hover = props.on_hover;
  return <detail.Host
    kind={::ui::HostKind::Box}
    key={props.key}
    id={props.id}
    idOffset={props.id_offset}
    style={props.layout}
    visual={::ui::resolve(::ui::use_theme().box, props.style, {})}
    interaction={detail::interaction_from_props(props)}
    accessibility={detail::accessibility_from_props(props, ::ui::SemanticRole::Auto)}
    callbacks={callbacks}
  >
    {props.children}
  </detail.Host>
}

} // namespace ui::components

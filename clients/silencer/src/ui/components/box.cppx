#include "box.h"

namespace ui {
namespace components {

::ui::UiElement Box(const BoxProps& props) {
	const ::ui::VisualStyle visual =
		::ui::resolve(::ui::use_theme().box,
		              props.style,
		              detail::interaction_state(props.disabled));
	return <detail.Host
	  kind={::ui::HostKind::Box}
	  key={props.key}
	  id={props.id}
	  idOffset={props.id_offset}
	  style={detail::reserve_visual_border(props.layout, visual)}
	  visual={visual}
	  interaction={detail::interaction_from_props(props)}
	  accessibility={detail::accessibility_from_props(props, ::ui::SemanticRole::Auto)}
	  callbacks={detail::callbacks_from_props(props)}
	>
		{props.children}
	</detail.Host>
}

}  // namespace components
}  // namespace ui

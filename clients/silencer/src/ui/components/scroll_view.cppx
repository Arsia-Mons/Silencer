#include "ui/components/scroll_view.h"

#include "ui/components/box.h"
#include "ui/runtime/interaction_hooks.h"
#include "ui/runtime/react.h"

#include <algorithm>
#include <functional>

namespace ui::components {

using ::ui::children;

::ui::UiElement ScrollView(const ScrollViewProps &props) {
  float *offset = use_state<float>(0.0f);

  const char *viewport_id = props.id ? props.id : "ScrollView";
  const char *content_id = use_text_storage("%sContent", viewport_id);
  const float viewport_height = use_measured_height(viewport_id);

  // When virtualizing, the content track holds only the visible row slice, so
  // derive the full content height from the rows instead of its measure: the
  // sum of per-row heights (variable) or row_height * count (uniform).
  float content_height = use_measured_height(content_id);
  if (props.row_heights && props.children.count > 0) {
    content_height = 0.0f;
    for (int i = 0; i < props.children.count; ++i)
      content_height += props.row_heights[i];
  } else if (props.row_height > 0.0f && props.children.count > 0) {
    content_height = props.row_height * (float)props.children.count;
  }

  *offset += use_scroll_into_view(viewport_id);

  const float max_off = std::max(0.0f, content_height - viewport_height);

  // `stuck` flips false when the user scrolls away (wheel/key below) and back
  // true on return to the bottom. Starts true so a fresh chat opens pinned.
  bool *stuck = use_state<bool>(true);
  if (props.stick_to_bottom && stuck && *stuck && max_off > 0.0f)
    *offset = max_off;

  if (*offset > max_off)
    *offset = max_off;
  if (*offset < 0.0f)
    *offset = 0.0f;
  const float step = props.step > 0.0f ? props.step : 32.0f;
  const float page = viewport_height > 0.0f ? viewport_height : step;

  const bool follow = props.stick_to_bottom;
  auto restick = [stuck, follow, max_off](float v) {
    if (follow && stuck)
      *stuck = v >= max_off - 0.5f;
  };
  // +dy = wheel up, which scrolls toward the top (offset decreases).
  std::function<void(const ::ui::WheelEvent &)> on_wheel =
      [offset, max_off, step, restick](const ::ui::WheelEvent &e) {
        float v = *offset - e.dy * step;
        if (v < 0.0f)
          v = 0.0f;
        if (v > max_off)
          v = max_off;
        *offset = v;
        restick(v);
      };
  std::function<void(const ::ui::KeyEvent &)> on_key =
      [offset, max_off, step, page, restick](const ::ui::KeyEvent &e) {
        float v = *offset;
        switch (e.key) {
        case ::ui::UiKey::Up:
          v -= step;
          break;
        case ::ui::UiKey::Down:
          v += step;
          break;
        case ::ui::UiKey::PageUp:
          v -= page;
          break;
        case ::ui::UiKey::PageDown:
          v += page;
          break;
        case ::ui::UiKey::Home:
          v = 0.0f;
          break;
        case ::ui::UiKey::End:
          v = max_off;
          break;
        default:
          return;
        }
        if (v < 0.0f)
          v = 0.0f;
        if (v > max_off)
          v = max_off;
        *offset = v;
        restick(v);
      };

  ::ui::LayoutStyle viewport = props.layout;
  viewport.position = ::ui::PositionType::Relative;
  viewport.overflow = ::ui::Overflow::Hidden;
  if (!viewport.flex_grow.is_defined())
    viewport.flex_grow = ::ui::StyleFloat::points(1.0f);
  // Pin basis to 0 so flex-grow alone (not min-content height) decides the
  // viewport height; otherwise a tall content track stretches it instead of
  // being clipped.
  if (viewport.flex_basis.kind == ::ui::LengthKind::Undefined ||
      viewport.flex_basis.kind == ::ui::LengthKind::Auto)
    viewport.flex_basis = ::ui::Length::points(0.0f);
  viewport.min_height = ::ui::Length::points(0.0f);

  // Content track: out of flow, translated up by the offset.
  ::ui::LayoutStyle content = {};
  content.position = ::ui::PositionType::Absolute;
  content.direction = ::ui::FlexDirection::Column;
  content.position_inset.left = ::ui::StyleValue::points(0.0f);
  content.position_inset.right = ::ui::StyleValue::points(0.0f);
  // Stick-to-bottom transcripts bottom-anchor when content underflows the
  // viewport (newest line flush to the bottom edge). Once content overflows,
  // the gap is <= 0 and this reduces to the normal top-anchored -offset.
  float content_top = -*offset;
  if (props.stick_to_bottom && content_height > 0.0f &&
      content_height < viewport_height)
    content_top = (viewport_height - content_height) - *offset;
  content.position_inset.top = ::ui::StyleValue::points(content_top);

  // Virtualize uniform-height lists: render only the row slice intersecting the
  // window (plus overscan), retargeting the children pointer into the arena.
  // The below-fold overscan is load-bearing for keyboard scroll-into-view: focus
  // can only land on a COMMITTED row, and scroll-into-view fires only after focus
  // moves onto an off-viewport row — so the row past the fold must already be
  // committed for Down to reach it (which then drives the follow-scroll).
  ::ui::UiChildren kids = props.children;
  constexpr int kOverscan = 2;
  if (props.row_heights && kids.count > 0) {
    // Variable-height window: walk cumulative row offsets to the first row whose
    // bottom is past the viewport top, back off by the overscan, then walk on
    // until past the viewport bottom (+ overscan). content_top is the cumulative
    // offset of the first committed row, minus the scroll offset.
    int first = 0;
    float top = 0.0f;
    while (first < kids.count && top + props.row_heights[first] <= *offset) {
      top += props.row_heights[first];
      ++first;
    }
    for (int o = 0; o < kOverscan && first > 0; ++o) {
      --first;
      top -= props.row_heights[first];
    }
    int last = first;
    float y = top;
    const float bottom = *offset + viewport_height;
    while (last < kids.count && y < bottom) {
      y += props.row_heights[last];
      ++last;
    }
    for (int o = 0; o < kOverscan && last < kids.count; ++o)
      ++last;
    float vtop = top - *offset;
    if (props.stick_to_bottom && content_height > 0.0f &&
        content_height < viewport_height)
      vtop = (viewport_height - content_height); // bottom-anchor on underflow
    content.position_inset.top = ::ui::StyleValue::points(vtop);
    kids.items = props.children.items + first;
    kids.count = last - first;
  } else if (props.row_height > 0.0f && kids.count > 0) {
    const float rh = props.row_height;
    int first = (int)(*offset / rh) - 1;
    if (first < 0)
      first = 0;
    int visible = (int)(viewport_height / rh) + 2 + kOverscan;
    if (first > kids.count - 1)
      first = kids.count - 1;
    int last = first + visible;
    if (last > kids.count)
      last = kids.count;
    content.position_inset.top =
        ::ui::StyleValue::points((float)first * rh - *offset);
    kids.items = props.children.items + first;
    kids.count = last - first;
  }

  ::ui::UiElement bar = ::ui::empty();
  if (props.show_scrollbar && max_off > 0.0f && viewport_height > 0.0f &&
      content_height > 0.0f) {
    constexpr float kTrackInset = 2.0f; // top+bottom clearance from the well edge
    // Thumb inset Yoga measures from the rail's OUTER border-box edge, so the
    // thumb must inset by border + gap on every side and travel only within that
    // inner area — else its fill paints over the rail hairline.
    constexpr float kRailBorder = 1.0f; // rail hairline width (matches track_paint)
    constexpr float kThumbGap = 1.0f;
    constexpr float kThumbInset = kRailBorder + kThumbGap;
    const float track_h = std::max(0.0f, viewport_height - 2.0f * kTrackInset);
    const float thumb_travel = std::max(0.0f, track_h - 2.0f * kThumbInset);
    const float ratio =
        content_height > 0.0f ? thumb_travel / content_height : 0.0f;
    float thumb_h = thumb_travel * ratio;
    if (thumb_h < 16.0f)
      thumb_h = 16.0f;
    if (thumb_h > thumb_travel)
      thumb_h = thumb_travel;
    const float thumb_top =
        kThumbInset + (thumb_travel - thumb_h) * (*offset / max_off);

    ::ui::LayoutStyle track = {};
    track.position = ::ui::PositionType::Absolute;
    track.position_inset.right = ::ui::StyleValue::points(2.0f);
    track.position_inset.top = ::ui::StyleValue::points(kTrackInset);
    track.width = ::ui::Length::points(8.0f);
    track.height = ::ui::Length::points(track_h);
    // origin/main green-phosphor scroll box (v00058 goldens): bright idx220 rail,
    // darker idx216 thumb. Mirrors silencer::tokens kInsetStroke/kChromeStroke,
    // which this screen-agnostic engine layer cannot include.
    const ::ui::Color rail_stroke{24, 124, 20, 255};
    const ::ui::Color thumb_fill{8, 84, 0, 255};
    ::ui::StylePatch track_paint = ::ui::patch().border(::ui::Border{
        {kRailBorder, kRailBorder, kRailBorder, kRailBorder},
        {rail_stroke, rail_stroke, rail_stroke, rail_stroke}});

    ::ui::LayoutStyle thumb = {};
    thumb.position = ::ui::PositionType::Absolute;
    thumb.position_inset.left = ::ui::StyleValue::points(kThumbInset);
    thumb.position_inset.right = ::ui::StyleValue::points(kThumbInset);
    thumb.position_inset.top = ::ui::StyleValue::points(thumb_top);
    thumb.height = ::ui::Length::points(thumb_h);

    ::ui::StylePatch thumb_paint = ::ui::patch().background(thumb_fill);
    const char *thumb_id =
        props.id ? use_text_storage("%sThumb", props.id) : "ScrollThumb";
    bar = ::ui::component(
        "Box", BoxProps{.key = "bar",
                        .layout = track,
                        .style = track_paint,
                        .children = children({::ui::component(
                            "Box",
                            BoxProps{.key = "thumb",
                                     .id = thumb_id,
                                     .layout = thumb,
                                     .style = thumb_paint},
                            Box)})},
        Box);
  }

  return <Box
    key={props.key}
    id={props.id}
    focusable={true}
    onKey={on_key}
    onWheel={on_wheel}
    layout={viewport}
    style={props.style}
  >
    <Box key="content" id={content_id} layout={content}>
      {kids}
    </Box>
    {bar}
  </Box>
}

} // namespace ui::components

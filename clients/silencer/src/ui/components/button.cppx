#include "button.h"

namespace ui::components {
namespace {

::ui::HostCallbacks button_callbacks(const ButtonProps &props) {
  ::ui::HostCallbacks callbacks = detail::callbacks_from_props(props);
  if (props.on_activate) {
    callbacks.on_activate = props.on_activate;
  }
  if (props.on_hover) {
    callbacks.on_hover = props.on_hover;
  }
  return callbacks;
}

} // namespace

::ui::UiElement Button(const ButtonProps &props) {
  // Resolve dense paint from theme + this component's live interaction; commit
  // as .visual. The renderer consumes it once P3 flips the builder.
  const ::ui::VisualStyle visual =
      ::ui::resolve(::ui::use_theme().button, props.style,
                    detail::interaction_state(props.disabled));
  return <detail.Host
    kind={::ui::HostKind::Button}
    key={props.key}
    id={props.id}
    idOffset={props.id_offset}
    style={detail::control_layout_style(props.layout)}
    visual={visual}
    text={::ui::HostTextProps{.value = props.label}}
    interaction={detail::interaction_from_props(props, true)}
    accessibility={detail::accessibility_from_props(props, ::ui::SemanticRole::Button)}
    callbacks={button_callbacks(props)}
  >
    {props.children}
    {props.children.count > 0 ? nullptr : props.label}
  </detail.Host>
}

} // namespace ui::components

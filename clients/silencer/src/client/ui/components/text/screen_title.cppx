#include "client/ui/components/text/screen_title.h"

#include "ui/components/box.h"
#include "ui/components/text.h"

#include "client/ui/components/tokens.h"

namespace silencer {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

::ui::UiElement ScreenTitle(const ScreenTitleProps &props) {
  // Origin/main renders screen/section titles in bank 135 (the dominant heading
  // face) and the big brand/prompt in bank 136. The cppx glyph atlas now renders
  // those bitmap banks directly (no more blank silencer-135.otf), so titles use
  // the Heading face (bank 135) and only Hero uses the larger Title face (136).
  ::ui::Color color = tokens::kTextTitle;
  uint16_t face = tokens::kFaceHeading;
  float font = tokens::kFontHeading;
  float line = tokens::kLineHeading;
  float height = tokens::kLineHeading;
  switch (props.variant) {
  case ScreenTitleVariant::Hero:
    color = tokens::kTextHeroTitle;
    face = tokens::kFaceTitle;
    font = tokens::kFontTitle;
    line = tokens::kLineTitle;
    height = tokens::kLineTitle;
    break;
  case ScreenTitleVariant::Screen:
    // origin TextSize::ScreenTitle: bank 135 tracked at advance 12 (vs the
    // Title face's 11) — the wider letterspacing of "Configure Controls" etc.
    color = tokens::kTextTitle;
    face = tokens::kFaceScreenTitle;
    break;
  case ScreenTitleVariant::Dialog:
    color = tokens::kTextTitle;
    break;
  case ScreenTitleVariant::Popup:
    color = tokens::kTextDialogTitle;
    break;
  case ScreenTitleVariant::Brand:
    color = tokens::kTextBrand;
    face = tokens::kFaceTitle;
    font = tokens::kFontLarge;
    line = tokens::kLineLarge;
    height = tokens::kLineLarge;
    break;
  case ScreenTitleVariant::Console:
    // Lobby/console panel titles (Game Options, Select Map, Active Games, Lobby)
    // — the chunky heading face at the Large size, a clear tier above the body
    // rows so the panel headers read as headers, not the first data row.
    color = tokens::kTextTitle;
    face = tokens::kFaceHeading;
    font = tokens::kFontLarge;
    line = tokens::kLineLarge;
    height = tokens::kLineLarge;
    break;
  case ScreenTitleVariant::Prose:
    // White section headers (Advantages/Description). origin renders these in
    // TextSize::Heading — bank 134 at its native advance (character_create_
    // layout.cpp AdvantageLines), not the heavy bank-136 prompt face.
    color = tokens::kTextProse;
    face = tokens::kFaceLarge;
    font = tokens::kFontLarge;
    line = tokens::kLineLarge;
    height = tokens::kLineLarge;
    break;
  }
  ::ui::StylePatch style = ::ui::patch().text(::ui::TextVisual{
      .color = color, .font_id = face, .font_size = font, .line_height = line});
  if (!props.centered)
    return <Text
      key={props.key}
      value={props.value}
      layout={{.height = ::ui::Length::points(height)}}
      style={style}
    />
  // A full-width row that centers its content-sized label (origin titles sit
  // centered in a baked notch).
  return <Box
    key={props.key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .justify_content = ::ui::JustifyContent::Center,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(height)}}
  >
    <Text
      key="t"
      value={props.value}
      layout={{.height = ::ui::Length::points(height)}}
      style={style}
    />
  </Box>
}

} // namespace silencer

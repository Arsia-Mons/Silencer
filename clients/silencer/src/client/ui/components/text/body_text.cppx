#include "client/ui/components/text/body_text.h"

#include "ui/components/text.h"

#include "client/ui/components/tokens.h"

namespace silencer {

using ::ui::components::Text;
using ::ui::components::TextProps;

::ui::UiElement BodyText(const BodyTextProps &props) {
  uint16_t font = tokens::kFontBody;
  float height = 16.0f;
  ::ui::Color color = tokens::kTextBody;
  switch (props.variant) {
  case BodyTextVariant::Body:
    font = tokens::kFontBody;
    height = 16.0f;
    color = tokens::kTextBody;
    break;
  case BodyTextVariant::Strong:
    font = tokens::kFontStrong;
    height = 18.0f;
    color = tokens::kTextWeaponName;
    break;
  case BodyTextVariant::Message:
    font = tokens::kFontMessage;
    height = 18.0f;
    color = tokens::kTextBodyMuted;
    break;
  case BodyTextVariant::Detail:
    font = tokens::kFontDetail;
    height = 16.0f;
    color = tokens::kTextWeaponDetail;
    break;
  case BodyTextVariant::Summary:
    font = tokens::kFontBody;
    height = 18.0f;
    color = tokens::kTextBody;
    break;
  }
  switch (props.tone) {
  case BodyTextTone::Default:
    break;
  case BodyTextTone::Muted:
    color = tokens::kTextBodyMuted;
    break;
  case BodyTextTone::Disabled:
    color = tokens::kTextWeaponDetailOff;
    break;
  }
  return <Text
    key={props.key}
    value={props.value}
    layout={{.height = ::ui::Length::points(height)}}
    style={tokens::text_patch(color, font)}
  />
}

} // namespace silencer

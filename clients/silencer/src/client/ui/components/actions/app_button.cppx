#include "client/ui/components/actions/app_button.h"

#include "ui/components/button.h"
#include "ui/components/text.h"
#include "client/ui/components/tokens.h"
#include "client/ui/hooks/use_chrome.h"
#include "client/ui/hooks/use_clock.h"
#include "ui/runtime/interaction_hooks.h"
#include "ui/runtime/react.h"

#include <cstdint>
#include <functional>

namespace silencer {

using ::ui::children;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

::ui::UiElement AppButton(const AppButtonProps &props) {
  // A targeted button ramps phase 0->4 (one step per 42ms); un-targeting ramps
  // down; disabled pins phase 0. Targeted = hover or REAL-source focus —
  // programmatic autofocus must not ramp, or rest-state renders drift off the
  // rest-state goldens.
  client::ui::Clock clock = client::ui::use_clock();
  uint32_t *anim_accum = use_state<uint32_t>(0u);
  int *phase = use_state<int>(0);
  bool *focused_now = use_state<bool>(false);
  bool *hovered_now = use_state<bool>(false);
  const auto *snap = static_cast<const ::ui::InteractionSnapshot *>(
      use_context(&::ui::InteractionContext));
  const bool source_real =
      snap && (snap->source == ::ui::FocusSource::Mouse ||
               snap->source == ::ui::FocusSource::Touch ||
               snap->source == ::ui::FocusSource::Keyboard ||
               snap->source == ::ui::FocusSource::Gamepad);
  const bool target_feedback =
      props.target_feedback || props.variant == AppButtonVariant::Oval ||
      props.variant == AppButtonVariant::Chrome;
  const bool targeted =
      !props.disabled && (*hovered_now || (*focused_now && source_real));
  const uint32_t kFrameMs = 42;
  *anim_accum += clock.delta_ms;
  while (*anim_accum >= kFrameMs) {
    *anim_accum -= kFrameMs;
    if (targeted && *phase < 4)
      ++*phase;
    else if (!targeted && *phase > 0)
      --*phase;
  }
  if (props.disabled)
    *phase = 0;
  const int p = *phase < 0 ? 0 : (*phase > 4 ? 4 : *phase);

  // Wrap the no-arg semantic callbacks into the event-taking ui callbacks.
  // Focus/blur/hover edges also feed the ramp state.
  std::function<void(const ::ui::ActivationEvent &)> on_activate = {};
  if (props.on_press) {
    on_activate = [on_press = props.on_press](const ::ui::ActivationEvent &) {
      on_press();
    };
  }
  std::function<void(const ::ui::FocusEvent &)> on_focus =
      [focused_now, user = props.on_focus](const ::ui::FocusEvent &) {
        *focused_now = true;
        if (user)
          user();
      };
  std::function<void(const ::ui::BlurEvent &)> on_blur =
      [focused_now](const ::ui::BlurEvent &) { *focused_now = false; };
  std::function<void(const ::ui::HoverEvent &)> on_hover =
      [hovered_now, user = props.on_hover](const ::ui::HoverEvent &e) {
        *hovered_now = e.entered;
        if (e.entered && user)
          user();
      };

  const char *a11y_label =
      props.accessibility_label ? props.accessibility_label : props.label;
  ::ui::LayoutStyle layout = app_button_layout(props.size, props.selected);
  ::ui::StyleStatePatch style = app_button_variant_patch(props.variant);

  // Oval is sprite-backed: it reads its baked bank-6 ramp frames from
  // use_chrome() and paints image-only, frame selected by size + phase.
  if (props.variant == AppButtonVariant::Oval) {
    client::ui::ChromeTextures chrome = client::ui::use_chrome();
    const uint32_t *frames = chrome.oval_md;
    if (props.size == AppButtonSize::Sm)
      frames = chrome.oval_sm;
    else if (props.size == AppButtonSize::Lg)
      frames = chrome.oval_lg;
    else if (props.size == AppButtonSize::List)
      frames = chrome.row_plate;
    const uint32_t tex = frames[p] ? frames[p] : frames[0];
    layout = app_button_oval_layout(props.size);
    style = app_button_oval_patch(tex);
  } else if (props.variant == AppButtonVariant::Chrome) {
    client::ui::ChromeTextures chrome = client::ui::use_chrome();
    const uint32_t tex =
        target_feedback && chrome.chrome_btn[p] ? chrome.chrome_btn[p]
                                                : chrome.chrome_btn_idle;
    layout = app_button_chrome_layout(props.size);
    style = app_button_chrome_patch(tex);
  }

  if (props.padding.set)
    layout.padding = props.padding.value;

  // The label MUST be a styled Text CHILD: the runtime only paints text on
  // Text-role nodes, so the Button's own value never renders and a bare string
  // child would paint the engine's neutral grey.
  ::ui::StyleStatePatch label_style{};
  label_style.base = ::ui::patch().text(app_button_label_visual(
      props.variant, props.disabled, props.size, target_feedback ? p : 0));
  ::ui::UiElement label_el =
      (props.label && props.children.count == 0)
          ? Text(TextProps{.value = props.label, .style = label_style})
          : ::ui::empty();

  return <Button
    key={props.key}
    id={props.control_id}
    idOffset={props.control_offset}
    disabled={props.disabled}
    autofocus={props.default_focused}
    accessibility={{.label = a11y_label}}
    onFocus={on_focus}
    onBlur={on_blur}
    onHover={on_hover}
    label={props.label}
    onActivate={on_activate}
    layout={layout}
    style={style}
  >
    {props.children}
    {label_el}
  </Button>
}

} // namespace silencer

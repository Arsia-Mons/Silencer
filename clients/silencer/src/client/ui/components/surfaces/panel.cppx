#include "client/ui/components/surfaces/panel.h"

#include "client/ui/components/tokens.h"
#include "client/ui/hooks/use_chrome.h"
#include "ui/components/box.h"

namespace silencer {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;

namespace {

// Loadout "details" column background. This is a loadout-feature-local color
// that no other shared surface consumes, so it is kept file-local rather than
// added to the shared palette in tokens.h. (The plan permits it to live in
// screens/loadout/loadout_tokens.h, but because Panel is a shared component it
// must resolve its own paint without depending on a screen-local header.)
constexpr ::ui::Color kSunkenBg = {22, 30, 36, 255};

// Canonical width (points) for each PanelSize tier. Auto defers to the
// variant's canonical width (handled by the caller).
float panel_size_width(PanelSize size) {
  switch (size) {
  case PanelSize::Sm:
    return 220.0f;
  case PanelSize::Md:
    return 260.0f;
  case PanelSize::Lg:
    return 340.0f;
  case PanelSize::Auto:
    break;
  }
  return 0.0f;
}

} // namespace

::ui::UiElement Panel(const PanelProps &props) {
  ::ui::LayoutStyle layout{};
  ::ui::StylePatch overlay{};

  switch (props.variant) {
  case PanelVariant::Hero:
    layout = ::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Center,
        .width = ::ui::Length::points(340.0f),
        .padding = {24.0f, 24.0f, 24.0f, 24.0f},
        .gap = 14.0f,
        .border_width = tokens::kBorderWidth,
    };
    overlay = tokens::panel_patch(tokens::kSurfaceHeroPanel,
                                  tokens::kBorderHeroPanel);
    break;
  case PanelVariant::Overlay:
    layout = ::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Center,
        .width = ::ui::Length::points(220.0f),
        .padding = {18.0f, 18.0f, 18.0f, 18.0f},
        .gap = 12.0f,
        .border_width = tokens::kBorderWidth,
    };
    overlay = tokens::panel_patch(tokens::kSurfacePanel, tokens::kBorderPanel);
    break;
  case PanelVariant::Sunken:
    layout = ::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .width = ::ui::Length::points(260.0f),
        .padding = {14.0f, 14.0f, 14.0f, 14.0f},
        .gap = 10.0f,
        .border_width = 0.0f,
    };
    overlay = tokens::fill_patch(kSunkenBg);
    break;
  case PanelVariant::Bordered:
    // Legacy console panel: #10141C fill + 1px #565E6F border. The
    // origin/main lobby uses bordered console panels, not the borderless slate
    // Sunken. Stretch + tighter padding for dense lobby columns.
    layout = ::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .width = ::ui::Length::points(260.0f),
        .padding = {12.0f, 12.0f, 12.0f, 12.0f},
        .gap = 8.0f,
        .border_width = tokens::kBorderWidth,
    };
    overlay = tokens::panel_patch(tokens::kSurfacePanel, tokens::kBorderPanel);
    break;
  case PanelVariant::Chrome: {
    // Sprite-backed full chrome panel (bank 7 idx5), drawn as a PLAIN image at
    // its native sprite size so the baked frame border + internal wells stay
    // aligned. Content padding keeps children inside the frame chrome. Falls
    // back to a vector Hero panel for the not-yet-baked frame.
    client::ui::ChromeTextures chrome = client::ui::use_chrome();
    const float w = chrome.chrome_panel_w ? (float)chrome.chrome_panel_w : 628.0f;
    const float h = chrome.chrome_panel_h ? (float)chrome.chrome_panel_h : 441.0f;
    layout = ::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Center,
        .width = ::ui::Length::points(w),
        .height = ::ui::Length::points(h),
        .padding = {40.0f, 40.0f, 40.0f, 40.0f},
        .gap = 12.0f,
    };
    overlay = chrome.chrome_panel
                  ? tokens::image_patch(chrome.chrome_panel)
                  : tokens::panel_patch(tokens::kSurfaceHeroPanel,
                                        tokens::kBorderHeroPanel);
    break;
  }
  case PanelVariant::ControlsFrame: {
    // Single-pane Options·Controls frame (bank 7 idx7), STRETCHED in origin
    // (PackImageStretch(7,7)). The sprite bakes its own title-header notch
    // (top-center) + right-edge scrollbar rail, so the screen draws neither.
    // Absolutely positioned at the logical rect of origin's virtual element
    // box; the executor swaps the draw for the canonical per-size Stretch
    // variant. Padding re-centers the
    // content where the previous flow layout put it (the keybind grid was
    // pixdiff-tuned against the golden there): the baked title notch is
    // cleared by the top padding, content centers horizontally (origin
    // childAlignment CENTER_X). Falls back to a vector green panel.
    client::ui::ChromeTextures chrome = client::ui::use_chrome();
    if (chrome.chrome_controls && chrome.chrome_controls_w > 0.0f) {
      layout = ::ui::LayoutStyle{
          .position = ::ui::PositionType::Absolute,
          .direction = ::ui::FlexDirection::Column,
          .align_items = ::ui::AlignItems::Center,
          .width = ::ui::Length::points(chrome.chrome_controls_w),
          .height = ::ui::Length::points(chrome.chrome_controls_h),
          .padding = {0.0f, 0.0f, 106.5f, 33.0f},
          .position_inset = {chrome.chrome_controls_x, {},
                             chrome.chrome_controls_y, {}},
      };
      overlay = tokens::image_patch(chrome.chrome_controls);
    } else {
      layout = ::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Column,
          .align_items = ::ui::AlignItems::Center,
          .width = ::ui::Length::points(1254.5f),
          .flex_grow = ::ui::StyleFloat::points(1.0f),
          .margin = {2.3f, 0.0f, 1.0f, 22.0f},
          .padding = {0.0f, 0.0f, 105.0f, 33.0f},
      };
      overlay = tokens::panel_patch(tokens::kSurfaceHeroPanel,
                                    tokens::kBorderHeroPanel);
    }
    break;
  }
  }

  if (props.size != PanelSize::Auto) {
    layout.width = ::ui::Length::points(panel_size_width(props.size));
  }

  return <Box key={props.key} layout={layout} style={overlay}>
    {props.children}
  </Box>
}

} // namespace silencer

#include "client/ui/modals/password_modal_frame.h"

#include "client/ui/components/actions/app_button.h"
#include "client/ui/components/tokens.h"
#include "ui/components/box.h"
#include "ui/components/text.h"
#include "ui/components/text_input.h"
#include "ui/style/style_patch.h"

#include <cstdint>
#include <cstring>

namespace silencer {
namespace client_ui {
namespace password_modal_frame_detail {

inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch dialog_patch() {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(40, 2),
		.tint = {255, 255, 255, 255},
	});
}

inline ::ui::StylePatch title_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = tokens::kTextTitle,
		.font_id = 134,
		.font_size = 8,
		.align = ::ui::TextAlign::Center,
		.line_height = 13.0f,
	});
}

inline ::ui::StyleStatePatch input_patch() {
	::ui::StylePatch base = ::ui::patch()
		.background(::ui::Color{0, 0, 0, 0})
		.border(::ui::Border{})
		.outline(::ui::Outline{})
		.text(::ui::TextVisual{
			.color = tokens::kTextTitle,
			.font_id = 135,
			.font_size = 11,
			.align = ::ui::TextAlign::Left,
		});
	::ui::StylePatch state = ::ui::patch()
		.background(::ui::Color{0, 0, 0, 0})
		.border(::ui::Border{})
		.outline(::ui::Outline{});
	::ui::StyleStatePatch patch{};
	patch.base = base;
	patch.hover = state;
	patch.focus_visible = state;
	patch.pressed = state;
	patch.disabled = state;
	return patch;
}

inline std::function<void(const ::ui::TextChangeEvent&)>
password_text_change_callback(std::function<void(const char *)> on_change) {
	return [on_change](const ::ui::TextChangeEvent& event) {
		if(on_change) on_change(event.value);
	};
}

inline std::function<void(const ::ui::TextSubmitEvent&)>
password_text_submit_callback(std::function<void(const char *)> on_submit) {
	return [on_submit](const ::ui::TextSubmitEvent& event) {
		if(on_submit) on_submit(event.value);
	};
}

}  // namespace password_modal_frame_detail

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Text;
using ::ui::components::TextInput;
using ::ui::components::TextInputProps;
using ::ui::components::TextProps;

::ui::UiElement PasswordModalFrame(const PasswordModalFrameProps& props) {
	const char * password_display =
		props.password_display ? props.password_display : "";
	const int caret = static_cast<int>(std::strlen(password_display));
	::ui::EdgeSizes title_inset;
	title_inset.left = ::ui::StyleValue::points(34.0f);
	title_inset.top = ::ui::StyleValue::points(30.0f);
	::ui::EdgeSizes input_inset;
	input_inset.left = ::ui::StyleValue::points(66.0f);
	input_inset.top = ::ui::StyleValue::points(77.0f);
	::ui::EdgeSizes button_inset;
	button_inset.left = ::ui::StyleValue::points(98.0f);
	button_inset.top = ::ui::StyleValue::points(101.0f);
	return <Box
	  key={props.key}
	  layout={::ui::LayoutStyle{
			.align_items = ::ui::AlignItems::Center,
			.justify_content = ::ui::JustifyContent::Center,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::percent(100.0f),
		}}
	>
		<Box
		  key="dialog"
		  layout={::ui::LayoutStyle{
				.position = ::ui::PositionType::Relative,
				.width = ::ui::Length::points(352.0f),
				.height = ::ui::Length::points(148.0f),
			}}
		  style={password_modal_frame_detail::dialog_patch()}
		>
			<Text
			  key="title"
			  value="This game requires a password"
			  layout={::ui::LayoutStyle{
						.position = ::ui::PositionType::Absolute,
						.position_inset = title_inset,
						.width = ::ui::Length::points(284.0f),
						.height = ::ui::Length::points(15.0f),
					}}
			  style={password_modal_frame_detail::title_patch()}
			/>
			<TextInput
			  key="password"
			  id="password_modal.password"
			  idOffset={1}
			  autofocus={true}
			  accessibility={{.label = "Password"}}
			  value={password_display}
			  textEdit={::ui::TextEditMetadata{
					.caret = caret,
					.selection_start = caret,
					.selection_end = caret,
			  }}
			  onTextChange={password_modal_frame_detail::password_text_change_callback(props.set_password)}
			  onTextSubmit={password_modal_frame_detail::password_text_submit_callback(props.submit_password)}
			  maxLength={20}
			  layout={::ui::LayoutStyle{
					.position = ::ui::PositionType::Absolute,
					.position_inset = input_inset,
					.width = ::ui::Length::points(180.0f),
					.height = ::ui::Length::points(14.0f),
				}}
			  style={password_modal_frame_detail::input_patch()}
			/>
			<Box
			  key="ok-slot"
			  layout={::ui::LayoutStyle{
						.position = ::ui::PositionType::Absolute,
						.position_inset = button_inset,
						.width = ::ui::Length::points(156.0f),
						.height = ::ui::Length::points(21.0f),
					}}
			>
				<AppButton
				  key="ok"
				  controlId="password_modal.ok"
				  size={AppButtonSize::Chrome}
				  label="OK"
				  onPress={props.submit}
				/>
			</Box>
		</Box>
	</Box>
}

}  // namespace client_ui
}  // namespace silencer

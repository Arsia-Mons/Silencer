#include "client/ui/modals/password_modal_view.h"

#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/dialog.h"
#include "ui/components/input.h"
#include "ui/components/text.h"

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Dialog;
using ::ui::components::DialogProps;
using ::ui::components::Input;
using ::ui::components::InputProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::LayoutStyle dialog_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Start,
		.width = ::ui::Length::points(352.0f),
		.height = ::ui::Length::points(148.0f),
		.padding = {34.0f, 34.0f, 30.0f, 24.0f},
		.gap = 16.0f,
	};
}

::ui::LayoutStyle prompt_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(284.0f),
		.height = ::ui::Length::points(24.0f),
	};
}

::ui::LayoutStyle input_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Stretch,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(180.0f),
		.height = ::ui::Length::points(24.0f),
		.padding = {7.0f, 7.0f, 5.0f, 5.0f},
	};
}

::ui::LayoutStyle button_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(96.0f),
		.height = ::ui::Length::points(30.0f),
		.padding = {14.0f, 14.0f, 6.0f, 6.0f},
	};
}

::ui::StyleStatePatch prompt_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 12,
		.align = ::ui::TextAlign::Center,
	});
}

::ui::StyleStatePatch input_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 12,
		.align = ::ui::TextAlign::Left,
	});
}

std::function<void(const std::string&)> password_change_callback(
	std::function<void(const std::string&)> set_password) {
	return [set_password](const std::string& value) {
		if(set_password) set_password(value);
	};
}

std::function<void(const ::ui::ActivationEvent&)> submit_callback(
	std::function<void()> submit) {
	return [submit](const ::ui::ActivationEvent&) {
		if(submit) submit();
	};
}

}  // namespace

::ui::UiElement PasswordModalFrame(const PasswordModalFrameProps& props) {
	const PasswordModalCredentials& credentials = UsePasswordModalCredentials();
	return <Box key={props.key} layout={root_layout()}>
		<Dialog key="dialog" modal={true} layout={dialog_layout()}>
			<Text
			  key="prompt"
			  value="This game requires a password"
			  layout={prompt_layout()}
			  style={prompt_style()}
			/>
			<Input
			  key="password"
			  id="password_modal.password"
			  value={credentials.password}
			  password={true}
			  autofocus={true}
			  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Password"}}
			  onChange={password_change_callback(credentials.set_password)}
			  onActivate={submit_callback(credentials.submit)}
			  layout={input_layout()}
			  style={input_style()}
			/>
			<Button
			  key="ok"
			  id="password_modal.ok"
			  label="OK"
			  onActivate={submit_callback(credentials.submit)}
			  layout={button_layout()}
			/>
		</Dialog>
	</Box>
}

}  // namespace silencer::client_ui

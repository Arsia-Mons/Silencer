constexpr int kPromptY = 200;
constexpr int kPromptFontBank = 136;
constexpr int kPromptAdvance = 16;
constexpr int kPromptLineHeight = 23;
constexpr std::uint8_t kPromptPalette = 202;
constexpr int kTopMessageX = 200;
constexpr int kTopMessageY = 10;
constexpr int kTopMessageWidth = 245;
constexpr int kTopMessageHeight = 12;
constexpr int kTopMessageMaxLength = 35;
constexpr int kTopMessageScrollLead = 24;
constexpr int kTopMessageFontBank = 133;
constexpr int kTopMessageAdvance = 7;
constexpr int kTopMessageLineHeight = 11;
constexpr std::uint8_t kTopMessagePalette = 0;
constexpr int kStatusBaseY = 370;
constexpr int kStatusLineStep = -10;
constexpr int kStatusMaxLines = 4;
constexpr int kStatusFontBank = 133;
constexpr int kStatusAdvance = 7;
constexpr int kStatusLineHeight = 11;
constexpr int kPlayerListRootPaddingX = 50;
constexpr int kPlayerListRootPaddingTop = 50;
constexpr int kPlayerListPanelPadding = 10;
constexpr int kPlayerListTeamHeight = 58;
constexpr int kPlayerListEmblemSlotWidth = 40;
constexpr int kPlayerListPeerHeight = 12;
constexpr int kPlayerListMaxTeams = 4;
constexpr int kPlayerListMaxPeers = 4;
constexpr int kPlayerListTextBank = 133;
constexpr int kPlayerListTextAdvance = 6;
constexpr int kPlayerListTextLineHeight = 11;
constexpr int kMessageLineAdvance = 20;
constexpr int kBuyTechMaxRows = 5;
constexpr int kBuyTechRowStep = 25;
constexpr int kBuyTechNameX = 222;
constexpr int kBuyTechTextY = 145;
constexpr int kBuyTechNameWidth = 180;
constexpr int kBuyTechPriceCenterX = 440;
constexpr int kBuyTechFooterCenterX = 320;
constexpr int kBuyTechFooterY = 275;
constexpr int kBuyTechTextBank = 134;
constexpr int kBuyTechTextAdvance = 8;
constexpr int kBuyTechTextLineHeight = 15;
constexpr int kChatTextX = 10;
constexpr int kChatTextStartY = 10;
constexpr int kChatLineStepY = 10;
constexpr int kChatMaxLines = 5;
constexpr int kChatInputVisibleChars = 28;
constexpr int kChatTextBank = 133;
constexpr int kChatTextAdvance = 6;
constexpr int kChatTextLineHeight = 11;
constexpr int kChatInputUid = 9000;

inline ::ui::LayoutStyle root_layout(int width, int height) {
	return {
		.width = ::ui::Length::points(static_cast<float>(std::max(1, width))),
		.height = ::ui::Length::points(static_cast<float>(std::max(1, height))),
	};
}

inline ::ui::LayoutStyle absolute_layout(int x,
                                         int y,
                                         int width,
                                         int height) {
	::ui::EdgeSizes inset;
	inset.left = ::ui::StyleValue::points(static_cast<float>(x));
	inset.top = ::ui::StyleValue::points(static_cast<float>(y));
	return {
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::points(static_cast<float>(std::max(0, width))),
		.height = ::ui::Length::points(static_cast<float>(std::max(0, height))),
		.position_inset = inset,
	};
}

inline ::ui::StylePatch prompt_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {kPromptPalette, 0, 0, 255},
		.font_id = kPromptFontBank,
		.font_size = kPromptAdvance,
		.line_height = static_cast<float>(kPromptLineHeight),
	});
}

inline ::ui::StylePatch top_message_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {kTopMessagePalette, 0, 0, 255},
		.font_id = kTopMessageFontBank,
		.font_size = kTopMessageAdvance,
		.line_height = static_cast<float>(kTopMessageLineHeight),
	});
}

inline std::uint8_t status_brightness(std::uint8_t time, bool shadow) {
	int brightness = 128;
	if(time <= 16) brightness -= (16 - time) * 8;
	if(shadow) brightness = std::max(8, brightness - 64);
	return static_cast<std::uint8_t>(std::max(0, std::min(255, brightness)));
}

inline ::ui::StylePatch status_text_patch(std::uint8_t palette,
                                          std::uint8_t brightness) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {palette, brightness, 0, 255},
		.font_id = kStatusFontBank,
		.font_size = kStatusAdvance,
		.line_height = static_cast<float>(kStatusLineHeight),
	});
}

inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch image_patch(std::uint8_t bank,
                                    std::uint16_t index,
                                    std::uint8_t brightness = 128,
                                    int source_width = 0,
                                    int source_height = 0,
                                    bool tile = false) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(bank, index),
		.source_w = static_cast<std::uint16_t>(std::max(0, source_width)),
		.source_h = static_cast<std::uint16_t>(std::max(0, source_height)),
		.brightness = brightness,
		.tile = tile,
	});
}

inline ::ui::StylePatch palette_fill_patch(std::uint8_t palette,
                                           std::uint8_t alpha) {
	return ::ui::patch().background(::ui::Color{palette, 0, 0, alpha});
}

inline ::ui::StylePatch player_list_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {0, 0, 0, 255},
		.font_id = kPlayerListTextBank,
		.font_size = kPlayerListTextAdvance,
		.line_height = static_cast<float>(kPlayerListTextLineHeight),
	});
}

inline ::ui::StylePatch buy_tech_text_patch(std::uint8_t brightness = 128) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {0, brightness, 0, 255},
		.font_id = kBuyTechTextBank,
		.font_size = kBuyTechTextAdvance,
		.line_height = static_cast<float>(kBuyTechTextLineHeight),
	});
}

inline std::string buy_tech_row_action_id(int index) {
	return "ingame.buytech.row." + std::to_string(index);
}

inline ::ui::StylePatch chat_text_patch(std::uint8_t brightness = 136) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {0, brightness, 0, 255},
		.font_id = kChatTextBank,
		.font_size = kChatTextAdvance,
		.line_height = static_cast<float>(kChatTextLineHeight),
	});
}

struct MessageTextMetrics {
	std::uint16_t font_bank = 135;
	std::uint16_t advance = 11;
	int line_height = 19;
};

inline MessageTextMetrics title_message_metrics() {
	return MessageTextMetrics{135, 11, 19};
}

inline MessageTextMetrics heading_message_metrics() {
	return MessageTextMetrics{134, 10, 15};
}

inline MessageTextMetrics message_title_metrics() {
	return MessageTextMetrics{136, 25, 23};
}

inline MessageTextMetrics message_subtitle_metrics() {
	return MessageTextMetrics{135, 13, 19};
}

inline ::ui::VisualStyle message_glyph_visual(const MessageTextMetrics& metrics,
                                              std::uint8_t palette,
                                              std::uint8_t brightness) {
	::ui::VisualStyle visual;
	visual.text = ::ui::TextVisual{
		.color = {palette, brightness, 0, 255},
		.font_id = metrics.font_bank,
		.font_size = metrics.advance,
		.line_height = static_cast<float>(metrics.line_height),
	};
	return visual;
}

inline std::string top_message_slice(const char * text, int progress) {
	const char * safe_text = text ? text : "";
	const int length = static_cast<int>(std::strlen(safe_text));
	int start = 0;
	if(progress / 2 > kTopMessageScrollLead){
		start = (progress / 2) - kTopMessageScrollLead;
		if(start > length) start = length;
	}
	return std::string(safe_text + start,
	                   static_cast<std::size_t>(std::min(kTopMessageMaxLength, length - start)));
}

struct QuitPromptProps {
	const char * key = nullptr;
	int surface_width = 0;
	bool show = false;
	const char * text = nullptr;
};

::ui::UiElement QuitPrompt(const QuitPromptProps& props) {
	const char * text = props.text ? props.text : "";
	if(!props.show || !*text) return ::ui::empty();
	const int width = static_cast<int>(std::strlen(text)) * kPromptAdvance;
	const int x = std::max(0, (props.surface_width - width) / 2);
	return <Text
	  key={props.key}
	  id="QuitPromptText"
	  value={text}
	  layout={absolute_layout(x, kPromptY, width, kPromptLineHeight)}
	  style={prompt_text_patch()}
	/>
}

struct TopMessageProps {
	const char * key = nullptr;
	bool show = false;
	const char * text = nullptr;
	int progress = 0;
};

::ui::UiElement TopMessage(const TopMessageProps& props) {
	const char * text = props.text ? props.text : "";
	if(!props.show || !*text || props.progress <= 0) return ::ui::empty();
	std::string clipped = top_message_slice(text, props.progress);
	return <Text
	  key={props.key}
	  id="InGameTopMessage"
	  value={::ui::copy_string(clipped.c_str())}
	  layout={absolute_layout(kTopMessageX, kTopMessageY, kTopMessageWidth, kTopMessageHeight)}
	  style={top_message_text_patch()}
	/>
}

void append_message_glyph(std::vector<::ui::UiElement>& glyphs,
                          int ordinal,
                          const char * text,
                          int x,
                          int y,
                          const MessageTextMetrics& metrics,
                          std::uint8_t palette,
                          std::uint8_t brightness) {
	glyphs.push_back(::ui::host(::ui::HostKind::Text,
	                            ::ui::HostProps{
		                            .id = "InGameMessageGlyph",
		                            .id_offset = ordinal,
		                            .style = absolute_layout(
			                            x, y, metrics.advance, metrics.line_height),
		                            .visual = message_glyph_visual(
			                            metrics, palette, brightness),
		                            .text = ::ui::HostTextProps{.value = text},
	                            }));
}

::ui::UiChildren message_glyph_children(const InGameMessageView& msg,
                                        int surface_width) {
	if(!msg.message_i || msg.message.empty()) return {};

	std::vector<::ui::UiElement> glyphs;
	const char * text = msg.message.c_str();
	const int total_len = static_cast<int>(msg.message.size());
	glyphs.reserve(static_cast<std::size_t>(std::min(total_len, static_cast<int>(msg.message_i))) * 2);
	int line_length = total_len;
	const char * newline = std::strchr(text, '\n');
	if(newline) line_length = static_cast<int>(newline - text);
	int line_y = 60;
	std::uint8_t color = 208;
	MessageTextMetrics metrics = title_message_metrics();
	switch(msg.messagetype){
		case 1:
			color = 128;
			line_y = 190;
			metrics = heading_message_metrics();
			break;
		case 2:
			color = 128;
			break;
		case 3:
			color = 192;
			break;
		case 4:
			color = 153;
			break;
		case 10:
			color = 224;
			break;
		case 11:
			color = 153;
			break;
		case 20:
			color = 153;
			line_y = 200;
			break;
	}
	int next_line = line_length;
	int line = 0;
	for(int i = 0; i < total_len; ++i){
		if(i >= msg.message_i) break;
		std::uint8_t brightness = 128;
		if(msg.messagetype < 10){
			if(msg.message_i - msg.messagetime + 8 >= 0){
				brightness -= (msg.message_i - msg.messagetime + 8) * 8;
			}
			if(msg.message_i % 32 >= 16){
				brightness += ((16 - (msg.message_i % 16)) * 2);
			}else{
				brightness += ((msg.message_i % 16) * 2);
			}
		}
		if(msg.message_i - i <= 5){
			brightness += 40 - ((msg.message_i - i) * 8);
		}
		char glyph_text[2] = {text[i], 0};
		if(msg.messagetype >= 10){
			metrics = line == 0 ? message_title_metrics() : message_subtitle_metrics();
		}
		const std::uint8_t shadow_brightness =
			(int(brightness) - 64) < 8 ? 8 : brightness - 64;
		const int x =
			((surface_width - (line_length * metrics.advance)) / 2) +
			(metrics.advance * (line_length - next_line));
		const int ordinal = static_cast<int>(glyphs.size());
		append_message_glyph(glyphs,
		                     ordinal,
		                     glyph_text,
		                     x + 1,
		                     line_y + 1,
		                     metrics,
		                     color,
		                     shadow_brightness);
		append_message_glyph(glyphs,
		                     ordinal + 1,
		                     glyph_text,
		                     x,
		                     line_y,
		                     metrics,
		                     color,
		                     brightness);
		next_line--;
		if(next_line < 0){
			line_length = static_cast<int>(std::strlen(&text[i + 1]));
			const char * next_newline = std::strchr(&text[i + 1], '\n');
			if(next_newline){
				line_length = static_cast<int>(next_newline - &text[i + 1]);
			}
			next_line = line_length;
			line_y += (line == 0 && msg.messagetype >= 10)
				? 40
				: kMessageLineAdvance;
			line++;
		}
	}
	return ::ui::children(glyphs.data(), static_cast<int>(glyphs.size()));
}

struct MessageProps {
	const char * key = nullptr;
	bool show = false;
	InGameMessageView message = {};
	int surface_width = 0;
	int surface_height = 0;
};

::ui::UiElement Message(const MessageProps& props) {
	if(!props.show || !props.message.message_i ||
	   props.message.message.empty()){
		return ::ui::empty();
	}
	return <Box
	  key={props.key}
	  id="InGameMessageRoot"
	  layout={root_layout(props.surface_width, props.surface_height)}
	>
		{message_glyph_children(props.message, props.surface_width)}
	</Box>
}

struct BuyTechHighlightProps {
	const char * key = nullptr;
	bool show = false;
	int width = 0;
	int height = 0;
};

::ui::UiElement BuyTechHighlight(const BuyTechHighlightProps& props) {
	if(!props.show || props.width <= 0 || props.height <= 0){
		return ::ui::empty();
	}
	return <Box
	  key={props.key}
	  id="InGameBuyTechHighlight"
	  layout={absolute_layout(0, 0, props.width, props.height)}
	  style={image_patch(102, 1)}
	/>
}

struct BuyTechIconProps {
	const char * key = nullptr;
	const BuyTechRowView * row = nullptr;
	int x = 0;
	int y = 0;
};

::ui::UiElement BuyTechIcon(const BuyTechIconProps& props) {
	if(!props.row || props.row->iconW <= 0 || props.row->iconH <= 0){
		return ::ui::empty();
	}
	return <Box
	  key={props.key}
	  id="InGameBuyTechIcon"
	  layout={absolute_layout(props.x, props.y, props.row->iconW, props.row->iconH)}
	  style={image_patch(props.row->spriteBank, props.row->spriteIndex, props.row->brightness)}
	/>
}

struct BuyTechFooterProps {
	const char * key = nullptr;
	const char * text = nullptr;
};

::ui::UiElement BuyTechFooter(const BuyTechFooterProps& props) {
	const char * text = props.text ? props.text : "";
	if(!*text) return ::ui::empty();
	const int width =
		static_cast<int>(std::strlen(text)) * kBuyTechTextAdvance;
	return <Text
	  key={props.key}
	  id="InGameBuyTechFooter"
	  value={text}
	  layout={absolute_layout(kBuyTechFooterCenterX - (width / 2), kBuyTechFooterY, width, kBuyTechTextLineHeight)}
	  style={buy_tech_text_patch()}
	/>
}

struct BuyTechRowProps {
	const char * key = nullptr;
	const BuyTechOverlayView * view = nullptr;
	int visible_row = 0;
};

::ui::UiElement BuyTechRow(const BuyTechRowProps& props) {
	if(!props.view || props.visible_row < 0 ||
	   props.visible_row >= static_cast<int>(props.view->rows.size()) ||
	   props.visible_row >= kBuyTechMaxRows){
		return ::ui::empty();
	}
	const BuyTechRowView& row = props.view->rows[props.visible_row];
	const int yoffset = props.visible_row * kBuyTechRowStep;
	const int row_x = props.view->highlightX;
	const int row_y = props.view->highlightY + yoffset;
	const int name_x = kBuyTechNameX - row_x;
	const int text_y = (kBuyTechTextY + yoffset) - row_y;
	const int icon_x = row.iconX - row_x;
	const int icon_y = row.iconY - row_y;
	const int price_width =
		static_cast<int>(row.price.size()) * kBuyTechTextAdvance;
	const int price_x = (kBuyTechPriceCenterX - (price_width / 2)) - row_x;
	std::string action_string = buy_tech_row_action_id(row.index);
	const char * action_id = ::ui::copy_string(action_string.c_str());
	return <component_detail.Host
	  kind={::ui::HostKind::Box}
	  key={props.key}
	  id={action_id}
	  idOffset={row.index + 1}
	  style={absolute_layout(row_x, row_y, props.view->highlightW, props.view->highlightH)}
	  interaction={::ui::NodeInteraction{
			.focusable = true,
			.checked = row.selected,
		}}
	  accessibility={{.role = ::ui::SemanticRole::ListRow, .label = row.name.c_str()}}
	>
		<BuyTechHighlight
		  key="highlight"
		  show={row.selected}
		  width={props.view->highlightW}
		  height={props.view->highlightH}
		/>
		<BuyTechIcon key="icon" row={&row} x={icon_x} y={icon_y} />
		<Text
		  key="name"
		  id="InGameBuyTechName"
		  value={row.name.c_str()}
		  layout={absolute_layout(name_x, text_y, kBuyTechNameWidth, kBuyTechTextLineHeight)}
		  style={buy_tech_text_patch(row.brightness)}
		/>
		<Text
		  key="price"
		  id="InGameBuyTechPrice"
		  value={row.price.c_str()}
		  layout={absolute_layout(price_x, text_y, price_width, kBuyTechTextLineHeight)}
		  style={buy_tech_text_patch(row.brightness)}
		/>
	</component_detail.Host>
}

struct BuyTechOverlayProps {
	const char * key = nullptr;
	bool show = false;
	BuyTechOverlayView view = {};
	int surface_width = 0;
	int surface_height = 0;
};

::ui::UiElement BuyTechOverlay(const BuyTechOverlayProps& props) {
	if(!props.show || props.view.rows.empty() ||
	   props.view.backgroundW <= 0 || props.view.backgroundH <= 0 ||
	   props.view.highlightW <= 0 || props.view.highlightH <= 0){
		return ::ui::empty();
	}
	return <Box
	  key={props.key}
	  id="InGameBuyTechRoot"
	  layout={root_layout(props.surface_width, props.surface_height)}
	>
		<Box
		  key="background"
		  id="InGameBuyTechBackground"
		  layout={absolute_layout(props.view.backgroundX, props.view.backgroundY, props.view.backgroundW, props.view.backgroundH)}
		  style={image_patch(102, 0)}
		/>
		<BuyTechRow key="row-0" view={&props.view} visibleRow={0} />
		<BuyTechRow key="row-1" view={&props.view} visibleRow={1} />
		<BuyTechRow key="row-2" view={&props.view} visibleRow={2} />
		<BuyTechRow key="row-3" view={&props.view} visibleRow={3} />
		<BuyTechRow key="row-4" view={&props.view} visibleRow={4} />
		<BuyTechFooter key="footer" text={props.view.footer.c_str()} />
	</Box>
}

struct ChatBackgroundSpriteProps {
	const char * key = nullptr;
	const ChatOverlayView * chat = nullptr;
	int index = 0;
};

::ui::UiElement ChatBackgroundSprite(const ChatBackgroundSpriteProps& props) {
	if(!props.chat || props.index < 0 ||
	   props.index >= static_cast<int>(props.chat->backgroundSprites.size())){
		return ::ui::empty();
	}
	const ChatBackgroundSpriteView& sprite =
		props.chat->backgroundSprites[props.index];
	if(sprite.w <= 0 || sprite.h <= 0) return ::ui::empty();
	return <Box
	  key={props.key}
	  id="InGameChatBackgroundSprite"
	  idOffset={props.index}
	  layout={absolute_layout(sprite.x, sprite.y, sprite.w, sprite.h)}
	  style={image_patch(sprite.bank, sprite.index, 128, sprite.sourceW, sprite.sourceH, sprite.tile)}
	/>
}

struct ChatLineProps {
	const char * key = nullptr;
	const ChatOverlayView * chat = nullptr;
	int index = 0;
};

::ui::UiElement ChatLine(const ChatLineProps& props) {
	if(!props.chat || props.index < 0 ||
	   props.index >= static_cast<int>(props.chat->lines.size()) ||
	   props.index >= kChatMaxLines){
		return ::ui::empty();
	}
	const std::string& line = props.chat->lines[props.index];
	if(line.empty()) return ::ui::empty();
	return <Text
	  key={props.key}
	  id="InGameChatLine"
	  idOffset={props.index}
	  value={line.c_str()}
	  layout={absolute_layout(kChatTextX, kChatTextStartY + (props.index * kChatLineStepY), static_cast<int>(line.size()) * kChatTextAdvance, kChatTextLineHeight)}
	  style={chat_text_patch()}
	/>
}

struct ChatCaretProps {
	const char * key = nullptr;
	bool show = false;
	int x = 0;
};

::ui::UiElement ChatCaret(const ChatCaretProps& props) {
	if(!props.show) return ::ui::empty();
	return <Box
	  key={props.key}
	  id="InGameChatCaret"
	  layout={absolute_layout(props.x, 0, 1, kChatTextLineHeight)}
	  style={palette_fill_patch(140, 255)}
	/>
}

struct ChatInputProps {
	const char * key = nullptr;
	const ChatOverlayView * chat = nullptr;
};

::ui::UiElement ChatInput(const ChatInputProps& props) {
	if(!props.chat || !props.chat->inputActive) return ::ui::empty();
	const int yoffset =
		kChatTextStartY +
		static_cast<int>(props.chat->lines.size()) * kChatLineStepY;
	const int prefix_width =
		static_cast<int>(props.chat->inputPrefix.size()) * kChatTextAdvance;
	const int input_width = kChatInputVisibleChars * kChatTextAdvance;
	const int caret_x =
		std::min(std::max(0, input_width - 1),
		         static_cast<int>(props.chat->inputText.size()) * kChatTextAdvance);
	return <Box
	  key={props.key}
	  id="InGameChatInputRow"
	  layout={absolute_layout(kChatTextX, yoffset, prefix_width + input_width, kChatTextLineHeight)}
	>
		<Text
		  key="prefix"
		  id="InGameChatInputPrefix"
		  value={props.chat->inputPrefix.c_str()}
		  layout={absolute_layout(0, 0, prefix_width, kChatTextLineHeight)}
		  style={chat_text_patch()}
		/>
		<component_detail.Host
		  kind={::ui::HostKind::Box}
		  key="input"
		  id="ingame.chat"
		  idOffset={kChatInputUid}
		  style={absolute_layout(prefix_width, 0, input_width, kChatTextLineHeight)}
		  text={::ui::HostTextProps{.value = props.chat->inputText.c_str()}}
		  interaction={::ui::NodeInteraction{.focusable = true}}
		  accessibility={{.role = ::ui::SemanticRole::TextBox, .label = "In-game chat"}}
		>
			<Text
			  key="value"
			  id="InGameChatInputText"
			  value={props.chat->inputText.c_str()}
			  layout={absolute_layout(0, 0, input_width, kChatTextLineHeight)}
			  style={chat_text_patch(128)}
			/>
			<ChatCaret key="caret" show={props.chat->caretVisible} x={caret_x} />
		</component_detail.Host>
	</Box>
}

struct ChatChannelTargetProps {
	const char * key = nullptr;
	const ChatOverlayView * chat = nullptr;
};

::ui::UiElement ChatChannelTarget(const ChatChannelTargetProps& props) {
	if(!props.chat || !props.chat->inputActive) return ::ui::empty();
	const char * label = props.chat->chatWithTeam ? "Team chat" : "All chat";
	return <component_detail.Host
	  kind={::ui::HostKind::Box}
	  key={props.key}
	  id="ingame.chat.channel"
	  style={absolute_layout(0, 0, props.chat->panelW, props.chat->panelH)}
	  interaction={::ui::NodeInteraction{
			.focusable = true,
			.checked = props.chat->chatWithTeam,
		}}
	  accessibility={{.role = ::ui::SemanticRole::Checkbox, .label = label}}
	/>
}

struct ChatOverlayProps {
	const char * key = nullptr;
	bool show = false;
	ChatOverlayView chat = {};
};

::ui::UiElement ChatOverlay(const ChatOverlayProps& props) {
	if(!props.show || !props.chat.visible ||
	   props.chat.panelW <= 0 || props.chat.panelH <= 0){
		return ::ui::empty();
	}
	return <Box
	  key={props.key}
	  id="InGameChatPanel"
	  layout={absolute_layout(props.chat.panelX, props.chat.panelY, props.chat.panelW, props.chat.panelH)}
	>
		<ChatChannelTarget key="channel" chat={&props.chat} />
		<ChatBackgroundSprite key="background-0" chat={&props.chat} index={0} />
		<ChatBackgroundSprite key="background-1" chat={&props.chat} index={1} />
		<ChatBackgroundSprite key="background-2" chat={&props.chat} index={2} />
		<ChatBackgroundSprite key="background-3" chat={&props.chat} index={3} />
		<ChatBackgroundSprite key="background-4" chat={&props.chat} index={4} />
		<ChatBackgroundSprite key="background-5" chat={&props.chat} index={5} />
		<ChatLine key="line-0" chat={&props.chat} index={0} />
		<ChatLine key="line-1" chat={&props.chat} index={1} />
		<ChatLine key="line-2" chat={&props.chat} index={2} />
		<ChatLine key="line-3" chat={&props.chat} index={3} />
		<ChatLine key="line-4" chat={&props.chat} index={4} />
		<ChatInput key="input" chat={&props.chat} />
	</Box>
}

inline bool player_list_has_peers(const TeamHudView * teams, int count) {
	if(!teams || count <= 0) return false;
	for(int i = 0; i < count; ++i){
		if(!teams[i].playerListPeers.empty()) return true;
	}
	return false;
}

inline int player_list_team_count(int count) {
	return std::max(0, std::min(kPlayerListMaxTeams, count));
}

inline std::string peer_stats_text(const TeamPeerView& peer) {
	char stats[100];
	std::snprintf(stats,
	              sizeof(stats),
	              "L:%d    E:%d  S:%d  J:%d  H:%d  C:%d",
	              peer.agencyLevel,
	              peer.agencyEndurance,
	              peer.agencyShield,
	              peer.agencyJetpack,
	              peer.agencyHacking,
	              peer.agencyContacts);
	return std::string(stats);
}

struct PlayerListPeerRowProps {
	const char * key = nullptr;
	const TeamHudView * team = nullptr;
	int peer_index = 0;
	int x = 0;
	int y = 0;
	int width = 0;
};

::ui::UiElement PlayerListPeerRow(const PlayerListPeerRowProps& props) {
	if(!props.team || props.peer_index < 0 ||
	   props.peer_index >= static_cast<int>(props.team->playerListPeers.size()) ||
	   props.peer_index >= kPlayerListMaxPeers){
		return ::ui::empty();
	}
	const TeamPeerView& peer = props.team->playerListPeers[props.peer_index];
	std::string stats = peer_stats_text(peer);
	const int stats_width =
		static_cast<int>(stats.size() + 1) * kPlayerListTextAdvance;
	const int name_width = std::max(0, props.width - stats_width);
	return <Box
	  key="peer-row"
	  id="PlayerListPeerRow"
	  layout={absolute_layout(props.x, props.y, props.width, kPlayerListPeerHeight)}
	>
		<Text
		  key="name"
		  id="PlayerListPeerName"
		  value={::ui::copy_string(peer.displayName.c_str())}
		  layout={absolute_layout(0, 0, name_width, kPlayerListTextLineHeight)}
		  style={player_list_text_patch()}
		/>
		<Text
		  key="stats"
		  id="PlayerListPeerStats"
		  value={::ui::copy_string(stats.c_str())}
		  layout={absolute_layout(name_width, 0, stats_width, kPlayerListTextLineHeight)}
		  style={player_list_text_patch()}
		/>
	</Box>
}

struct PlayerListTeamRowProps {
	const char * key = nullptr;
	const TeamHudView * teams = nullptr;
	int team_count = 0;
	int team_index = 0;
	int x = 0;
	int y = 0;
	int width = 0;
};

::ui::UiElement PlayerListTeamRow(const PlayerListTeamRowProps& props) {
	if(!props.teams || props.team_index < 0 ||
	   props.team_index >= props.team_count ||
	   props.team_index >= kPlayerListMaxTeams){
		return ::ui::empty();
	}
	const TeamHudView& team = props.teams[props.team_index];
	const int emblem_y =
		std::max(0, (kPlayerListTeamHeight - team.emblemH) / 2);
	const int peer_column_x = kPlayerListEmblemSlotWidth;
	const int peer_column_width =
		std::max(0, props.width - kPlayerListEmblemSlotWidth);
	int peer_y =
		((kPlayerListMaxPeers -
		  static_cast<int>(team.playerListPeers.size())) *
		 kPlayerListPeerHeight) /
		2;
	if(peer_y < 0) peer_y = 0;
	return <Box
	  key="team-row"
	  id="PlayerListTeamRow"
	  layout={absolute_layout(props.x, props.y, props.width, kPlayerListTeamHeight)}
	>
		<Box
		  key="emblem"
		  id="PlayerListTeamEmblem"
		  layout={absolute_layout(0, emblem_y, team.emblemW, team.emblemH)}
		  style={image_patch(181, team.agency)}
		/>
		<PlayerListPeerRow
		  key="peer-0"
		  team={&team}
		  peerIndex={0}
		  x={peer_column_x}
		  y={peer_y}
		  width={peer_column_width}
		/>
		<PlayerListPeerRow
		  key="peer-1"
		  team={&team}
		  peerIndex={1}
		  x={peer_column_x}
		  y={peer_y + kPlayerListPeerHeight}
		  width={peer_column_width}
		/>
		<PlayerListPeerRow
		  key="peer-2"
		  team={&team}
		  peerIndex={2}
		  x={peer_column_x}
		  y={peer_y + (kPlayerListPeerHeight * 2)}
		  width={peer_column_width}
		/>
		<PlayerListPeerRow
		  key="peer-3"
		  team={&team}
		  peerIndex={3}
		  x={peer_column_x}
		  y={peer_y + (kPlayerListPeerHeight * 3)}
		  width={peer_column_width}
		/>
	</Box>
}

struct PlayerListProps {
	const char * key = nullptr;
	bool show = false;
	const TeamHudView * teams = nullptr;
	int team_count = 0;
	int surface_width = 0;
};

::ui::UiElement PlayerList(const PlayerListProps& props) {
	const int team_count = player_list_team_count(props.team_count);
	if(!props.show || team_count <= 0 ||
	   !player_list_has_peers(props.teams, team_count)){
		return ::ui::empty();
	}
	const int panel_x = kPlayerListRootPaddingX;
	const int panel_y = kPlayerListRootPaddingTop;
	const int panel_w =
		std::max(0, props.surface_width - (kPlayerListRootPaddingX * 2));
	const int panel_h =
		kPlayerListPanelPadding + (team_count * kPlayerListTeamHeight);
	const int row_x = kPlayerListPanelPadding;
	const int row_w = std::max(0, panel_w - (kPlayerListPanelPadding * 2));
	const int first_row_y = kPlayerListPanelPadding;
	return <Box
	  key="player-list"
	  id="PlayerListPanel"
	  layout={absolute_layout(panel_x, panel_y, panel_w, panel_h)}
	  style={palette_fill_patch(0, 128)}
	>
		<PlayerListTeamRow
		  key="team-0"
		  teams={props.teams}
		  teamCount={team_count}
		  teamIndex={0}
		  x={row_x}
		  y={first_row_y}
		  width={row_w}
		/>
		<PlayerListTeamRow
		  key="team-1"
		  teams={props.teams}
		  teamCount={team_count}
		  teamIndex={1}
		  x={row_x}
		  y={first_row_y + kPlayerListTeamHeight}
		  width={row_w}
		/>
		<PlayerListTeamRow
		  key="team-2"
		  teams={props.teams}
		  teamCount={team_count}
		  teamIndex={2}
		  x={row_x}
		  y={first_row_y + (kPlayerListTeamHeight * 2)}
		  width={row_w}
		/>
		<PlayerListTeamRow
		  key="team-3"
		  teams={props.teams}
		  teamCount={team_count}
		  teamIndex={3}
		  x={row_x}
		  y={first_row_y + (kPlayerListTeamHeight * 3)}
		  width={row_w}
		/>
	</Box>
}

struct StatusLineProps {
	const char * key = nullptr;
	bool show = false;
	const InGameStatusLineView * lines = nullptr;
	int count = 0;
	int index = 0;
	int surface_width = 0;
	bool shadow = false;
};

::ui::UiElement StatusLine(const StatusLineProps& props) {
	if(!props.show || !props.lines || props.index < 0 ||
	   props.index >= props.count || props.index >= kStatusMaxLines){
		return ::ui::empty();
	}
	const InGameStatusLineView& line = props.lines[props.index];
	if(line.text.empty()) return ::ui::empty();
	const int width = static_cast<int>(line.text.size()) * kStatusAdvance;
	const int x = std::max(0, (props.surface_width - width) / 2) +
	              (props.shadow ? 1 : 0);
	const int y = kStatusBaseY + (props.index * kStatusLineStep) +
	              (props.shadow ? 1 : 0);
	return <Text
	  key={props.key}
	  id="InGameStatusLine"
	  value={::ui::copy_string(line.text.c_str())}
	  layout={absolute_layout(x, y, width, kStatusLineHeight)}
	  style={status_text_patch(line.color, status_brightness(line.time, props.shadow))}
	/>
}


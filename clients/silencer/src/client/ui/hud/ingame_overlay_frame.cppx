struct HudSecretSpriteProps {
	const char * key = nullptr;
	const HudSecretOverlayView * overlay = nullptr;
	int index = 0;
	std::uint8_t phase = 0;
};

::ui::UiElement HudSecretSprite(const HudSecretSpriteProps& props) {
	if(!props.overlay || props.index < 0 ||
	   props.index >= props.overlay->spriteCount || props.index >= 3){
		return ::ui::empty();
	}
	const HudSpriteView& sprite = props.overlay->sprites[props.index];
	if(!sprite.visible || sprite.w <= 0 || sprite.h <= 0){
		return ::ui::empty();
	}
	const std::uint8_t brightness = sprite.animatedHighlight
		? animated_highlight_brightness(props.phase)
		: sprite.brightness;
	return <Box
	  key={props.key}
	  id="HudSecretSprite"
	  idOffset={props.index}
	  layout={absolute_layout(sprite.x, sprite.y, sprite.w, sprite.h)}
	  style={image_patch(sprite.spriteBank, sprite.spriteIndex, brightness)}
	/>
}

inline const char * secret_progress_label(int index) {
	switch(index){
		case 0: return "Guv Net";
		case 1: return "OS";
		case 2: return "Protocol";
		case 3: return "Cypher Lock 1";
		case 4: return "Cypher Lock 2";
		case 5: return "Cypher Lock 3";
		case 6: return "Header";
		case 7: return "Schedule";
		case 8: return "Location";
	}
	return "";
}

inline bool secret_progress_dimmed(const HudSecretOverlayView& overlay,
                                   int index,
                                   std::uint8_t phase) {
	const int progress = overlay.secretProgress - (20 * (index + 1));
	const bool hackingTick =
		overlay.hackingTickEligible && (phase % 16) < 8;
	return progress < (hackingTick ? -20 : 0);
}

struct HudSecretProgressLineProps {
	const char * key = nullptr;
	const HudSecretOverlayView * overlay = nullptr;
	int index = 0;
	std::uint8_t phase = 0;
};

::ui::UiElement HudSecretProgressLine(const HudSecretProgressLineProps& props) {
	if(!props.overlay || !props.overlay->showProgress ||
	   props.index < 0 || props.index >= kSecretProgressLines){
		return ::ui::empty();
	}
	const bool dimmed =
		secret_progress_dimmed(*props.overlay, props.index, props.phase);
	return <Text
	  key={props.key}
	  id="HudSecretProgressLine"
	  idOffset={props.index}
	  value={secret_progress_label(props.index)}
	  layout={absolute_layout(kSecretProgressX, kSecretProgressBaseY + (props.index * kSecretProgressStepY) + props.overlay->yOffset, kSecretProgressWidth, kSecretProgressHeight)}
	  style={secret_progress_text_patch(dimmed ? 114 : 0, dimmed ? 96 : 136)}
	/>
}


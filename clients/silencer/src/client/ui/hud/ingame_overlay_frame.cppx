inline std::uint8_t team_strip_ramp_plus(const HudSpriteView& sprite,
                                         std::uint8_t phase) {
	if(sprite.rampColor == 0 || sprite.rampTime == 0) return sprite.rampPlus;
	const std::uint8_t shifted = phase >> sprite.rampShift;
	const std::uint8_t period = sprite.rampTime * 2;
	if(period == 0) return sprite.rampPlus;
	if(shifted % period < sprite.rampTime) return shifted % sprite.rampTime;
	return sprite.rampTime - (shifted % sprite.rampTime);
}


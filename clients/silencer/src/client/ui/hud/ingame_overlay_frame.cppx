using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;

::ui::UiElement InGameOverlayFrame(const InGameOverlayFrameProps& props) {
	return <Box
	  key={props.key}
	  id="InGameOverlayRoot"
	  layout={ingame_overlay_frame_detail::root_layout(props.width, props.height)}
	>
		<ingame_overlay_frame_detail.Message
		  key="message"
		  show={props.show_message}
		  message={props.message}
		  surfaceWidth={props.width}
		  surfaceHeight={props.height}
		/>
		<ingame_overlay_frame_detail.BuyTechOverlay
		  key="buy-tech"
		  show={props.show_buy_tech}
		  view={props.buy_tech}
		  surfaceWidth={props.width}
		  surfaceHeight={props.height}
		/>
		<ingame_overlay_frame_detail.ChatOverlay key="chat" show={props.show_chat} chat={props.chat} />
		<ingame_overlay_frame_detail.PlayerList
		  key="player-list"

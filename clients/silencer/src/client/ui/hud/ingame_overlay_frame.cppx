inline ::ui::LayoutStyle root_layout(int width, int height) {
	return {
		.width = ::ui::Length::points(static_cast<float>(std::max(1, width))),
		.height = ::ui::Length::points(static_cast<float>(std::max(1, height))),
	};
}

inline ::ui::LayoutStyle layer_layout(int width, int height) {
	::ui::LayoutStyle layout = root_layout(width, height);
	layout.position = ::ui::PositionType::Absolute;
	layout.position_inset.left = ::ui::StyleValue::points(0.0f);
	layout.position_inset.top = ::ui::StyleValue::points(0.0f);
	return layout;
}

inline ::ui::LayoutStyle absolute_layout(int x,
                                         int y,
                                         int width,
                                         int height) {
	::ui::EdgeSizes inset;
	inset.left = ::ui::StyleValue::points(static_cast<float>(x));
	inset.top = ::ui::StyleValue::points(static_cast<float>(y));
	return {
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::points(static_cast<float>(std::max(0, width))),
		.height = ::ui::Length::points(static_cast<float>(std::max(0, height))),
		.position_inset = inset,
	};
}

inline ::ui::StylePatch prompt_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {kPromptPalette, 0, 0, 255},
		.font_id = kPromptFontBank,
		.font_size = kPromptAdvance,
		.line_height = static_cast<float>(kPromptLineHeight),
	});
}

inline ::ui::StylePatch top_message_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {kTopMessagePalette, 0, 0, 255},
		.font_id = kTopMessageFontBank,
		.font_size = kTopMessageAdvance,
		.line_height = static_cast<float>(kTopMessageLineHeight),
	});
}

inline std::uint8_t status_brightness(std::uint8_t time, bool shadow) {
	int brightness = 128;
	if(time <= 16) brightness -= (16 - time) * 8;
	if(shadow) brightness = std::max(8, brightness - 64);
	return static_cast<std::uint8_t>(std::max(0, std::min(255, brightness)));
}

inline ::ui::StylePatch status_text_patch(std::uint8_t palette,
                                          std::uint8_t brightness) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {palette, brightness, 0, 255},
		.font_id = kStatusFontBank,
		.font_size = kStatusAdvance,
		.line_height = static_cast<float>(kStatusLineHeight),
	});
}

inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch image_patch(std::uint8_t bank,
                                    std::uint16_t index,
                                    std::uint8_t brightness = 128,
                                    int source_width = 0,
                                    int source_height = 0,
                                    bool tile = false,
                                    int source_x = 0,
                                    int source_y = 0,
                                    std::uint8_t effect_color = 0,
                                    std::uint8_t ramp_color = 0,
                                    std::uint8_t ramp_plus = 0) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(bank, index),
		.source_x = static_cast<std::uint16_t>(std::max(0, source_x)),
		.source_y = static_cast<std::uint16_t>(std::max(0, source_y)),
		.source_w = static_cast<std::uint16_t>(std::max(0, source_width)),
		.source_h = static_cast<std::uint16_t>(std::max(0, source_height)),
		.effect_color = effect_color,
		.brightness = brightness,
		.ramp_color = ramp_color,
		.ramp_plus = ramp_plus,
		.tile = tile,
	});
}

inline ::ui::StylePatch team_emblem_patch(std::uint8_t bank,
                                          std::uint16_t index,
                                          std::uint8_t team_color,
                                          std::uint8_t outline_color,
                                          bool scaled) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(bank, index),
		.team_color = team_color,
		.outline_color = outline_color,
		.team_emblem = true,
		.scaled = scaled,
	});
}


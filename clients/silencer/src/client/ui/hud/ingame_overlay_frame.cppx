struct HudStatusSpriteProps {
	const char * key = nullptr;
	const HudStatusView * status = nullptr;
	int index = 0;
	std::uint8_t phase = 0;
};

::ui::UiElement HudStatusSprite(const HudStatusSpriteProps& props) {
	if(!props.status || props.index < 0 ||
	   props.index >= static_cast<int>(props.status->sprites.size())){
		return ::ui::empty();
	}
	const HudSpriteView& sprite = props.status->sprites[props.index];
	if(!sprite.visible || sprite.w <= 0 || sprite.h <= 0){
		return ::ui::empty();
	}
	if(sprite.blinkWarning && props.phase % 8 > 3){
		return ::ui::empty();
	}
	const std::uint8_t brightness = sprite.animatedShield
		? animated_shield_brightness(props.phase)
		: sprite.brightness;
	return <Box
	  key={props.key}
	  id="HudStatusSprite"
	  idOffset={props.index}
	  layout={absolute_layout(sprite.x, sprite.y, sprite.w, sprite.h)}
	  style={image_patch(sprite.spriteBank, sprite.spriteIndex, brightness, sprite.sourceW, sprite.sourceH, false, sprite.sourceX, sprite.sourceY)}
	/>
}


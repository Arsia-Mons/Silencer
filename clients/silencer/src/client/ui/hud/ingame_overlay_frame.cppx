struct HudReadoutTextProps {
	const char * key = nullptr;
	const char * id = nullptr;
	const char * value = nullptr;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
	std::uint8_t palette = 0;
	std::uint16_t text_bank = kReadoutTinyBank;
	std::uint16_t advance = kReadoutTinyAdvance;
	int line_height = kReadoutTinyLineHeight;
	::ui::TextAlign align = ::ui::TextAlign::Left;
	std::uint8_t alpha = 255;
};

::ui::UiElement HudReadoutText(const HudReadoutTextProps& props) {
	const char * value = props.value ? props.value : "";
	if(!*value) return ::ui::empty();
	return <Text
	  key={props.key}
	  id={props.id}
	  value={value}
	  layout={absolute_layout(props.x, props.y, props.width, props.height)}
	  style={readout_text_patch(props.palette, props.text_bank, props.advance, static_cast<float>(props.line_height), props.align, props.alpha)}
	/>
}

struct HudInventoryCountProps {
	const char * key = nullptr;
	const HudReadoutsView * readouts = nullptr;
	int index = 0;
};

::ui::UiElement HudInventoryCount(const HudInventoryCountProps& props) {
	if(!props.readouts || props.index < 0 || props.index >= 4){
		return ::ui::empty();
	}
	const int xoffsets[] = {612, 584, 556, 528};
	const int yoffsets[] = {13, 13, 11, 7};
	return <HudReadoutText
	  key={props.key}
	  id="HudInventoryCount"
	  value={props.readouts->inventoryCounts[props.index].c_str()}
	  x={xoffsets[props.index] + 20}
	  y={yoffsets[props.index] + 20}
	  width={32}
	  height={10}
	  palette={0}
	  textBank={kReadoutTinyBank}
	  advance={kReadoutTinyCounterAdvance}
	  lineHeight={kReadoutTinyLineHeight}
	/>
}


	return <Box key={props.key} layout={root_layout()}>
		<HudFixedSprite key="minimap-frame" bank={94} index={0} />
		<FuelLowSprite key="fuel-low" />
		<FuelBar key="fuel-bar" />
		<HudFixedSprite key="fuel-mask" bank={95} index={5} />
		<HealthBar key="health-bar" />
		<ShieldBar key="shield-bar" />
		<PoisonedSprite key="poisoned" />
		<FilesBar key="files-bar" />
		<WeaponFace key="weapon-face" />
		<WeaponGlow key="weapon-glow" />
		<WeaponSelector key="weapon-selector" />
		<HealthWarningSprite key="health-warning" />
		<ShieldWarningSprite key="shield-warning" />
		<HudFixedSprite key="inventory-frame" bank={94} index={2} />
		<InventoryIcon key="inventory-icon-0" slot={0} />
		<InventoryIcon key="inventory-icon-1" slot={1} />
		<InventoryIcon key="inventory-icon-2" slot={2} />
		<InventoryIcon key="inventory-icon-3" slot={3} />
		<InventoryLetter key="inventory-letter-0" slot={0} />
		<InventoryLetter key="inventory-letter-1" slot={1} />
		<InventoryLetter key="inventory-letter-2" slot={2} />
		<InventoryLetter key="inventory-letter-3" slot={3} />
	</Box>
}

const TeamHudView * team_at(const HudView& view, int slot) {
	if(slot < 0 || slot >= static_cast<int>(view.teams.size())) return nullptr;
	return &view.teams[static_cast<size_t>(slot)];
}

const TeamHudView * viewed_player_team(const HudView& view) {
	return find_team(view, view.viewedPlayer.teamId);
}

int secret_y_offset(const HudView& view) {
	int y = 60;
	const int count = static_cast<int>(view.teams.size());
	if(count >= 3) y += (count * 20) - 65;
	return y;
}

int team_y_offset(int slot) {
	return 5 + (slot * 20);
}

Uint8 hud_pulse_plus(Uint8 phase, Uint8 time, Uint8 shift) {
	if((phase >> shift) % (time * 2) < time) return (phase >> shift) % time;
	return time - ((phase >> shift) % time);
}

Uint8 secret_highlight_brightness(Uint8 phase) {
	Uint8 brightness = 120;
	if(phase % 32 < 16) brightness += phase % 16;
	else brightness += 16 - (phase % 16);
	return brightness;
}

int players_with_secret(const TeamHudView& team) {
	int count = 0;
	for(int i = 0; i < team.numPeers && i < 4; ++i){
		if(team.peerSlots[i].hasSecret) count++;
	}
	return count;
}

::ui::Color secret_progress_color(const PlayerHudView& player,
                                  int secretProgress,
                                  Uint8 phase,
                                  int line) {
	Uint8 effectColor = 0;
	Uint8 brightness = 136;
	for(int i = 0; i <= line; ++i){
		secretProgress -= 20;
		const bool hackingTick =
			player.state == kHudPlayerStateHacking && player.state_i == 16 && phase % 16 < 8;
		if(secretProgress < (hackingTick ? -20 : 0)){
			effectColor = 114;
			brightness = 96;
		}
	}
	if(effectColor == 114){
		return brightness < 128
			? ::ui::Color{62, 152, 104, 255}
			: ::ui::Color{93, 218, 142, 255};
	}
	return brightness < 128
		? ::ui::Color{168, 176, 186, 255}
		: ::ui::Color{226, 234, 242, 255};
}

const char * secret_progress_label(int line) {
	static const char * names[] = {
		"Guv Net", "OS", "Protocol", "Cypher Lock 1", "Cypher Lock 2",
		"Cypher Lock 3", "Header", "Schedule", "Location",
	};
	if(line < 0 || line >= 9) return "";
	return names[line];
}

struct HudTeamEmblemProps {
	const char * key = nullptr;
	int slot = 0;
	int x = 0;
	int y = 0;
};

::ui::UiElement HudTeamEmblem(const HudTeamEmblemProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const TeamHudView * team = team_at(*hud.state.view, props.slot);
	if(!team) return ::ui::empty();
	const RetainedHudTeamEmblemPayload payload{
		.bank = 181,
		.index = team->agency,
		.teamColor = team->color,
		.outlineColor = 17,
		.scaled = true,
	};
	return <Box
	  key={props.key}
	  layout={text_layout(props.x, props.y, team->emblemW, team->emblemH)}
	  style={team_emblem_style(payload)}
	/>
}


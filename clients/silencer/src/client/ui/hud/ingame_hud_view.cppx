int sprite_width(const Resources& resources, Uint8 bank, Uint16 index) {
	if(bank >= resources.spritebank.size()) return 0;
	if(index >= resources.spritebank[bank].size()) return 0;
	Surface * sprite = resources.spritebank[bank][index].get();
	return sprite ? sprite->w : 0;
}

int sprite_height(const Resources& resources, Uint8 bank, Uint16 index) {
	if(bank >= resources.spritebank.size()) return 0;
	if(index >= resources.spritebank[bank].size()) return 0;
	Surface * sprite = resources.spritebank[bank][index].get();
	return sprite ? sprite->h : 0;
}

int sprite_offset_x(const Resources& resources, Uint8 bank, Uint16 index) {
	if(bank >= resources.spriteoffsetx.size()) return 0;
	if(index >= resources.spriteoffsetx[bank].size()) return 0;
	return resources.spriteoffsetx[bank][index];
}

int sprite_offset_y(const Resources& resources, Uint8 bank, Uint16 index) {
	if(bank >= resources.spriteoffsety.size()) return 0;
	if(index >= resources.spriteoffsety[bank].size()) return 0;
	return resources.spriteoffsety[bank][index];
}

int sprite_x(const Resources& resources, Uint8 bank, Uint16 index, int logicalX = 0) {
	return logicalX - sprite_offset_x(resources, bank, index);
}

int sprite_y(const Resources& resources, Uint8 bank, Uint16 index, int logicalY = 0) {
	return logicalY - sprite_offset_y(resources, bank, index);
}

std::string visible_top_message(const InGameTopMessageView& message) {
	if(!message.topmessage_i || message.text.empty()) return std::string();
	int start = 0;
	if(message.topmessage_i / 2 > 24){
		start = (message.topmessage_i / 2) - 24;
		if(start > static_cast<int>(message.text.size())){
			start = static_cast<int>(message.text.size());
		}
	}
	const int length = std::min(kTopMessageMaxLength,
	                            static_cast<int>(message.text.size()) - start);
	return length > 0
		? message.text.substr(static_cast<size_t>(start), static_cast<size_t>(length))
		: std::string();
}

::ui::Color hud_text_color(Uint8 paletteColor) {
	switch(paletteColor){
		case 128: return {198, 213, 232, 255};
		case 153: return {238, 118, 118, 255};
		case 161: return {118, 230, 158, 255};
		case 192: return {135, 219, 174, 255};
		case 202: return {243, 216, 133, 255};
		case 208: return {226, 234, 242, 255};
		case 224: return {250, 245, 190, 255};
		default:  return {226, 234, 242, 255};
	}
}

std::string two_digit_text(int value) {
	return std::string(value < 10 ? " " : "") + std::to_string(value);
}

Uint8 current_ammo(const PlayerHudView& player) {
	switch(player.currentWeapon){
		case 0: return 99;
		case 1: return player.laserAmmo;
		case 2: return player.rocketAmmo;
		case 3: return player.flamerAmmo;
		default: return 0;
	}
}

const TeamHudView * find_team(const HudView& view, Uint16 id) {
	for(const TeamHudView& team : view.teams){
		if(team.id == id) return &team;
	}
	return nullptr;
}

Uint8 trace_time(const HudView& view) {
	const PlayerHudView& player = view.viewedPlayer;
	Uint8 value = 0;
	const TeamHudView * team = find_team(view, player.teamId);
	if(team && team->beamingTerminalId && team->beamingTerminalTraceTime > 0){
		value = team->beamingTerminalTraceTime;
	}
	if(player.tracetime > 0) value = player.tracetime;
	return value;
}

::ui::Color shadow_color() {
	return {24, 28, 36, 220};
}

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::EdgeSizes top_message_inset() {
	::ui::EdgeSizes inset;
	inset.left = ::ui::StyleValue::points(200.0f);
	inset.top = ::ui::StyleValue::points(10.0f);
	return inset;
}

::ui::EdgeSizes absolute_inset(int x, int y) {
	::ui::EdgeSizes inset;
	inset.left = ::ui::StyleValue::points(static_cast<float>(x));
	inset.top = ::ui::StyleValue::points(static_cast<float>(y));
	return inset;
}

::ui::LayoutStyle text_layout(int x, int y, int w, int h) {
	return ::ui::LayoutStyle{
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::points(static_cast<float>(w)),
		.height = ::ui::Length::points(static_cast<float>(h)),
		.position_inset = absolute_inset(x, y),
	};
}

::ui::LayoutStyle chat_input_layout(int x, int y, int w) {
	return ::ui::LayoutStyle{
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::points(static_cast<float>(w)),
		.height = ::ui::Length::points(16.0f),
		.position_inset = absolute_inset(x, y),
	};
}

::ui::LayoutStyle top_message_layout() {
	return ::ui::LayoutStyle{
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::points(245.0f),
		.height = ::ui::Length::points(12.0f),
		.position_inset = top_message_inset(),
	};
}

::ui::StyleStatePatch text_style(::ui::Color color,
                                 uint16_t font_id,
                                 uint16_t font_size,
                                 ::ui::TextAlign align = ::ui::TextAlign::Left) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = color,
		.font_id = font_id,
		.font_size = font_size,
		.align = align,
	});
}

::ui::StyleStatePatch chat_input_style() {
	::ui::StylePatch clear = ::ui::patch()
		.background(::ui::Color{0, 0, 0, 0})
		.border(::ui::Border{})
		.outline(::ui::Outline{})
		.text(::ui::TextVisual{
			.color = hud_text_color(128),
			.font_id = 133,
			.font_size = 6,
			.line_height = 11.0f,
		});
	::ui::StyleStatePatch state;
	state.base = clear;
	state.hover = clear;
	state.focus_visible = clear;
	state.pressed = clear;
	state.active = clear;
	return state;
}

::ui::StyleStatePatch sprite_style(const RetainedHudSpritePayload& payload) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = RetainedHudSpriteTextureId(payload),
		.tint = {255, 255, 255, 255},
	});
}

::ui::StyleStatePatch team_emblem_style(const RetainedHudTeamEmblemPayload& payload) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = RetainedHudTeamEmblemTextureId(payload),
		.tint = {255, 255, 255, 255},
	});
}

struct HudSpriteProps {
	const char * key = nullptr;
	Uint8 bank = 0;
	Uint16 index = 0;
	int src_x = 0;
	int src_y = 0;
	int src_w = 0;
	int src_h = 0;
	Uint8 effect_color = 0;
	Uint8 brightness = 128;
	Uint8 ramp_color = 0;
	Uint8 ramp_plus = 0;
	int x = 0;
	int y = 0;
	int w = 0;
	int h = 0;
};

::ui::UiElement HudSprite(const HudSpriteProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.resources) return ::ui::empty();
	const int width = props.w > 0
		? props.w
		: props.src_w > 0 ? props.src_w : sprite_width(*hud.state.resources, props.bank, props.index);
	const int height = props.h > 0
		? props.h
		: props.src_h > 0 ? props.src_h : sprite_height(*hud.state.resources, props.bank, props.index);
	if(width <= 0 || height <= 0) return ::ui::empty();
	const RetainedHudSpritePayload payload{
		.bank = props.bank,
		.index = props.index,
		.srcX = static_cast<Sint16>(props.src_x),
		.srcY = static_cast<Sint16>(props.src_y),
		.srcW = static_cast<Sint16>(props.src_w),
		.srcH = static_cast<Sint16>(props.src_h),
		.effectColor = props.effect_color,
		.brightness = props.brightness,
		.rampColor = props.ramp_color,
		.rampPlus = props.ramp_plus,
	};
	return <Box
	  key={props.key}
	  layout={text_layout(props.x, props.y, width, height)}
	  style={sprite_style(payload)}
	/>
}

struct HudFixedSpriteProps {
	const char * key = nullptr;
	Uint8 bank = 0;
	Uint16 index = 0;
	int logical_x = 0;
	int logical_y = 0;
	Uint8 brightness = 128;
	Uint8 ramp_color = 0;
	Uint8 ramp_plus = 0;
};

::ui::UiElement HudFixedSprite(const HudFixedSpriteProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.resources) return ::ui::empty();
	const Resources& resources = *hud.state.resources;
	return <HudSprite
	  key={props.key}
	  bank={props.bank}
	  index={props.index}
	  x={sprite_x(resources, props.bank, props.index, props.logical_x)}
	  y={sprite_y(resources, props.bank, props.index, props.logical_y)}
	  brightness={props.brightness}
	  rampColor={props.ramp_color}
	  rampPlus={props.ramp_plus}
	/>
}

int proportional_size(int value, int maxValue, int size) {
	if(maxValue <= 0 || size <= 0) return 0;
	return static_cast<int>((static_cast<float>(value) / maxValue) * size);
}

::ui::Color inventory_letter_color(Uint8 brightness) {
	return brightness >= 128
		? ::ui::Color{226, 234, 242, 255}
		: ::ui::Color{78, 86, 98, 255};
}


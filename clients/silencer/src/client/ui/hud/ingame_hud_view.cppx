	const char * key = nullptr;
};

::ui::UiElement FuelLowSprite(const FuelLowSpriteProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.view->viewedPlayer.fuelLow) return ::ui::empty();
	return <HudFixedSprite key={props.key} bank={95} index={8} />
}

struct FuelBarProps {
	const char * key = nullptr;
};

::ui::UiElement FuelBar(const FuelBarProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.resources) return ::ui::empty();
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	const Resources& resources = *hud.state.resources;
	const int w = proportional_size(player.fuel, player.maxFuel, sprite_width(resources, 95, 6));
	const int h = sprite_height(resources, 95, 6);
	if(w <= 0 || h <= 0) return ::ui::empty();
	return <HudSprite
	  key={props.key}
	  bank={95}
	  index={6}
	  srcW={w}
	  srcH={h}
	  x={sprite_x(resources, 95, 6)}
	  y={sprite_y(resources, 95, 6)}
	  w={w}
	  h={h}
	/>
}

struct HealthBarProps {
	const char * key = nullptr;
};

::ui::UiElement HealthBar(const HealthBarProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.resources) return ::ui::empty();
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	const Resources& resources = *hud.state.resources;
	const int h = sprite_height(resources, 95, 0);
	const int w = sprite_width(resources, 95, 0);
	if(w <= 0 || h <= 0) return ::ui::empty();
	const int yOffset = h - proportional_size(player.health, player.maxHealth, h);
	const int barH = h - yOffset;
	if(barH <= 0) return ::ui::empty();
	return <HudSprite
	  key={props.key}
	  bank={95}
	  index={0}
	  srcY={yOffset}
	  srcW={w}
	  srcH={barH}
	  x={sprite_x(resources, 95, 0)}
	  y={sprite_y(resources, 95, 0) + yOffset}
	  w={w}
	  h={barH}
	/>
}

struct ShieldBarProps {
	const char * key = nullptr;
};

::ui::UiElement ShieldBar(const ShieldBarProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.resources) return ::ui::empty();
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	const Resources& resources = *hud.state.resources;
	const int h = sprite_height(resources, 95, 1);
	const int w = sprite_width(resources, 95, 1);
	if(w <= 0 || h <= 0) return ::ui::empty();
	int yOffset = h - proportional_size(player.shield, player.maxShield, h);
	if(yOffset < 0) yOffset = 0;
	const int barH = h - yOffset;
	if(barH <= 0) return ::ui::empty();
	Uint8 brightness = 128;
	if(player.shield > player.maxShield){
		const Uint8 time = 6;
		brightness = 136;
		if(hud.state.animationPhase % (time * 2) < time){
			brightness += (hud.state.animationPhase % time) * 2;
		}else{
			brightness += (time - (hud.state.animationPhase % time)) * 2;
		}
	}
	return <HudSprite
	  key={props.key}
	  bank={95}
	  index={1}
	  srcY={yOffset}
	  srcW={w}
	  srcH={barH}
	  x={sprite_x(resources, 95, 1)}
	  y={sprite_y(resources, 95, 1) + yOffset}
	  w={w}
	  h={barH}
	  brightness={brightness}
	/>
}


	const char * key = nullptr;
};

::ui::UiElement HudTeamChrome(const HudTeamChromeProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || hud.state.view->teams.empty()) return ::ui::empty();
	if(hud.state.view->teams.size() == 1){
		return <HudFixedSprite key={props.key} bank={94} index={1} />
	}
	return <Box key={props.key} layout={root_layout()}>
		<HudFixedSprite
		  key="team-strip-background"
		  bank={103}
		  index={0}
		  logicalY={-133 + ((static_cast<int>(hud.state.view->teams.size()) - 1) * 20)}
		/>
		<HudFixedSprite key="team-strip-front" bank={103} index={1} />
	</Box>
}

struct HudTeamPeerSpriteProps {
	const char * key = nullptr;
	int team_slot = 0;
	int peer_slot = 0;
};

::ui::UiElement HudTeamPeerSprite(const HudTeamPeerSpriteProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const TeamHudView * team = team_at(*hud.state.view, props.team_slot);
	if(!team) return ::ui::empty();
	if(props.peer_slot < 0 || props.peer_slot >= team->numPeers || props.peer_slot >= 4){
		return ::ui::empty();
	}
	const TeamHudView::PeerSlot& slot = team->peerSlots[props.peer_slot];
	if(!slot.present) return ::ui::empty();
	Uint8 index = slot.state == kHudPlayerStateDead || slot.state == kHudPlayerStateDying ? 8 : 4;
	index += static_cast<Uint8>(props.peer_slot);
	Uint8 rampColor = 0;
	Uint8 rampPlus = 0;
	if(slot.inBase || slot.hasSecret){
		Uint8 time = 4;
		Uint8 shift = 2;
		rampColor = 210;
		if(slot.hasSecret){
			time = 8;
			rampColor = 114;
			shift = 0;
		}
		rampPlus = hud_pulse_plus(hud.state.animationPhase, time, shift);
	}
	return <HudFixedSprite
	  key={props.key}
	  bank={103}
	  index={index}
	  logicalX={25 + (17 * props.peer_slot)}
	  logicalY={team_y_offset(props.team_slot)}
	  rampColor={rampColor}
	  rampPlus={rampPlus}
	/>
}

struct HudTeamSecretSpriteProps {
	const char * key = nullptr;
	int team_slot = 0;
	int secret_slot = 0;
};

::ui::UiElement HudTeamSecretSprite(const HudTeamSecretSpriteProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const TeamHudView * team = team_at(*hud.state.view, props.team_slot);
	if(!team || props.secret_slot < 0 || props.secret_slot >= 3) return ::ui::empty();
	Uint8 index = team->secrets > props.secret_slot ? 2 : 3;
	Uint8 rampColor = 0;
	const int secretPlayers = players_with_secret(*team);
	if(index == 3 && secretPlayers > props.secret_slot - team->secrets &&
	   hud.state.view->tickCount % 12 < 6){
		index = 2;
	}
	if(team->beamingTerminalId && team->secrets == props.secret_slot && index == 3){
		rampColor = 224;
		index = 3;
	}
	return <HudFixedSprite
	  key={props.key}
	  bank={103}
	  index={index}
	  logicalX={-(9 * (3 - props.secret_slot)) + 11}
	  logicalY={team_y_offset(props.team_slot)}
	  rampColor={rampColor}
	/>
}


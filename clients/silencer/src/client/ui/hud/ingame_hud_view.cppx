struct MessageTextMetrics {
	uint16_t font_id = 135;
	uint16_t font_size = 11;
	int line_height = 19;
	int advance = 11;
};

Uint8 message_palette_color(Uint8 type) {
	switch(type){
		case 1:
		case 2:
			return 128;
		case 3:
			return 192;
		case 4:
		case 11:
		case 20:
			return 153;
		case 10:
			return 224;
		default:
			return 208;
	}
}

int message_start_y(Uint8 type) {
	switch(type){
		case 1:
			return 190;
		case 20:
			return 200;
		default:
			return 60;
	}
}

MessageTextMetrics message_text_metrics(Uint8 type, int line) {
	if(type >= 10){
		return line == 0
			? MessageTextMetrics{ .font_id = 136, .font_size = 25, .line_height = 23, .advance = 25 }
			: MessageTextMetrics{ .font_id = 135, .font_size = 13, .line_height = 19, .advance = 13 };
	}
	if(type == 1){
		return MessageTextMetrics{ .font_id = 134, .font_size = 10, .line_height = 15, .advance = 10 };
	}
	return MessageTextMetrics{};
}

int message_line_y(Uint8 type, int line) {
	const int start = message_start_y(type);
	if(type >= 10 && line > 0) return start + 40 + ((line - 1) * 20);
	return start + (line * 20);
}

std::string visible_message_line(const InGameMessageView& message, int targetLine) {
	if(targetLine < 0 || !message.message_i || message.message.empty()) return std::string();
	const int visibleChars = std::min<int>(message.message_i, static_cast<int>(message.message.size()));
	int line = 0;
	std::string out;
	for(int i = 0; i < visibleChars; ++i){
		const char ch = message.message[static_cast<size_t>(i)];
		if(ch == '\n'){
			if(line == targetLine) return out;
			line++;
			out.clear();
			continue;
		}
		if(line == targetLine) out.push_back(ch);
	}
	return line == targetLine ? out : std::string();
}

struct MessageLineProps {
	const char * key = nullptr;
	int line = 0;
	bool shadow = false;
};

::ui::UiElement MessageLine(const MessageLineProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const InGameMessageView& message = hud.state.view->message;
	std::string text = visible_message_line(message, props.line);
	if(text.empty()) return ::ui::empty();
	const MessageTextMetrics metrics = message_text_metrics(message.messagetype, props.line);
	const int width = static_cast<int>(text.size()) * metrics.advance;
	if(width <= 0) return ::ui::empty();
	const int x = (640 - width) / 2;
	const int y = message_line_y(message.messagetype, props.line);
	return <Text
	  key={props.key}
	  value={::ui::copy_string(text.c_str())}
	  layout={text_layout(x + (props.shadow ? 1 : 0), y + (props.shadow ? 1 : 0), width, metrics.line_height)}
	  style={text_style(props.shadow ? shadow_color() : hud_text_color(message_palette_color(message.messagetype)), metrics.font_id, metrics.font_size)}
	/>
}


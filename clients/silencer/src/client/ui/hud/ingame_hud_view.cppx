struct HealthWarningSpriteProps {
	const char * key = nullptr;
};

::ui::UiElement HealthWarningSprite(const HealthWarningSpriteProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	if(!player.health || player.maxHealth <= 0) return ::ui::empty();
	if(static_cast<float>(player.health) / player.maxHealth > 0.5f) return ::ui::empty();
	if(hud.state.animationPhase % 8 > 3) return ::ui::empty();
	return <HudFixedSprite key={props.key} bank={95} index={3} />
}

struct ShieldWarningSpriteProps {
	const char * key = nullptr;
};

::ui::UiElement ShieldWarningSprite(const ShieldWarningSpriteProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	if(!player.shield || player.maxShield <= 0) return ::ui::empty();
	if(static_cast<float>(player.shield) / player.maxShield > 0.5f) return ::ui::empty();
	if(hud.state.animationPhase % 8 > 3) return ::ui::empty();
	return <HudFixedSprite key={props.key} bank={95} index={4} />
}

struct InventoryIconProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement InventoryIcon(const InventoryIconProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.resources) return ::ui::empty();
	if(props.slot < 0 || props.slot >= 4) return ::ui::empty();
	const int xOffsets[] = {612, 584, 556, 528};
	const int yOffsets[] = {13, 13, 11, 7};
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	const Resources& resources = *hud.state.resources;
	const Uint8 index = player.inventorySpriteIndexes[props.slot];
	const int x = sprite_x(resources, 97, index, xOffsets[props.slot]);
	const int y = sprite_y(resources, 97, index, yOffsets[props.slot]);
	const int w = sprite_width(resources, 97, index);
	const int h = sprite_height(resources, 97, index);
	if(w <= 0 || h <= 0) return ::ui::empty();
	const Uint8 brightness = player.currentInventoryItem == props.slot ? 128 : 32;
	return <HudSprite
	  key={props.key}
	  bank={97}
	  index={index}
	  x={x}
	  y={y}
	  w={w}
	  h={h}
	  brightness={brightness}
	/>
}

struct InventoryLetterProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement InventoryLetter(const InventoryLetterProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	if(props.slot < 0 || props.slot >= 4) return ::ui::empty();
	const int xOffsets[] = {612, 584, 556, 528};
	const int yOffsets[] = {13, 13, 11, 7};
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	const char letter = player.inventoryLetters[props.slot];
	if(letter == '\0') return ::ui::empty();
	const Uint8 brightness = player.currentInventoryItem == props.slot ? 128 : 32;
	return <Text
	  key={props.key}
	  value={::ui::copy_string(use_text_storage("%c", letter))}
	  layout={text_layout(xOffsets[props.slot] - 2, yOffsets[props.slot], 8, 8)}
	  style={text_style(inventory_letter_color(brightness), 132, 4)}
	/>
}


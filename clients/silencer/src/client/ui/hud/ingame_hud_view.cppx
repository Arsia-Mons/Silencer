		<MessageLine key="line-5-shadow" line={5} shadow={true} />
		<MessageLine key="line-5-text" line={5} />
	</Box>
}

int chat_middle_tile_x(const Resources& resources, bool interior, int slot, int& tileW) {
	const Uint16 leftIndex = interior ? 6 : 0;
	const Uint16 middleIndex = interior ? 7 : 1;
	const Uint16 rightIndex = interior ? 8 : 2;
	int xOffset = sprite_width(resources, kChatBackgroundBank, leftIndex);
	const int rightLimit = kChatW - sprite_width(resources, kChatBackgroundBank, rightIndex);
	for(int currentSlot = 0; xOffset < rightLimit; ++currentSlot){
		tileW = kChatW - xOffset - kChatRightCapX;
		const int maxTileW = sprite_width(resources, kChatBackgroundBank, middleIndex);
		if(maxTileW <= 0) break;
		if(tileW > maxTileW) tileW = maxTileW;
		if(tileW <= 0) break;
		if(currentSlot == slot) return xOffset;
		xOffset += tileW;
	}
	tileW = 0;
	return -1;
}

int chat_visible_line_count(const HudView& view) {
	const PlayerHudView& player = view.viewedPlayer;
	int count = 0;
	for(int i = 0; i < static_cast<int>(view.chatLines.size()); ++i){
		if(player.chatActive && i == 0 && view.chatLines.size() == 5) continue;
		++count;
	}
	return count;
}

std::string chat_history_line_text(const HudView& view, int slot) {
	const PlayerHudView& player = view.viewedPlayer;
	int visibleSlot = 0;
	for(int i = 0; i < static_cast<int>(view.chatLines.size()); ++i){
		if(player.chatActive && i == 0 && view.chatLines.size() == 5) continue;
		if(visibleSlot == slot){
			return view.chatLines[static_cast<size_t>(i)]
				.substr(0, static_cast<size_t>(kChatMaxHistoryChars));
		}
		++visibleSlot;
	}
	return std::string();
}

std::function<void(const ::ui::ActivationEvent&)>
submit_chat_text(std::function<void(const std::string&)> submit, std::string value) {
	return [submit, value](const ::ui::ActivationEvent&) {
		if(submit) submit(value);
	};
}

std::function<void(const ::ui::ActivationEvent&)>
toggle_chat_channel(std::function<void()> toggle) {
	return [toggle](const ::ui::ActivationEvent&) {
		if(toggle) toggle();
	};
}

struct ChatBackgroundSpriteProps {
	const char * key = nullptr;
	Uint16 index = 0;
	int logical_x = 0;
	int logical_y = 0;
	int src_w = 0;
	int src_h = 0;
};

::ui::UiElement ChatBackgroundSprite(const ChatBackgroundSpriteProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.resources) return ::ui::empty();
	const Resources& resources = *hud.state.resources;
	const int w = props.src_w > 0
		? props.src_w
		: sprite_width(resources, kChatBackgroundBank, props.index);
	const int h = props.src_h > 0
		? props.src_h
		: sprite_height(resources, kChatBackgroundBank, props.index);
	if(w <= 0 || h <= 0) return ::ui::empty();
	return <HudSprite
	  key={props.key}
	  bank={kChatBackgroundBank}
	  index={props.index}
	  srcW={w}
	  srcH={h}
	  x={kChatX + sprite_x(resources, kChatBackgroundBank, props.index, props.logical_x)}
	  y={kChatY + sprite_y(resources, kChatBackgroundBank, props.index, props.logical_y)}
	  w={w}
	  h={h}
	/>
}

struct ChatMiddleTileProps {
	const char * key = nullptr;
	bool interior = false;
	int slot = 0;
};

::ui::UiElement ChatMiddleTile(const ChatMiddleTileProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.resources) return ::ui::empty();
	const Resources& resources = *hud.state.resources;
	int tileW = 0;
	const int logicalX = chat_middle_tile_x(resources, props.interior, props.slot, tileW);
	if(logicalX < 0 || tileW <= 0) return ::ui::empty();
	const Uint16 index = props.interior ? 7 : 1;
	return <ChatBackgroundSprite
	  key={props.key}
	  index={index}
	  logicalX={logicalX}
	  logicalY={props.interior ? kChatBackgroundInteriorH : 0}
	  srcW={tileW}
	  srcH={sprite_height(resources, kChatBackgroundBank, index)}
	/>
}

struct ChatBackgroundProps {
	const char * key = nullptr;
};

::ui::UiElement ChatBackground(const ChatBackgroundProps& props) {
	return <Box key={props.key} layout={root_layout()}>
		<ChatBackgroundSprite key="top-left" index={0} logicalX={0} logicalY={0} />
		<ChatMiddleTile key="top-mid-0" slot={0} />
		<ChatMiddleTile key="top-mid-1" slot={1} />
		<ChatMiddleTile key="top-mid-2" slot={2} />
		<ChatMiddleTile key="top-mid-3" slot={3} />
		<ChatMiddleTile key="top-mid-4" slot={4} />
		<ChatBackgroundSprite key="top-right" index={2} logicalX={kChatW - kChatRightCapX} logicalY={0} />
		<ChatBackgroundSprite
		  key="body-left"
		  index={6}
		  logicalX={0}
		  logicalY={kChatBackgroundInteriorH}
		/>
		<ChatMiddleTile key="body-mid-0" interior={true} slot={0} />
		<ChatMiddleTile key="body-mid-1" interior={true} slot={1} />
		<ChatMiddleTile key="body-mid-2" interior={true} slot={2} />
		<ChatMiddleTile key="body-mid-3" interior={true} slot={3} />
		<ChatMiddleTile key="body-mid-4" interior={true} slot={4} />
		<ChatBackgroundSprite
		  key="body-right"
		  index={8}
		  logicalX={kChatW - kChatRightCapX}
		  logicalY={kChatBackgroundInteriorH}
		/>
	</Box>
}

struct ChatHistoryLineProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement ChatHistoryLine(const ChatHistoryLineProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	std::string text = chat_history_line_text(*hud.state.view, props.slot);
	if(text.empty()) return ::ui::empty();
	return <Text
	  key={props.key}
	  value={::ui::copy_string(text.c_str())}
	  layout={text_layout(kChatX + kChatTextX, kChatY + kChatTextStartY + (props.slot * kChatLineStepY), kChatMaxHistoryChars * kChatTextAdvance, kChatLineHeight)}
	  style={text_style(hud_text_color(208), 133, 6)}
	/>
}

struct ChatInputLineProps {
	const char * key = nullptr;
	int y = 0;
};

::ui::UiElement ChatInputLine(const ChatInputLineProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	if(!player.chatActive) return ::ui::empty();
	const char * prefix = player.chatWithTeam ? "(TEAM):" : "(ALL):";
	const int prefixW = static_cast<int>(std::strlen(prefix)) * kChatTextAdvance;
	const int inputX = kChatX + kChatTextX + prefixW - 8;
	const int inputY = kChatY + props.y;
	return <Box key={props.key} layout={root_layout()}>
		<Box
		  key={player.chatWithTeam ? "channel-hit-team" : "channel-hit-all"}
		  focusable={true}
		  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::Button, .label = player.chatWithTeam ? "Team chat" : "All chat"}}
		  onActivate={toggle_chat_channel(hud.actions.toggle_chat_channel)}
		  layout={text_layout(kChatX + kChatTextX, inputY, prefixW, kChatLineHeight)}
		/>
		<Text
		  key="prefix"
		  value={prefix}
		  layout={text_layout(kChatX + kChatTextX, inputY, prefixW, kChatLineHeight)}
		  style={text_style(hud_text_color(208), 133, 6)}
		/>
		<Input
		  key="input"
		  id={kChatInputActionId}
		  value={player.chatText.c_str()}
		  autofocus={true}
		  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "In-game chat"}}
		  onChange={hud.actions.set_chat_text}
		  onActivate={submit_chat_text(hud.actions.submit_chat_text, player.chatText)}
		  layout={chat_input_layout(inputX, inputY, (kChatInputVisibleChars * kChatTextAdvance) + 16)}
		  style={chat_input_style()}
		/>
	</Box>
}

struct ChatOverlayProps {
	const char * key = nullptr;
};

::ui::UiElement ChatOverlay(const ChatOverlayProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	if(!player.chatActive && hud.state.view->showChatTicks <= 0) return ::ui::empty();
	const int lineCount = chat_visible_line_count(*hud.state.view);
	if(lineCount <= 0 && !player.chatActive) return ::ui::empty();
	const int inputY = kChatTextStartY + (lineCount * kChatLineStepY);
	return <Box key={props.key} layout={root_layout()}>
		<ChatBackground key="background" />
		<ChatHistoryLine key="line-0" slot={0} />
		<ChatHistoryLine key="line-1" slot={1} />
		<ChatHistoryLine key="line-2" slot={2} />
		<ChatHistoryLine key="line-3" slot={3} />
		<ChatHistoryLine key="line-4" slot={4} />
		<ChatInputLine key="input-line" y={inputY} />
	</Box>
}

std::string buy_tech_action_id(int index) {
	return "ingame.buytech.row." + std::to_string(index);
}

std::function<void(const ::ui::FocusEvent&)>
focus_buy_tech_row(std::function<void(int)> focus, int index) {
	return [focus, index](const ::ui::FocusEvent&) {
		if(focus) focus(index);
	};
}

std::function<void(const ::ui::ActivationEvent&)>
activate_buy_tech_row(std::function<void(int)> activate, int index) {
	return [activate, index](const ::ui::ActivationEvent&) {
		if(activate) activate(index);
	};
}

::ui::Color buy_tech_text_color(Uint8 brightness) {
	return brightness > 128
		? ::ui::Color{250, 245, 190, 255}
		: ::ui::Color{226, 234, 242, 255};
}

::ui::StyleStatePatch buy_tech_text_style(Uint8 brightness,
                                          ::ui::TextAlign align = ::ui::TextAlign::Left) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = buy_tech_text_color(brightness),
		.font_id = 134,
		.font_size = 8,
		.align = align,
	});
}

const BuyTechRowView * buy_tech_row_at(const BuyTechOverlayView& view, int slot) {
	if(slot < 0 || slot >= static_cast<int>(view.rows.size())) return nullptr;
	return &view.rows[static_cast<size_t>(slot)];
}

struct BuyTechRowProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement BuyTechRow(const BuyTechRowProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.resources) return ::ui::empty();
	const BuyTechOverlayView& overlay = hud.state.view->buyTech;
	const BuyTechRowView * row = buy_tech_row_at(overlay, props.slot);
	if(!row) return ::ui::empty();
	const Resources& resources = *hud.state.resources;
	const int yOffset = props.slot * 25;
	const int highlightX = sprite_x(resources, 102, 1);
	const int highlightY = sprite_y(resources, 102, 1) + yOffset;
	const int highlightW = sprite_width(resources, 102, 1);
	const int highlightH = sprite_height(resources, 102, 1);
	const int iconW = sprite_width(resources, row->spriteBank, row->spriteIndex);
	const int iconH = sprite_height(resources, row->spriteBank, row->spriteIndex);
	const int iconX = sprite_x(resources, row->spriteBank, row->spriteIndex, 169);
	const int iconY = sprite_y(resources, row->spriteBank, row->spriteIndex, 139 + yOffset);
	const int priceW = static_cast<int>(row->price.size()) * 8;
	return <Box key={props.key} layout={root_layout()}>
		<Box
		  key="hit"
		  focusable={true}
		  autofocus={row->selected}
		  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::Button, .label = row->name.c_str()}}
		  onFocus={focus_buy_tech_row(hud.actions.focus_buy_tech, row->index)}
		  onActivate={activate_buy_tech_row(hud.actions.activate_buy_tech, row->index)}
		  layout={text_layout(highlightX, highlightY, highlightW, highlightH)}
		/>
		<HudSprite
		  key="icon"
		  bank={row->spriteBank}
		  index={row->spriteIndex}
		  x={iconX}
		  y={iconY}
		  w={iconW}
		  h={iconH}
		  brightness={row->brightness}
		/>
		<Text
		  key="name"
		  value={row->name.c_str()}
		  layout={text_layout(222, 145 + yOffset, 180, 15)}
		  style={buy_tech_text_style(row->brightness)}
		/>
		<Text
		  key="price"
		  value={row->price.c_str()}
		  layout={text_layout(440 - (priceW / 2), 145 + yOffset, priceW, 15)}
		  style={buy_tech_text_style(row->brightness)}
		/>
	</Box>
}

struct BuyTechSelectedHighlightProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement BuyTechSelectedHighlight(const BuyTechSelectedHighlightProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const BuyTechRowView * row = buy_tech_row_at(hud.state.view->buyTech, props.slot);
	if(!row || !row->selected) return ::ui::empty();
	return <HudFixedSprite key={props.key} bank={102} index={1} logicalY={props.slot * 25} />
}

struct BuyTechOverlayProps {
	const char * key = nullptr;
};

::ui::UiElement BuyTechOverlay(const BuyTechOverlayProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.view->buyTech.visible || hud.state.view->buyTech.rows.empty()){
		return ::ui::empty();
	}
	const BuyTechOverlayView& overlay = hud.state.view->buyTech;
	const int footerW = static_cast<int>(overlay.footer.size()) * 8;
	return <Box key={props.key} layout={root_layout()}>
		<HudFixedSprite key="background" bank={102} index={0} />
		<BuyTechSelectedHighlight key="selected-0" slot={0} />
		<BuyTechSelectedHighlight key="selected-1" slot={1} />
		<BuyTechSelectedHighlight key="selected-2" slot={2} />
		<BuyTechSelectedHighlight key="selected-3" slot={3} />
		<BuyTechSelectedHighlight key="selected-4" slot={4} />
		<BuyTechRow key="row-0" slot={0} />
		<BuyTechRow key="row-1" slot={1} />
		<BuyTechRow key="row-2" slot={2} />
		<BuyTechRow key="row-3" slot={3} />
		<BuyTechRow key="row-4" slot={4} />
		<Text
		  key="footer"
		  value={overlay.footer.c_str()}
		  layout={text_layout(320 - (footerW / 2), 275, footerW, 15)}
		  style={buy_tech_text_style(128)}
		/>
	</Box>
}

struct SystemCameraFrameProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement SystemCameraFrame(const SystemCameraFrameProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.resources) return ::ui::empty();
	if(props.slot < 0 || props.slot >= 2) return ::ui::empty();
	if(!hud.state.view->systemCamera[props.slot].active) return ::ui::empty();

	const Uint8 bank = 95;
	const Uint16 index = props.slot == 0 ? 2 : 11;
	const Uint8 offsetBank = 92;
	const int logicalY = props.slot == 0 ? 381 : 318;
	const Resources& resources = *hud.state.resources;
	const int w = sprite_width(resources, bank, index);
	const int h = sprite_height(resources, bank, index);
	if(w <= 0 || h <= 0) return ::ui::empty();
	return <HudSprite
	  key={props.key}
	  bank={bank}
	  index={index}
	  x={-sprite_offset_x(resources, bank, index)}
	  y={-sprite_offset_y(resources, offsetBank, index) + logicalY}
	  w={w}
	  h={h}
	/>
}

struct TopMessageProps {
	const char * key = nullptr;
};

::ui::UiElement TopMessage(const TopMessageProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	std::string text = visible_top_message(hud.state.view->topMessage);
	if(text.empty()) return ::ui::empty();
	return <Text
	  key={props.key}
	  value={text.c_str()}
	  layout={top_message_layout()}
	  style={text_style(hud_text_color(208), 133, 7)}
	/>
}

struct StatusLineProps {
	const char * key = nullptr;
	int slot = 0;
	bool shadow = false;
};

::ui::UiElement StatusLine(const StatusLineProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	if(props.slot < 0 || props.slot >= static_cast<int>(hud.state.view->statusMessages.size())){
		return ::ui::empty();
	}
	const InGameStatusLineView& line = hud.state.view->statusMessages[static_cast<size_t>(props.slot)];
	const int width = static_cast<int>(line.text.size()) * 7;
	const int x = (640 - width) / 2;
	const int y = 370 - (props.slot * 10);
	return <Text
	  key={props.key}
	  value={line.text.c_str()}
	  layout={text_layout(x + (props.shadow ? 1 : 0), y + (props.shadow ? 1 : 0), width, 11)}
	  style={text_style(props.shadow ? shadow_color() : hud_text_color(line.color), 133, 7)}
	/>
}

struct StatusMessagesProps {
	const char * key = nullptr;
};

::ui::UiElement StatusMessages(const StatusMessagesProps& props) {
	return <Box key={props.key} layout={root_layout()}>
		<StatusLine key="status-0-shadow" slot={0} shadow={true} />
		<StatusLine key="status-0-text" slot={0} shadow={false} />
		<StatusLine key="status-1-shadow" slot={1} shadow={true} />
		<StatusLine key="status-1-text" slot={1} shadow={false} />
		<StatusLine key="status-2-shadow" slot={2} shadow={true} />
		<StatusLine key="status-2-text" slot={2} shadow={false} />
		<StatusLine key="status-3-shadow" slot={3} shadow={true} />
		<StatusLine key="status-3-text" slot={3} shadow={false} />
	</Box>
}

std::string quit_prompt_text() {
#ifdef OUYA
	return "Hit O To QUIT";
#else
	return "Hit Enter To Quit";
#endif
}

struct QuitPromptProps {
	const char * key = nullptr;
};

::ui::UiElement QuitPrompt(const QuitPromptProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || (hud.state.view->quitState != 1 && hud.state.view->quitState != 2)){
		return ::ui::empty();
	}
	const std::string text = quit_prompt_text();
	const int width = static_cast<int>(text.size()) * 16;
	return <Text
	  key={props.key}
	  value={text.c_str()}
	  layout={text_layout((640 - width) / 2, 200, width, 23)}
	  style={text_style(hud_text_color(202), 136, 16)}
	/>
}

struct HudReadoutsProps {
	const char * key = nullptr;
};

::ui::UiElement HudReadouts(const HudReadoutsProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view || !hud.state.view->viewedPlayer.valid) return ::ui::empty();
	const PlayerHudView& player = hud.state.view->viewedPlayer;
	const std::string currentAmmo = two_digit_text(current_ammo(player));
	const std::string blasterAmmo = "99";
	const std::string laserAmmo = player.laserAmmo > 0 ? two_digit_text(player.laserAmmo) : std::string();
	const std::string rocketAmmo = player.rocketAmmo > 0 ? two_digit_text(player.rocketAmmo) : std::string();
	const std::string flamerAmmo = player.flamerAmmo > 0 ? two_digit_text(player.flamerAmmo) : std::string();
	const std::string credits = std::to_string(player.credits);
	const std::string health = std::to_string(player.health);
	const std::string shield = std::to_string(player.shield);
	const std::string inventory0 = player.inventoryItemsNum[0] > 1
		? std::to_string(player.inventoryItemsNum[0])
		: std::string();
	const std::string inventory1 = player.inventoryItemsNum[1] > 1
		? std::to_string(player.inventoryItemsNum[1])
		: std::string();
	const std::string inventory2 = player.inventoryItemsNum[2] > 1
		? std::to_string(player.inventoryItemsNum[2])
		: std::string();
	const std::string inventory3 = player.inventoryItemsNum[3] > 1
		? std::to_string(player.inventoryItemsNum[3])
		: std::string();

	return <Box key={props.key} layout={root_layout()}>
		<Text
		  key="current-ammo"
		  value={::ui::copy_string(currentAmmo.c_str())}
		  layout={text_layout(117, 457, 40, 18)}
		  style={text_style(hud_text_color(208), 135, 12)}
		/>
		<Text
		  key="blaster-ammo"
		  value={::ui::copy_string(blasterAmmo.c_str())}
		  layout={text_layout(0, 414, 20, 8)}
		  style={text_style(hud_text_color(208), 132, 4, ::ui::TextAlign::Center)}
		/>
		<Text
		  key="laser-ammo"
		  value={::ui::copy_string(laserAmmo.c_str())}
		  layout={text_layout(0, 428, 20, 8)}
		  style={text_style(hud_text_color(208), 132, 4, ::ui::TextAlign::Center)}
		/>
		<Text
		  key="rocket-ammo"
		  value={::ui::copy_string(rocketAmmo.c_str())}
		  layout={text_layout(0, 442, 20, 8)}
		  style={text_style(hud_text_color(208), 132, 4, ::ui::TextAlign::Center)}
		/>
		<Text
		  key="flamer-ammo"
		  value={::ui::copy_string(flamerAmmo.c_str())}
		  layout={text_layout(0, 456, 20, 8)}
		  style={text_style(hud_text_color(208), 132, 4, ::ui::TextAlign::Center)}
		/>
		<Text
		  key="credits"
		  value={::ui::copy_string(credits.c_str())}
		  layout={text_layout(572, 456, 60, 18)}
		  style={text_style(hud_text_color(202), 135, 12)}
		/>
		<Text
		  key="health"
		  value={::ui::copy_string(health.c_str())}
		  layout={text_layout(145, 463, 26, 8)}
		  style={text_style(hud_text_color(161), 132, 4, ::ui::TextAlign::Center)}
		/>
		<Text
		  key="shield"
		  value={::ui::copy_string(shield.c_str())}
		  layout={text_layout(468, 463, 26, 8)}
		  style={text_style(hud_text_color(202), 132, 4, ::ui::TextAlign::Center)}
		/>
		<Text
		  key="inventory-count-0"
		  value={::ui::copy_string(inventory0.c_str())}
		  layout={text_layout(632, 33, 32, 10)}
		  style={text_style(hud_text_color(208), 132, 6)}
		/>
		<Text
		  key="inventory-count-1"
		  value={::ui::copy_string(inventory1.c_str())}
		  layout={text_layout(604, 33, 32, 10)}
		  style={text_style(hud_text_color(208), 132, 6)}
		/>
		<Text
		  key="inventory-count-2"
		  value={::ui::copy_string(inventory2.c_str())}
		  layout={text_layout(576, 31, 32, 10)}
		  style={text_style(hud_text_color(208), 132, 6)}
		/>
		<Text
		  key="inventory-count-3"
		  value={::ui::copy_string(inventory3.c_str())}
		  layout={text_layout(548, 27, 32, 10)}
		  style={text_style(hud_text_color(208), 132, 6)}
		/>
	</Box>
}

struct TraceTimeProps {
	const char * key = nullptr;
};

::ui::UiElement TraceTime(const TraceTimeProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	const Uint8 value = trace_time(*hud.state.view);
	if(value == 0) return ::ui::empty();
	const std::string text = "Government Trace Time: " + std::to_string(value);
	return <Text
	  key={props.key}
	  value={::ui::copy_string(text.c_str())}
	  layout={text_layout(20, 350, 180, 12)}
	  style={text_style(hud_text_color(208), 133, 6)}
	/>
}

}  // namespace

::ui::UiElement InGameHudFrame(const InGameHudFrameProps& props) {
	return <Box key={props.key} layout={root_layout()}>
		<SystemCameraFrame key="system-camera-0" slot={0} />
		<SystemCameraFrame key="system-camera-1" slot={1} />
		<HudStatusSprites key="status-sprites" />
		<HudReadouts key="readouts" />
		<HudTeams key="teams" />
		<HudSecretOverlay key="secrets" />
		<TraceTime key="trace-time" />
		<StatusMessages key="status" />
		<TopMessage key="top-message" />
		<QuitPrompt key="quit-prompt" />
		<BuyTechOverlay key="buy-tech" />
		<ChatOverlay key="chat" />
		<MessageOverlay key="message" />
		<PlayerListOverlay key="player-list" />
	</Box>
}

}  // namespace silencer::client_ui

::ui::UiElement WeaponGlow(const WeaponGlowProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.view) return ::ui::empty();
	Uint16 index = 5;
	switch(hud.view->viewedPlayer.currentWeapon){
		case 1: index = 6; break;
		case 2: index = 7; break;
		case 3: index = 8; break;
		default: index = 5; break;
	}
	return <HudFixedSprite key={props.key} bank={96} index={index} />
}


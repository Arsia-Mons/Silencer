struct WeaponFaceProps {
	const char * key = nullptr;
};

::ui::UiElement WeaponFace(const WeaponFaceProps& props) {
	const InGameHudContextValue& hud = UseInGameHud();
	if(!hud.state.view) return ::ui::empty();
	Uint16 index = 1;
	switch(hud.state.view->viewedPlayer.currentWeapon){
		case 1: index = 2; break;
		case 2: index = 3; break;
		case 3: index = 4; break;
		default: index = 1; break;
	}
	return <HudFixedSprite key={props.key} bank={96} index={index} />
}


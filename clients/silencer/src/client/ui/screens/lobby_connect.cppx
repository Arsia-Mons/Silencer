#include "client/ui/screens/lobby_connect.h"

#include "client/ui/components/actions/actions.h"
#include "client/ui/components/text/text.h"
#include "client/ui/components/tokens.h"
#include "client/ui/hooks/use_lobby_session.h"
#include "ui/components/box.h"
#include "ui/components/input.h"
#include "ui/runtime/react.h"

#include <functional>
#include <string>

namespace client::ui {
namespace {

using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Input;
using ::ui::components::InputProps;

struct LobbyConnectProps {
  uint32_t unused = 0;
};

// origin/main Lobby Connect: a single thin green-bordered rectangle over black
// (NOT the ornate bank-40 dialog sprite). A connection-log region grows to fill
// the empty top, pushing Username/Password label+field rows and the Login/Create
// + Cancel buttons to the bottom. Fields + buttons carry their own green theme
// chrome (green-dim border, near-black fill) — no baked sprite wells.
::ui::UiElement LobbyConnectView(const LobbyConnectProps &) {
  LobbySession lobby = use_lobby_session();
  std::string *username = use_state<std::string>(std::string());
  std::string *password = use_state<std::string>(std::string());
  if (!username || !password)
    return ::ui::empty();

  std::function<void()> submit = [lobby, username, password]() {
    if (lobby.connect)
      lobby.connect(*username, *password);
  };
  std::function<void(const std::string &)> set_username =
      [username](const std::string &next) { *username = next; };
  std::function<void(const std::string &)> set_password =
      [password](const std::string &next) { *password = next; };
  std::function<void(const ::ui::ActivationEvent &)> on_activate =
      [submit](const ::ui::ActivationEvent &) { submit(); };

  const char *log = use_text_storage("%s", lobby.status_log.c_str());

  auto field_layout = ::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::Start,
      .flex_grow = ::ui::StyleFloat::points(1.0f),
      .height = ::ui::Length::points(26.0f),
      .padding = {8.0f, 8.0f, 2.0f, 2.0f}};
  auto field_row = ::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .width = ::ui::Length::percent(100.0f),
      .gap = 10.0f};

  // origin/main: a BRIGHT thick green frame over pure black, with an inner
  // bordered well holding the connection log. Brighter/thicker than the dim
  // lobby panels.
  const ::ui::Color kConnectBorder = {60, 200, 60, 255};
  ::ui::StylePatch panel_style =
      tokens::panel_patch(tokens::kSurfaceMenu, kConnectBorder, 2.0f);
  ::ui::StylePatch logbox_style =
      tokens::panel_patch(::ui::Color{0, 0, 0, 255}, kConnectBorder, 1.0f);

  return <Box
    key="root"
    layout={::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::Center,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::percent(100.0f)}}
    style={tokens::fill_patch(::ui::Color{0, 0, 0, 255})}>
    <Box
      key="panel"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .width = ::ui::Length::points(420.0f),
        .height = ::ui::Length::points(420.0f),
        .padding = {12.0f, 12.0f, 12.0f, 12.0f},
        .gap = 8.0f,
        .border_width = 2.0f}}
      style={panel_style}>
      <Box
        key="logbox"
        layout={::ui::LayoutStyle{
          .overflow = ::ui::Overflow::Hidden,
          .align_items = ::ui::AlignItems::Start,
          .flex_grow = ::ui::StyleFloat::points(1.0f),
          .width = ::ui::Length::percent(100.0f),
          .padding = {8.0f, 8.0f, 6.0f, 6.0f},
          .border_width = 1.0f}}
        style={logbox_style}>
        <BodyText key="log" variant={BodyTextVariant::Message} value={log} />
      </Box>
      <Box key="urow" layout={field_row}>
        <BodyText key="ulbl" variant={BodyTextVariant::Body} value="Username" />
        <Input
          key="username"
          id="Username"
          autofocus={true}
          accessibility={{.label = "Username"}}
          value={username->c_str()}
          onChange={set_username}
          onActivate={on_activate}
          layout={field_layout}
        />
      </Box>
      <Box key="prow" layout={field_row}>
        <BodyText key="plbl" variant={BodyTextVariant::Body} value="Password" />
        <Input
          key="password"
          id="Password"
          accessibility={{.label = "Password"}}
          value={password->c_str()}
          onChange={set_password}
          onActivate={on_activate}
          layout={field_layout}
        />
      </Box>
      <Box
        key="actions"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .justify_content = ::ui::JustifyContent::Center,
          .gap = 10.0f}}>
        <AppButton key="login" controlId="Login" variant={AppButtonVariant::Oval} size={AppButtonSize::Sm} label="Login/Create" onPress={submit} />
        <AppButton key="cancel" controlId="Cancel" variant={AppButtonVariant::Oval} size={AppButtonSize::Sm} label="Cancel" onPress={lobby.cancel} />
      </Box>
    </Box>
  </Box>
}

} // namespace

::ui::UiElement LobbyConnect(const char *key) {
  return ::ui::component("LobbyConnect", LobbyConnectProps{}, LobbyConnectView,
                         key);
}

} // namespace client::ui

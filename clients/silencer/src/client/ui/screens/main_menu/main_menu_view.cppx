#include "client/ui/screens/main_menu/main_menu_view.h"

#include "client/ui/hooks/use_game_session.h"
#include "client/ui/hooks/use_navigation.h"
#include "client/ui/screens/lobby_connect/lobby_connect_screen.h"
#include "client/ui/screens/options/options_screen.h"
#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/text.h"

#include <memory>

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
		.gap = 20.0f,
	};
}

::ui::StyleStatePatch root_style() {
	return ::ui::patch().background(::ui::Color{14, 18, 25, 255});
}

::ui::LayoutStyle title_stack_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(300.0f),
		.gap = 8.0f,
	};
}

::ui::LayoutStyle title_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(300.0f),
		.height = ::ui::Length::points(34.0f),
	};
}

::ui::LayoutStyle subtitle_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(300.0f),
		.height = ::ui::Length::points(16.0f),
	};
}

::ui::LayoutStyle button_stack_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(216.0f),
		.gap = 14.0f,
	};
}

::ui::LayoutStyle button_layout(bool autofocus = false) {
	(void)autofocus;
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(216.0f),
		.height = ::ui::Length::points(33.0f),
		.padding = {24.0f, 24.0f, 7.0f, 7.0f},
	};
}

::ui::StyleStatePatch title_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {236, 241, 247, 255},
		.font_id = 133,
		.font_size = 22,
		.align = ::ui::TextAlign::Center,
	});
}

::ui::StyleStatePatch subtitle_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {148, 162, 178, 255},
		.font_id = 133,
		.font_size = 10,
		.align = ::ui::TextAlign::Center,
	});
}

std::function<void(const ::ui::ActivationEvent&)> start_tutorial_callback(
	GameSessionActions session) {
	return [session](const ::ui::ActivationEvent&) {
		if(session.start_tutorial) session.start_tutorial();
	};
}

std::function<void(const ::ui::ActivationEvent&)> open_lobby_connect_callback(
	Navigation navigation) {
	return [navigation](const ::ui::ActivationEvent&) {
		if(navigation.reset_to){
			navigation.reset_to(std::make_unique<LobbyConnectScreen>());
		}
	};
}

std::function<void(const ::ui::ActivationEvent&)> open_options_callback(
	Navigation navigation) {
	return [navigation](const ::ui::ActivationEvent&) {
		if(navigation.push){
			navigation.push(std::make_unique<OptionsScreen>());
		}
	};
}

std::function<void(const ::ui::ActivationEvent&)> request_quit_callback(
	GameSessionActions session) {
	return [session](const ::ui::ActivationEvent&) {
		if(session.request_quit) session.request_quit();
	};
}

}  // namespace

::ui::UiElement MainMenuView(const MainMenuViewProps& props) {
	Navigation navigation = use_navigation();
	GameSessionActions session = use_game_session();
	return <Box key={props.key} layout={root_layout()} style={root_style()}>
		<Box key="title-stack" layout={title_stack_layout()}>
			<Text key="title" value="Silencer" layout={title_layout()} style={title_style()} />
			<Text key="version" value={props.version} layout={subtitle_layout()} style={subtitle_style()} />
		</Box>
		<Box key="button-stack" layout={button_stack_layout()}>
			<Button
			  key="tutorial"
			  id="main_menu.tutorial"
			  label="Tutorial"
			  autofocus={true}
			  onActivate={start_tutorial_callback(session)}
			  layout={button_layout(true)}
			/>
			<Button
			  key="lobby"
			  id="main_menu.lobby"
			  label="Connect To Lobby"
			  onActivate={open_lobby_connect_callback(navigation)}
			  layout={button_layout()}
			/>
			<Button
			  key="options"
			  id="main_menu.options"
			  label="Options"
			  onActivate={open_options_callback(navigation)}
			  layout={button_layout()}
			/>
			<Button
			  key="exit"
			  id="main_menu.exit"
			  label="Exit"
			  onActivate={request_quit_callback(session)}
			  layout={button_layout()}
			/>
		</Box>
	</Box>
}

}  // namespace silencer::client_ui

#include "client/ui/screens/options/options_screen.h"

#include "client/ui/components/actions/actions.h"
#include "client/ui/components/layout/layout.h"
#include "client/ui/components/text/text.h"
#include "client/ui/hooks/use_navigation.h"
#include "client/ui/hooks/use_settings.h"
#include "client/ui/screens/options/options_audio.h"
#include "client/ui/screens/options/options_controls.h"
#include "client/ui/screens/options/options_display.h"
#include "ui/components/box.h"
#include "ui/runtime/react.h"

#include <functional>
#include <memory>

namespace client::ui {
namespace {

// JSX lowering emits each tag's component function + `<Tag>Props` type
// unqualified, so pull in the silencer semantic layer + the runtime children().
using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;

struct OptionsProps {
  uint32_t unused = 0;
};

::ui::UiElement OptionsView(const OptionsProps &) {
  Navigation nav = use_navigation();
  if (!nav.is_top)
    return ::ui::empty();

  std::function<void()> open_audio = [nav]() {
    if (nav.push)
      nav.push(std::make_unique<OptionsAudioScreen>());
  };
  std::function<void()> open_display = [nav]() {
    if (nav.push)
      nav.push(std::make_unique<OptionsDisplayScreen>());
  };
  std::function<void()> open_controls = [nav]() {
    if (nav.push)
      nav.push(std::make_unique<OptionsControlsScreen>());
  };
  std::function<void()> go_back = [nav]() {
    if (nav.pop_current)
      nav.pop_current();
  };

  // origin/main: a plain centered oval menu — Controls / Display / Audio / Go Back
  // over the starfield. Each sub-screen owns its own Save/Cancel (commit/revert),
  // so the root is pure navigation: no title, no dirty indicator, no Done/Cancel.
  // Each oval sits in a margin-right-2 wrapper: centering 294+2 in 1280 puts
  // the cell at x=492 (device 738 = origin vx 328 exactly) so the per-phase
  // oval bake lands on the golden's virtual grid (bare centering gives 493).
  const ::ui::LayoutStyle grid_nudge{.margin = ::ui::EdgeSizes{{}, 2.0f, {}, {}}};
  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Overlay}>
    <Box key="w0" layout={grid_nudge}>
      <AppButton
        key="controls"
        controlId="OptionsControls"
        variant={AppButtonVariant::Oval}
        label="Controls"
        onPress={open_controls}
      />
    </Box>
    <Box key="w1" layout={grid_nudge}>
      <AppButton
        key="display"
        controlId="OptionsDisplay"
        variant={AppButtonVariant::Oval}
        label="Display"
        onPress={open_display}
      />
    </Box>
    <Box key="w2" layout={grid_nudge}>
      <AppButton
        key="audio"
        controlId="OptionsAudio"
        variant={AppButtonVariant::Oval}
        label="Audio"
        onPress={open_audio}
      />
    </Box>
    <Box key="w3" layout={grid_nudge}>
      <AppButton
        key="goback"
        controlId="OptionsGoBack"
        variant={AppButtonVariant::Oval}
        label="Go Back"
        onPress={go_back}
      />
    </Box>
  </ScreenLayout>
}

} // namespace

bool OptionsScreen::build_element(::ui::UiElementFrame &, ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component("Options", OptionsProps{}, OptionsView, "options");
  return true;
}

} // namespace client::ui

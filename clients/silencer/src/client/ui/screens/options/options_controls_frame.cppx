	struct RowsViewportProps {
		const char * key = nullptr;
		const options::KeybindListView * view = nullptr;
		std::function<void(int, int)> begin_rebind = {};
		std::function<void(int)> toggle_operator = {};
	};

	::ui::UiElement RowsViewport(const RowsViewportProps& props) {
		return <detail.Host
		  kind={::ui::HostKind::Box}
		  key={props.key}
		  id={options::kKeybindListScrollId}
		  style={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Column,
			.width = ::ui::Length::grow(1.0f),
			.height = ::ui::Length::grow(1.0f),
			.overflow = ::ui::Overflow::Hidden,
			.gap = static_cast<float>(kRowGap),
		}}
		  text={::ui::HostTextProps{.value = "scroll"}}
		  accessibility={{.label = options::kKeybindListScrollLabel}}
		>
			<KeybindRows
			  key="rows"
			  view={props.view}
			  beginRebind={props.begin_rebind}
			  toggleOperator={props.toggle_operator}
			/>
		</detail.Host>
	}

	struct PresetRowProps {
		const char * key = nullptr;
		const options::KeybindListView * view = nullptr;
		std::function<void()> cycle_preset = {};
	};

	::ui::UiElement PresetRow(const PresetRowProps& props) {
		const float scale = horizontal_scale(props.view);
		const float actionNameW =
			static_cast<float>(scaled_metric(kActionNameW, scale));
		const float presetGap =
			static_cast<float>(scaled_metric(kPresetGap, scale));
		const char * preset =
			(props.view && !props.view->presetText.empty())
				? props.view->presetText.c_str()
				: "";
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Row,
				.align_items = ::ui::AlignItems::Center,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::points(static_cast<float>(kPresetRowH)),
			.gap = presetGap,
		}}
		>
		<Text
		  key="label"
		  value="Preset:"
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::points(actionNameW),
				.height = ::ui::Length::points(15.0f),
			}}
		  style={text_patch(134, 8)}
		/>
			<OvalButton
			  key="button"
			  id={kActionPreset}
			  label={preset}
			  width={kPresetButtonW}
			  spriteIndex={23}
			  onPress={props.cycle_preset}
			/>
		</Box>
	}

	struct ActionRowProps {
		const char * key = nullptr;
		const options::KeybindListView * view = nullptr;
		std::function<void()> save = {};
		std::function<void()> cancel = {};
	};

	::ui::UiElement ActionRow(const ActionRowProps& props) {
		const float scale = horizontal_scale(props.view);
		const float actionGap =
			static_cast<float>(scaled_metric(kActionGap, scale));
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Row,
				.align_items = ::ui::AlignItems::Center,
			.justify_content = ::ui::JustifyContent::Center,
			.height = ::ui::Length::points(static_cast<float>(kActionRowH)),
			.gap = actionGap,
		}}
		>
		<AppButton
		  key="save"
		  controlId={kActionSave}
		  size={AppButtonSize::MainMenu}
		  label="Save"
		  onPress={props.save}
		/>
		<AppButton
		  key="cancel"
		  controlId={kActionCancel}
		  size={AppButtonSize::MainMenu}
		  label="Cancel"
		  onPress={props.cancel}
		/>
		</Box>
	}

	struct ContentProps {
		const char * key = nullptr;
		const options::KeybindListView * view = nullptr;
		std::function<void()> cycle_preset = {};
		std::function<void(int, int)> begin_rebind = {};
		std::function<void(int)> toggle_operator = {};
		std::function<void()> save = {};
		std::function<void()> cancel = {};
	};

	::ui::UiElement Content(const ContentProps& props) {
		const float scale = horizontal_scale(props.view);
		const float contentW =
			static_cast<float>(scaled_metric(kContentW, scale));
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Column,
				.align_items = ::ui::AlignItems::Center,
			.width = ::ui::Length::points(contentW),
			.height = ::ui::Length::grow(1.0f),
			.gap = static_cast<float>(kSectionGap),
			}}
		>
			<PresetRow key="preset-row" view={props.view} cyclePreset={props.cycle_preset} />
			<RowsViewport
			  key="rows-viewport"
			  view={props.view}
			  beginRebind={props.begin_rebind}
			  toggleOperator={props.toggle_operator}
			/>
			<Box
			  key="action-spacer"
			  layout={::ui::LayoutStyle{
				.width = ::ui::Length::grow(1.0f),
					.height = ::ui::Length::points(static_cast<float>(kActionTopGap)),
				}}
			/>
			<ActionRow key="actions" view={props.view} save={props.save} cancel={props.cancel} />
		</Box>
	}

}  // namespace options_controls_frame_detail

using ::ui::children;
using ::ui::components::Box;

namespace client::ui {
namespace {

using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::ScrollView;
using ::ui::components::ScrollViewProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

// Keybind-grid geometry, origin options_controls_screen.cpp x1.5. Row =
// [label 270 | bind oval 168 | OR 67.5 | bind oval 168] with 18 col gaps.
constexpr float kContentW = 729.0f;
constexpr float kLabelCol = 270.0f;  // kActionNameW 180 x1.5
constexpr float kColGap = 18.0f;     // kColumnGap 12 x1.5
// kOperatorW 45 x1.5 = 67.5, +0.5 so the right bind lane lands at x=833
// (device 1249 = origin vx 555 cell) instead of the ambiguous 832.5 — the
// per-phase oval bake needs cells on the golden's virtual grid.
constexpr float kOrCol = 68.0f;
constexpr float kRowContentH = 81.0f;
constexpr float kRowGap = 15.0f;     // kRowGap 10 x1.5
constexpr float kRowH = kRowContentH + kRowGap; // virtualized row pitch
constexpr float kPresetRowH = 64.5f; // kPresetRowH 43 x1.5
constexpr float kSectionGap = 10.5f; // kSectionGap 8 x1.5, -1.5 golden-measured
constexpr float kViewportH = kRowH * 3.0f + kRowContentH; // 4 visible rows

::ui::UiElement grid_label(const char *value) {
  return <Text
    key="lbl"
    value={value}
    layout={::ui::LayoutStyle{.height = ::ui::Length::points(tokens::kLineLarge)}}
    style={tokens::text_patch(tokens::kTextBody, tokens::kFontLarge, tokens::kFaceLarge, tokens::kLineLarge)}
  />
}

constexpr int kRebindTimeoutFrames = 72;

// Two bind slots joined by an And/Or connector. A 2-chip chord in combo 0 is
// And (both keys pressed together — diagonal aim); separate combos are Or
// alternates (slot1 = combo0's first chip, slot2 = combo1's first chip).
struct BindingView {
  std::string slot1; // left oval label ("" = unbound)
  std::string slot2; // right oval label ("" = unbound)
  bool and_ = false; // connector: true = "And" (chord), false = "Or"
};

BindingView binding_view(const KeyMapAction &a) {
  BindingView v;
  if (a.combos.empty())
    return v;
  const KeyMapCombo &c0 = a.combos[0];
  if (c0.chips.size() >= 2) {
    v.slot1 = c0.chips[0].label;
    v.slot2 = c0.chips[1].label;
    v.and_ = true;
    return v;
  }
  if (!c0.chips.empty())
    v.slot1 = c0.chips[0].label;
  if (a.combos.size() >= 2 && !a.combos[1].chips.empty())
    v.slot2 = a.combos[1].chips[0].label;
  return v;
}

// Index of the combo a Rebind replaces (0 if the action already has one, else
// -1 to append a fresh combo).
int rebind_combo_index(const KeyMap &km, Action action) {
  for (const KeyMapAction &a : km.actions) {
    if (a.action == action)
      return a.combos.empty() ? -1 : 0;
  }
  return -1;
}

// label | primary bind oval | "OR" | secondary bind oval. The fixed column
// widths stack every row's ovals into aligned vertical lanes.
struct BindingRowProps {
  const char *key;
  const char *primary_id;
  const char *secondary_id;
  const char *label;
  const char *primary;
  const char *secondary;
  bool is_and;
  std::function<void()> rebind_primary;
  std::function<void()> rebind_secondary;
};

::ui::UiElement make_binding_row(const BindingRowProps &r) {
  return <Box
    key={r.key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(kRowH),
      .padding = {0.0f, 0.0f, 0.0f, kRowGap},
      .gap = kColGap}}
  >
    <Box
      key="lblc"
      layout={::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Start,
      .width = ::ui::Length::points(kLabelCol)}}
    >
      {grid_label(r.label)}
    </Box>
    <AppButton
      key="p"
      controlId={r.primary_id}
      variant={AppButtonVariant::Oval}
      size={AppButtonSize::Sm}
      label={r.primary}
      onPress={r.rebind_primary}
    />
    <Box
      key="orc"
      layout={::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::Center,
      .width = ::ui::Length::points(kOrCol)}}
    >
      <Text
        key="or"
        value={r.is_and ? "AND" : "OR"}
        layout={::ui::LayoutStyle{
          .height = ::ui::Length::points(tokens::kLineLarge),
          .margin = ::ui::EdgeSizes{2.0f, {}, {}, {}}}}
        style={tokens::text_patch(tokens::kTextBody, tokens::kFontLarge, tokens::kFaceLarge, tokens::kLineLarge)}
      />
    </Box>
    <AppButton
      key="s"
      controlId={r.secondary_id}
      variant={AppButtonVariant::Oval}
      size={AppButtonSize::Sm}
      label={r.secondary}
      onPress={r.rebind_secondary}
    />
  </Box>
}

::ui::UiElement make_preset_row(const char *label, const char *value,
                                std::function<void()> cycle) {
  // padding-bottom 2 biases the centered oval to y=122 (device 183 = origin
  // vy 81 cell) — bare centering gives 123, one device px below the cell.
  return <Box
    key="presetrow"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(kPresetRowH),
      .padding = {0.0f, 0.0f, 0.0f, 2.0f},
      .gap = kColGap}}
  >
    <Box
      key="lblc"
      layout={::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Start,
      .width = ::ui::Length::points(kLabelCol)}}
    >
      {grid_label(label)}
    </Box>
    <AppButton
      key="cycle"
      controlId="CyclePreset"
      variant={AppButtonVariant::Oval}
      size={AppButtonSize::Lg}
      label={value}
      onPress={cycle}
    />
  </Box>
}

struct OptionsControlsProps {
  uint32_t unused = 0;
};

::ui::UiElement OptionsControlsView(const OptionsControlsProps &) {
  Navigation nav = use_navigation();
  KeyMap km = use_key_map();
  KeybindCapture cap = use_keybind_capture();
  if (!nav.is_top)
    return ::ui::empty();

  use_rebind_timeout(cap, kRebindTimeoutFrames);

  const int action_count = static_cast<int>(km.actions.size());
  OptionsCommit commit = use_options_commit(km.commit, km.revert);

  std::vector<::ui::UiElement> rows;
  rows.reserve(km.actions.size());
  for (int i = 0; i < action_count; ++i) {
    const KeyMapAction &a = km.actions[i];
    const char *rkey = ::ui::copy_string(("row" + std::to_string(i)).c_str());
    const char *pid = ::ui::copy_string(("BindP" + std::to_string(i)).c_str());
    const char *sid = ::ui::copy_string(("BindS" + std::to_string(i)).c_str());
    const char *label = ::ui::copy_string((a.label + ":").c_str());
    BindingView bv = binding_view(a);
    const char *prim = bv.slot1.empty() ? nullptr
                                        : ::ui::copy_string(bv.slot1.c_str());
    const char *sec = bv.slot2.empty() ? nullptr
                                       : ::ui::copy_string(bv.slot2.c_str());
    Action act = a.action;
    std::function<void()> rb0 = [cap, km, act]() {
      if (cap.begin_capture)
        cap.begin_capture(act, rebind_combo_index(km, act));
    };
    std::function<void()> rb1 = [cap, act]() {
      if (cap.begin_capture)
        cap.begin_capture(act, 1);
    };
    rows.push_back(make_binding_row(BindingRowProps{rkey, pid, sid, label, prim,
                                                    sec, bv.and_, rb0, rb1}));
  }
  // Chromeless viewport: the focusable viewport would otherwise paint the
  // injected focus-ring outline (a spurious inner frame). Chromeless gates it;
  // clearing .outline() alone just re-injects.
  ::ui::StyleStatePatch table_style{};
  table_style.base = tokens::chromeless_clear_patch();
  table_style.focus_visible = table_style.base;
  ::ui::UiElement scroll = ::ui::component(
      "ScrollView",
      ScrollViewProps{
          .key = "table",
          .id = "ControlsList",
          .step = kRowH,
          .row_height = kRowH,
          .show_scrollbar = false,
          .layout = ::ui::LayoutStyle{.width = ::ui::Length::percent(100.0f)},
          .style = table_style,
          .children = ::ui::children(rows)},
      ScrollView);
  // The well's bounded height is what gives the ScrollView's flex-grow a target.
  ::ui::UiElement table = Box(BoxProps{
      .key = "tablewell",
      .layout = ::ui::LayoutStyle{
          .width = ::ui::Length::percent(100.0f),
          .height = ::ui::Length::points(kViewportH),
          .flex_shrink = ::ui::StyleFloat::points(0.0f)},
      .children = ::ui::children({scroll})});

  const char *pval = ::ui::copy_string(km.preset_label.c_str());

  // Virtual-grid nudges so the per-phase oval/string bakes land on golden cells:
  // content margin-right 2, actiongap 48.5 + ActionRow margin-left 1, titlewrap
  // inset-top 13 (not 12), and the OR label's margin-left 2 (in make_binding_row).
  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Overlay} stretchedBackdrop={true}>
    <Panel key="frame" variant={PanelVariant::ControlsFrame}>
      <Box
        key="titlewrap"
        layout={::ui::LayoutStyle{
          .position = ::ui::PositionType::Absolute,
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::Center,
          .justify_content = ::ui::JustifyContent::Center,
          .position_inset = ::ui::EdgeSizes{0.0f, 0.0f, 13.0f, {}}}}
      >
        <ScreenTitle key="title" variant={ScreenTitleVariant::Screen} value="Configure Controls" />
      </Box>
      <Box
        key="content"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Column,
          .width = ::ui::Length::points(kContentW),
          .margin = ::ui::EdgeSizes{{}, 2.0f, {}, {}}}}
      >
        {make_preset_row("Preset:", pval, km.cycle_preset)}
        <Box
          key="sectiongap"
          layout={::ui::LayoutStyle{.height = ::ui::Length::points(kSectionGap)}}
        />
        {table}
        <Box key="actiongap" layout={::ui::LayoutStyle{.height = ::ui::Length::points(48.5f)}} />
        <Box
          key="actionwrap"
          layout={::ui::LayoutStyle{
            .align_items = ::ui::AlignItems::Center,
            .justify_content = ::ui::JustifyContent::Center,
            .width = ::ui::Length::percent(100.0f)}}
        >
          <Box
            key="actionsnudge"
            layout={::ui::LayoutStyle{.margin = ::ui::EdgeSizes{1.0f, {}, {}, {}}}}
          >
          <ActionRow key="actions">
            <AppButton
              key="save"
              controlId="SaveBinds"
              variant={AppButtonVariant::Oval}
              label="Save"
              onPress={commit.save}
            />
            <AppButton
              key="cancel"
              controlId="ControlsBack"
              variant={AppButtonVariant::Oval}
              label="Cancel"
              onPress={commit.cancel}
            />
          </ActionRow>
          </Box>
        </Box>
      </Box>
    </Panel>
  </ScreenLayout>
}

} // namespace

bool OptionsControlsScreen::build_element(::ui::UiElementFrame &,
                                          ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component("OptionsControls", OptionsControlsProps{},
                         OptionsControlsView, "options-controls");
  return true;
}

} // namespace client::ui

#include "client/ui/screens/options/options_menu_view.h"

#include "client/ui/hooks/use_game_navigation.h"
#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/text.h"

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::LayoutStyle column_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(196.0f),
		.gap = 19.0f,
	};
}

::ui::LayoutStyle title_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(196.0f),
		.height = ::ui::Length::points(24.0f),
	};
}

::ui::LayoutStyle button_layout(bool autofocus = false) {
	(void)autofocus;
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(196.0f),
		.height = ::ui::Length::points(33.0f),
		.padding = {24.0f, 24.0f, 7.0f, 7.0f},
	};
}

::ui::StyleStatePatch title_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 14,
		.align = ::ui::TextAlign::Center,
	});
}

std::function<void(const ::ui::ActivationEvent&)> go_to_destination_callback(
	GameNavigation navigation,
	ScreenDestination destination) {
	return [navigation, destination](const ::ui::ActivationEvent&) {
		if(navigation.go_to) navigation.go_to(destination);
	};
}

struct OptionsNavigationButtonProps {
	const char * key = nullptr;
	const char * id = "";
	const char * label = "";
	ScreenDestination destination = ScreenDestination::MainMenu;
	bool autofocus = false;
};

::ui::UiElement OptionsNavigationButton(const OptionsNavigationButtonProps& props) {
	GameNavigation navigation = use_game_navigation();
	return <Button
	  key={props.key}
	  id={props.id}
	  label={props.label}
	  autofocus={props.autofocus}
	  onActivate={go_to_destination_callback(navigation, props.destination)}
	  layout={button_layout(props.autofocus)}
	/>
}

}  // namespace

::ui::UiElement OptionsMenuView(const OptionsMenuViewProps& props) {
	return <Box key={props.key} layout={root_layout()}>
		<Box key="column" layout={column_layout()}>
			<Text key="title" value="Options" layout={title_layout()} style={title_style()} />
			<OptionsNavigationButton
			  key="controls"
			  id="options.controls"
			  label="Controls"
			  destination={ScreenDestination::OptionsControls}
			  autofocus={true}
			/>
			<OptionsNavigationButton
			  key="display"
			  id="options.display"
			  label="Display"
			  destination={ScreenDestination::OptionsDisplay}
			/>
			<OptionsNavigationButton
			  key="audio"
			  id="options.audio"
			  label="Audio"
			  destination={ScreenDestination::OptionsAudio}
			/>
			<OptionsNavigationButton
			  key="back"
			  id="options.back"
			  label="Go Back"
			  destination={ScreenDestination::MainMenu}
			/>
		</Box>
	</Box>
}

}  // namespace silencer::client_ui

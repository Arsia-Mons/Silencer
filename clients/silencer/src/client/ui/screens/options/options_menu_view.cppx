#include "client/ui/screens/options/options_menu_view.h"

#include "client/ui/hooks/use_navigation.h"
#include "client/ui/screens/options/options_audio_screen.h"
#include "client/ui/screens/options/options_controls_screen.h"
#include "client/ui/screens/options/options_display_screen.h"
#include "client/ui/style/silencer_style.h"
#include "ui/components/box.h"

#include <memory>

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;

namespace {

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::StyleStatePatch root_style() {
	return style::SpriteBackground(6, 0);
}

::ui::LayoutStyle column_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(196.0f),
		.gap = 19.0f,
	};
}

::ui::LayoutStyle button_layout(bool autofocus = false) {
	(void)autofocus;
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Start,
		.width = ::ui::Length::points(196.0f),
		.height = ::ui::Length::points(33.0f),
		.padding = {24.0f, 24.0f, 8.0f, 7.0f},
	};
}

std::function<void(const ::ui::ActivationEvent&)> open_controls_callback(
	Navigation navigation) {
	return [navigation](const ::ui::ActivationEvent&) {
		if(navigation.push){
			navigation.push(std::make_unique<OptionsControlsScreen>());
		}
	};
}

std::function<void(const ::ui::ActivationEvent&)> open_display_callback(
	Navigation navigation) {
	return [navigation](const ::ui::ActivationEvent&) {
		if(navigation.push){
			navigation.push(std::make_unique<OptionsDisplayScreen>());
		}
	};
}

std::function<void(const ::ui::ActivationEvent&)> open_audio_callback(
	Navigation navigation) {
	return [navigation](const ::ui::ActivationEvent&) {
		if(navigation.push){
			navigation.push(std::make_unique<OptionsAudioScreen>());
		}
	};
}

std::function<void(const ::ui::ActivationEvent&)> back_callback(
	Navigation navigation) {
	return [navigation](const ::ui::ActivationEvent&) {
		if(navigation.pop_current) navigation.pop_current();
	};
}

struct OptionsButtonProps {
	const char * key = nullptr;
	const char * id = nullptr;
	const char * label = nullptr;
	bool autofocus = false;
	std::function<void(const ::ui::ActivationEvent&)> on_activate = {};
};

::ui::UiElement OptionsButton(const OptionsButtonProps& props) {
	return style::LegacyButton(style::LegacyButtonProps{
		.key = props.key,
		.id = props.id,
		.autofocus = props.autofocus,
		.label = props.label,
		.on_activate = props.on_activate,
		.layout = button_layout(props.autofocus),
	});
}

}  // namespace

::ui::UiElement OptionsMenuView(const OptionsMenuViewProps& props) {
	Navigation navigation = use_navigation();
	return <Box key={props.key} layout={root_layout()} style={root_style()}>
		<Box key="column" layout={column_layout()}>
			<OptionsButton
			  key="controls"
			  id="options.controls"
			  label="Controls"
			  autofocus={true}
			  onActivate={open_controls_callback(navigation)}
			/>
			<OptionsButton
			  key="display"
			  id="options.display"
			  label="Display"
			  onActivate={open_display_callback(navigation)}
			/>
			<OptionsButton
			  key="audio"
			  id="options.audio"
			  label="Audio"
			  onActivate={open_audio_callback(navigation)}
			/>
			<OptionsButton
			  key="back"
			  id="options.back"
			  label="Go Back"
			  onActivate={back_callback(navigation)}
			/>
		</Box>
	</Box>
}

}  // namespace silencer::client_ui

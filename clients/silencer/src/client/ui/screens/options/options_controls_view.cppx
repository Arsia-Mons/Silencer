#include "client/ui/screens/options/options_controls_view.h"

#include "client/ui/hooks/use_navigation.h"
#include "client/ui/style/silencer_style.h"
#include "ui/components/box.h"
#include "ui/components/text.h"
#include "ui/runtime/react.h"

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

constexpr int kContentW = 486;
constexpr int kActionNameW = 180;
constexpr int kOperatorW = 45;
constexpr int kActionSlotW = 112;
constexpr int kPresetButtonW = 220;
constexpr int kPanelMinW = 560;
constexpr int kPanelMinH = 420;
constexpr int kPresetRowH = 43;
constexpr int kRowH = 43;
constexpr int kRowGap = 10;
constexpr int kColumnGap = 12;
constexpr int kPresetGap = 12;
constexpr int kSectionGap = 8;
constexpr int kActionTopGap = 16;
constexpr int kActionRowH = 33;

int scaled(float h_scale, int value) {
	int result = static_cast<int>(static_cast<float>(value) * h_scale + 0.5f);
	return result < 1 ? 1 : result;
}

float h_scale(const options::KeybindListView * view) {
	return view ? view->hScale : 1.0f;
}

const options::KeybindRowView * row_at(const options::KeybindListView * view, int index) {
	if(!view) return nullptr;
	if(index < 0 || index >= view->visibleRowCount) return nullptr;
	if(index >= static_cast<int>(view->rows.size())) return nullptr;
	return &view->rows[index];
}

const char * preset_text(const options::KeybindListView * view) {
	return view ? view->presetText.c_str() : "";
}

float title_offset_y(const options::KeybindListView * view) {
	return view ? view->titleOffsetY : 8.0f;
}

const char * primary_id(int row) {
	return ::ui::copy_string(use_text_storage("options_controls.primary.%d", row));
}

const char * secondary_id(int row) {
	return ::ui::copy_string(use_text_storage("options_controls.secondary.%d", row));
}

const char * operator_id(int row) {
	return ::ui::copy_string(use_text_storage("options_controls.operator.%d", row));
}

std::function<void(const ::ui::ActivationEvent&)> rebind_callback(
	std::function<void(int row, int slot)> handler,
	int row,
	int slot) {
	return [handler, row, slot](const ::ui::ActivationEvent&) {
		if(handler) handler(row, slot);
	};
}

std::function<void(const ::ui::ActivationEvent&)> operator_callback(
	std::function<void(int row)> handler,
	int row) {
	return [handler, row](const ::ui::ActivationEvent&) {
		if(handler) handler(row);
	};
}

std::function<void(const ::ui::ActivationEvent&)> action_callback(
	std::function<void()> action) {
	return [action](const ::ui::ActivationEvent&) {
		if(action) action();
	};
}

std::function<void(const ::ui::ActivationEvent&)> navigation_action_callback(
	std::function<void()> action,
	Navigation navigation) {
	return [action, navigation](const ::ui::ActivationEvent&) {
		if(action) action();
		if(navigation.pop_current) navigation.pop_current();
	};
}

::ui::LayoutStyle root_layout(const OptionsControls& controls) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
		.padding = {
			static_cast<float>(controls.frame_pad_left),
			static_cast<float>(controls.frame_pad_right),
			static_cast<float>(controls.frame_pad_top),
			static_cast<float>(controls.frame_pad_bottom),
		},
	};
}

::ui::StyleStatePatch root_style() {
	return style::SpriteBackground(6, 0);
}

::ui::LayoutStyle panel_layout(const OptionsControls& controls) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
		.min_width = ::ui::Length::points(static_cast<float>(kPanelMinW)),
		.min_height = ::ui::Length::points(static_cast<float>(kPanelMinH)),
		.padding = {
			static_cast<float>(controls.panel_pad_x),
			static_cast<float>(controls.panel_pad_x),
			70.0f,
			static_cast<float>(controls.panel_pad_bottom),
		},
	};
}

::ui::StyleStatePatch panel_style() {
	return style::SpriteBackground(7, 7);
}

::ui::EdgeSizes title_position(float y) {
	::ui::EdgeSizes inset;
	inset.left = ::ui::StyleValue::percent(0.0f);
	inset.right = ::ui::StyleValue::percent(0.0f);
	inset.top = ::ui::StyleValue::points(y);
	return inset;
}

::ui::LayoutStyle title_layout(const options::KeybindListView * view) {
	return ::ui::LayoutStyle{
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::points(static_cast<float>(scaled(h_scale(view), kContentW))),
		.height = ::ui::Length::points(24.0f),
		.position_inset = title_position(title_offset_y(view)),
	};
}

::ui::LayoutStyle content_layout(const options::KeybindListView * view) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(static_cast<float>(scaled(h_scale(view), kContentW))),
		.height = ::ui::Length::grow(1.0f),
		.gap = static_cast<float>(kSectionGap),
	};
}

::ui::LayoutStyle preset_row_layout(const options::KeybindListView * view) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::points(static_cast<float>(kPresetRowH)),
		.gap = static_cast<float>(scaled(h_scale(view), kPresetGap)),
	};
}

::ui::LayoutStyle rows_layout() {
	return ::ui::LayoutStyle{
		.overflow = ::ui::Overflow::Hidden,
		.direction = ::ui::FlexDirection::Column,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::grow(1.0f),
		.gap = static_cast<float>(kRowGap),
	};
}

::ui::LayoutStyle row_layout(float h_scale) {
	(void)h_scale;
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::points(static_cast<float>(kRowH)),
		.gap = static_cast<float>(scaled(h_scale, kColumnGap)),
	};
}

::ui::LayoutStyle label_layout(float h_scale) {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(static_cast<float>(scaled(h_scale, kActionNameW))),
		.height = ::ui::Length::points(18.0f),
	};
}

::ui::LayoutStyle preset_button_layout(float h_scale) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Start,
		.width = ::ui::Length::points(static_cast<float>(scaled(h_scale, kPresetButtonW))),
		.height = ::ui::Length::points(33.0f),
		.padding = {24.0f, 24.0f, 8.0f, 7.0f},
	};
}

::ui::LayoutStyle action_button_layout(float h_scale) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Start,
		.width = ::ui::Length::points(static_cast<float>(scaled(h_scale, kActionSlotW))),
		.height = ::ui::Length::points(33.0f),
		.padding = {12.0f, 12.0f, 8.0f, 7.0f},
	};
}

::ui::LayoutStyle operator_button_layout(float h_scale) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(static_cast<float>(scaled(h_scale, kOperatorW))),
		.height = ::ui::Length::points(23.0f),
		.padding = {0.0f, 0.0f, 4.0f, 4.0f},
	};
}

::ui::LayoutStyle spacer_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::points(static_cast<float>(kActionTopGap)),
	};
}

::ui::LayoutStyle actions_layout(const options::KeybindListView * view) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.height = ::ui::Length::points(static_cast<float>(kActionRowH)),
		.gap = static_cast<float>(scaled(h_scale(view), kColumnGap)),
	};
}

::ui::LayoutStyle footer_button_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Start,
		.width = ::ui::Length::points(196.0f),
		.height = ::ui::Length::points(33.0f),
		.padding = {24.0f, 24.0f, 8.0f, 7.0f},
	};
}

::ui::StyleStatePatch title_style() {
	return style::LegacyScreenTitleTextStyle(12);
}

::ui::StyleStatePatch heading_style() {
	return style::LegacyHeadingTextStyle(8);
}

struct KeybindRowProps {
	const char * key = nullptr;
	int index = 0;
};

struct RowActionButtonProps {
	const char * key = nullptr;
	const char * id = nullptr;
	const char * label = nullptr;
	float scale = 1.0f;
	std::function<void(const ::ui::ActivationEvent&)> on_activate = {};
};

::ui::UiElement RowActionButton(const RowActionButtonProps& props) {
	return style::LegacyButton(style::LegacyButtonProps{
		.key = props.key,
		.id = props.id,
		.label = props.label,
		.on_activate = props.on_activate,
		.layout = action_button_layout(props.scale),
		.style = style::LegacyOvalButtonStyle(28),
		.text_style = style::LegacyButtonTextStyle(11),
	});
}

struct RowOperatorButtonProps {
	const char * key = nullptr;
	const char * id = nullptr;
	const char * label = nullptr;
	float scale = 1.0f;
	std::function<void(const ::ui::ActivationEvent&)> on_activate = {};
};

::ui::UiElement RowOperatorButton(const RowOperatorButtonProps& props) {
	return style::LegacyButton(style::LegacyButtonProps{
		.key = props.key,
		.id = props.id,
		.label = props.label,
		.on_activate = props.on_activate,
		.layout = operator_button_layout(props.scale),
		.style = style::LegacyTextButtonStyle(),
		.text_style = style::LegacyHeadingTextStyle(8),
		.text_layout = style::ButtonLabelLayout(15.0f),
	});
}

::ui::UiElement KeybindRow(const KeybindRowProps& props) {
	const OptionsControls& controls = UseOptionsControls();
	const options::KeybindRowView * row = row_at(controls.keybinds, props.index);
	if(!row) return ::ui::empty();
	const float scale = h_scale(controls.keybinds);
	return <Box key={props.key} layout={row_layout(scale)}>
		<Text
		  key="action"
		  value={row->actionLabel.c_str()}
		  layout={label_layout(scale)}
		  style={heading_style()}
		/>
		<RowActionButton
		  key="primary"
		  id={primary_id(props.index)}
		  label={row->rebindingPrimary ? "-" : row->primaryLabel.c_str()}
		  scale={scale}
		  onActivate={rebind_callback(controls.begin_rebind, props.index, 0)}
		/>
		<RowOperatorButton
		  key="operator"
		  id={operator_id(props.index)}
		  label={row->operatorLabel.c_str()}
		  scale={scale}
		  onActivate={operator_callback(controls.toggle_operator, props.index)}
		/>
		<RowActionButton
		  key="secondary"
		  id={secondary_id(props.index)}
		  label={row->rebindingSecondary ? "-" : row->secondaryLabel.c_str()}
		  scale={scale}
		  onActivate={rebind_callback(controls.begin_rebind, props.index, 1)}
		/>
	</Box>
}

struct PresetButtonProps {
	const char * key = nullptr;
};

::ui::UiElement PresetButton(const PresetButtonProps& props) {
	const OptionsControls& controls = UseOptionsControls();
	return style::LegacyButton(style::LegacyButtonProps{
		.key = props.key,
		.id = "options_controls.preset",
		.autofocus = true,
		.accessibility = ::ui::components::AccessibilityProps{.label = "Preset"},
		.label = preset_text(controls.keybinds),
		.on_activate = action_callback(controls.cycle_preset),
		.layout = preset_button_layout(h_scale(controls.keybinds)),
		.style = style::LegacyOvalButtonStyle(23),
	});
}

struct ControlsSaveButtonProps {
	const char * key = nullptr;
};

::ui::UiElement ControlsSaveButton(const ControlsSaveButtonProps& props) {
	const OptionsControls& controls = UseOptionsControls();
	Navigation navigation = use_navigation();
	return style::LegacyButton(style::LegacyButtonProps{
		.key = props.key,
		.id = "options_controls.save",
		.label = "Save",
		.on_activate = navigation_action_callback(controls.save, navigation),
		.layout = footer_button_layout(),
	});
}

struct ControlsCancelButtonProps {
	const char * key = nullptr;
};

::ui::UiElement ControlsCancelButton(const ControlsCancelButtonProps& props) {
	const OptionsControls& controls = UseOptionsControls();
	Navigation navigation = use_navigation();
	return style::LegacyButton(style::LegacyButtonProps{
		.key = props.key,
		.id = "options_controls.cancel",
		.label = "Cancel",
		.on_activate = navigation_action_callback(controls.cancel, navigation),
		.layout = footer_button_layout(),
	});
}

}  // namespace

::ui::UiElement OptionsControlsFrame(const OptionsControlsFrameProps& props) {
	const OptionsControls& controls = UseOptionsControls();
	return <Box key={props.key} layout={root_layout(controls)} style={root_style()}>
		<Box key="panel" layout={panel_layout(controls)} style={panel_style()}>
			<Text
			  key="title"
			  value="Configure Controls"
			  layout={title_layout(controls.keybinds)}
			  style={title_style()}
			/>
			<Box key="content" layout={content_layout(controls.keybinds)}>
				<Box key="preset-row" layout={preset_row_layout(controls.keybinds)}>
					<Text
					  key="preset-label"
					  value="Preset:"
					  layout={label_layout(h_scale(controls.keybinds))}
					  style={heading_style()}
					/>
					<PresetButton key="preset" />
				</Box>
				<Box
				  key="rows"
				  id="options_controls.list"
				  accessibility={::ui::components::AccessibilityProps{.label = "Controls List", .description = "scroll"}}
				  layout={rows_layout()}
				>
					<KeybindRow key="row-00" index={0} />
					<KeybindRow key="row-01" index={1} />
					<KeybindRow key="row-02" index={2} />
					<KeybindRow key="row-03" index={3} />
					<KeybindRow key="row-04" index={4} />
					<KeybindRow key="row-05" index={5} />
					<KeybindRow key="row-06" index={6} />
					<KeybindRow key="row-07" index={7} />
					<KeybindRow key="row-08" index={8} />
					<KeybindRow key="row-09" index={9} />
					<KeybindRow key="row-10" index={10} />
					<KeybindRow key="row-11" index={11} />
					<KeybindRow key="row-12" index={12} />
					<KeybindRow key="row-13" index={13} />
					<KeybindRow key="row-14" index={14} />
					<KeybindRow key="row-15" index={15} />
					<KeybindRow key="row-16" index={16} />
					<KeybindRow key="row-17" index={17} />
					<KeybindRow key="row-18" index={18} />
					<KeybindRow key="row-19" index={19} />
					<KeybindRow key="row-20" index={20} />
					<KeybindRow key="row-21" index={21} />
					<KeybindRow key="row-22" index={22} />
					<KeybindRow key="row-23" index={23} />
					<KeybindRow key="row-24" index={24} />
					<KeybindRow key="row-25" index={25} />
					<KeybindRow key="row-26" index={26} />
					<KeybindRow key="row-27" index={27} />
					<KeybindRow key="row-28" index={28} />
					<KeybindRow key="row-29" index={29} />
				</Box>
				<Box key="spacer" layout={spacer_layout()} />
				<Box key="actions" layout={actions_layout(controls.keybinds)}>
					<ControlsSaveButton key="save" />
					<ControlsCancelButton key="cancel" />
				</Box>
			</Box>
		</Box>
	</Box>
}

}  // namespace silencer::client_ui

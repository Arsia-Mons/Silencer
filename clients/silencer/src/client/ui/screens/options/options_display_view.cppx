#include "client/ui/screens/options/options_display_view.h"

#include "client/ui/navigation/NavigationProvider.h"
#include "game_state.h"
#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/checkbox.h"
#include "ui/components/text.h"

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Checkbox;
using ::ui::components::CheckboxProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Start,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
		.padding = {0.0f, 0.0f, 80.0f, 0.0f},
	};
}

::ui::StyleStatePatch root_style() {
	return ::ui::patch().background(::ui::Color{14, 18, 25, 255});
}

::ui::LayoutStyle panel_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(420.0f),
		.gap = 22.0f,
		.padding = {24.0f, 24.0f, 32.0f, 32.0f},
	};
}

::ui::LayoutStyle title_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(260.0f),
		.height = ::ui::Length::points(24.0f),
	};
}

::ui::LayoutStyle rows_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.gap = 20.0f,
	};
}

::ui::LayoutStyle setting_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Start,
		.width = ::ui::Length::points(216.0f),
		.height = ::ui::Length::points(33.0f),
		.padding = {12.0f, 12.0f, 7.0f, 7.0f},
		.gap = 10.0f,
	};
}

::ui::LayoutStyle actions_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.gap = 12.0f,
	};
}

::ui::LayoutStyle action_button_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(102.0f),
		.height = ::ui::Length::points(33.0f),
		.padding = {18.0f, 18.0f, 7.0f, 7.0f},
	};
}

::ui::StyleStatePatch title_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 14,
		.align = ::ui::TextAlign::Center,
	});
}

std::function<void(bool)> toggle_fullscreen_callback(const OptionsDisplayContextValue& display) {
	return [display](bool) {
		if(display.toggle_fullscreen) display.toggle_fullscreen();
	};
}

std::function<void(bool)> toggle_smooth_scaling_callback(const OptionsDisplayContextValue& display) {
	return [display](bool) {
		if(display.toggle_smooth_scaling) display.toggle_smooth_scaling();
	};
}

std::function<void(const ::ui::ActivationEvent&)> save_callback(
	const OptionsDisplayContextValue& display,
	Navigation navigation) {
	return [display, navigation](const ::ui::ActivationEvent&) {
		if(display.save) display.save();
		if(navigation.goToState) navigation.goToState(GameState::OPTIONS);
	};
}

std::function<void(const ::ui::ActivationEvent&)> cancel_callback(
	const OptionsDisplayContextValue& display,
	Navigation navigation) {
	return [display, navigation](const ::ui::ActivationEvent&) {
		if(display.cancel) display.cancel();
		if(navigation.goToState) navigation.goToState(GameState::OPTIONS);
	};
}

struct FullscreenToggleProps {
	const char * key = nullptr;
};

::ui::UiElement FullscreenToggle(const FullscreenToggleProps& props) {
	const OptionsDisplayContextValue& display = UseOptionsDisplay();
	return <Checkbox
	  key={props.key}
	  id="options_display.fullscreen"
	  label="Fullscreen"
	  checked={display.fullscreen}
	  autofocus={true}
	  onChange={toggle_fullscreen_callback(display)}
	  layout={setting_layout()}
	/>
}

struct SmoothScalingToggleProps {
	const char * key = nullptr;
};

::ui::UiElement SmoothScalingToggle(const SmoothScalingToggleProps& props) {
	const OptionsDisplayContextValue& display = UseOptionsDisplay();
	return <Checkbox
	  key={props.key}
	  id="options_display.smooth_scaling"
	  label="Smooth Scaling"
	  checked={display.smooth_scaling}
	  onChange={toggle_smooth_scaling_callback(display)}
	  layout={setting_layout()}
	/>
}

struct DisplaySaveButtonProps {
	const char * key = nullptr;
};

::ui::UiElement DisplaySaveButton(const DisplaySaveButtonProps& props) {
	const OptionsDisplayContextValue& display = UseOptionsDisplay();
	Navigation navigation = UseNavigation();
	return <Button
	  key={props.key}
	  id="options_display.save"
	  label="Save"
	  onActivate={save_callback(display, navigation)}
	  layout={action_button_layout()}
	/>
}

struct DisplayCancelButtonProps {
	const char * key = nullptr;
};

::ui::UiElement DisplayCancelButton(const DisplayCancelButtonProps& props) {
	const OptionsDisplayContextValue& display = UseOptionsDisplay();
	Navigation navigation = UseNavigation();
	return <Button
	  key={props.key}
	  id="options_display.cancel"
	  label="Cancel"
	  onActivate={cancel_callback(display, navigation)}
	  layout={action_button_layout()}
	/>
}

}  // namespace

::ui::UiElement OptionsDisplayFrame(const OptionsDisplayFrameProps& props) {
	return <Box key={props.key} layout={root_layout()} style={root_style()}>
		<Box key="panel" layout={panel_layout()}>
			<Text key="title" value="Display Options" layout={title_layout()} style={title_style()} />
			<Box key="rows" layout={rows_layout()}>
				<FullscreenToggle key="fullscreen" />
				<SmoothScalingToggle key="smooth-scaling" />
			</Box>
			<Box key="actions" layout={actions_layout()}>
				<DisplaySaveButton key="save" />
				<DisplayCancelButton key="cancel" />
			</Box>
		</Box>
	</Box>
}

}  // namespace silencer::client_ui

#include "client/ui/screens/password_modal.h"

#include "client/ui/components/actions/actions.h"
#include "client/ui/components/layout/layout.h"
#include "client/ui/components/text/text.h"
#include "client/ui/components/tokens.h"
#include "client/ui/hooks/use_chrome.h"
#include "client/ui/hooks/use_navigation.h"
#include "ui/components/box.h"
#include "ui/components/input.h"
#include "ui/components/text.h"
#include "ui/runtime/react.h"

#include <functional>
#include <string>
#include <utility>

namespace client::ui {
namespace {

using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Input;
using ::ui::components::InputProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

constexpr float kDialogW = 352.0f;
constexpr float kDialogH = 148.0f;
constexpr float kDialogPadX = 34.0f;
constexpr float kDialogPadTop = 30.0f;
constexpr float kDialogPadBottom = 24.0f;
constexpr float kPromptW = kDialogW;
constexpr float kInputW = 180.0f;
constexpr float kInputH = 14.0f;

struct PasswordModalProps {
  const char *title = "";
  std::function<void(const std::string &)> on_submit = {};
};

::ui::UiElement PasswordPromptText() {
  ::ui::StyleStatePatch text_style{};
  text_style.base = ::ui::patch().text(::ui::TextVisual{
      .color = tokens::kTextSubtitle,
      .font_id = tokens::kFaceLarge,
      .font_size = tokens::kFontLarge,
      .align = ::ui::TextAlign::Center,
      .wrap = ::ui::TextWrap::Words,
      .line_height = tokens::kLineLarge,
  });
  TextProps props{};
  props.key = "prompt";
  props.value = "This game requires a password";
  props.layout.width = ::ui::Length::points(kPromptW);
  props.style = text_style;
  return Text(props);
}

::ui::UiElement PasswordModalView(const PasswordModalProps &props) {
  std::string *value = use_state<std::string>(std::string());
  if (!value)
    return ::ui::empty();
  Navigation nav = use_navigation();
  ChromeTextures chrome = use_chrome();

  std::function<void()> submit = [value, on_submit = props.on_submit, nav]() {
    if (on_submit)
      on_submit(*value);
    if (nav.pop_current)
      nav.pop_current();
  };
  // origin cap: maxLength 20.
  std::function<void(const std::string &)> on_change =
      [value](const std::string &next) { *value = next.substr(0, 20); };
  std::function<void(const ::ui::ActivationEvent &)> on_activate =
      [submit](const ::ui::ActivationEvent &) { submit(); };

  // Bare field over the sprite well (masking deferred): chromeless clear + caret.
  ::ui::StylePatch clear = tokens::chromeless_clear_patch();
  clear.caret = ::ui::opt(::ui::Caret{chrome.caret_lobby, 1.5f});
  ::ui::StyleStatePatch bare{};
  bare.base = clear;
  bare.hover = clear;
  bare.focus_visible = clear;
  bare.pressed = clear;
  auto field_layout = ::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::Center,
      .width = ::ui::Length::points(kInputW),
      .height = ::ui::Length::points(kInputH),
      .padding = {8.0f, 0.0f, 0.0f, 0.0f}};

  ::ui::StylePatch panel_style =
      chrome.dialog_pw ? tokens::image_patch_cover(chrome.dialog_pw)
                       : tokens::panel_patch(tokens::kSurfacePanel,
                                             tokens::kBorderPanel);

  return <ScreenLayout key="root" variant={ScreenLayoutVariant::CenteredOverlay}>
    <Box
      key="panel"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Center,
        .justify_content = ::ui::JustifyContent::Start,
        .width = ::ui::Length::points(kDialogW),
        .height = ::ui::Length::points(kDialogH),
        .padding = {kDialogPadX, kDialogPadX, kDialogPadTop, kDialogPadBottom},
        .gap = 16.0f}}
      style={panel_style}
    >
      {PasswordPromptText()}
      <Input
        key="field"
        id="Password"
        autofocus={true}
        accessibility={{.label = "Password"}}
        onActivate={on_activate}
        value={value->c_str()}
        onChange={on_change}
        layout={field_layout}
        style={bare}
      />
      <AppButton
        key="ok"
        controlId="Ok"
        variant={AppButtonVariant::Chrome}
        size={AppButtonSize::Sm}
        label="OK"
        onPress={submit}
      />
    </Box>
  </ScreenLayout>
}

} // namespace

bool PasswordModalScreen::build_element(::ui::UiElementFrame &,
                                        ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component(
      "PasswordModal",
      PasswordModalProps{.title = title_.c_str(), .on_submit = on_submit_},
      PasswordModalView, "password-modal");
  return true;
}

} // namespace client::ui

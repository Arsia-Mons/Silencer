#include "client/ui/screens/lobby_connect/lobby_connect_view.h"

#include "client/ui/hooks/use_game_navigation.h"
#include "game_state.h"
#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/input.h"
#include "ui/components/text.h"

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Input;
using ::ui::components::InputProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::LayoutStyle panel_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Stretch,
		.width = ::ui::Length::points(284.0f),
		.height = ::ui::Length::points(277.0f),
		.padding = {12.0f, 12.0f, 8.0f, 8.0f},
		.gap = 7.0f,
	};
}

::ui::StyleStatePatch panel_style() {
	return ::ui::patch()
		.background(::ui::Color{31, 36, 44, 248})
		.border(::ui::Border{
			.width = {1.0f, 1.0f, 1.0f, 1.0f},
			.color = {
				{74, 86, 102, 255},
				{74, 86, 102, 255},
				{74, 86, 102, 255},
				{74, 86, 102, 255},
			},
		});
}

::ui::LayoutStyle log_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Start,
		.width = ::ui::Length::points(250.0f),
		.height = ::ui::Length::points(170.0f),
		.gap = 0.0f,
	};
}

::ui::LayoutStyle log_line_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(250.0f),
		.height = ::ui::Length::points(11.0f),
	};
}

::ui::LayoutStyle form_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.gap = 6.0f,
	};
}

::ui::LayoutStyle form_row_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.height = ::ui::Length::points(21.0f),
	};
}

::ui::LayoutStyle label_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(86.0f),
		.height = ::ui::Length::points(21.0f),
	};
}

::ui::LayoutStyle input_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Stretch,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(183.0f),
		.height = ::ui::Length::points(21.0f),
		.padding = {7.0f, 7.0f, 3.0f, 3.0f},
	};
}

::ui::LayoutStyle actions_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.height = ::ui::Length::points(33.0f),
		.gap = 0.0f,
	};
}

::ui::LayoutStyle button_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(112.0f),
		.height = ::ui::Length::points(28.0f),
		.padding = {10.0f, 10.0f, 5.0f, 5.0f},
	};
}

::ui::StyleStatePatch label_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 8,
		.align = ::ui::TextAlign::Center,
	});
}

::ui::StyleStatePatch log_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 6,
	});
}

std::function<void(const std::string&)> text_callback(
	std::function<void(const std::string&)> action) {
	return [action](const std::string& value) {
		if(action) action(value);
	};
}

std::function<void(const ::ui::ActivationEvent&)> submit_callback(
	std::function<void()> submit) {
	return [submit](const ::ui::ActivationEvent&) {
		if(submit) submit();
	};
}

std::function<void(const ::ui::ActivationEvent&)> cancel_callback(
	GameNavigation navigation) {
	return [navigation](const ::ui::ActivationEvent&) {
		if(navigation.go_to_state) navigation.go_to_state(GameState::MAINMENU);
	};
}

struct UsernameInputProps {
	const char * key = nullptr;
};

::ui::UiElement UsernameInput(const UsernameInputProps& props) {
	const LobbyConnectCredentials& credentials = UseLobbyConnectCredentials();
	return <Input
	  key={props.key}
	  id="lobby_connect.username"
	  value={credentials.username}
	  disabled={credentials.inactive}
	  autofocus={true}
	  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Username"}}
	  onChange={text_callback(credentials.set_username)}
	  layout={input_layout()}
	/>
}

struct PasswordInputProps {
	const char * key = nullptr;
};

::ui::UiElement PasswordInput(const PasswordInputProps& props) {
	const LobbyConnectCredentials& credentials = UseLobbyConnectCredentials();
	return <Input
	  key={props.key}
	  id="lobby_connect.password"
	  value={credentials.password}
	  password={true}
	  disabled={credentials.inactive}
	  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Password"}}
	  onChange={text_callback(credentials.set_password)}
	  layout={input_layout()}
	/>
}

struct LoginButtonProps {
	const char * key = nullptr;
};

::ui::UiElement LoginButton(const LoginButtonProps& props) {
	const LobbyConnectCredentials& credentials = UseLobbyConnectCredentials();
	return <Button
	  key={props.key}
	  id="lobby_connect.login"
	  label="Login/Create"
	  onActivate={submit_callback(credentials.submit)}
	  layout={button_layout()}
	/>
}

struct LobbyConnectCancelButtonProps {
	const char * key = nullptr;
};

::ui::UiElement LobbyConnectCancelButton(const LobbyConnectCancelButtonProps& props) {
	GameNavigation navigation = use_game_navigation();
	return <Button
	  key={props.key}
	  id="lobby_connect.cancel"
	  label="Cancel"
	  onActivate={cancel_callback(navigation)}
	  layout={button_layout()}
	/>
}

}  // namespace

::ui::UiElement LobbyConnectFrame(const LobbyConnectFrameProps& props) {
	const LobbyConnectLog& log = UseLobbyConnectLog();
	return <Box key={props.key} layout={root_layout()}>
		<Box key="panel" layout={panel_layout()} style={panel_style()}>
			<Box key="log" layout={log_layout()}>
				<Text key="log-00" value={log.log_lines[0]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-01" value={log.log_lines[1]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-02" value={log.log_lines[2]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-03" value={log.log_lines[3]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-04" value={log.log_lines[4]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-05" value={log.log_lines[5]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-06" value={log.log_lines[6]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-07" value={log.log_lines[7]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-08" value={log.log_lines[8]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-09" value={log.log_lines[9]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-10" value={log.log_lines[10]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-11" value={log.log_lines[11]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-12" value={log.log_lines[12]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-13" value={log.log_lines[13]} layout={log_line_layout()} style={log_style()} />
				<Text key="log-14" value={log.log_lines[14]} layout={log_line_layout()} style={log_style()} />
			</Box>
			<Box key="form" layout={form_layout()}>
				<Box key="username-row" layout={form_row_layout()}>
					<Text key="username-label" value="Username" layout={label_layout()} style={label_style()} />
					<UsernameInput key="username" />
				</Box>
				<Box key="password-row" layout={form_row_layout()}>
					<Text key="password-label" value="Password" layout={label_layout()} style={label_style()} />
					<PasswordInput key="password" />
				</Box>
			</Box>
			<Box key="actions" layout={actions_layout()}>
				<LoginButton key="login" />
				<LobbyConnectCancelButton key="cancel" />
			</Box>
		</Box>
	</Box>
}

}  // namespace silencer::client_ui

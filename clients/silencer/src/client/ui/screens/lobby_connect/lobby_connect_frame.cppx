	>
		<Box
		  key="panel"
		  layout={::ui::LayoutStyle{
				.position = ::ui::PositionType::Relative,
				.width = ::ui::Length::points(284.0f),
				.height = ::ui::Length::points(277.0f),
			}}
		  style={lobby_connect_frame_detail::panel_patch()}
		>
			<Text
			  key="log-0"
			  value={lobby_connect_frame_detail::log_line(log_text, 0)}
			  layout={lobby_connect_frame_detail::log_line_layout(0)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-1"
			  value={lobby_connect_frame_detail::log_line(log_text, 1)}
			  layout={lobby_connect_frame_detail::log_line_layout(1)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-2"
			  value={lobby_connect_frame_detail::log_line(log_text, 2)}
			  layout={lobby_connect_frame_detail::log_line_layout(2)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-3"
			  value={lobby_connect_frame_detail::log_line(log_text, 3)}
			  layout={lobby_connect_frame_detail::log_line_layout(3)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-4"
			  value={lobby_connect_frame_detail::log_line(log_text, 4)}
			  layout={lobby_connect_frame_detail::log_line_layout(4)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-5"
			  value={lobby_connect_frame_detail::log_line(log_text, 5)}
			  layout={lobby_connect_frame_detail::log_line_layout(5)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-6"
			  value={lobby_connect_frame_detail::log_line(log_text, 6)}
			  layout={lobby_connect_frame_detail::log_line_layout(6)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-7"
			  value={lobby_connect_frame_detail::log_line(log_text, 7)}
			  layout={lobby_connect_frame_detail::log_line_layout(7)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-8"
			  value={lobby_connect_frame_detail::log_line(log_text, 8)}
			  layout={lobby_connect_frame_detail::log_line_layout(8)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-9"
			  value={lobby_connect_frame_detail::log_line(log_text, 9)}
			  layout={lobby_connect_frame_detail::log_line_layout(9)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-10"
			  value={lobby_connect_frame_detail::log_line(log_text, 10)}
			  layout={lobby_connect_frame_detail::log_line_layout(10)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-11"
			  value={lobby_connect_frame_detail::log_line(log_text, 11)}
			  layout={lobby_connect_frame_detail::log_line_layout(11)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-12"
			  value={lobby_connect_frame_detail::log_line(log_text, 12)}
			  layout={lobby_connect_frame_detail::log_line_layout(12)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-13"
			  value={lobby_connect_frame_detail::log_line(log_text, 13)}
			  layout={lobby_connect_frame_detail::log_line_layout(13)}
			  style={lobby_connect_frame_detail::log_patch()}
			/>
			<Text
			  key="log-14"
			  value={lobby_connect_frame_detail::log_line(log_text, 14)}
			  layout={lobby_connect_frame_detail::log_line_layout(14)}
			  style={lobby_connect_frame_detail::log_patch()}

#include "client/ui/screens/lobby_connect/lobby_connect_frame.h"

#include "client/ui/components/actions/app_button.h"
#include "client/ui/components/tokens.h"
#include "ui/components/box.h"
#include "ui/components/text.h"
#include "ui/components/text_input.h"
#include "ui/style/style_patch.h"

#include <cstdint>
#include <cstring>
#include <string>

namespace silencer {
namespace client_ui {
namespace lobby_connect_frame_detail {

constexpr ::ui::Color kLegacyText = {0, 128, 0, 255};
constexpr std::uint16_t kPanelW = 284;
constexpr std::uint16_t kButtonPatchX = 84;
constexpr std::uint16_t kButtonPatchY = 246;
constexpr std::uint16_t kButtonPatchW = 116;
constexpr std::uint16_t kButtonPatchH = 24;

inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch panel_patch() {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(7, 2),
		.tint = {255, 255, 255, 255},
	});
}

inline const std::uint8_t * button_well_pixels() {
	static std::uint8_t pixels[kButtonPatchW * kButtonPatchH];
	static bool initialized = false;
	if(initialized) return pixels;
	for(std::uint16_t y = 0; y < kButtonPatchH; ++y){
		for(std::uint16_t x = 0; x < kButtonPatchW; ++x){
			const std::uint16_t panelX = kButtonPatchX + x;
			const std::uint16_t panelY = kButtonPatchY + y;
			pixels[(y * kButtonPatchW) + x] =
				((panelY & 1) == 0 || (panelX & 1) == 0) ? 210 : 146;
		}
	}
	initialized = true;
	return pixels;
}

inline ::ui::StylePatch button_well_patch() {
	return ::ui::patch().bitmap(::ui::RawBitmapImage{
		.pixels = button_well_pixels(),
		.width = kButtonPatchW,
		.height = kButtonPatchH,
	});
}

inline ::ui::StylePatch label_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = kLegacyText,
		.font_id = 134,
		.font_size = 8,
		.align = ::ui::TextAlign::Center,
	});
}

inline ::ui::StylePatch log_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = kLegacyText,
		.font_id = 133,
		.font_size = 6,
		.align = ::ui::TextAlign::Left,
		.wrap = ::ui::TextWrap::Words,
		.line_height = 11.0f,
	});
}

inline const char * log_line(const char * text, int index) {
	if(!text || index < 0) return "";
	const char * start = text;
	int current = 0;
	while(*start && current < index){
		const char * newline = std::strchr(start, '\n');
		if(!newline) return "";
		start = newline + 1;
		++current;
	}
	const char * end = std::strchr(start, '\n');
	std::string line = end
		? std::string(start, static_cast<std::size_t>(end - start))
		: std::string(start);
	return ::ui::copy_string(line.c_str());
}

inline ::ui::LayoutStyle log_line_layout(int index) {
	::ui::EdgeSizes inset;
	inset.left = ::ui::StyleValue::points(7.0f);
	inset.top = ::ui::StyleValue::points(8.0f + index * 11.0f);
	return ::ui::LayoutStyle{
		.position = ::ui::PositionType::Absolute,
		.position_inset = inset,
		.width = ::ui::Length::points(250.0f),
		.height = ::ui::Length::points(11.0f),
	};
}

inline ::ui::StylePatch input_patch() {
	return ::ui::patch()
		.background(::ui::Color{0, 0, 0, 0})
		.border(::ui::Border{
			{1.0f, 1.0f, 1.0f, 1.0f},
			{{216, 0, 0, 255}, {216, 0, 0, 255},
			 {216, 0, 0, 255}, {216, 0, 0, 255}},
		})
		.text(::ui::TextVisual{
			.color = kLegacyText,
			.font_id = tokens::kFontBodyBank,
			.font_size = 6,
			.align = ::ui::TextAlign::Left,
		});
}

inline ::ui::EdgeSizes inset_left_top(float left, float top) {
	::ui::EdgeSizes edges;
	edges.left = ::ui::StyleValue::points(left);
	edges.top = ::ui::StyleValue::points(top);
	return edges;
}

inline std::function<void(const ::ui::TextChangeEvent&)>
text_change_callback(std::function<void(const char *)> on_change) {
	return [on_change](const ::ui::TextChangeEvent& event) {
		if(on_change) on_change(event.value);
	};
}

inline std::function<void(const ::ui::TextSubmitEvent&)>
text_submit_callback(std::function<void(const char *)> on_submit) {
	return [on_submit](const ::ui::TextSubmitEvent& event) {
		if(on_submit) on_submit(event.value);
	};
}

}  // namespace lobby_connect_frame_detail

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Text;
using ::ui::components::TextInput;
using ::ui::components::TextInputProps;
using ::ui::components::TextProps;

::ui::UiElement LobbyConnectFrame(const LobbyConnectFrameProps& props) {
	const char * log_text = props.log_text ? props.log_text : "";
	const char * username_display =
		props.username_display ? props.username_display : "";
	const char * password_display =
		props.password_display ? props.password_display : "";

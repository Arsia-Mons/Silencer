using ::ui::components::InputProps;

// --- screen-local provider (doc §5/§6): the wizard cursor --------------------
// Holds the staged-create UI state; setters mutate the use_state pointers
// directly from event callbacks (the established Silencer screen idiom — the
// callbacks fire in the focus/hit-test pass, after this frame's build).
struct CharacterCreateContextValue {
  int *step = nullptr;
  std::string *alias = nullptr;
  bool *submitting = nullptr;
  int *preview_agency = nullptr;
};

ReactContext CharacterCreateContext = {};

struct CharacterCreateProviderProps {
  const char *key = nullptr;
  ::ui::UiChildren children = {};
};

::ui::UiElement CharacterCreateProvider(const CharacterCreateProviderProps &props) {
  int *step = use_state<int>(0);
  std::string *alias = use_state<std::string>(std::string());
  bool *submitting = use_state<bool>(false);
  int *preview_agency = use_state<int>(0);
  if (!step || !alias || !submitting || !preview_agency)
    return ::ui::empty();
  CharacterCreateContextValue value{step, alias, submitting, preview_agency};
  const CharacterCreateContextValue *stored = ::ui::copy_value(value);
  if (!stored)
    return ::ui::empty();
  return ::ui::provider("CharacterCreateProvider", &CharacterCreateContext,
                        const_cast<CharacterCreateContextValue *>(stored),
                        props.children, props.key);
}

// One agency row: a focusable selectable button (left column). Focusing a row
// previews that agency in the right detail column; activating commits it and
// creates the agent. The previewed row is shown selected.
::ui::UiElement agency_row(int index, int preview,
                           std::function<void(int)> on_pick,
                           std::function<void(int)> set_preview) {
  std::function<void()> on_press = [on_pick, index]() {
    if (on_pick)
      on_pick(index);
  };
  std::function<void()> on_focus = [set_preview, index]() {
    if (set_preview)
      set_preview(index);
  };
  return <AppButton
    key={kAgencies[index].control_id}
    controlId={kAgencies[index].control_id}
    controlOffset={index}
    variant={AppButtonVariant::Oval}
    selected={index == preview}
    defaultFocused={index == 0}
    accessibilityLabel={kAgencies[index].name}
    label={kAgencies[index].name}
    onPress={on_press}
    onFocus={on_focus}
  />
}

// One advantage line: "Endurance" left, "[+3]" right (green body palette). An
// empty slot ({nullptr,...}) renders nothing.
::ui::UiElement advantage_row(const char *key, const Advantage &adv) {
  if (!adv.label || adv.label[0] == '\0')
    return ::ui::empty();
  return <Box key={key} layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::SpaceBetween,
      .width = ::ui::Length::percent(100.0f),
      .gap = 8.0f}}>
    <BodyText key="l" variant={BodyTextVariant::Body} value={adv.label} />
    <BodyText key="b" variant={BodyTextVariant::Strong} value={adv.bonus} />
  </Box>
}

// One description prose line (the lore paragraph is authored one line per
// BodyText — the engine does not break on '\n' and screens don't use the wrap
// path, so multi-line text is composed as stacked fixed-height rows).
::ui::UiElement desc_line(const char *key, const char *value) {
  return <BodyText key={key} variant={BodyTextVariant::Body} value={value} />
}

// One roster row: select an existing agent. Out-of-range slots render nothing.
::ui::UiElement roster_row(int index, const std::vector<std::string> &roster,
                           std::function<void(int)> on_select) {
  if (index < 0 || index >= (int)roster.size())
    return ::ui::empty();
  const char *label = ::ui::copy_string(roster[index].c_str());
  const char *key = ::ui::copy_string(("agent" + std::to_string(index)).c_str());
  std::function<void()> on_press = [on_select, index]() {
    if (on_select)
      on_select(index);
  };
  return <AppButton
    key={key}
    controlId="SelectAgent"
    controlOffset={index}
    label={label}
    onPress={on_press}
  />
}

struct CharacterCreateContentProps {
  const char *key = nullptr;
};

::ui::UiElement CharacterCreateContent(const CharacterCreateContentProps &) {
  CharacterWizard w = use_character_create();
  Characters chars = use_characters();
  LobbySession lobby = use_lobby_session();

  std::function<void(int)> on_select = chars.select;
  std::function<void(int)> on_pick = [create = chars.create, alias = w.alias,
                                      submitting = w.submitting,
                                      begin = w.begin_submit](int agency) {
    if (submitting)
      return;
    if (begin)
      begin();
    if (create)
      create(alias, agency);
  };
  std::function<void(const ::ui::ActivationEvent &)> on_alias_enter =
      [confirm = w.confirm_alias](const ::ui::ActivationEvent &) {
        if (confirm)
          confirm();
      };

  // The wizard is a staged single-root view: roster → alias → agency. (Rendering
  // the alias/agency as true modals layered over the roster needs overlay
  // stack-entries, since the flex layout has no absolute/z stacking — a noted
  // follow-up for the test-17 background-trap semantics.)
  if (w.step == 1) {
    return <ScreenLayout key="aliasmodal" variant={ScreenLayoutVariant::CenteredOverlay}>
      <Panel key="panel" variant={PanelVariant::Hero}>
        <ScreenTitle key="t" variant={ScreenTitleVariant::Dialog} value="New Agent" />
        <ScreenSubtitle key="s" value="Step 2 of 3: choose an alias" />
        <Input
          key="alias"
          id="Alias"
          autofocus={true}
          accessibility={{.label = "Alias"}}
          value={w.alias.c_str()}
          onChange={w.set_alias}
          onActivate={on_alias_enter}
        />
        <ActionRow key="actions">
          <AppButton
            key="ok"
            controlId="AliasConfirm"
            variant={AppButtonVariant::Oval}
            disabled={w.alias.empty()}
            label="Continue"
            onPress={w.confirm_alias}
          />
          <AppButton key="cancel" controlId="AliasCancel" label="Cancel" onPress={w.cancel} />
        </ActionRow>
      </Panel>
    </ScreenLayout>
  }

  if (w.step == 2) {
    const int pi =
        (w.preview_agency >= 0 && w.preview_agency < kAgencyCount) ? w.preview_agency : 0;
    const AgencyInfo &a = kAgencies[pi];
    std::function<void(int)> set_preview = w.set_preview_agency;

    // The lore paragraph is authored one BodyText per line (see data header).
    std::vector<::ui::UiElement> desc;
    for (int i = 0; i < AgencyInfo::kMaxDescLines && a.description[i]; ++i) {
      const char *dk = ::ui::copy_string(("d" + std::to_string(i)).c_str());
      desc.push_back(desc_line(dk, a.description[i]));
    }
    ::ui::UiChildren desc_lines = ::ui::children(desc);

    // origin/main "SELECT AGENCY": two side-by-side GREEN bordered panels filling
    // the starfield overlay — left = framed agency list, right = Advantages +
    // Description. No outer wizard panel, no slate Sunken card, no emblem glyph,
    // no step subtitle (the regression palette + stat dump are gone).
    const ::ui::StylePatch panel_bg =
        tokens::panel_patch(tokens::kSurfacePanel, tokens::kBorderPanel);
    return <ScreenLayout key="agencyscreen" variant={ScreenLayoutVariant::Overlay}>
      <Box key="cols" layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::Stretch,
          .width = ::ui::Length::percent(100.0f),
          .height = ::ui::Length::points(380.0f),
          .gap = 14.0f}}>
        <Box key="left" layout={::ui::LayoutStyle{
            .direction = ::ui::FlexDirection::Column,
            .align_items = ::ui::AlignItems::Stretch,
            .flex_grow = ::ui::StyleFloat::points(1.15f),
            .flex_basis = ::ui::Length::points(0.0f),
            .min_width = ::ui::Length::points(0.0f),
            .padding = {16.0f, 16.0f, 14.0f, 14.0f},
            .gap = 8.0f,
            .border_width = tokens::kBorderWidth}} style={panel_bg}>
          <ScreenTitle key="t" variant={ScreenTitleVariant::Screen} value="SELECT AGENCY" />
          {agency_row(0, pi, on_pick, set_preview)}
          {agency_row(1, pi, on_pick, set_preview)}
          {agency_row(2, pi, on_pick, set_preview)}
          {agency_row(3, pi, on_pick, set_preview)}
          {agency_row(4, pi, on_pick, set_preview)}
        </Box>
        <Box key="right" layout={::ui::LayoutStyle{
            .direction = ::ui::FlexDirection::Column,
            .align_items = ::ui::AlignItems::Stretch,
            .flex_grow = ::ui::StyleFloat::points(1.0f),
            .flex_basis = ::ui::Length::points(0.0f),
            .min_width = ::ui::Length::points(0.0f),
            .overflow = ::ui::Overflow::Hidden,
            .padding = {16.0f, 16.0f, 14.0f, 14.0f},
            .gap = 4.0f,
            .border_width = tokens::kBorderWidth}} style={panel_bg}>
          <ScreenTitle key="adv" variant={ScreenTitleVariant::Screen} value="Advantages" />
          {advantage_row("a0", a.advantages[0])}
          {advantage_row("a1", a.advantages[1])}
          {advantage_row("a2", a.advantages[2])}
          {advantage_row("a3", a.advantages[3])}
          <ScreenTitle key="dh" variant={ScreenTitleVariant::Screen} value="Description" />
          {desc_lines}
        </Box>
      </Box>
      <ActionRow key="actions">
        <AppButton key="back" controlId="AgencyBack" variant={AppButtonVariant::Oval} size={AppButtonSize::Sm} label="Back" onPress={w.cancel} />
      </ActionRow>
    </ScreenLayout>
  }

  // step 0 — the roster + a "Create New Character" entry.
  return <ScreenLayout key="roster" variant={ScreenLayoutVariant::Menu}>
    <Panel key="panel" variant={PanelVariant::Hero}>
      <ScreenTitle key="title" variant={ScreenTitleVariant::Hero} value="Select Agent" />
      <ScreenSubtitle key="sub" value="Step 1 of 3: choose an agent or create a new one" />
      {roster_row(0, chars.roster, on_select)}
      {roster_row(1, chars.roster, on_select)}
      {roster_row(2, chars.roster, on_select)}
      {roster_row(3, chars.roster, on_select)}
      {roster_row(4, chars.roster, on_select)}
      <AppButton
        key="new"
        controlId="CreateNewCharacter"
        variant={AppButtonVariant::Oval}
        label="Create New Character"
        onPress={w.open_alias}
      />
      <AppButton key="leave" controlId="CharCreateCancel" label="Back" onPress={lobby.cancel} />
    </Panel>
  </ScreenLayout>
}

struct CharacterCreateProps {
  uint32_t unused = 0;
};

::ui::UiElement CharacterCreateView(const CharacterCreateProps &) {
  return <CharacterCreateProvider key="provider">
    <CharacterCreateContent key="content" />
  </CharacterCreateProvider>
}

} // namespace

CharacterWizard use_character_create() {
  CharacterCreateContextValue *v = static_cast<CharacterCreateContextValue *>(
      use_context(&CharacterCreateContext));
  if (!v) {
    react_report_error("client/ui: missing CharacterCreateProvider\n");
    return {};
  }
  CharacterWizard w;
  w.step = v->step ? *v->step : 0;
  w.alias = v->alias ? *v->alias : std::string();
  w.submitting = v->submitting ? *v->submitting : false;
  w.preview_agency = v->preview_agency ? *v->preview_agency : 0;
  int *step = v->step;
  std::string *alias = v->alias;
  bool *submitting = v->submitting;
  int *preview_agency = v->preview_agency;
  w.set_alias = [alias](const std::string &s) {
    if (alias)
      *alias = s;
  };
  w.open_alias = [step]() {
    if (step)
      *step = 1;
  };
  w.confirm_alias = [step, alias]() {
    if (step && alias && !alias->empty())
      *step = 2;
  };
  w.reopen_alias = [step]() {
    if (step)
      *step = 1; // Rename Once: back to alias entry, keep the typed alias
  };
  w.cancel = [step, alias, submitting]() {
    if (step)
      *step = 0;
    if (alias)
      alias->clear();
    if (submitting)
      *submitting = false;
  };
  w.begin_submit = [submitting]() {
    if (submitting)
      *submitting = true;
  };
  w.set_preview_agency = [preview_agency](int idx) {
    if (preview_agency && idx >= 0 && idx < kAgencyCount)
      *preview_agency = idx;
  };
  return w;
}

::ui::UiElement CharacterCreate(const char *key) {
  return ::ui::component("CharacterCreate", CharacterCreateProps{},
                         CharacterCreateView, key);
}

} // namespace client::ui

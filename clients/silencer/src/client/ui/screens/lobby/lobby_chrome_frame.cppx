struct GameTechTallPanelProps {
	const char * key = nullptr;
	bool show = false;
	const GameTechPanelState * state = nullptr;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement GameTechTallPanel(const GameTechTallPanelProps& props) {
	if(!props.show || !props.state || props.width <= 0 || props.height <= 0){
		return ::ui::empty();
	}
	const int selectedNameY =
		kGameTechGridY
		+ game_tech_visible_rows(props.state) * kGameTechRowH
		+ kGameTechSelectedGapY;
	const int descY =
		selectedNameY
		+ kGameTechNameH
		+ kGameTechDescGapY;
	return <Box key={props.key} layout={absolute_layout(props.x, props.y, props.width, props.height)}>
		<Text
		  key="slots-left"
		  value={props.state->slotsLeftStr.c_str()}
		  layout={absolute_layout(kGameTechSlotsX, kGameTechSlotsY, props.width - kGameTechSlotsX, 11)}
		  style={palette_text_patch(kGameTechTextPalette, 133, 6, 11.0f)}
		/>
		<GameTechRows key="rows" state={props.state} width={props.width} height={props.height} />
		<Text
		  key="selected-name"
		  value={props.state->techNameStr.c_str()}
		  layout={absolute_layout(0, selectedNameY, props.width, kGameTechNameH)}
		  style={palette_text_patch(0, 135, 11, 15.0f, ::ui::TextAlign::Center)}
		/>
		<GameTechDescLines key="description" state={props.state} y={descY} width={props.width} />
	</Box>
}

struct GameTechPeerNameProps {
	const char * key = nullptr;
	const GameTechPanelState * state = nullptr;
	int index = 0;
	int x = 0;
	int y = 0;
	int width = 0;
};

::ui::UiElement GameTechPeerName(const GameTechPeerNameProps& props) {
	if(!props.state || props.index < 0 || props.index >= 3){
		return ::ui::empty();
	}
	const char * value = props.state->peerNameStrs[props.index].c_str();
	if(!value || !*value) return ::ui::empty();
	return <Text
	  key={props.key}
	  value={value}
	  layout={absolute_layout(props.x, props.y, props.width, 11)}
	  style={text_patch(133, 6, 11.0f, ::ui::TextAlign::Right)}
	/>
}

struct GameTechUpperProps {
	const char * key = nullptr;
	bool show = false;
	const GameTechPanelState * state = nullptr;
	int back_x = 0;
	int back_y = 0;
	int back_width = 0;
	int back_height = 0;
	int peer_x = 0;
	int peer_y = 0;
	int peer_width = 0;
	int peer_row_gap = 0;
};

::ui::UiElement GameTechUpper(const GameTechUpperProps& props) {
	if(!props.show || !props.state){
		return ::ui::empty();
	}
	return <Box
	  key={props.key}
	  layout={::ui::LayoutStyle{
			.position = ::ui::PositionType::Absolute,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::percent(100.0f),
			.position_inset = absolute_inset(0.0f, 0.0f),
		}}
	>
		<AbsoluteChromeButton
		  key="back"
		  id="lobby.game_tech.back"
		  label="Back To Teams"
		  show={true}
		  x={props.back_x}
		  y={props.back_y}
		  width={props.back_width}
		  height={props.back_height}
		/>
		<GameTechPeerName
		  key="peer-0"
		  state={props.state}
		  index={0}
		  x={props.peer_x}
		  y={props.peer_y}
		  width={props.peer_width}
		/>
		<GameTechPeerName
		  key="peer-1"
		  state={props.state}
		  index={1}
		  x={props.peer_x}
		  y={props.peer_y + 11 + props.peer_row_gap}
		  width={props.peer_width}
		/>
		<GameTechPeerName
		  key="peer-2"
		  state={props.state}
		  index={2}
		  x={props.peer_x}
		  y={props.peer_y + (11 + props.peer_row_gap) * 2}
		  width={props.peer_width}
		/>
	</Box>
}

}  // namespace lobby_chrome_frame_detail

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

::ui::UiElement LobbyChromeFrame(const LobbyChromeFrameProps& props) {
	return <Box
	  key={props.key}
	  layout={::ui::LayoutStyle{
			.position = ::ui::PositionType::Relative,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::percent(100.0f),
		}}
	>
		<Box
		  key="title-bar"
		  id="LobbyTitleBar"
		  layout={lobby_chrome_frame_detail::title_layout(props)}
		  style={lobby_chrome_frame_detail::chrome_border_patch()}
		>
			<Text
			  key="title"
			  id="LobbyTitle"
			  value="Silencer"
			  layout={lobby_chrome_frame_detail::text_slot(88.0f)}
			  style={lobby_chrome_frame_detail::title_text_patch()}
			/>
			<Text
			  key="version"
			  id="LobbyVer"
			  value={props.version}
			  layout={lobby_chrome_frame_detail::text_slot(72.0f)}
			  style={lobby_chrome_frame_detail::version_text_patch()}
			/>
			<Text
			  key="map-name"
			  id="LobbyMapName"
			  value={props.show_map_name ? props.map_name : ""}
			  layout={lobby_chrome_frame_detail::text_slot(props.show_map_name ? 180.0f : 0.0f)}
			  style={lobby_chrome_frame_detail::map_text_patch()}
			/>
			<Box
			  key="spacer"
			  layout={::ui::LayoutStyle{
					.width = ::ui::Length::grow(1.0f),
					.height = ::ui::Length::points(1.0f),
				}}
			/>
			<Button
			  key="go-back"
			  id="lobby.go_back"
			  label="Go Back"
			  accessibility={{.label = "Go Back"}}
			  layout={::ui::LayoutStyle{
					.align_items = ::ui::AlignItems::Center,
					.justify_content = ::ui::JustifyContent::Center,
					.width = ::ui::Length::points(156.0f),
					.height = ::ui::Length::points(21.0f),
					.padding = {8.0f, 8.0f, 4.0f, 4.0f},
				}}
			  style={lobby_chrome_frame_detail::chrome_button_patch()}
			/>
		</Box>
		<lobby_chrome_frame_detail.CharacterPanelView
		  key="character-panel"
		  show={props.show_character}
		  state={props.character}
		  x={props.character_x}
		  y={props.character_y}
		  width={props.character_width}
		  height={props.character_height}
		/>
		<lobby_chrome_frame_detail.GameSelectTallPanel
		  key="game-select-tall"
		  show={props.show_game_select_tall}
		  state={props.game_select}
		  x={props.game_select_tall_x}
		  y={props.game_select_tall_y}
		  width={props.game_select_tall_width}
		  height={props.game_select_tall_height}
		/>
		<lobby_chrome_frame_detail.AbsoluteChromeButton
		  key="game-join-choose-tech"
		  id="lobby.game_join.choose_tech"
		  label="Choose Tech"
		  show={props.show_game_join_actions}
		  x={props.game_join_button_x}
		  y={props.game_join_choose_tech_y}
		  width={props.game_join_button_width}
		  height={props.game_join_button_height}
		/>
		<lobby_chrome_frame_detail.AbsoluteChromeButton
		  key="game-join-change-team"
		  id="lobby.game_join.change_team"
		  label="Change Team"
		  show={props.show_game_join_actions}
		  x={props.game_join_button_x}
		  y={props.game_join_change_team_y}
		  width={props.game_join_button_width}
		  height={props.game_join_button_height}
		/>
		<lobby_chrome_frame_detail.AbsoluteChromeButton
		  key="game-join-ready"
		  id="lobby.game_join.ready"
		  label={props.game_join_ready_label ? props.game_join_ready_label : "Ready"}
		  show={props.show_game_join_actions}
		  x={props.game_join_button_x}
		  y={props.game_join_ready_y}
		  width={props.game_join_button_width}
		  height={props.game_join_button_height}
		/>
		<lobby_chrome_frame_detail.GameJoinRosterPanel
		  key="game-join-roster"
		  show={props.show_game_join_roster}
		  state={props.game_join}
		  assets={props.app_assets}
		  x={props.game_join_roster_x}
		  y={props.game_join_roster_y}
		  width={props.game_join_roster_width}
		  height={props.game_join_roster_height}
		/>
		<lobby_chrome_frame_detail.GameTechUpper
		  key="game-tech-upper"
		  show={props.show_game_tech_upper}
		  state={props.game_tech}
		  backX={props.game_tech_back_x}
		  backY={props.game_tech_back_y}
		  backWidth={props.game_tech_back_width}
		  backHeight={props.game_tech_back_height}
		  peerX={props.game_tech_peer_x}
		  peerY={props.game_tech_peer_y}
		  peerWidth={props.game_tech_peer_width}
		  peerRowGap={props.game_tech_peer_row_gap}
		/>
		<lobby_chrome_frame_detail.GameTechTallPanel
		  key="game-tech-tall"
		  show={props.show_game_tech_tall}
		  state={props.game_tech}
		  x={props.game_tech_tall_x}
		  y={props.game_tech_tall_y}
		  width={props.game_tech_tall_width}
		  height={props.game_tech_tall_height}
		/>
		<lobby_chrome_frame_detail.AbsoluteChromeButton
		  key="game-select-create"
		  id="lobby.game_select.create"
		  label="Create Game"
		  show={props.show_game_select_create}
		  x={props.game_select_create_x}
		  y={props.game_select_create_y}
		  width={props.game_select_create_width}
		  height={props.game_select_create_height}
		/>
		<lobby_chrome_frame_detail.AbsoluteChromeButton
		  key="game-select-spectate"
		  id="lobby.game_select.spectate"
		  label="Spectate"
		  show={props.show_game_select_spectate}
		  x={props.game_select_spectate_x}
		  y={props.game_select_spectate_y}
		  width={props.game_select_action_width}
		  height={props.game_select_action_height}
		/>
		<lobby_chrome_frame_detail.AbsoluteChromeButton
		  key="game-select-join"
		  id="lobby.game_select.join"
		  label="Join Game"
		  show={props.show_game_select_join}
		  x={props.game_select_join_x}
		  y={props.game_select_join_y}
		  width={props.game_select_action_width}
		  height={props.game_select_action_height}
		/>
	</Box>
}

}  // namespace lobby
}  // namespace client_ui
}  // namespace silencer

struct ChatPanelViewProps {
	const char * key = nullptr;
	bool show = false;
	const ChatPanelState * state = nullptr;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement ChatPanelView(const ChatPanelViewProps& props) {
	if(!props.show || !props.state || props.width <= 0 || props.height <= 0){
		return ::ui::empty();
	}
	const ChatPanelLayoutMetrics metrics = ResolveChatPanelLayout(
		static_cast<Uint16>(props.width),
		static_cast<Uint16>(props.height));
	const int caret = static_cast<int>(std::strlen(props.state->inputBuffer));
	return <Box
	  key={props.key}
	  id="ChatPanelContent"
	  layout={character_root_layout(props.x, props.y, props.width, props.height)}
	>
		<Box
		  key="content"
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Column,
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::percent(100.0f),
				.padding = {
					static_cast<float>(metrics.rootPadX),
					static_cast<float>(metrics.rootPadX),
					static_cast<float>(metrics.rootPadTop),
					static_cast<float>(metrics.rootPadBottom),
				},
				.overflow = ::ui::Overflow::Hidden,
			}}
		>
			<Text
			  key="channel"
			  id="ChatChannelRow"
			  value={props.state->channel.c_str()}
			  layout={::ui::LayoutStyle{
					.width = ::ui::Length::percent(100.0f),
					.height = ::ui::Length::points(static_cast<float>(metrics.channelHeight)),
				}}
			  style={text_patch(134, 8, 13.0f)}
			/>
			<Box
			  key="main-border"
			  id="ChatMainBorder"
			  layout={::ui::LayoutStyle{
					.direction = ::ui::FlexDirection::Row,
					.width = ::ui::Length::percent(100.0f),
					.height = ::ui::Length::grow(1.0f),
					.padding = {
						static_cast<float>(metrics.bodyPadLeft),
						static_cast<float>(metrics.bodyPadRight),
						static_cast<float>(metrics.bodyPadTop),
						static_cast<float>(metrics.bodyPadBottom),
					},
					.gap = static_cast<float>(metrics.bodyGap),
					.overflow = ::ui::Overflow::Hidden,
				}}
			  style={inset_border_patch()}
			>
				<Box
				  key="chat"
				  id="ChatBoxWrap"
				  layout={::ui::LayoutStyle{
						.position = ::ui::PositionType::Relative,
						.width = ::ui::Length::points(static_cast<float>(metrics.chatWidth)),
						.height = ::ui::Length::points(static_cast<float>(metrics.chatHeight)),
						.overflow = ::ui::Overflow::Hidden,
					}}
				>
					<ChatLineSlots
					  key="chat-lines"
					  state={props.state}
					  width={metrics.chatWidth}
					  height={metrics.chatHeight}
					/>
				</Box>
				<Box
				  key="presence"
				  id="ChatPresWrap"
				  layout={::ui::LayoutStyle{
						.position = ::ui::PositionType::Relative,
						.width = ::ui::Length::points(static_cast<float>(metrics.presenceWidth)),
						.height = ::ui::Length::points(static_cast<float>(metrics.presenceHeight)),
						.overflow = ::ui::Overflow::Hidden,
						.display = metrics.presenceWidth > 0 ? ::ui::Display::Flex : ::ui::Display::None,
					}}
				>
					<PresenceLineSlots
					  key="presence-lines"
					  state={props.state}
					  width={metrics.presenceWidth}
					  height={metrics.presenceHeight}
					/>
				</Box>
			</Box>
			<Box
			  key="input-gap"
			  layout={::ui::LayoutStyle{
					.width = ::ui::Length::points(1.0f),
					.height = ::ui::Length::points(static_cast<float>(metrics.mainGap)),
				}}
			/>
			<Box
			  key="input-border"
			  id="ChatInputBorder"
			  layout={::ui::LayoutStyle{
					.width = ::ui::Length::percent(100.0f),
					.height = ::ui::Length::points(static_cast<float>(metrics.inputBorderHeight)),
					.padding = {
						static_cast<float>(metrics.inputPadX),
						static_cast<float>(metrics.inputPadX),
						static_cast<float>(metrics.inputPadTop),
						static_cast<float>(metrics.inputPadBottom),
					},
				}}
			  style={inset_border_patch()}
			>
				<TextInput
				  key="input"
				  id={kChatInputAction}
				  idOffset={kChatInputUid}
				  accessibility={{.label = "Chat"}}
				  value={props.state->inputBuffer}
				  textEdit={::ui::TextEditMetadata{
						.caret = caret,
						.selection_start = caret,
						.selection_end = caret,
					}}
				  layout={::ui::LayoutStyle{
						.width = ::ui::Length::points(static_cast<float>(metrics.inputWidth)),
						.height = ::ui::Length::points(static_cast<float>(metrics.inputHeight)),
						.padding = {3.0f, 3.0f, 1.0f, 1.0f},
					}}
				  style={chat_input_patch()}
				/>
			</Box>
		</Box>
	</Box>
}

struct GameCreateOptionValueProps {
	const char * key = nullptr;
	const GameCreatePanelState * state = nullptr;
	int row = 0;
	int x = 0;
	int width = 0;
};

::ui::UiElement GameCreateOptionValue(const GameCreateOptionValueProps& props) {
	if(!props.state) return ::ui::empty();
	const char * action_id = game_create_option_action_id(props.row);
	const char * label = game_create_option_accessibility_label(props.row);
	const char * value = game_create_option_value(*props.state, props.row);
	if(game_create_option_is_text_input(props.row)){
		const int caret = static_cast<int>(std::strlen(value));
		const int input_width = clamp_int(props.width, 20, 28);
		return <TextInput
		  key={props.key}
		  id={action_id}
		  accessibility={{.label = label}}
		  value={value}
		  textEdit={::ui::TextEditMetadata{
				.caret = caret,
				.selection_start = caret,
				.selection_end = caret,
			}}
		  layout={absolute_layout(props.x, 0, input_width, kGameCreateFormRowH)}
		  style={game_create_text_input_patch()}
		/>
	}
	const bool selected = props.row == 5 && props.state->spectatable;
	return <component_detail.Host
	  kind={::ui::HostKind::Button}
	  key={props.key}
	  id={action_id}
	  style={absolute_layout(props.x, 0, props.width, kGameCreateFormRowH)}
	  visual={game_create_inline_control_visual(selected)}
	  text={::ui::HostTextProps{.value = value}}
	  interaction={::ui::NodeInteraction{.focusable = true, .checked = selected}}
	  accessibility={{.role = props.row == 5 ? ::ui::SemanticRole::Checkbox : ::ui::SemanticRole::Button, .label = label}}
	>
		<Text
		  key="label"
		  value={value}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::points(static_cast<float>(kGameCreateFormRowH)),
				.padding = {2.0f, 2.0f, 1.0f, 1.0f},
			}}
		  style={text_patch(133, 6, 11.0f)}
		/>
	</component_detail.Host>
}

struct GameCreateOptionRowProps {
	const char * key = nullptr;
	const GameCreatePanelState * state = nullptr;
	GameCreateOptionsLayout layout_metrics = {};
	int row = 0;
	int width = 0;
};

::ui::UiElement GameCreateOptionRow(const GameCreateOptionRowProps& props) {
	if(!props.state || props.row < 0 || props.row >= kGameCreateOptionRowSlots){
		return ::ui::empty();
	}
	const int first_row = static_cast<int>(props.state->optionsScrollPosition);
	const int visible_rows = static_cast<int>(props.layout_metrics.visibleRows);
	const int last_row = first_row + visible_rows;
	if(props.row < first_row || props.row >= last_row){
		return ::ui::empty();
	}
	const int slot = props.row - first_row;
	const int y = slot * (kGameCreateFormRowH + kGameCreateFormRowGap);
	const int value_width = static_cast<int>(props.layout_metrics.valueColumnWidth);
	const int value_x = std::max(0, props.width - value_width);
	const int label_width =
		std::max(0, value_x - kGameCreateFormColumnGap);
	return <Box
	  key={props.key}
	  id="GameCreateOptionRow"
	  idOffset={props.row}
	  layout={absolute_layout(0, y, props.width, kGameCreateFormRowH)}
	>
		<Text
		  key="label"
		  value={game_create_option_label(props.row)}
		  layout={absolute_layout(0, 0, label_width, kGameCreateFormRowH)}
		  style={text_patch(133, 6, 11.0f)}
		/>
		<GameCreateOptionValue
		  key="value"
		  state={props.state}
		  row={props.row}
		  x={value_x}
		  width={value_width}
		/>
	</Box>
}

struct GameCreateOptionRowsProps {
	const char * key = nullptr;
	const GameCreatePanelState * state = nullptr;
	GameCreateOptionsLayout layout_metrics = {};
	int width = 0;
	int height = 0;
};

::ui::UiElement GameCreateOptionRows(const GameCreateOptionRowsProps& props) {
	return <Box key={props.key} layout={absolute_layout(0, 0, props.width, props.height)}>
		<GameCreateOptionRow

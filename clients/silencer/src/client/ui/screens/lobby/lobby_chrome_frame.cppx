inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch chrome_border_patch() {
	return ::ui::patch().border(::ui::Border{
		{1.0f, 1.0f, 1.0f, 1.0f},
		{{216, 0, 0, 255}, {216, 0, 0, 255},
		 {216, 0, 0, 255}, {216, 0, 0, 255}},
	});
}

inline ::ui::StylePatch chrome_border_sides_patch(std::uint8_t sides) {
	const ::ui::Color chrome = {216, 0, 0, 255};
	return ::ui::patch().border(::ui::Border{
		{
			(sides & kChromeSideTop) ? 1.0f : 0.0f,
			(sides & kChromeSideRight) ? 1.0f : 0.0f,
			(sides & kChromeSideBottom) ? 1.0f : 0.0f,
			(sides & kChromeSideLeft) ? 1.0f : 0.0f,
		},
		{
			(sides & kChromeSideTop) ? chrome : ::ui::Color{},
			(sides & kChromeSideRight) ? chrome : ::ui::Color{},
			(sides & kChromeSideBottom) ? chrome : ::ui::Color{},
			(sides & kChromeSideLeft) ? chrome : ::ui::Color{},
		},
	});
}

inline ::ui::StylePatch title_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {152, 0, 0, 255},
		.font_id = 135,
		.font_size = 11,
	});
}

inline ::ui::StylePatch version_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {189, 0, 0, 255},
		.font_id = 133,
		.font_size = 6,
	});
}

inline ::ui::StylePatch map_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {129, 0, 0, 255},
		.font_id = 135,
		.font_size = 11,
	});
}

inline ::ui::StyleStatePatch chrome_button_patch() {
	::ui::StyleStatePatch patch{};
	patch.base = ::ui::patch()
		.image(::ui::BackgroundImage{
			.texture_id = texture_id(7, 24),
			.tint = {255, 255, 255, 255},
		})
		.text(::ui::TextVisual{
			.color = {0, 0, 0, 255},
			.font_id = 134,
			.font_size = 8,
			.align = ::ui::TextAlign::Center,
	});
	patch.hover = patch.base;
	patch.focus_visible = patch.base;
	patch.pressed = patch.base;
	return patch;
}

inline ::ui::EdgeSizes absolute_inset(float left, float top) {
	::ui::EdgeSizes inset;
	inset.left = ::ui::StyleValue::points(left);
	inset.top = ::ui::StyleValue::points(top);
	return inset;
}

inline ::ui::LayoutStyle title_layout(const LobbyChromeFrameProps& props) {
	return {
		.position = ::ui::PositionType::Absolute,
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(static_cast<float>(props.width)),
		.height = ::ui::Length::points(static_cast<float>(props.height)),
		.padding = {static_cast<float>(props.pad_x),
		            static_cast<float>(props.pad_x),
		            4.0f,
		            4.0f},
		.gap = static_cast<float>(props.row_gap),
		.position_inset = absolute_inset(
			static_cast<float>(props.x),
			static_cast<float>(props.y)),
	};
}

inline ::ui::LayoutStyle text_slot(float width) {
	return {
		.width = width > 0.0f ? ::ui::Length::points(width) : ::ui::Length::auto_size(),
		.height = ::ui::Length::points(21.0f),
	};
}

inline ::ui::LayoutStyle absolute_layout(int x,
                                         int y,
                                         int width,
                                         int height) {
	return {
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::points(static_cast<float>(width)),
		.height = ::ui::Length::points(static_cast<float>(height)),
		.position_inset = absolute_inset(
			static_cast<float>(x),
			static_cast<float>(y)),
	};
}

inline ::ui::LayoutStyle absolute_button_layout(int x,
                                                int y,
                                                int width,
                                                int height) {
	return {
		.position = ::ui::PositionType::Absolute,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(static_cast<float>(width)),
		.height = ::ui::Length::points(static_cast<float>(height)),
		.padding = {8.0f, 8.0f, 4.0f, 4.0f},
		.position_inset = absolute_inset(
			static_cast<float>(x),
			static_cast<float>(y)),
	};
}

inline ::ui::StylePatch text_patch(std::uint16_t font_id,
                                   std::uint16_t font_size,
                                   float line_height,
                                   ::ui::TextAlign align = ::ui::TextAlign::Left) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {0, 0, 0, 255},
		.font_id = font_id,
		.font_size = font_size,
		.align = align,
		.line_height = line_height,
	});
}

inline ::ui::StylePatch inset_border_patch() {
	return ::ui::patch().border(::ui::Border{
		{1.0f, 1.0f, 1.0f, 1.0f},
		{{220, 0, 0, 255}, {220, 0, 0, 255},
		 {220, 0, 0, 255}, {220, 0, 0, 255}},
	});
}

inline ::ui::StylePatch sprite_patch(std::uint8_t bank, std::uint16_t index) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(bank, index),
		.tint = {255, 255, 255, 255},
	});
}

inline ::ui::StylePatch raw_bitmap_patch(const std::uint8_t * pixels,
                                         int width,
                                         int height) {
	return ::ui::patch().bitmap(::ui::RawBitmapImage{
		.pixels = pixels,
		.width = static_cast<std::uint16_t>(std::max(0, width)),
		.height = static_cast<std::uint16_t>(std::max(0, height)),
	});
}

inline ::ui::VisualStyle sprite_visual(std::uint8_t bank, std::uint16_t index) {
	::ui::VisualStyle visual{};
	visual.image = ::ui::BackgroundImage{
		.texture_id = texture_id(bank, index),
		.tint = {255, 255, 255, 255},
	};
	return visual;
}

inline ::ui::StylePatch level_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {kGameJoinRosterLevelColor, 0, 0, 255},
		.font_id = 132,
		.font_size = 4,
		.line_height = 5.0f,
	});
}

inline ::ui::StylePatch palette_text_patch(std::uint8_t palette,
                                           std::uint16_t font_id,
                                           std::uint16_t font_size,
                                           float line_height,
                                           ::ui::TextAlign align = ::ui::TextAlign::Left,
                                           std::uint8_t alpha = 255) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {palette, 0, 0, alpha},
		.font_id = font_id,
		.font_size = font_size,
		.align = align,
		.line_height = line_height,
	});
}

inline ::ui::VisualStyle row_visual(bool selected) {
	::ui::VisualStyle visual{};
	visual.background = selected
		? ::ui::Color{180, 0, 0, 255}
		: ::ui::Color{0, 0, 0, 0};
	visual.text = ::ui::TextVisual{
		.color = {0, 0, 0, 255},
		.font_id = 133,
		.font_size = 6,
		.line_height = 11.0f,
	};
	return visual;
}

struct GameSelectTallLayout {
	int list_box_x = 0;
	int list_box_y = 0;
	int list_box_w = 0;
	int list_box_h = 0;
	int list_x = 0;
	int list_y = 0;
	int list_w = 0;
	int list_h = 0;
	int visible_rows = 0;
	int info_y = 0;
};

inline GameSelectTallLayout resolve_game_select_tall_layout(int width,
                                                            int height) {
	GameSelectTallLayout out;
	const int titleWrapH = kGameSelectHeadingPadTop + kGameSelectHeadingLineH;
	const int infoH = 5 * kGameSelectInfoRowH;
	const int footerH =
		kGameSelectFooterPadTop
		+ infoH
		+ kGameSelectFooterGap
		+ kGameSelectButtonRowH
		+ kGameSelectButtonGap
		+ kGameSelectButtonRowH;
	out.list_box_x = kGameSelectListPadLeft;
	out.list_box_y = titleWrapH + kGameSelectListPadTop;
	out.list_box_w = std::max(0, width - kGameSelectListPadLeft * 2);
	out.list_box_h = std::max(0, height - titleWrapH - kGameSelectListPadTop - footerH);
	out.list_x = out.list_box_x + kGameSelectListBorderPad;
	out.list_y = out.list_box_y + kGameSelectListBorderPad;
	out.list_w = std::max(0, out.list_box_w - kGameSelectListBorderPad * 2);
	out.list_h = std::max(0, out.list_box_h - kGameSelectListBorderPad * 2);
	out.visible_rows = std::min(kGameSelectRowSlots, out.list_h / kGameSelectListLineH);
	out.info_y = height - footerH + kGameSelectFooterPadTop;
	return out;
}

inline const char * copied_row_id(int source) {
	std::string value =
		std::string(kGameSelectRowActionPrefix) + "." + std::to_string(source);
	return ::ui::copy_string(value.c_str());
}

inline const char * copied_prefixed_id(const char * prefix, int value) {
	std::string id = std::string(prefix) + std::to_string(value);
	return ::ui::copy_string(id.c_str());
}

inline int split_line_count(const char * text) {
	if(!text || !*text) return 0;
	int count = 1;
	for(const char * p = text; *p; ++p){
		if(*p == '\n') ++count;
	}
	return count;
}

inline const char * copied_split_line(const char * text, int index) {
	if(!text || index < 0) return "";
	int current = 0;
	const char * lineStart = text;
	for(const char * p = text;; ++p){
		if(*p != '\n' && *p != '\0') continue;
		if(current == index){
			std::string value(lineStart, static_cast<size_t>(p - lineStart));
			return ::ui::copy_string(value.c_str());
		}
		if(*p == '\0') break;
		++current;
		lineStart = p + 1;
	}
	return "";
}

inline int clamp_int(int value, int lo, int hi) {
	if(value < lo) return lo;
	if(value > hi) return hi;
	return value;
}

inline int text_width(const std::string& value, int advance) {
	return static_cast<int>(value.size()) * advance;
}

inline const char * fit_middle_ellipsis(const std::string& text,
                                        int available_px,
                                        int advance) {
	const int max_chars = advance > 0 ? available_px / advance : 0;
	if(max_chars <= 0) return "";
	if(static_cast<int>(text.size()) <= max_chars) return text.c_str();
	if(max_chars <= 3){
		return ::ui::copy_string(
			text.substr(0, static_cast<size_t>(max_chars)).c_str());
	}
	const int kept = max_chars - 3;
	const int front = (kept + 1) / 2;
	const int back = kept - front;
	const std::string value =
		text.substr(0, static_cast<size_t>(front)) + "..." +
		text.substr(text.size() - static_cast<size_t>(back));
	return ::ui::copy_string(value.c_str());
}

inline int character_upgrade_value_width(const CharacterPanelState& state) {
	int width = text_width(state.endurance, kCharacterBodyAdvance);
	width = std::max(width, text_width(state.shield, kCharacterBodyAdvance));
	width = std::max(width, text_width(state.jetpack, kCharacterBodyAdvance));
	width = std::max(width, text_width(state.techslots, kCharacterBodyAdvance));
	width = std::max(width, text_width(state.hacking, kCharacterBodyAdvance));
	width = std::max(width, text_width(state.contacts, kCharacterBodyAdvance));
	return std::max(width + 4, kCharacterUpgradeValueColumnMinW);
}

inline ::ui::LayoutStyle character_root_layout(int x,
                                               int y,
                                               int width,
                                               int height) {
	::ui::LayoutStyle layout = absolute_layout(x, y, width, height);
	layout.overflow = ::ui::Overflow::Hidden;
	return layout;
}

inline ::ui::LayoutStyle flex_row_layout(float width,
                                         float height,
                                         float gap = 0.0f) {
	return {
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.width = width > 0.0f ? ::ui::Length::points(width) : ::ui::Length::auto_size(),
		.height = height > 0.0f ? ::ui::Length::points(height) : ::ui::Length::auto_size(),
		.gap = gap,
	};
}

inline ::ui::LayoutStyle flex_column_layout(float width,
                                            float height,
                                            float gap = 0.0f) {
	return {
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Start,
		.width = width > 0.0f ? ::ui::Length::points(width) : ::ui::Length::auto_size(),
		.height = height > 0.0f ? ::ui::Length::points(height) : ::ui::Length::auto_size(),
		.gap = gap,
	};
}

inline int max_scroll_for_line_count(int line_count,
                                     int line_height,
                                     int height) {
	if(line_height <= 0) return 0;
	const int visible = height / line_height;
	const int max_scroll = line_count - visible;
	return max_scroll > 0 ? max_scroll : 0;
}

inline int visible_chat_start(int line_count,
                              int visible_slots,
                              int scroll_position,
                              int height) {
	if(line_count <= 0 || visible_slots <= 0) return 0;
	const int max_scroll =
		max_scroll_for_line_count(line_count, kChatLineH, height);
	const int clamped_scroll = clamp_int(scroll_position, 0, max_scroll);
	const int start = line_count - visible_slots - (max_scroll - clamped_scroll);
	return clamp_int(start, 0, std::max(0, line_count - visible_slots));
}

inline std::uint8_t line_alpha(std::uint8_t brightness) {
	if(brightness >= 128) return 255;
	return static_cast<std::uint8_t>(
		clamp_int(static_cast<int>(brightness) * 2, 96, 255));
}

inline ::ui::StylePatch chat_input_patch() {
	return ::ui::patch()
		.border(::ui::Border{
			{1.0f, 1.0f, 1.0f, 1.0f},
			{{216, 0, 0, 255}, {216, 0, 0, 255},
			 {216, 0, 0, 255}, {216, 0, 0, 255}},
		})
		.text(::ui::TextVisual{
			.color = {0, 0, 0, 255},
			.font_id = 133,
			.font_size = 6,
			.line_height = 11.0f,
		});
}

inline const char * game_select_info_value(const GameSelectPanelState& state,
                                           int index) {
	switch(index){
		case 0: return state.infoName.c_str();
		case 1: return state.infoMap.c_str();
		case 2: return state.infoSecurity.c_str();
		case 3: return state.infoCreator.c_str();
		case 4: return state.infoLimits.c_str();
	}
	return "";
}

inline const char * game_create_security_label(std::uint8_t index) {
	switch(index){
		case 0: return "Off";
		case 1: return "Low";
		case 3: return "High";
		default: return "Medium";
	}
}

inline const char * game_create_option_label(int row) {
	switch(row){
		case 0: return "Security:";
		case 1: return "Min Level:";
		case 2: return "Max Level:";
		case 3: return "Max Players:";
		case 4: return "Max Teams:";
		case 5: return "Spectatable:";
	}
	return "";
}

inline const char * game_create_option_accessibility_label(int row) {
	switch(row){
		case 0: return "Security";
		case 1: return "Min Level";
		case 2: return "Max Level";
		case 3: return "Max Players";
		case 4: return "Max Teams";
		case 5: return "Spectatable";
	}
	return "";
}

inline const char * game_create_option_action_id(int row) {
	switch(row){
		case 0: return kGameCreateSecurityAction;
		case 1: return kGameCreateMinLevelAction;
		case 2: return kGameCreateMaxLevelAction;
		case 3: return kGameCreateMaxPlayersAction;
		case 4: return kGameCreateMaxTeamsAction;
		case 5: return kGameCreateSpectatableAction;
	}
	return "";
}

inline const char * game_create_option_value(const GameCreatePanelState& state,
                                             int row) {
	switch(row){
		case 0: return game_create_security_label(state.securityIndex);
		case 1: return state.minLevel;
		case 2: return state.maxLevel;
		case 3: return state.maxPlayers;
		case 4: return state.maxTeams;
		case 5: return state.spectatable ? "Yes" : "No";
	}
	return "";
}

inline bool game_create_option_is_text_input(int row) {
	return row >= 1 && row <= 4;
}

inline ::ui::VisualStyle game_create_inline_control_visual(bool selected) {
	::ui::VisualStyle visual{};
	visual.background = selected
		? ::ui::Color{180, 0, 0, 72}
		: ::ui::Color{0, 0, 0, 0};
	return visual;
}

inline ::ui::StyleStatePatch game_create_text_input_patch() {
	return ::ui::patch()
		.border(::ui::Border{
			{1.0f, 1.0f, 1.0f, 1.0f},
			{{216, 0, 0, 255}, {216, 0, 0, 255},
			 {216, 0, 0, 255}, {216, 0, 0, 255}},
		})
		.text(::ui::TextVisual{
			.color = {0, 0, 0, 255},
			.font_id = 133,
			.font_size = 6,
			.line_height = 11.0f,
		});
}

inline ::ui::StyleStatePatch game_create_scrollbar_thumb_patch() {
	return ::ui::patch().background({216, 0, 0, 255});
}

inline const char * game_create_map_label(const std::string& raw) {
	if(raw.size() >= 5 && std::memcmp(raw.c_str(), "[DL] ", 5) == 0){
		return raw.c_str() + 5;
	}
	return raw.c_str();
}

inline const char * copied_game_create_map_id(int source) {
	return copied_prefixed_id(kGameCreateMapActionPrefix, source);
}

inline int game_create_map_scroll_max(const GameCreatePanelState& state,
                                      const GameCreateTallLayout& layout) {
	const int visible_rows = static_cast<int>(layout.visibleMapRows);
	if(visible_rows <= 0) return 0;
	const int max_scroll = static_cast<int>(state.maps.size()) - visible_rows;
	return max_scroll > 0 ? max_scroll : 0;
}

inline bool game_create_map_show_scrollbar(const GameCreatePanelState& state,
                                           const GameCreateTallLayout& layout) {
	return game_create_map_scroll_max(state, layout) > 0;
}

inline int game_create_map_rows_width(const GameCreatePanelState& state,
                                      const GameCreateTallLayout& layout) {
	int width = static_cast<int>(layout.listWidth);
	if(game_create_map_show_scrollbar(state, layout)){
		width -= kGameCreateMapScrollbarWidth;
	}
	return std::max(0, width);
}

inline const char * game_create_password_display(const GameCreatePanelState& state) {
	const std::string masked(std::strlen(state.password), '*');
	return ::ui::copy_string(masked.c_str());
}

struct AbsoluteChromeButtonProps {
	const char * key = nullptr;
	const char * id = nullptr;
	const char * label = nullptr;
	bool show = false;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
	std::function<void()> on_press = {};
};

::ui::UiElement AbsoluteChromeButton(const AbsoluteChromeButtonProps& props) {
	if(!props.show) return ::ui::empty();
	std::function<void(const ::ui::ActivationEvent&)> on_activate = {};
	if(props.on_press){
		on_activate = [on_press = props.on_press](const ::ui::ActivationEvent&) {
			on_press();
		};
	}
	return <Button
	  key={props.key}
	  id={props.id}
	  label={props.label}
	  accessibility={{.label = props.label}}
	  onActivate={on_activate}
	  layout={absolute_button_layout(props.x, props.y, props.width, props.height)}
	  style={chrome_button_patch()}
	/>
}

struct LobbyPanelChromeProps {
	const char * key = nullptr;
	bool show = false;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
	std::uint8_t sides = kChromeSideAll;
};

::ui::UiElement LobbyPanelChrome(const LobbyPanelChromeProps& props) {
	if(!props.show || props.width <= 0 || props.height <= 0){
		return ::ui::empty();
	}
	return <Box
	  key={props.key}
	  layout={absolute_layout(props.x, props.y, props.width, props.height)}
	  style={chrome_border_sides_patch(props.sides)}
	/>
}


	  key={props.key}
	  layout={::ui::LayoutStyle{
			.direction = ::ui::FlexDirection::Column,
			.width = ::ui::Length::points(static_cast<float>(kGameCreateScrollbarWidth)),
			.height = ::ui::Length::points(static_cast<float>(props.layout_metrics.viewportHeight)),
			.padding = {
				static_cast<float>(kGameCreateScrollbarTrackPad),
				static_cast<float>(kGameCreateScrollbarTrackPad),
				static_cast<float>(kGameCreateScrollbarTrackPad),

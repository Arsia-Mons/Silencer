struct GameCreateUpperPanelProps {
	const char * key = nullptr;
	bool show = false;
	const GameCreatePanelState * state = nullptr;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement GameCreateUpperPanel(const GameCreateUpperPanelProps& props) {
	if(!props.show || !props.state || props.width <= 0 || props.height <= 0){
		return ::ui::empty();
	}
	const GameCreateOptionsLayout layout =
		ResolveGameCreateOptionsLayout(
			static_cast<Uint16>(props.width),
			static_cast<Uint16>(props.height));
	const GameCreateOptionsScrollbarLayout scrollbar =
		ResolveGameCreateOptionsScrollbarLayout(layout, *props.state);
	const int content_width =
		std::max(0, props.width - kGameCreatePanelPad * 2);
	const int form_width =
		layout.showScrollbar
			? std::max(0, content_width - kGameCreateScrollbarWidth - kGameCreateScrollbarGap)
			: content_width;
	return <Box
	  key={props.key}
	  id="GameCreateOptionsContent"
	  layout={character_root_layout(props.x, props.y, props.width, props.height)}
	>
		<Box
		  key="content"
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Column,
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::percent(100.0f),
				.padding = {
					static_cast<float>(kGameCreatePanelPad),
					static_cast<float>(kGameCreatePanelPad),
					static_cast<float>(kGameCreatePanelPad),
					static_cast<float>(kGameCreatePanelPad),
				},
				.gap = static_cast<float>(kGameCreateFormRowGap),
				.overflow = ::ui::Overflow::Hidden,
			}}
		>
			<Text
			  key="heading"
			  value="Game Options"
			  layout={::ui::LayoutStyle{
					.width = ::ui::Length::percent(100.0f),
					.height = ::ui::Length::points(static_cast<float>(layout.titleHeight)),
				}}
			  style={text_patch(134, 8, 13.0f)}
			/>
			<Box
			  key="form-border"
			  id="GameCreateOptionsFormBorder"
			  layout={::ui::LayoutStyle{
					.direction = ::ui::FlexDirection::Row,
					.width = ::ui::Length::percent(100.0f),
					.height = ::ui::Length::grow(1.0f),
					.padding = {
						static_cast<float>(kGameCreateFormPadLeft),
						static_cast<float>(kGameCreateFormPadLeft),
						static_cast<float>(kGameCreateFormPadTop),
						static_cast<float>(kGameCreateFormPadBottom),
					},
					.gap = static_cast<float>(kGameCreateScrollbarGap),
					.overflow = ::ui::Overflow::Hidden,
				}}
			  style={inset_border_patch()}
			>
				<component_detail.Host
				  kind={::ui::HostKind::Box}
				  key="viewport"
				  id={kGameCreateOptionsScrollId}
				  style={::ui::LayoutStyle{
						.position = ::ui::PositionType::Relative,
						.width = ::ui::Length::points(static_cast<float>(form_width)),
						.height = ::ui::Length::points(static_cast<float>(layout.viewportHeight)),
						.overflow = ::ui::Overflow::Hidden,
					}}
				  text={::ui::HostTextProps{.value = "scroll"}}
				  accessibility={{.label = kGameCreateOptionsScrollLabel}}
				>
					<GameCreateOptionRows
					  key="rows"
					  state={props.state}
					  layoutMetrics={layout}
					  width={form_width}
					  height={layout.viewportHeight}
					/>
				</component_detail.Host>
				<GameCreateOptionsScrollbar
				  key="scrollbar"
				  show={layout.showScrollbar}
				  layoutMetrics={layout}
				  scrollbar={scrollbar}
				/>
			</Box>
		</Box>
	</Box>
}

struct GameCreateMapRowProps {
	const char * key = nullptr;
	const GameCreatePanelState * state = nullptr;
	GameCreateTallLayout layout = {};
	int visible_row = 0;
};

::ui::UiElement GameCreateMapRow(const GameCreateMapRowProps& props) {
	if(!props.state || props.visible_row < 0 ||
	   props.visible_row >= static_cast<int>(props.layout.visibleMapRows)){
		return ::ui::empty();
	}
	const int source = static_cast<int>(props.state->mapScrollPos) + props.visible_row;
	if(source < 0 || source >= static_cast<int>(props.state->maps.size())){
		return ::ui::empty();
	}
	const std::string& raw = props.state->maps[static_cast<size_t>(source)];
	const char * label = game_create_map_label(raw);
	const bool selected = source == props.state->mapSelectedIndex;
	const int rows_width =
		game_create_map_rows_width(*props.state, props.layout);
	return <component_detail.Host
	  kind={::ui::HostKind::Button}
	  key={props.key}
	  id={copied_game_create_map_id(source)}
	  idOffset={source + 1}
	  style={absolute_layout(0, props.visible_row * kGameCreateMapLineH, rows_width, kGameCreateMapLineH)}
	  visual={row_visual(selected)}
	  interaction={::ui::NodeInteraction{
			.focusable = true,
			.checked = selected,
		}}
	  accessibility={{.role = ::ui::SemanticRole::ListRow, .label = label}}
	>
		<Text
		  key="label"
		  value={label}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::points(11.0f),
				.padding = {4.0f, 6.0f, 1.0f, 0.0f},
			}}
		  style={text_patch(133, 6, 11.0f)}
		/>
	</component_detail.Host>
}


inline ::ui::VisualStyle row_visual(bool selected) {
	::ui::VisualStyle visual{};
	visual.background = selected
		? ::ui::Color{180, 0, 0, 255}
		: ::ui::Color{0, 0, 0, 0};
	visual.text = ::ui::TextVisual{
		.color = {0, 0, 0, 255},
		.font_id = 133,
		.font_size = 6,
		.line_height = 11.0f,
	};
	return visual;
}

struct GameSelectTallLayout {
	int list_box_x = 0;
	int list_box_y = 0;
	int list_box_w = 0;
	int list_box_h = 0;
	int list_x = 0;
	int list_y = 0;
	int list_w = 0;
	int list_h = 0;
	int visible_rows = 0;
	int info_y = 0;
};

inline GameSelectTallLayout resolve_game_select_tall_layout(int width,
                                                            int height) {
	GameSelectTallLayout out;
	const int titleWrapH = kGameSelectHeadingPadTop + kGameSelectHeadingLineH;
	const int infoH = 5 * kGameSelectInfoRowH;
	const int footerH =
		kGameSelectFooterPadTop
		+ infoH
		+ kGameSelectFooterGap
		+ kGameSelectButtonRowH
		+ kGameSelectButtonGap
		+ kGameSelectButtonRowH;
	out.list_box_x = kGameSelectListPadLeft;
	out.list_box_y = titleWrapH + kGameSelectListPadTop;
	out.list_box_w = std::max(0, width - kGameSelectListPadLeft * 2);
	out.list_box_h = std::max(0, height - titleWrapH - kGameSelectListPadTop - footerH);
	out.list_x = out.list_box_x + kGameSelectListBorderPad;
	out.list_y = out.list_box_y + kGameSelectListBorderPad;
	out.list_w = std::max(0, out.list_box_w - kGameSelectListBorderPad * 2);
	out.list_h = std::max(0, out.list_box_h - kGameSelectListBorderPad * 2);
	out.visible_rows = std::min(kGameSelectRowSlots, out.list_h / kGameSelectListLineH);
	out.info_y = height - footerH + kGameSelectFooterPadTop;
	return out;
}

inline const char * copied_row_id(int source) {
	std::string value =
		std::string(kGameSelectRowActionPrefix) + "." + std::to_string(source);
	return ::ui::copy_string(value.c_str());
}

inline const char * copied_prefixed_id(const char * prefix, int value) {
	std::string id = std::string(prefix) + std::to_string(value);
	return ::ui::copy_string(id.c_str());
}

inline int clamp_int(int value, int lo, int hi) {
	if(value < lo) return lo;
	if(value > hi) return hi;
	return value;
}

inline int text_width(const std::string& value, int advance) {
	return static_cast<int>(value.size()) * advance;
}

inline const char * fit_middle_ellipsis(const std::string& text,
                                        int available_px,
                                        int advance) {
	const int max_chars = advance > 0 ? available_px / advance : 0;
	if(max_chars <= 0) return "";
	if(static_cast<int>(text.size()) <= max_chars) return text.c_str();
	if(max_chars <= 3){
		return ::ui::copy_string(
			text.substr(0, static_cast<size_t>(max_chars)).c_str());
	}
	const int kept = max_chars - 3;
	const int front = (kept + 1) / 2;
	const int back = kept - front;
	const std::string value =
		text.substr(0, static_cast<size_t>(front)) + "..." +
		text.substr(text.size() - static_cast<size_t>(back));
	return ::ui::copy_string(value.c_str());
}

inline int character_upgrade_value_width(const CharacterPanelState& state) {
	int width = text_width(state.endurance, kCharacterBodyAdvance);
	width = std::max(width, text_width(state.shield, kCharacterBodyAdvance));
	width = std::max(width, text_width(state.jetpack, kCharacterBodyAdvance));
	width = std::max(width, text_width(state.techslots, kCharacterBodyAdvance));
	width = std::max(width, text_width(state.hacking, kCharacterBodyAdvance));
	width = std::max(width, text_width(state.contacts, kCharacterBodyAdvance));
	return std::max(width + 4, kCharacterUpgradeValueColumnMinW);
}

inline ::ui::LayoutStyle character_root_layout(int x,
                                               int y,
                                               int width,
                                               int height) {
	::ui::LayoutStyle layout = absolute_layout(x, y, width, height);
	layout.overflow = ::ui::Overflow::Hidden;
	return layout;
}

inline ::ui::LayoutStyle flex_row_layout(float width,
                                         float height,
                                         float gap = 0.0f) {
	return {
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.width = width > 0.0f ? ::ui::Length::points(width) : ::ui::Length::auto_size(),
		.height = height > 0.0f ? ::ui::Length::points(height) : ::ui::Length::auto_size(),
		.gap = gap,
	};
}

inline ::ui::LayoutStyle flex_column_layout(float width,
                                            float height,
                                            float gap = 0.0f) {
	return {
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Start,
		.width = width > 0.0f ? ::ui::Length::points(width) : ::ui::Length::auto_size(),
		.height = height > 0.0f ? ::ui::Length::points(height) : ::ui::Length::auto_size(),
		.gap = gap,
	};
}

inline const char * game_select_info_value(const GameSelectPanelState& state,
                                           int index) {
	switch(index){
		case 0: return state.infoName.c_str();
		case 1: return state.infoMap.c_str();
		case 2: return state.infoSecurity.c_str();
		case 3: return state.infoCreator.c_str();
		case 4: return state.infoLimits.c_str();
	}
	return "";
}

struct AbsoluteChromeButtonProps {
	const char * key = nullptr;
	const char * id = nullptr;
	const char * label = nullptr;
	bool show = false;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement AbsoluteChromeButton(const AbsoluteChromeButtonProps& props) {
	if(!props.show) return ::ui::empty();
	return <Button
	  key={props.key}
	  id={props.id}
	  label={props.label}
	  accessibility={{.label = props.label}}
	  layout={absolute_button_layout(props.x, props.y, props.width, props.height)}
	  style={chrome_button_patch()}
	/>
}

struct CharacterStatRowProps {
	const char * key = nullptr;
	int index = 0;
	const char * label = nullptr;
	const char * value = nullptr;
	int label_width = 0;
};

::ui::UiElement CharacterStatRow(const CharacterStatRowProps& props) {
	return <Box
	  key={props.key}
	  id="CharacterPanelStatRow"
	  idOffset={props.index}
	  layout={flex_row_layout(0.0f, static_cast<float>(kCharacterBodyLineH), 8.0f)}
	>
		<Text
		  key="label"
		  value={props.label}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::points(static_cast<float>(props.label_width)),
				.height = ::ui::Length::points(static_cast<float>(kCharacterBodyLineH)),
			}}
		  style={text_patch(133, 6, 11.0f)}
		/>
		<Text
		  key="value"
		  value={props.value}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::auto_size(),
				.height = ::ui::Length::points(static_cast<float>(kCharacterBodyLineH)),
			}}
		  style={text_patch(133, 6, 11.0f)}
		/>
	</Box>
}

struct CharacterUpgradeRowProps {
	const char * key = nullptr;
	int index = 0;
	const char * label = nullptr;
	const char * value = nullptr;
	int value_width = 0;
};

::ui::UiElement CharacterUpgradeRow(const CharacterUpgradeRowProps& props) {
	return <Box
	  key={props.key}
	  id="CharacterPanelUpgradeRow"
	  idOffset={props.index}
	  layout={::ui::LayoutStyle{
			.direction = ::ui::FlexDirection::Row,
			.align_items = ::ui::AlignItems::Center,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::points(static_cast<float>(kCharacterUpgradeRowH)),
			.gap = 6.0f,
		}}
	>
		<Text
		  key="label"
		  value={props.label}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::grow(1.0f),
				.height = ::ui::Length::points(static_cast<float>(kCharacterBodyLineH)),
			}}
		  style={text_patch(133, 6, 11.0f)}
		/>
		<Text
		  key="value"
		  value={props.value}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::points(static_cast<float>(props.value_width)),
				.height = ::ui::Length::points(static_cast<float>(kCharacterBodyLineH)),
			}}
		  style={text_patch(133, 6, 11.0f, ::ui::TextAlign::Right)}
		/>
	</Box>
}

struct CharacterPanelViewProps {
	const char * key = nullptr;
	bool show = false;
	const CharacterPanelState * state = nullptr;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement CharacterPanelView(const CharacterPanelViewProps& props) {
	if(!props.show || !props.state || props.width <= 0 || props.height <= 0){
		return ::ui::empty();
	}
	const CharacterPanelState& state = *props.state;
	const int inner_width = std::max(1, props.width - kCharacterPanelPad * 2);
	const int emblem_w = clamp_int(
		inner_width * kCharacterEmblemWidthPct / 100,
		kCharacterEmblemMinW,
		kCharacterEmblemMaxW);
	const int details_width =
		std::max(0, inner_width - emblem_w - kCharacterEmblemGap);
	const int label_width =
		text_width("LOSSES", kCharacterBodyAdvance) + 4;
	const int upgrade_value_width = character_upgrade_value_width(state);
	const char * fitted_name = fit_middle_ellipsis(
		state.agentName,
		details_width,
		kCharacterHeadingAdvance);
	const std::string xp_text = "XP " + state.xp;
	const char * xp_label = ::ui::copy_string(xp_text.c_str());
	return <Box
	  key={props.key}
	  id="CharacterPanelContent"
	  layout={character_root_layout(props.x, props.y, props.width, props.height)}
	>
		<Box
		  key="content"
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Row,
				.align_items = ::ui::AlignItems::Start,
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::percent(100.0f),
				.padding = {
					static_cast<float>(kCharacterPanelPad),
					static_cast<float>(kCharacterPanelPad),
					static_cast<float>(kCharacterPanelPad),
					static_cast<float>(kCharacterPanelPad),
				},
				.gap = static_cast<float>(kCharacterEmblemGap),
				.overflow = ::ui::Overflow::Hidden,
			}}
		>
			<Box
			  key="left-rail"
			  id="CharacterPanelLeftRail"
			  layout={::ui::LayoutStyle{
					.direction = ::ui::FlexDirection::Column,
					.align_items = ::ui::AlignItems::Center,
					.width = ::ui::Length::points(static_cast<float>(emblem_w)),
					.height = ::ui::Length::auto_size(),
					.gap = 4.0f,
					.overflow = ::ui::Overflow::Hidden,
				}}
			>
				<Box
				  key="emblem"
				  id="CharacterPanelAgencyEmblem"
				  layout={::ui::LayoutStyle{
						.width = ::ui::Length::points(static_cast<float>(emblem_w)),
						.height = ::ui::Length::points(static_cast<float>(emblem_w)),
					}}
				  style={sprite_patch(kCharacterAgencySpriteBank, state.displayAgency)}
				/>
				<Text
				  key="level"
				  id="CharacterPanelLevelBadge"
				  value={state.levelLabel.c_str()}
				  layout={::ui::LayoutStyle{
						.width = ::ui::Length::points(static_cast<float>(emblem_w)),
						.height = ::ui::Length::points(static_cast<float>(kCharacterBodyLineH)),
					}}
				  style={text_patch(133, 6, 11.0f, ::ui::TextAlign::Center)}
				/>
			</Box>
			<Box
			  key="info"
			  id="CharacterPanelInfoArea"
			  layout={::ui::LayoutStyle{
					.direction = ::ui::FlexDirection::Column,
					.align_items = ::ui::AlignItems::Start,
					.width = ::ui::Length::grow(1.0f),
					.height = ::ui::Length::grow(1.0f),
					.gap = static_cast<float>(kCharacterDetailsGap),
					.overflow = ::ui::Overflow::Hidden,
				}}
			>
				<Text
				  key="name"
				  id="CharacterPanelNameHeader"
				  value={fitted_name}
				  layout={::ui::LayoutStyle{
						.width = ::ui::Length::percent(100.0f),
						.height = ::ui::Length::points(static_cast<float>(kCharacterHeadingLineH)),
					}}
				  style={palette_text_patch(kCharacterHeadingPalette, 134, 8, 13.0f)}
				/>
				<Box
				  key="details"
				  id="CharacterPanelDetailsArea"
				  layout={::ui::LayoutStyle{
						.direction = ::ui::FlexDirection::Row,
						.align_items = ::ui::AlignItems::Center,
						.width = ::ui::Length::percent(100.0f),
						.height = ::ui::Length::grow(1.0f),
						.gap = static_cast<float>(kCharacterDetailsGap),
						.overflow = ::ui::Overflow::Hidden,
					}}
				>
					<Box
					  key="stats"
					  id="CharacterPanelStatsColumn"
					  layout={::ui::LayoutStyle{
							.direction = ::ui::FlexDirection::Column,
							.align_items = ::ui::AlignItems::Start,
							.width = ::ui::Length::auto_size(),
							.height = ::ui::Length::grow(1.0f),
							.gap = static_cast<float>(kCharacterInfoGap),
							.overflow = ::ui::Overflow::Hidden,
						}}
					>
						<Box
						  key="stat-table"
						  id="CharacterPanelStatTable"
						  layout={flex_column_layout(0.0f, 0.0f, static_cast<float>(kCharacterStatRowGap))}
						>
							<CharacterStatRow
							  key="wins"
							  index={0}
							  label="WINS"
							  value={state.wins.c_str()}
							  labelWidth={label_width}
							/>
							<CharacterStatRow
							  key="losses"
							  index={1}
							  label="LOSSES"
							  value={state.losses.c_str()}
							  labelWidth={label_width}
							/>
						</Box>
						<Text
						  key="xp"
						  id="CharacterPanelXpLine"
						  value={xp_label}
						  layout={::ui::LayoutStyle{
								.width = ::ui::Length::auto_size(),
								.height = ::ui::Length::points(static_cast<float>(kCharacterBodyLineH)),
							}}
						  style={text_patch(133, 6, 11.0f)}
						/>
						<Button
						  key="agents"
						  id={kCharacterAgentsAction}
						  label="Agents"
						  disabled={state.agentSelectionLocked}
						  accessibility={{.label = "Agents"}}
						  layout={::ui::LayoutStyle{
								.align_items = ::ui::AlignItems::Center,
								.justify_content = ::ui::JustifyContent::Center,
								.width = ::ui::Length::points(static_cast<float>(kCharacterActionButtonMinW)),
								.height = ::ui::Length::points(static_cast<float>(kCharacterButtonH)),
								.padding = {12.0f, 12.0f, 4.0f, 4.0f},
							}}
						  style={chrome_button_patch()}
						/>
					</Box>
					<Box
					  key="upgrades"
					  id="CharacterPanelUpgradePanel"
					  layout={::ui::LayoutStyle{
							.direction = ::ui::FlexDirection::Column,
							.align_items = ::ui::AlignItems::Start,
							.width = ::ui::Length::grow(1.0f),
							.height = ::ui::Length::grow(1.0f),
							.padding = {
								static_cast<float>(kCharacterUpgradePanelPadX),
								static_cast<float>(kCharacterUpgradePanelPadX),
								static_cast<float>(kCharacterUpgradePanelPadY),
								static_cast<float>(kCharacterUpgradePanelPadY),
							},
							.gap = static_cast<float>(kCharacterStatRowGap),
							.overflow = ::ui::Overflow::Hidden,
						}}
					  style={inset_border_patch()}
					>
						<CharacterUpgradeRow
						  key="endurance"
						  index={10}
						  label="ENDURANCE:"
						  value={state.endurance.c_str()}
						  valueWidth={upgrade_value_width}
						/>
						<CharacterUpgradeRow
						  key="shield"
						  index={11}
						  label="SHIELD:"
						  value={state.shield.c_str()}
						  valueWidth={upgrade_value_width}
						/>
						<CharacterUpgradeRow
						  key="jetpack"
						  index={12}
						  label="JETPACK:"
						  value={state.jetpack.c_str()}
						  valueWidth={upgrade_value_width}
						/>
						<CharacterUpgradeRow
						  key="tech-slots"
						  index={13}
						  label="TECH SLOTS:"
						  value={state.techslots.c_str()}
						  valueWidth={upgrade_value_width}
						/>
						<CharacterUpgradeRow
						  key="hacking"

		<lobby_chrome_frame_detail.AbsoluteChromeButton
		  key="game-select-spectate"
		  id="lobby.game_select.spectate"
		  label="Spectate"
		  show={props.show_game_select_spectate}
		  x={props.game_select_spectate_x}
		  y={props.game_select_spectate_y}
		  width={props.game_select_action_width}
		  height={props.game_select_action_height}
		/>
		<lobby_chrome_frame_detail.AbsoluteChromeButton
		  key="game-select-join"
		  id="lobby.game_select.join"
		  label="Join Game"
		  show={props.show_game_select_join}
		  x={props.game_select_join_x}
		  y={props.game_select_join_y}
		  width={props.game_select_action_width}
		  height={props.game_select_action_height}
		/>
		<lobby_chrome_frame_detail.GameCreatePreviewOverlay
		  key="game-create-preview"
		  show={props.show_game_create_preview}
		  x={props.game_create_preview_x}
		  y={props.game_create_preview_y}
		  width={props.game_create_preview_width}
		  height={props.game_create_preview_height}
		  lineHeight={props.game_create_preview_line_height}
		  gap={props.game_create_preview_gap}
		  bitmapWidth={props.game_create_preview_bitmap_width}
		  bitmapHeight={props.game_create_preview_bitmap_height}
		  name={props.game_create_preview_name}
		  description={props.game_create_preview_description}
		  pixels={props.game_create_preview_pixels}
		/>
	</Box>
}


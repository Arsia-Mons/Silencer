		  key={kGameJoinRosterRowKeys[29]}
		  state={props.state}
		  assets={props.assets}
		  index={29}
		  width={props.width}
		  height={props.height}
		/>
		<GameJoinRosterRowView
		  key={kGameJoinRosterRowKeys[30]}
		  state={props.state}
		  assets={props.assets}
		  index={30}
		  width={props.width}
		  height={props.height}
		/>
		<GameJoinRosterRowView
		  key={kGameJoinRosterRowKeys[31]}
		  state={props.state}
		  assets={props.assets}
		  index={31}
		  width={props.width}
		  height={props.height}
		/>
	</Box>
}

inline int game_tech_visible_rows(const GameTechPanelState * state) {
	if(!state) return 0;
	return std::min(
		kGameTechRowSlots,
		static_cast<int>(state->grid.rows.size()));
}

inline std::uint8_t game_tech_label_alpha(std::uint8_t brightness) {
	return brightness >= 128 ? 255 : 160;
}

struct GameTechToggleCellProps {
	const char * key = nullptr;
	const GameTechGridRowState * row = nullptr;
	int column = 0;
	int row_position = 0;
};

::ui::UiElement GameTechToggleCell(const GameTechToggleCellProps& props) {
	if(!props.row || props.column < 0 ||
	   props.column >= static_cast<int>(props.row->cells.size())){
		return ::ui::empty();
	}
	const GameTechGridCellState& cell =
		props.row->cells[static_cast<size_t>(props.column)];
	if(!cell.draw) return ::ui::empty();
	const int x =
		kGameTechGridX
		+ props.column * (kGameTechCheckboxW + kGameTechColumnGap);
	const int y = kGameTechGridY + props.row_position * kGameTechRowH;
	const std::uint16_t spriteIndex =
		cell.selected ? kGameTechCheckboxOn : kGameTechCheckboxOff;
	if(cell.local){
		return <component_detail.Host
		  kind={::ui::HostKind::Box}
		  key={props.key}
		  id={copied_prefixed_id(kGameTechToggleActionPrefix, props.row->itemIndex)}
		  style={absolute_layout(x, y, kGameTechCheckboxW, kGameTechCheckboxH)}
		  visual={sprite_visual(kGameTechCheckboxBank, spriteIndex)}
		  interaction={::ui::NodeInteraction{
				.focusable = true,
				.checked = cell.selected,
			}}
		  accessibility={{.role = ::ui::SemanticRole::Checkbox, .label = props.row->label.c_str()}}
		/>
	}
	return <Box
	  key={props.key}
	  layout={absolute_layout(x, y, kGameTechCheckboxW, kGameTechCheckboxH)}
	  style={sprite_patch(kGameTechCheckboxBank, spriteIndex)}
	/>
}

struct GameTechRowLabelProps {
	const char * key = nullptr;
	const GameTechGridRowState * row = nullptr;
	int row_position = 0;
	int width = 0;
};

::ui::UiElement GameTechRowLabel(const GameTechRowLabelProps& props) {
	if(!props.row || props.width <= kGameTechLabelX) return ::ui::empty();
	const int y =
		kGameTechGridY
		+ kGameTechLabelPadY
		+ props.row_position * kGameTechRowH;
	return <component_detail.Host
	  kind={::ui::HostKind::Box}
	  key={props.key}
	  id={copied_prefixed_id(kGameTechDescriptionActionPrefix, props.row->itemIndex)}
	  style={absolute_layout(kGameTechLabelX, y, props.width - kGameTechLabelX, kGameTechRowH)}
	  interaction={::ui::NodeInteraction{.focusable = true}}
	  accessibility={{.role = ::ui::SemanticRole::Button, .label = props.row->label.c_str()}}
	>
		<Text
		  key="text"
		  value={props.row->label.c_str()}
		  layout={absolute_layout(0, 0, props.width - kGameTechLabelX, kGameTechRowH)}
		  style={palette_text_patch(0, 133, 6, 11.0f, ::ui::TextAlign::Left, game_tech_label_alpha(props.row->labelBrightness))}
		/>
	</component_detail.Host>
}

struct GameTechGridRowViewProps {
	const char * key = nullptr;
	const GameTechPanelState * state = nullptr;
	int index = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement GameTechGridRowView(const GameTechGridRowViewProps& props) {
	if(!props.state || !props.state->grid.visible ||
	   props.index < 0 ||
	   props.index >= static_cast<int>(props.state->grid.rows.size())){
		return ::ui::empty();
	}
	const GameTechGridRowState& row =
		props.state->grid.rows[static_cast<size_t>(props.index)];
	return <Box key={props.key} layout={absolute_layout(0, 0, props.width, props.height)}>
		<GameTechToggleCell key="cell-0" row={&row} column={0} rowPosition={props.index} />
		<GameTechToggleCell key="cell-1" row={&row} column={1} rowPosition={props.index} />
		<GameTechToggleCell key="cell-2" row={&row} column={2} rowPosition={props.index} />
		<GameTechToggleCell key="cell-3" row={&row} column={3} rowPosition={props.index} />
		<GameTechRowLabel
		  key="label"
		  row={props.state->grid.localLabelsVisible ? &row : nullptr}
		  rowPosition={props.index}
		  width={props.width}
		/>
	</Box>
}


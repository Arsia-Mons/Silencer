struct GameCreateMapScrollbarProps {
	const char * key = nullptr;
	const GameCreatePanelState * state = nullptr;
	GameCreateTallLayout layout = {};
};

::ui::UiElement GameCreateMapScrollbar(const GameCreateMapScrollbarProps& props) {
	if(!props.state || !game_create_map_show_scrollbar(*props.state, props.layout) ||
	   props.layout.listHeight <= kGameCreateScrollbarTrackPad * 2){
		return ::ui::empty();
	}
	const int track_height =
		static_cast<int>(props.layout.listHeight)
		- kGameCreateScrollbarTrackPad * 2;
	if(track_height <= 0) return ::ui::empty();
	const int visible_rows = static_cast<int>(props.layout.visibleMapRows);
	const int row_count = static_cast<int>(props.state->maps.size());
	const int max_scroll = game_create_map_scroll_max(*props.state, props.layout);
	int thumb_height = row_count > 0
		? (track_height * visible_rows) / row_count
		: track_height;
	thumb_height = clamp_int(thumb_height, 12, track_height);
	const int travel = track_height - thumb_height;
	int top_spacer = 0;
	if(max_scroll > 0 && travel > 0){
		top_spacer =
			(travel * static_cast<int>(props.state->mapScrollPos) + max_scroll / 2)
			/ max_scroll;
	}
	top_spacer = clamp_int(top_spacer, 0, travel);
	const int bottom_spacer = travel - top_spacer;
	return <Box
	  key={props.key}
	  layout={absolute_layout(std::max(0, static_cast<int>(props.layout.listWidth) - kGameCreateMapScrollbarWidth), 0, kGameCreateMapScrollbarWidth, props.layout.listHeight)}
	  style={inset_border_patch()}
	>
		<Box key="top" layout={absolute_layout(0, 0, kGameCreateMapScrollbarWidth, top_spacer)} />
		<Box
		  key="thumb"
		  layout={absolute_layout(kGameCreateScrollbarTrackPad, kGameCreateScrollbarTrackPad + top_spacer, std::max(1, kGameCreateMapScrollbarWidth - kGameCreateScrollbarTrackPad * 2), thumb_height)}
		  style={game_create_scrollbar_thumb_patch()}
		/>
		<Box
		  key="bottom"
		  layout={absolute_layout(0, kGameCreateScrollbarTrackPad + top_spacer + thumb_height, kGameCreateMapScrollbarWidth, bottom_spacer)}
		/>
	</Box>
}

struct GameCreateTallPanelProps {
	const char * key = nullptr;
	bool show = false;
	const GameCreatePanelState * state = nullptr;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement GameCreateTallPanel(const GameCreateTallPanelProps& props) {
	if(!props.show || !props.state || props.width <= 0 || props.height <= 0){
		return ::ui::empty();
	}
	const GameCreateTallLayout layout =
		ResolveGameCreateTallLayout(
			static_cast<Uint16>(props.width),
			static_cast<Uint16>(props.height));
	const int list_box_x = kGameCreateTallPanelPad;
	const int list_box_y =
		kGameCreateTallPanelPad
		+ kGameCreateTallHeadingH
		+ kGameCreateTallSectionGap;
	const int list_x = list_box_x + kGameCreateMapListBorderPad;
	const int list_y = list_box_y + kGameCreateMapListBorderPad;
	const int footer_y =
		list_box_y
		+ static_cast<int>(layout.listBoxHeight)
		+ kGameCreateTallSectionGap;
	const int name_input_y =
		footer_y + kGameCreateTallHeadingH + kGameCreateTallFooterGap;
	const int password_label_y =
		name_input_y + kGameCreateTallInputH + kGameCreateTallFooterGap;
	const int password_input_y =
		password_label_y + kGameCreateTallHeadingH + kGameCreateTallFooterGap;
	const int create_y =
		password_input_y + kGameCreateTallInputH + kGameCreateTallFooterGap;
	return <Box
	  key={props.key}
	  id="GameCreateTallContent"
	  layout={character_root_layout(props.x, props.y, props.width, props.height)}
	>
		<Text
		  key="heading"
		  value="Select Map"
		  layout={absolute_layout(kGameCreateTallPanelPad, kGameCreateTallPanelPad, std::max(0, props.width - kGameCreateTallPanelPad), kGameCreateTallHeadingH)}
		  style={text_patch(134, 8, 13.0f)}
		/>
		<Box
		  key="list-border"
		  id="GameCreateMapListBorder"
		  layout={absolute_layout(list_box_x, list_box_y, layout.listBoxWidth, layout.listBoxHeight)}
		  style={inset_border_patch()}
		/>
		<Box
		  key="list-viewport"
		  layout={absolute_layout(list_x, list_y, layout.listWidth, layout.listHeight)}
		>
			<GameCreateMapRows key="rows" state={props.state} layout={layout} />
			<GameCreateMapScrollbar key="scrollbar" state={props.state} layout={layout} />
		</Box>
		<Text
		  key="name-label"
		  value="Game name:"
		  layout={absolute_layout(kGameCreateTallPanelPad, footer_y, layout.inputWidth, kGameCreateTallHeadingH)}
		  style={text_patch(134, 8, 13.0f)}
		/>
		<TextInput
		  key="name-input"
		  id={kGameCreateNameAction}
		  accessibility={{.label = "Game name"}}
		  value={props.state->name}
		  textEdit={::ui::TextEditMetadata{
				.caret = static_cast<int>(std::strlen(props.state->name)),
				.selection_start = static_cast<int>(std::strlen(props.state->name)),
				.selection_end = static_cast<int>(std::strlen(props.state->name)),
			}}
		  layout={absolute_layout(kGameCreateTallPanelPad, name_input_y, layout.inputWidth, kGameCreateTallInputH)}
		  style={game_create_text_input_patch()}
		/>
		<Text
		  key="password-label"
		  value="Password (optional):"
		  layout={absolute_layout(kGameCreateTallPanelPad, password_label_y, layout.inputWidth, kGameCreateTallHeadingH)}
		  style={text_patch(134, 8, 13.0f)}
		/>
		<TextInput
		  key="password-input"
		  id={kGameCreatePasswordAction}
		  accessibility={{.label = "Password"}}
		  value={game_create_password_display(*props.state)}
		  textEdit={::ui::TextEditMetadata{
				.caret = static_cast<int>(std::strlen(props.state->password)),
				.selection_start = static_cast<int>(std::strlen(props.state->password)),
				.selection_end = static_cast<int>(std::strlen(props.state->password)),
			}}
		  layout={absolute_layout(kGameCreateTallPanelPad, password_input_y, layout.inputWidth, kGameCreateTallInputH)}
		  style={game_create_text_input_patch()}
		/>
		<Button
		  key="create"
		  id={kGameCreateCreateAction}
		  label="Create"
		  accessibility={{.label = "Create"}}
		  layout={absolute_button_layout(kGameCreateTallPanelPad, create_y, std::max(1, static_cast<int>(layout.inputWidth)), kGameCreateTallButtonH)}
		  style={chrome_button_patch()}
		/>
	</Box>
}

struct GameCreatePreviewDescLineProps {
	const char * key = nullptr;
	const char * description = nullptr;
	int index = 0;
	int x = 0;
	int y = 0;
	int width = 0;
	int line_height = 0;
};

::ui::UiElement GameCreatePreviewDescLine(const GameCreatePreviewDescLineProps& props) {
	if(props.index < 0 ||
	   props.index >= std::min(split_line_count(props.description), kGameCreatePreviewDescLineSlots)){
		return ::ui::empty();
	}
	return <Text
	  key={props.key}
	  value={copied_split_line(props.description, props.index)}
	  layout={absolute_layout(props.x, props.y + props.index * props.line_height, props.width, props.line_height)}
	  style={palette_text_patch(129, 133, 7, static_cast<float>(props.line_height))}
	/>

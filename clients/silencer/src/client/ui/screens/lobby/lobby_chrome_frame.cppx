struct GameSelectInfoLineProps {
	const char * key = nullptr;
	const GameSelectPanelState * state = nullptr;
	int index = 0;
	int y = 0;
	int width = 0;
};

::ui::UiElement GameSelectInfoLine(const GameSelectInfoLineProps& props) {
	if(!props.state || props.index < 0 || props.index >= 5){
		return ::ui::empty();
	}
	const char * value = game_select_info_value(*props.state, props.index);
	if(!value || !*value) return ::ui::empty();
	return <Text
	  key={props.key}
	  value={value}
	  layout={absolute_layout(kGameSelectInfoPadLeft, props.y, props.width - kGameSelectInfoPadLeft, kGameSelectInfoRowH)}
	  style={text_patch(133, 6, 11.0f)}
	/>
}

struct GameSelectTallPanelProps {
	const char * key = nullptr;
	bool show = false;
	const GameSelectPanelState * state = nullptr;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement GameSelectTallPanel(const GameSelectTallPanelProps& props) {
	if(!props.show || !props.state || props.width <= 0 || props.height <= 0){
		return ::ui::empty();
	}
	const GameSelectTallLayout layout =
		resolve_game_select_tall_layout(props.width, props.height);
	return <Box key={props.key} layout={absolute_layout(props.x, props.y, props.width, props.height)}>
		<Text
		  key="heading"
		  value="Active Games"
		  layout={absolute_layout(kGameSelectHeadingPadLeft, kGameSelectHeadingPadTop, props.width - kGameSelectHeadingPadLeft, kGameSelectHeadingLineH)}
		  style={text_patch(134, 8, 13.0f)}
		/>
		<Box
		  key="list-border"
		  layout={absolute_layout(layout.list_box_x, layout.list_box_y, layout.list_box_w, layout.list_box_h)}
		  style={inset_border_patch()}
		/>
		<GameSelectRows key="rows" state={props.state} layout={layout} />
		<GameSelectInfoLine
		  key="info-name"
		  state={props.state}
		  index={0}
		  y={layout.info_y}
		  width={props.width}
		/>
		<GameSelectInfoLine
		  key="info-map"
		  state={props.state}
		  index={1}
		  y={layout.info_y + kGameSelectInfoRowH}
		  width={props.width}
		/>
		<GameSelectInfoLine
		  key="info-security"
		  state={props.state}
		  index={2}
		  y={layout.info_y + kGameSelectInfoRowH * 2}
		  width={props.width}
		/>
		<GameSelectInfoLine
		  key="info-creator"
		  state={props.state}
		  index={3}
		  y={layout.info_y + kGameSelectInfoRowH * 3}
		  width={props.width}
		/>
		<GameSelectInfoLine
		  key="info-limits"
		  state={props.state}
		  index={4}
		  y={layout.info_y + kGameSelectInfoRowH * 4}
		  width={props.width}
		/>
	</Box>
}

struct GameJoinRosterRowViewProps {
	const char * key = nullptr;
	const GameJoinPanelState * state = nullptr;
	const AppAssetsModel * assets = nullptr;
	int index = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement GameJoinRosterRowView(const GameJoinRosterRowViewProps& props) {
	if(!props.state || props.index < 0 ||
	   props.index >= static_cast<int>(props.state->rosterRows.size())){
		return ::ui::empty();
	}
	const GameJoinRosterRow& row =
		props.state->rosterRows[static_cast<size_t>(props.index)];
	const int rowYOffset =
		row.teamNumber * kGameJoinRosterTeamStepY
		+ row.peerSlot * kGameJoinRosterPeerStepY;
	const AppSpriteFrame emblem =
		props.assets ? props.assets->agency_emblem(row.agency) : AppSpriteFrame{};
	const int emblemW = emblem.available ? emblem.width : 16;
	const int emblemH = emblem.available ? emblem.height : 16;
	const int emblemX =
		kGameJoinRosterEmblemAnchorX
		- (emblem.available ? emblem.offset_x : 0);
	const int emblemY =
		kGameJoinRosterEmblemAnchorY
		+ row.teamNumber * kGameJoinRosterTeamStepY
		- (emblem.available ? emblem.offset_y : 0);
	const std::uint16_t readyIndex = row.ready ? 18 : 19;
	const AppSpriteFrame ready =
		props.assets ? props.assets->ready_indicator(row.ready) : AppSpriteFrame{};
	const int readyW = ready.available ? ready.width : 8;
	const int readyH = ready.available ? ready.height : 8;
	const int readyX =
		kGameJoinRosterReadyAnchorX
		- (ready.available ? ready.offset_x : 0);
	const int readyY =
		kGameJoinRosterReadyAnchorY
		+ rowYOffset
		- (ready.available ? ready.offset_y : 0);
	const int levelX =
		kGameJoinRosterNameX + static_cast<int>(row.name.size()) * 6 + 3;
	return <Box key={props.key} layout={absolute_layout(0, 0, props.width, props.height)}>
		<Box
		  key="emblem"
		  layout={absolute_layout(emblemX, emblemY, emblemW, emblemH)}
		  style={row.drawEmblem ? sprite_patch(181, row.agency) : ::ui::StylePatch{}}
		/>
		<Box
		  key="ready"
		  layout={absolute_layout(readyX, readyY, readyW, readyH)}
		  style={sprite_patch(7, readyIndex)}
		/>
		<Text
		  key="name"
		  value={row.name.c_str()}
		  layout={absolute_layout(kGameJoinRosterNameX, kGameJoinRosterTextY + rowYOffset, props.width - kGameJoinRosterNameX, 11)}
		  style={text_patch(133, 6, 11.0f)}
		/>
		<Text
		  key="level"
		  value={row.level.empty() ? "" : row.level.c_str()}
		  layout={absolute_layout(levelX, kGameJoinRosterTextY + rowYOffset, props.width - levelX, 7)}
		  style={level_text_patch()}
		/>
	</Box>
}


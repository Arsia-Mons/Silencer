struct GameCreatePreviewOverlayProps {
	const char * key = nullptr;
	bool show = false;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
	int line_height = 0;
	int gap = 0;
	int bitmap_width = 0;
	int bitmap_height = 0;
	const char * name = nullptr;
	const char * description = nullptr;
	const std::uint8_t * pixels = nullptr;
};

::ui::UiElement GameCreatePreviewOverlay(const GameCreatePreviewOverlayProps& props) {
	if(!props.show || !props.pixels || props.width <= 0 || props.height <= 0 ||
	   props.bitmap_width <= 0 || props.bitmap_height <= 0 || props.line_height <= 0){
		return ::ui::empty();
	}
	const int bitmap_y = props.line_height + props.gap;
	const int desc_y = bitmap_y + props.bitmap_height + props.gap;
	return <Box
	  key={props.key}
	  id="GCrtMapPreview"
	  layout={absolute_layout(props.x, props.y, props.width, props.height)}
	>
		<Text
		  key="name"
		  id="GCrtMapPreviewName"
		  value={props.name}
		  layout={absolute_layout(0, 0, props.width, props.line_height)}
		  style={palette_text_patch(129, 133, 7, static_cast<float>(props.line_height))}
		/>
		<Box
		  key="minimap"
		  id="GCrtMapPreviewMinimap"
		  layout={absolute_layout(0, bitmap_y, props.bitmap_width, props.bitmap_height)}
		  style={raw_bitmap_patch(props.pixels, props.bitmap_width, props.bitmap_height)}
		/>
		<GameCreatePreviewDescLines
		  key="description"
		  description={props.description}
		  x={0}
		  y={desc_y}
		  width={props.width}
		  lineHeight={props.line_height}
		/>
	</Box>
}

struct GameSelectRowProps {
	const char * key = nullptr;
	const GameSelectPanelState * state = nullptr;
	GameSelectTallLayout layout = {};
	int visible_row = 0;
};

::ui::UiElement GameSelectRow(const GameSelectRowProps& props) {
	if(!props.state || props.visible_row < 0 ||
	   props.visible_row >= props.layout.visible_rows){
		return ::ui::empty();
	}
	const int source = static_cast<int>(props.state->scrollPos) + props.visible_row;
	if(source < 0 || source >= static_cast<int>(props.state->rows.size())){
		return ::ui::empty();
	}
	const GameSelectPanelState::Row& row =
		props.state->rows[static_cast<size_t>(source)];
	const bool selected = source == props.state->selectedIndex;
	return <component_detail.Host
	  kind={::ui::HostKind::Button}
	  key={props.key}
	  id={copied_row_id(source)}
	  idOffset={source + 1}
	  style={absolute_layout(0, props.visible_row * kGameSelectListLineH, props.layout.list_w, kGameSelectListLineH)}
	  visual={row_visual(selected)}
	  interaction={::ui::NodeInteraction{
			.focusable = true,
			.checked = selected,
		}}
	  accessibility={{.role = ::ui::SemanticRole::ListRow, .label = row.name.c_str()}}
	>
		<Text
		  key="label"
		  value={row.name.c_str()}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::points(11.0f),
				.padding = {4.0f, 6.0f, 1.0f, 0.0f},
			}}
		  style={text_patch(133, 6, 11.0f)}
		/>
	</component_detail.Host>
}


constexpr int kGameSelectHeadingPadLeft = 7;
constexpr int kGameSelectHeadingPadTop = 6;
constexpr int kGameSelectHeadingLineH = 13;
constexpr int kGameSelectListPadLeft = 9;
constexpr int kGameSelectListPadTop = 4;
constexpr int kGameSelectListBorderPad = 1;
constexpr int kGameSelectListLineH = 14;
constexpr int kGameSelectRowSlots = 32;
constexpr int kGameSelectFooterPadTop = 4;
constexpr int kGameSelectFooterGap = 4;
constexpr int kGameSelectInfoPadLeft = 7;
constexpr int kGameSelectInfoRowH = 12;
constexpr int kGameSelectButtonRowH = 21;
constexpr int kGameSelectButtonGap = 2;
constexpr const char * kGameSelectRowActionPrefix = "lobby.game_select.row";

const char * kGameSelectRowKeys[kGameSelectRowSlots] = {
	"game-select-row-0",  "game-select-row-1",  "game-select-row-2",
	"game-select-row-3",  "game-select-row-4",  "game-select-row-5",
	"game-select-row-6",  "game-select-row-7",  "game-select-row-8",
	"game-select-row-9",  "game-select-row-10", "game-select-row-11",
	"game-select-row-12", "game-select-row-13", "game-select-row-14",
	"game-select-row-15", "game-select-row-16", "game-select-row-17",
	"game-select-row-18", "game-select-row-19", "game-select-row-20",
	"game-select-row-21", "game-select-row-22", "game-select-row-23",
	"game-select-row-24", "game-select-row-25", "game-select-row-26",
	"game-select-row-27", "game-select-row-28", "game-select-row-29",
	"game-select-row-30", "game-select-row-31",
};

inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch chrome_border_patch() {
	return ::ui::patch().border(::ui::Border{
		{1.0f, 1.0f, 1.0f, 1.0f},
		{{216, 0, 0, 255}, {216, 0, 0, 255},
		 {216, 0, 0, 255}, {216, 0, 0, 255}},
	});
}

inline ::ui::StylePatch title_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {152, 0, 0, 255},
		.font_id = 135,
		.font_size = 11,
	});
}

inline ::ui::StylePatch version_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {189, 0, 0, 255},
		.font_id = 133,
		.font_size = 6,
	});
}

inline ::ui::StylePatch map_text_patch() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {129, 0, 0, 255},
		.font_id = 135,
		.font_size = 11,
	});
}

inline ::ui::StyleStatePatch chrome_button_patch() {
	::ui::StyleStatePatch patch{};
	patch.base = ::ui::patch()
		.image(::ui::BackgroundImage{
			.texture_id = texture_id(7, 24),
			.tint = {255, 255, 255, 255},
		})
		.text(::ui::TextVisual{
			.color = {0, 0, 0, 255},
			.font_id = 134,
			.font_size = 8,
			.align = ::ui::TextAlign::Center,
	});
	patch.hover = patch.base;
	patch.focus_visible = patch.base;
	patch.pressed = patch.base;
	return patch;
}

inline ::ui::EdgeSizes absolute_inset(float left, float top) {
	::ui::EdgeSizes inset;
	inset.left = ::ui::StyleValue::points(left);
	inset.top = ::ui::StyleValue::points(top);
	return inset;
}

inline ::ui::LayoutStyle title_layout(const LobbyChromeFrameProps& props) {
	return {
		.position = ::ui::PositionType::Absolute,
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(static_cast<float>(props.width)),
		.height = ::ui::Length::points(static_cast<float>(props.height)),
		.padding = {static_cast<float>(props.pad_x),
		            static_cast<float>(props.pad_x),
		            4.0f,
		            4.0f},
		.gap = static_cast<float>(props.row_gap),
		.position_inset = absolute_inset(
			static_cast<float>(props.x),
			static_cast<float>(props.y)),
	};
}

inline ::ui::LayoutStyle text_slot(float width) {
	return {
		.width = width > 0.0f ? ::ui::Length::points(width) : ::ui::Length::auto_size(),
		.height = ::ui::Length::points(21.0f),
	};
}

inline ::ui::LayoutStyle absolute_layout(int x,
                                         int y,
                                         int width,
                                         int height) {
	return {
		.position = ::ui::PositionType::Absolute,
		.width = ::ui::Length::points(static_cast<float>(width)),
		.height = ::ui::Length::points(static_cast<float>(height)),
		.position_inset = absolute_inset(
			static_cast<float>(x),
			static_cast<float>(y)),
	};
}

inline ::ui::LayoutStyle absolute_button_layout(int x,
                                                int y,
                                                int width,
                                                int height) {
	return {
		.position = ::ui::PositionType::Absolute,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(static_cast<float>(width)),
		.height = ::ui::Length::points(static_cast<float>(height)),
		.padding = {8.0f, 8.0f, 4.0f, 4.0f},
		.position_inset = absolute_inset(
			static_cast<float>(x),
			static_cast<float>(y)),
	};
}

inline ::ui::StylePatch text_patch(std::uint16_t font_id,
                                   std::uint16_t font_size,
                                   float line_height,
                                   ::ui::TextAlign align = ::ui::TextAlign::Left) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {0, 0, 0, 255},
		.font_id = font_id,
		.font_size = font_size,
		.align = align,
		.line_height = line_height,
	});
}

inline ::ui::StylePatch inset_border_patch() {
	return ::ui::patch().border(::ui::Border{
		{1.0f, 1.0f, 1.0f, 1.0f},
		{{220, 0, 0, 255}, {220, 0, 0, 255},
		 {220, 0, 0, 255}, {220, 0, 0, 255}},
	});
}

inline ::ui::VisualStyle row_visual(bool selected) {
	::ui::VisualStyle visual{};
	visual.background = selected
		? ::ui::Color{180, 0, 0, 255}
		: ::ui::Color{0, 0, 0, 0};
	visual.text = ::ui::TextVisual{
		.color = {0, 0, 0, 255},
		.font_id = 133,
		.font_size = 6,
		.line_height = 11.0f,
	};
	return visual;
}

struct GameSelectTallLayout {
	int list_box_x = 0;
	int list_box_y = 0;
	int list_box_w = 0;
	int list_box_h = 0;
	int list_x = 0;
	int list_y = 0;
	int list_w = 0;
	int list_h = 0;
	int visible_rows = 0;
	int info_y = 0;
};

inline GameSelectTallLayout resolve_game_select_tall_layout(int width,
                                                            int height) {
	GameSelectTallLayout out;
	const int titleWrapH = kGameSelectHeadingPadTop + kGameSelectHeadingLineH;
	const int infoH = 5 * kGameSelectInfoRowH;
	const int footerH =
		kGameSelectFooterPadTop
		+ infoH
		+ kGameSelectFooterGap
		+ kGameSelectButtonRowH
		+ kGameSelectButtonGap
		+ kGameSelectButtonRowH;
	out.list_box_x = kGameSelectListPadLeft;
	out.list_box_y = titleWrapH + kGameSelectListPadTop;
	out.list_box_w = std::max(0, width - kGameSelectListPadLeft * 2);
	out.list_box_h = std::max(0, height - titleWrapH - kGameSelectListPadTop - footerH);
	out.list_x = out.list_box_x + kGameSelectListBorderPad;
	out.list_y = out.list_box_y + kGameSelectListBorderPad;
	out.list_w = std::max(0, out.list_box_w - kGameSelectListBorderPad * 2);
	out.list_h = std::max(0, out.list_box_h - kGameSelectListBorderPad * 2);
	out.visible_rows = std::min(kGameSelectRowSlots, out.list_h / kGameSelectListLineH);
	out.info_y = height - footerH + kGameSelectFooterPadTop;
	return out;
}

inline const char * copied_row_id(int source) {
	std::string value =
		std::string(kGameSelectRowActionPrefix) + "." + std::to_string(source);
	return ::ui::copy_string(value.c_str());
}

inline const char * game_select_info_value(const GameSelectPanelState& state,
                                           int index) {
	switch(index){
		case 0: return state.infoName.c_str();
		case 1: return state.infoMap.c_str();
		case 2: return state.infoSecurity.c_str();
		case 3: return state.infoCreator.c_str();
		case 4: return state.infoLimits.c_str();
	}
	return "";
}

struct AbsoluteChromeButtonProps {
	const char * key = nullptr;
	const char * id = nullptr;
	const char * label = nullptr;
	bool show = false;
	int x = 0;
	int y = 0;
	int width = 0;
	int height = 0;
};

::ui::UiElement AbsoluteChromeButton(const AbsoluteChromeButtonProps& props) {
	if(!props.show) return ::ui::empty();
	return <Button
	  key={props.key}
	  id={props.id}
	  label={props.label}
	  accessibility={{.label = props.label}}
	  layout={absolute_button_layout(props.x, props.y, props.width, props.height)}
	  style={chrome_button_patch()}
	/>
}

struct GameSelectRowProps {
	const char * key = nullptr;
	const GameSelectPanelState * state = nullptr;
	GameSelectTallLayout layout = {};
	int visible_row = 0;
};

::ui::UiElement GameSelectRow(const GameSelectRowProps& props) {
	if(!props.state || props.visible_row < 0 ||
	   props.visible_row >= props.layout.visible_rows){
		return ::ui::empty();
	}
	const int source = static_cast<int>(props.state->scrollPos) + props.visible_row;
	if(source < 0 || source >= static_cast<int>(props.state->rows.size())){
		return ::ui::empty();
	}
	const GameSelectPanelState::Row& row =
		props.state->rows[static_cast<size_t>(source)];
	const bool selected = source == props.state->selectedIndex;
	return <component_detail.Host
	  kind={::ui::HostKind::Button}
	  key={props.key}
	  id={copied_row_id(source)}
	  idOffset={source + 1}
	  style={absolute_layout(0, props.visible_row * kGameSelectListLineH, props.layout.list_w, kGameSelectListLineH)}
	  visual={row_visual(selected)}
	  interaction={::ui::NodeInteraction{
			.focusable = true,
			.checked = selected,
		}}
	  accessibility={{.role = ::ui::SemanticRole::ListRow, .label = row.name.c_str()}}
	>
		<Text
		  key="label"
		  value={row.name.c_str()}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::points(11.0f),
				.padding = {4.0f, 6.0f, 1.0f, 0.0f},
			}}
		  style={text_patch(133, 6, 11.0f)}
		/>
	</component_detail.Host>
}


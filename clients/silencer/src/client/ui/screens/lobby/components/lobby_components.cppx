                              .padding = {0.0f, 0.0f, 5.5f, 0.0f}};
  const char *display = ::ui::copy_string(std::to_string((unsigned)value).c_str());
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(kGameOptionRowH),
      .flex_shrink = ::ui::StyleFloat::points(0.0f),

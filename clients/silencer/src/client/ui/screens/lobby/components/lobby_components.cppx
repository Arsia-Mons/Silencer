constexpr size_t kLobbyChatMaxChars = 200;
constexpr float kGameOptionRowH = 25.5f;
constexpr int kGameOptionRowCount = 6;

std::string cap_lobby_chat_text(const std::string &value) {
  if (value.size() <= kLobbyChatMaxChars)
    return value;
  return value.substr(0, kLobbyChatMaxChars);
}


// One AgentCard stat row (WINS/LOSSES/XP): a fixed-width Body label column with
// the value aligned after it, origin's StatRow convention (Body face, not tiny).
::ui::UiElement stat_kv(const char *key, const char *label, const char *value) {
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .height = ::ui::Length::points(tokens::kLineBody),
      .gap = 12.0f}}
  >
    <Box
      key="lc"
      layout={::ui::LayoutStyle{
        .width = ::ui::Length::points(60.0f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
    >
      <BodyText key="l" variant={BodyTextVariant::Body} value={label} />
    </Box>
    <BodyText key="v" variant={BodyTextVariant::Body} value={value} />
  </Box>
}


// Selected-row styling shared by the Active-Games + Select-Map lists: origin
// draws the selection as a single SOLID legacy-palette-180 fill bar (renderer
// SELECTBOX), no caret/border/focus ring. Defined later; forward-declared here
// so the game-browser rows above can use the same treatment.
::ui::StyleStatePatch selectable_row_style(bool selected);


// One game-browser entry as its own row: origin ScrollList draws the filename at
// the same Body weight on every row; the selected row is the solid 180 highlight
// bar (NOT a "> " caret). Mirrors map_list_rows' row treatment (height = origin
// kListLineH 14 v -> 21 logical, text inset 6 logical).
::ui::UiElement game_row(const char *key, const char *id, int offset,
                         const char *value, bool selected,
                         std::function<void()> on_select) {
  std::function<void(const ::ui::ActivationEvent &)> activate =
      [on_select](const ::ui::ActivationEvent &) {
        if (on_select)
          on_select();
      };
  std::function<void(const ::ui::FocusEvent &)> focus =
      [on_select](const ::ui::FocusEvent &) {
        if (on_select)
          on_select();
      };
  return Box(BoxProps{
      .key = key,
      .id = id,
      .id_offset = offset,
      .focusable = true,
      .accessibility = {.label = value},
      .on_focus = focus,
      .on_activate = activate,
      .layout = ::ui::LayoutStyle{.height = ::ui::Length::points(21.0f),
                                  .flex_shrink = ::ui::StyleFloat::points(0.0f),
                                  .padding = {6.0f, 0.0f, 2.0f, 0.0f}},
      .style = selectable_row_style(selected),
      .children = ::ui::children({BodyText(BodyTextProps{
          .key = "t", .variant = BodyTextVariant::Body, .value = value})})});
}


// The right tall column (origin rightTallW; 463 logical at the design canvas,
// right edge on the root pad). tall_w resolved ONCE in LobbyScreenView and
// passed down (same shape as lobby_chat_layout(chat_w) — layout helpers take
// values, never call hooks).
::ui::LayoutStyle lobby_right_cell_layout(float tall_w) {
  ::ui::LayoutStyle l = {
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::points(tall_w),
      .min_height = ::ui::Length::points(0.0f),
      .padding = {8.0f, 8.0f, 6.0f, 6.0f},
      .gap = 4.0f};
  l.flex_shrink = ::ui::StyleFloat::points(0.0f);
  return l;
}

// The chat panel (origin chatW = topRowW - regionGap; 757 logical at the
// design canvas), full height of the lower row (the seam fills the rest).
::ui::LayoutStyle lobby_chat_layout(float chat_w) {
  ::ui::LayoutStyle l = {
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::points(chat_w),
      .min_height = ::ui::Length::points(0.0f),
      .padding = {10.0f, 10.0f, 8.0f, 7.0f},
      .gap = 0.0f};
  l.flex_shrink = ::ui::StyleFloat::points(0.0f);
  return l;
}


// origin/main lobby panels are connected green hairline frames (vector strokes
// at palette idx216, not sprites) over a transparent interior so the Mars
// backdrop reads through.
inline ::ui::StylePatch lobby_panel_style() {
  return tokens::frame_patch(tokens::kChromeStroke);
}

// origin LobbyRightUpperBox: chrome on top/bottom/left, open right edge (it
// reads as one connected region with the right tall panel).
inline ::ui::StylePatch lobby_panel_open_right() {
  return tokens::frame_patch_sides(tokens::kChromeStroke, true, false, true, true);
}

// origin LobbyRightTallBox: chrome on top/bottom/right, open left edge.
inline ::ui::StylePatch lobby_panel_open_left() {
  return tokens::frame_patch_sides(tokens::kChromeStroke, true, true, true, false);
}


// One "ENDURANCE:    0" loadout stat line (origin UpgradeRow): label in a
// growing left cell, value right-aligned in a fixed 18-virtual (27 logical)
// column; row 12 virtual (18) tall, gap 6 virtual (9).
::ui::UiElement loadout_row(const char *key, const char *label, uint8_t value) {
  const char *val = ::ui::copy_string(std::to_string((unsigned)value).c_str());
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Start,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(18.0f),
      .flex_shrink = ::ui::StyleFloat::points(0.0f),
      .gap = 9.0f}}
  >
    <Box
      key="lc"
      layout={::ui::LayoutStyle{
        .min_width = ::ui::Length::points(0.0f),
        .flex_basis = ::ui::Length::points(0.0f),
        .flex_grow = ::ui::StyleFloat::points(1.0f)}}
    >
      <BodyText key="l" variant={BodyTextVariant::Body} value={label} />
    </Box>
    <Box
      key="vc"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Row,
        .justify_content = ::ui::JustifyContent::End,
        .width = ::ui::Length::points(27.0f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
    >
      <BodyText key="v" variant={BodyTextVariant::Body} value={val} />
    </Box>
  </Box>
}


// --- right-column panels (screen-local swap) ---------------------------------

// The default center region (origin/main): a "Create Game" button floating at the
// top over the backdrop. The "In Lobby" presence lives in the shared Lobby panel
// (so it shows in create/staging modes too), not here.


// The Active-Games browser body — chromeless (the panel chrome + "Active Games"
// title live on the dedicated right cockpit cell). A flex spacer pushes the
// browse/join actions to the bottom so the list reads sparse like the reference.

// origin layout knobs (game_select_panel_layout.cpp), virtual px x1.5 -> logical.
constexpr float kTallInfoRowH = 12.0f * 1.5f;   // 18: fixed info-row slot height
constexpr float kTallButtonRowH = 21.0f * 1.5f; // 31.5: fixed button-slot height
constexpr float kTallButtonGap = 2.0f * 1.5f;   // 3
constexpr float kTallFooterGap = 4.0f * 1.5f;   // 6
constexpr float kTallFooterPadTop = 4.0f * 1.5f;// 6
constexpr float kTallInfoPadLeft = 7.0f * 1.5f; // 10.5
// footerH reserved below the list box: padTop 6 + 5*18 + gap 6 + 31.5 + 3 + 31.5.
constexpr float kGameSelectFooterH = kTallFooterPadTop + 5.0f * kTallInfoRowH +
                                     kTallFooterGap + kTallButtonRowH +
                                     kTallButtonGap + kTallButtonRowH;

// One info-block line (origin BuildGameSelectInfoBlock: a FIXED-height Body row,
// blank when the field is empty so the block never reflows).
::ui::UiElement info_line(const char *key, const char *value) {
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .height = ::ui::Length::points(kTallInfoRowH),
      .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
  >
    <BodyText key="t" variant={BodyTextVariant::Body} value={value} />
  </Box>
}


// One always-reserved button slot (origin GSelBtn*Wrap): a fixed-height row that
// centers its button; the button is rendered only when its action is available
// (an unavailable action shows an EMPTY slot, never a greyed button) — so the
// footer height is stable and the reserved empty Spectate slot is the gap above
// Join Game for a waiting game.
::ui::UiElement action_slot(const char *key, ::ui::UiElement button) {
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::Center,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(kTallButtonRowH),
      .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
  >
    {button}
  </Box>
}


// The Active-Games FOOTER (origin GSelFooter): the 5-field info block over the
// two reserved button slots (Spectate top, Join Game bottom). Sits BELOW the
// bordered list box, not inside it. Fixed total height (kGameSelectFooterH).

// The Active-Games LIST: just the scrolling game rows (origin ScrollList). Lives
// INSIDE the bordered list box; the footer (info + buttons) is a sibling BELOW
// the box (GameBrowserFooter), never inside this well.

// SIL-234: the right-column "Connecting" hold. While a create/join is in flight
// (clicked, not yet connected), the right column shows this stable panel instead
// of flashing the games browser between the create form and staging — origin
// masks the same window with a "Creating game..." progress modal. Top region.

// SIL-234: the tall-cell counterpart of ConnectingPanel — keeps the right
// cockpit cell occupied (same chrome as ActiveGamesCell) so the column reads as
// one stable connecting state through the join window. Shares the "rightcell"
// key so the slot reconciles in place when staging mounts.

// The lobby's right cockpit column: the Active Games browser, or (while creating
// a game) the Select Map filename list (CreateRightCell). Both share the key
// "rightcell" so the slot reconciles in place when the mode swaps.

// Game-Options row. origin renders cycle values (Security/Spectatable) as
// BodySm text buttons centered in the row, and numeric values as inline
// TextInputs whose Body pen sits 3 virtual px under the row top — so the
// numeric value column is top-anchored at +4.5 logical, not centered.

int parse_u8_option(const std::string &value, int fallback, int lo, int hi) {
  if (value.empty())
    return fallback;
  int next = 0;
  for (char c : value) {
    if (c < '0' || c > '9')
      return fallback;
    next = next * 10 + (c - '0');
    if (next > hi)
      return hi;
  }
  if (next < lo)
    return lo;
  return next;
}



::ui::StyleStatePatch game_option_row_style() {
  ::ui::StylePatch p = tokens::chromeless_clear_patch();
  ::ui::StyleStatePatch s{};
  s.base = p;
  s.hover = p;
  s.pressed = p;
  s.focus_visible = p;
  return s;
}


::ui::UiElement option_label(const char *key, const char *label) {
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .min_width = ::ui::Length::points(0.0f),
      .flex_basis = ::ui::Length::points(0.0f),
      .flex_grow = ::ui::StyleFloat::points(1.0f)}}
  >
    <BodyText key="l" variant={BodyTextVariant::Body} value={label} />
  </Box>
}


::ui::UiElement option_value_text(const char *key, const char *value,
                                  bool cycle) {
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .width = ::ui::Length::points(96.0f),
      .height = ::ui::Length::points(21.0f),
      .flex_shrink = ::ui::StyleFloat::points(0.0f),
      .padding = cycle ? ::ui::EdgeSizes{} : ::ui::EdgeSizes{0.0f, 0.0f, 5.5f, 0.0f}}}
  >
    <Text
      key="v"
      value={value}
      layout={{.height = ::ui::Length::points(tokens::kLineBody)}}
      style={tokens::text_patch(tokens::kTextBody, tokens::kFontBodyEm, cycle ? tokens::kFaceBodySm : tokens::kFaceBody, tokens::kLineBody)}
    />

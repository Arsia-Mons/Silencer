        .flex_shrink = ::ui::StyleFloat::points(0.0f),
        .gap = ::ui::StyleValue::points(6.0f)}}
    >
      <Box
        key="avatar"
        layout={::ui::LayoutStyle{
          .width = ::ui::Length::points(75.0f),
          .height = ::ui::Length::points(75.0f),
          .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
        style={props.emblem_tex ? tokens::image_patch(props.emblem_tex) : ::ui::patch().background(tokens::kEmblemFallbackFill).corner_radius(2.0f)}
      />
      <Box
        key="lvbox"
        layout={::ui::LayoutStyle{
          .align_items = ::ui::AlignItems::Center,
          .justify_content = ::ui::JustifyContent::Center,
          .width = ::ui::Length::points(75.0f),
          .height = ::ui::Length::points(tokens::kLineBody)}}
      >
        <BodyText key="lv" variant={BodyTextVariant::Body} value="LV 0" />
      </Box>
    </Box>
    <Box
      key="infoArea"
      layout={::ui::LayoutStyle{
        .overflow = ::ui::Overflow::Hidden,
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .min_width = ::ui::Length::points(0.0f),
        .flex_basis = ::ui::Length::points(0.0f),
        .flex_grow = ::ui::StyleFloat::points(1.0f),
        .gap = ::ui::StyleValue::points(7.5f)}}
    >
      <Text
        key="name"
        value={props.agent_name}
        layout={{.height = ::ui::Length::points(tokens::kLineLarge)}}
        style={tokens::text_patch(tokens::kTextAgentName, tokens::kFontLarge, tokens::kFaceLarge, tokens::kLineLarge)}
      />
      <Box
        key="detailsArea"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::Stretch,
          .flex_grow = ::ui::StyleFloat::points(1.0f),
          .gap = ::ui::StyleValue::points(7.0f)}}
      >
        <Box
          key="statsCol"
          layout={::ui::LayoutStyle{
            .direction = ::ui::FlexDirection::Column,
            .width = ::ui::Length::points(138.0f),
            .flex_shrink = ::ui::StyleFloat::points(0.0f),
            .gap = ::ui::StyleValue::points(15.0f)}}
        >
          <Box
            key="stattable"
            layout={::ui::LayoutStyle{
              .direction = ::ui::FlexDirection::Column,
              .gap = ::ui::StyleValue::points(2.5f)}}
          >
            {stat_kv("wins", "WINS", "0")}
            {stat_kv("loss", "LOSSES", "0")}
          </Box>
          <BodyText key="xp" variant={BodyTextVariant::Body} value={props.xp_line} />
          <Box
            key="actionsrow"
            layout={::ui::LayoutStyle{
              .direction = ::ui::FlexDirection::Row,
              .align_items = ::ui::AlignItems::Center,
              .height = ::ui::Length::points(31.5f),
              .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
          >
            <AppButton
              key="agents"
              controlId="LobbyAgents"
              variant={AppButtonVariant::Chrome}
              targetFeedback={true}
              label="Agents"
              onPress={props.on_agents}
            />
          </Box>
        </Box>
        <Box
          key="statWell"
          layout={::ui::LayoutStyle{
            .direction = ::ui::FlexDirection::Column,
            .align_items = ::ui::AlignItems::Stretch,
            .min_width = ::ui::Length::points(0.0f),
            .flex_basis = ::ui::Length::points(0.0f),
            .flex_grow = ::ui::StyleFloat::points(1.0f),
            .padding = {6.0f, 6.0f, 4.0f, 4.5f},
            .gap = ::ui::StyleValue::points(3.0f)}}
          style={tokens::frame_patch(tokens::kInsetStroke)}
        >
          {loadout_row("s0", "ENDURANCE:", 0)}
          {loadout_row("s1", "SHIELD:", 0)}
          {loadout_row("s2", "JETPACK:", 0)}
          {loadout_row("s3", "TECH SLOTS:", 3)}
          {loadout_row("s4", "HACKING:", 0)}
          {loadout_row("s5", "CONTACTS:", 0)}
        </Box>
      </Box>
    </Box>
  </Box>
}

::ui::UiElement LobbyChatPanel(const LobbyChatPanelProps &props) {
  return <Box key="chat" layout={lobby_chat_layout(props.chat_w)} style={lobby_panel_style()}>
    <Box
      key="chanrow"
      layout={::ui::LayoutStyle{
        .height = ::ui::Length::points(24.0f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
    >
      <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value={props.title} />
    </Box>
    <Box
      key="logwell"
      id="logwell"
      layout={::ui::LayoutStyle{
        .overflow = ::ui::Overflow::Hidden,
        .direction = ::ui::FlexDirection::Row,
        .align_items = ::ui::AlignItems::Stretch,
        .width = ::ui::Length::percent(100.0f),
        .flex_grow = ::ui::StyleFloat::points(1.0f),
        .padding = {8.0f, 8.0f, 6.0f, 3.0f},
        .gap = 12.0f}}
      style={tokens::frame_patch(tokens::kInsetStroke)}
    >
      <ChatLog key="logcol" />
      <Box
        key="prescol"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Column,
          .align_items = ::ui::AlignItems::Start,
          .width = ::ui::Length::points(150.0f),
          .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
      >
        <Text
          key="il"
          value={props.pregame ? "Pregame" : "In Lobby"}
          layout={{.height = ::ui::Length::points(tokens::kLineBody)}}
          style={tokens::text_patch(tokens::kTextPresenceHeader, tokens::kFontBodyEm, tokens::kFaceBody, tokens::kLineBody)}
        />
        <BodyText key="p" variant={BodyTextVariant::Detail} value={props.presence} />
      </Box>
    </Box>
    <Box
      key="ingap"
      layout={::ui::LayoutStyle{
        .height = ::ui::Length::points(6.0f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
    />
    <Box
      key="inputstrip"
      layout={::ui::LayoutStyle{
        .width = ::ui::Length::percent(100.0f),
        .height = ::ui::Length::points(25.0f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
      style={tokens::frame_patch(tokens::kInsetStroke)}
    >
      <LobbyChatCompose key="compose" send={props.send} caretColor={props.caret_color} />
    </Box>
  </Box>
}

// Select-Map filename rows (create-game mode), capped at kMaxMapRows so the
// list shows without scrolling.
std::vector<::ui::UiElement> map_list_rows(const std::vector<std::string> &maps,
                                           int *map_index, int *hovered_map) {
  constexpr int kMaxMapRows = 14;
  std::vector<::ui::UiElement> rows;
  for (int i = 0; i < (int)maps.size() && i < kMaxMapRows; ++i) {
    const char *mk = ::ui::copy_string(("m" + std::to_string(i)).c_str());
    const char *mv = ::ui::copy_string(maps[i].c_str());
    std::function<void(const ::ui::ActivationEvent &)> pick =
        [map_index, i](const ::ui::ActivationEvent &) { *map_index = i; };
    // Track the hovered row so the screen can float that map's minimap
    // preview at the cursor. Clear only if leaving the row we last set.
    std::function<void(const ::ui::HoverEvent &)> hover =
        [hovered_map, i](const ::ui::HoverEvent &e) {
          if (e.entered)
            *hovered_map = i;
          else if (*hovered_map == i)
            *hovered_map = -1;
        };
    rows.push_back(Box(BoxProps{
        .key = mk,
        .id = "MapRow",
        .id_offset = i,
        .focusable = true,
        .accessibility = {.label = mv},
        .on_hover = hover,
        .on_activate = pick,
        .layout = ::ui::LayoutStyle{.height = ::ui::Length::points(21.0f),
                                    .flex_shrink = ::ui::StyleFloat::points(0.0f),
                                    .padding = {6.0f, 0.0f, 2.0f, 0.0f}},
        .style = selectable_row_style(i == *map_index),
        .children = ::ui::children({BodyText(BodyTextProps{
            .key = "t", .variant = BodyTextVariant::Body, .value = mv})})}));
  }
  return rows;
}

// The cursor-following map preview: name / minimap / wrapped description stacked
// directly on the lobby backdrop (no panel/border), pinned at pointer + offset.
::ui::UiElement MapPreviewOverlay(uint32_t texture, const char *name,
                                  const char *description, float pointer_x,
                                  float pointer_y, float origin_x,
                                  float origin_y, float canvas_w) {
  if (!texture)
    return ::ui::empty();
  constexpr float kPreviewW = 172.0f * 1.5f;
  constexpr float kPreviewH = 62.0f * 1.5f;
  constexpr float kGap = 5.0f * 1.5f;
  constexpr float kOffsetX = -185.0f * 1.5f;
  constexpr float kOffsetY = -30.0f * 1.5f;
  const bool has_name = name && name[0];
  const bool has_desc = description && description[0];

  ::ui::StylePatch text_style = tokens::text_patch(
      tokens::kTextTechSlots, tokens::kFontBodyEm, tokens::kFaceBodySm,
      tokens::kLineBody);
  ::ui::StylePatch desc_style = text_style;
  desc_style.text.value.wrap = ::ui::TextWrap::Words;

  std::vector<::ui::UiElement> kids;
  if (has_name)
    kids.push_back(Box(BoxProps{
        .key = "name",
        .layout = ::ui::LayoutStyle{.width = ::ui::Length::points(kPreviewW)},
        .children = ::ui::children({Text(TextProps{
            .key = "t",
            .value = ::ui::copy_string(name),
            .layout = {.height = ::ui::Length::points(tokens::kLineBody)},
            .style = text_style})})}));
  kids.push_back(Box(BoxProps{
      .key = "img",
      .layout = ::ui::LayoutStyle{
          .width = ::ui::Length::points(kPreviewW),
          .height = ::ui::Length::points(kPreviewH),
          .flex_shrink = ::ui::StyleFloat::points(0.0f)},
      .style = tokens::image_patch(texture)}));
  if (has_desc)
    kids.push_back(Box(BoxProps{
        .key = "desc",
        .layout = ::ui::LayoutStyle{.width = ::ui::Length::points(kPreviewW)},
        .children = ::ui::children({Text(TextProps{
            .key = "t",
            .value = ::ui::copy_string(description),
            .layout = ::ui::LayoutStyle{.width = ::ui::Length::percent(100.0f)},
            .style = desc_style})})}));

  // The inset is measured from the ScreenLayout content box, so subtract the
  // root pad (origin_x/y) to track the true cursor. Snap the anchor to a coarse
  // grid so the IR stays byte-identical under cursor jitter (raster skip fires).
  constexpr float kAnchorGrid = 16.0f;
  const float px = std::floor((pointer_x - origin_x) / kAnchorGrid) * kAnchorGrid;
  const float py = std::floor((pointer_y - origin_y) / kAnchorGrid) * kAnchorGrid;
  float left = px + kOffsetX;
  float top = py + kOffsetY;
  // Clamp left/top inside the content box. Right/bottom clamps are approximate
  // (the card height is content-driven); clamp left against the minimap width.
  const float content_w = canvas_w - origin_x * 2.0f;
  if (left < 0.0f)
    left = 0.0f;
  if (left > content_w - kPreviewW)
    left = std::max(0.0f, content_w - kPreviewW);
  if (top < 0.0f)
    top = 0.0f;
  return <Box
    key="map-preview"
    layout={::ui::LayoutStyle{
      .position = ::ui::PositionType::Absolute,
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Start,
      .width = ::ui::Length::points(kPreviewW),
      .position_inset = ::ui::EdgeSizes{left, {}, top, {}},
      .gap = kGap}}
  >
    {::ui::children(kids)}
  </Box>
}

::ui::UiElement LobbyPaneGrid(const LobbyPaneGridProps &props) {
  const LobbyPanes &panes = props.panes;
  return <Box
    key="body"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::percent(100.0f),
      .flex_grow = ::ui::StyleFloat::points(1.0f)}}
  >
    <Box
      key="leftstack"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .width = ::ui::Length::points(panes.left_w),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
    >
      <Box
        key="toprow"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::Stretch,
          .width = ::ui::Length::percent(100.0f),
          .height = ::ui::Length::points(panes.upper_h),
          .flex_shrink = ::ui::StyleFloat::points(0.0f),
          .gap = ::ui::StyleValue::points(panes.gap)}}
      >
        {props.agent_card}
        {props.upper_right}
      </Box>
      <Box
        key="elbowrow"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .height = ::ui::Length::points(panes.gap),
          .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
      >
        <Box key="efill" layout={::ui::LayoutStyle{.flex_grow = ::ui::StyleFloat::points(1.0f)}} />
        <Box
          key="eseam"
          layout={::ui::LayoutStyle{
            .width = ::ui::Length::points(panes.gap),
            .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
          style={tokens::frame_patch_sides(tokens::kChromeStroke, false, true, false, false)}
        />
      </Box>
      <Box
        key="lowerrow"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::Stretch,
          .flex_grow = ::ui::StyleFloat::points(1.0f)}}
      >
        {props.chat_panel}
        <Box
          key="cseam"
          layout={::ui::LayoutStyle{
            .width = ::ui::Length::points(panes.gap),
            .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
          style={tokens::frame_patch_sides(tokens::kChromeStroke, false, true, false, false)}
        />
      </Box>
    </Box>
    {props.right_cell}
  </Box>
}


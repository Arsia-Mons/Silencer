    <Box
      key="cbw"
      layout={::ui::LayoutStyle{
        .position = ::ui::PositionType::Absolute,
        .position_inset = ::ui::EdgeSizes{9.0f, 9.0f, 542.0f, {}}}}
    >
      <AppButton
        key="create"
        controlId="CreateGame"
        variant={AppButtonVariant::Chrome}
        disabled={!props.can_create}
        targetFeedback={true}
        label="Create"
        onPress={props.on_create}
      />
    </Box>
  </Box>
}


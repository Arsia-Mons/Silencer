::ui::UiElement CenterCol(const CenterColProps &props) {
  // origin's RightUpperBox: the Create Game chrome button is the single
  // full-width child at the top of the box (GSelBtnCreateWrap pad L4 T4
  // virtual, button width = panel - 8 virtual -> stretch inside pad 6).
  return <Box
    key="centercol"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .justify_content = ::ui::JustifyContent::Start,
      .min_width = ::ui::Length::points(0.0f),
      .flex_basis = ::ui::Length::points(0.0f),
      .flex_grow = ::ui::StyleFloat::points(1.0f),
      .padding = {6.0f, 6.0f, 7.0f, 0.0f}}}
    style={lobby_panel_open_right()}
  >
    <AppButton
      key="creategame"
      controlId="NewGame"
      variant={AppButtonVariant::Chrome}
      targetFeedback={true}
      label="Create Game"
      onPress={props.on_create}
    />
  </Box>
}

::ui::UiElement GameBrowserFooter(const GameBrowserProps &props) {
  ::ui::UiElement spectate_btn =
      props.spectate_visible
          ? AppButton(AppButtonProps{.key = "spectate",
                                     .control_id = "SpectateGame",
                                     .variant = AppButtonVariant::Chrome,
                                     .size = AppButtonSize::Sm,
                                     .target_feedback = true,
                                     .label = "Spectate",
                                     .on_press = props.on_spectate})
          : ::ui::empty();
  ::ui::UiElement join_btn =
      props.join_visible
          ? AppButton(AppButtonProps{.key = "join",
                                     .control_id = "JoinGame",
                                     .variant = AppButtonVariant::Chrome,
                                     .size = AppButtonSize::Sm,
                                     .target_feedback = true,
                                     .label = "Join Game",
                                     .on_press = props.on_join})
          : ::ui::empty();
  return <Box
    key="footer"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(kGameSelectFooterH),
      .flex_shrink = ::ui::StyleFloat::points(0.0f),
      .padding = {0.0f, 0.0f, kTallFooterPadTop, 0.0f},
      .gap = kTallFooterGap}}
  >
    <Box
      key="info"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .width = ::ui::Length::percent(100.0f),
        .padding = {kTallInfoPadLeft, 0.0f, 0.0f, 0.0f}}}
    >
      {info_line("iname", props.info_name)}
      {info_line("imap", props.info_map)}
      {info_line("isec", props.info_security)}
      {info_line("icreator", props.info_creator)}
      {info_line("ilimits", props.info_limits)}
    </Box>
    <Box
      key="buttons"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .width = ::ui::Length::percent(100.0f),
        .gap = kTallButtonGap}}
    >
      {action_slot("spectateslot", spectate_btn)}
      {action_slot("joinslot", join_btn)}
    </Box>
  </Box>
}

::ui::UiElement GameBrowser(const GameBrowserProps &props) {
  std::vector<::ui::UiElement> rows;
  for (int i = 0; i < (int)props.entries.size(); ++i) {
    const bool on = i == props.selected;
    const char *name = ::ui::copy_string(props.entries[i].name.c_str());
    std::function<void()> select = [cb = props.on_select, i]() {
      if (cb)
        cb(i);
    };
    rows.push_back(game_row(::ui::copy_string(("gl" + std::to_string(i)).c_str()),
                            "GameRow", i, name, on, select));
  }
  return <Box
    key="browserbody"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::percent(100.0f),
      .flex_grow = ::ui::StyleFloat::points(1.0f)}}
  >
    {::ui::children(rows)}
  </Box>
}


      key="goback"
      controlId="LobbyGoBack"
      variant={AppButtonVariant::Chrome}
      size={AppButtonSize::Sm}
      targetFeedback={true}
      label="Go Back"
      onPress={props.on_go_back}
    />
  </Box>

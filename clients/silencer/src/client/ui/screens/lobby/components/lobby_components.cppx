std::vector<::ui::UiElement> map_list_rows(const std::vector<std::string> &maps,
                                           int *map_index, int *hovered_map) {
  constexpr int kMaxMapRows = 14;
  std::vector<::ui::UiElement> rows;
  for (int i = 0; i < (int)maps.size() && i < kMaxMapRows; ++i) {
    const char *mk = ::ui::copy_string(("m" + std::to_string(i)).c_str());
    const char *mv = ::ui::copy_string(maps[i].c_str());
    std::function<void(const ::ui::ActivationEvent &)> pick =
        [map_index, i](const ::ui::ActivationEvent &) { *map_index = i; };
    // SIL-216: track the hovered row so the screen can float that map's minimap
    // preview at the cursor. Clear only if leaving the row we last set.
    std::function<void(const ::ui::HoverEvent &)> hover =
        [hovered_map, i](const ::ui::HoverEvent &e) {
          if (e.entered)
            *hovered_map = i;
          else if (*hovered_map == i)
            *hovered_map = -1;
        };
    rows.push_back(Box(BoxProps{
        .key = mk,
        .id = "MapRow",
        .id_offset = i,
        .focusable = true,
        .accessibility = {.label = mv},
        .on_hover = hover,
        .on_activate = pick,
        .layout = ::ui::LayoutStyle{.height = ::ui::Length::points(21.0f),
                                    .flex_shrink = ::ui::StyleFloat::points(0.0f),
                                    .padding = {6.0f, 0.0f, 2.0f, 0.0f}},
        .style = selectable_row_style(i == *map_index),
        // origin draws every row's filename at the same palette-133 weight; the
        // solid fill bar is the only selection feedback (no bolded text).
        .children = ::ui::children({BodyText(BodyTextProps{
            .key = "t", .variant = BodyTextVariant::Body, .value = mv})})}));
  }
  return rows;
}

::ui::UiElement MapPreviewOverlay(uint32_t texture, const char *name,
                                  const char *description, float pointer_x,
                                  float pointer_y, float origin_x,
                                  float origin_y, float canvas_w) {
  if (!texture)
    return ::ui::empty();
  // origin kPreviewW/H 172x62, kPreviewGap 5, kPreviewOffset (-185,-30); x1.5.
  constexpr float kPreviewW = 172.0f * 1.5f;
  constexpr float kPreviewH = 62.0f * 1.5f;
  constexpr float kGap = 5.0f * 1.5f;
  constexpr float kOffsetX = -185.0f * 1.5f;
  constexpr float kOffsetY = -30.0f * 1.5f;
  const bool has_name = name && name[0];
  const bool has_desc = description && description[0];

  ::ui::StylePatch text_style = tokens::text_patch(
      tokens::kTextTechSlots, tokens::kFontBodyEm, tokens::kFaceBodySm,
      tokens::kLineBody);
  // origin word-wraps the description at 29 chars and renders it newline-only;
  // wrapping the cppx Text to the minimap width reproduces the multi-line block.
  ::ui::StylePatch desc_style = text_style;
  desc_style.text.value.wrap = ::ui::TextWrap::Words;

  std::vector<::ui::UiElement> kids;
  if (has_name)
    kids.push_back(Box(BoxProps{
        .key = "name",
        .layout = ::ui::LayoutStyle{.width = ::ui::Length::points(kPreviewW)},
        .children = ::ui::children({Text(TextProps{
            .key = "t",
            .value = ::ui::copy_string(name),
            .layout = {.height = ::ui::Length::points(tokens::kLineBody)},
            .style = text_style})})}));
  kids.push_back(Box(BoxProps{
      .key = "img",
      .layout = ::ui::LayoutStyle{
          .width = ::ui::Length::points(kPreviewW),
          .height = ::ui::Length::points(kPreviewH),
          .flex_shrink = ::ui::StyleFloat::points(0.0f)},
      .style = tokens::image_patch(texture)}));
  if (has_desc)
    kids.push_back(Box(BoxProps{
        .key = "desc",
        .layout = ::ui::LayoutStyle{.width = ::ui::Length::points(kPreviewW)},
        .children = ::ui::children({Text(TextProps{
            .key = "t",
            .value = ::ui::copy_string(description),
            .layout = ::ui::LayoutStyle{.width = ::ui::Length::percent(100.0f)},
            .style = desc_style})})}));

  // The pointer is in full-canvas logical space; the overlay's absolute inset is
  // measured from the ScreenLayout root's content box (after its pad). Subtract
  // the root pad (origin_x/origin_y) so the card tracks the true cursor, then
  // apply origin's pointer offset. SIL-237: snap the anchor to a coarse grid so
  // the IR stays byte-identical under cursor jitter and the raster skip fires.
  constexpr float kAnchorGrid = 16.0f;
  const float px = std::floor((pointer_x - origin_x) / kAnchorGrid) * kAnchorGrid;
  const float py = std::floor((pointer_y - origin_y) / kAnchorGrid) * kAnchorGrid;
  float left = px + kOffsetX;
  float top = py + kOffsetY;
  // Clamp the card's left/top inside the canvas content box (origin clamps to
  // the screen). Right/bottom clamps are approximate — the card height is
  // content-driven; clamp the left edge against the known minimap width.
  const float content_w = canvas_w - origin_x * 2.0f;
  if (left < 0.0f)
    left = 0.0f;
  if (left > content_w - kPreviewW)
    left = std::max(0.0f, content_w - kPreviewW);
  if (top < 0.0f)
    top = 0.0f;
  return <Box
    key="map-preview"
    layout={::ui::LayoutStyle{
      .position = ::ui::PositionType::Absolute,
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Start,
      .width = ::ui::Length::points(kPreviewW),
      .position_inset = ::ui::EdgeSizes{left, {}, top, {}},
      .gap = kGap}}
  >
    {::ui::children(kids)}
  </Box>
}

::ui::UiElement LobbyPaneGrid(const LobbyPaneGridProps &props) {
  const LobbyPanes &panes = props.panes;
  return <Box
    key="body"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::percent(100.0f),
      .flex_grow = ::ui::StyleFloat::points(1.0f)}}
  >
    <Box
      key="leftstack"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .width = ::ui::Length::points(panes.left_w),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
    >
      <Box
        key="toprow"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::Stretch,
          .width = ::ui::Length::percent(100.0f),
          .height = ::ui::Length::points(panes.upper_h),
          .flex_shrink = ::ui::StyleFloat::points(0.0f),
          .gap = ::ui::StyleValue::points(panes.gap)}}
      >
        {props.agent_card}
        {props.upper_right}
      </Box>
      <Box
        key="elbowrow"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .height = ::ui::Length::points(panes.gap),
          .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
      >
        <Box key="efill" layout={::ui::LayoutStyle{.flex_grow = ::ui::StyleFloat::points(1.0f)}} />
        <Box
          key="eseam"
          layout={::ui::LayoutStyle{
            .width = ::ui::Length::points(panes.gap),
            .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
          style={tokens::frame_patch_sides(tokens::kChromeStroke, false, true, false, false)}
        />
      </Box>
      <Box
        key="lowerrow"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::Stretch,
          .flex_grow = ::ui::StyleFloat::points(1.0f)}}
      >
        {props.chat_panel}
        <Box
          key="cseam"
          layout={::ui::LayoutStyle{
            .width = ::ui::Length::points(panes.gap),
            .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
          style={tokens::frame_patch_sides(tokens::kChromeStroke, false, true, false, false)}
        />
      </Box>
    </Box>
    {props.right_cell}
  </Box>
}


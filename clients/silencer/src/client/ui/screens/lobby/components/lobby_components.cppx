                .children = ::ui::children({Text(TextProps{
                    .key = "mapname",
                    .value = props.map_name,
                    .layout = {.height = ::ui::Length::points(tokens::kLineHeading)},
                    .style = tokens::text_patch(tokens::kTextProse,
                                                tokens::kFontHeading,
                                                tokens::kFaceHeading,
                                                tokens::kLineHeading)})})})
          : ::ui::empty();
  return <Box
    key="titlebar"

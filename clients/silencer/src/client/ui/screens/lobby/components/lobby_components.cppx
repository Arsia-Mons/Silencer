// --- top-level sections -------------------------------------------------------

// The full-width header strip: brand + amber version + (staging) map name in
// aligned slots, spring, Go Back.


// The upper-left agent card: emblem rail + name + WINS/LOSSES/XP column +
// loadout stat well + the Agents button.



::ui::UiElement LobbyChatCompose(const LobbyChatComposeProps &props) {
  std::string *compose = use_state<std::string>(std::string());
  std::string *live = use_state<std::string>(std::string());
  if (!compose || !live)
    return ::ui::empty();
  *live = *compose;

  std::function<void(const std::string &)> on_change =
      [compose, live](const std::string &value) {
        std::string next = cap_lobby_chat_text(value);
        *compose = next;
        *live = next;
      };
  std::function<void(const ::ui::ActivationEvent &)> on_activate =
      [compose, live, send = props.send](const ::ui::ActivationEvent &) {
        std::string message = cap_lobby_chat_text(*live);
        if (message.empty())
          return;
        if (send)
          send(message);
        compose->clear();
        live->clear();
      };
  const ::ui::StyleStatePatch field_style =
      tokens::chromeless_field_style(props.caret_color, tokens::kTextBody);

  return <Input
    key="field"
    id="LobbyChat"
    accessibility={{.label = "Chat"}}
    onActivate={on_activate}
    value={compose->c_str()}
    onChange={on_change}
    layout={::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::Start,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::percent(100.0f),
      .padding = {6.0f, 0.0f, 0.0f, 0.0f}}}
    style={field_style}
  />
}


// The scrollable chat transcript. A flex-grown auto-measuring ScrollView fills
// the chat well: it learns its own viewport height and the (variable-height,
// word-wrapped) transcript's content height from the layout read-back, so it
// scrolls ONLY when the transcript overflows — a short chat neither rubber-bands
// nor shows a scrollbar. `stick_to_bottom` keeps the newest line pinned and
// auto-follows new messages (until the user scrolls up into history). The
// viewport is focusable so the wheel routes to it; the chromeless style
// suppresses the builder-injected focus ring (which gates on `chromeless`).

::ui::UiElement ChatLog(const ChatLogProps &props) {
  ::ui::StylePatch st =
      tokens::text_patch(tokens::kTextBodyMuted, tokens::kFontBodyEm,
                         tokens::kFaceBody, tokens::kLineBody);
  st.text.value.wrap = ::ui::TextWrap::Words;
  ::ui::StyleStatePatch text_style{};
  text_style.base = st;

  ::ui::StyleStatePatch scroll_style{};
  scroll_style.base = tokens::chromeless_clear_patch();
  scroll_style.focus_visible = scroll_style.base;

  return ::ui::component(
      "ScrollView",
      ScrollViewProps{
          .key = props.key,
          .id = "ChatLog",
          .step = tokens::kLineBody,
          .show_scrollbar = false,
          .stick_to_bottom = true,
          .layout = ::ui::LayoutStyle{
              .align_items = ::ui::AlignItems::Start,
              .min_width = ::ui::Length::points(0.0f)},
          .style = scroll_style,
          .children = ::ui::children({Text(TextProps{
              .key = "log",
              .value = props.scrollback,
              .layout = {.width = ::ui::Length::percent(100.0f)},
              .style = text_style})})},
      ScrollView);
}


// The lower-left chat panel: channel title, log well + presence column, and the
// lobby chat compose field.


// Selected-row styling for the Select-Map list. origin draws the selected row
// as a single solid filled rectangle (renderer.cpp SELECTBOX:
// DrawFilledRectangle(..., 180)) — no border, no rounded corners, and no hover
// or focus highlight (selecting is mouse-driven; the fill is the only feedback).
// Matching that: selected = an opaque legacy-palette-180 bar, everything else
// clear. No outline box (that was the SIL-233 regression).
::ui::StyleStatePatch selectable_row_style(bool selected) {
  // The map rows are focusable for keyboard nav, but origin shows no focus ring
  // on the list — selection is the only feedback. Both states carry
  // `chromeless` so the renderer's intrinsic focus-ring injection is suppressed
  // (draw_command_builder gates it on !chromeless, for any focused node — mouse
  // or keyboard). The selected row keeps its explicit fill (an explicit
  // background always draws, even on a chromeless node).
  const ::ui::StylePatch selected_fill =
      ::ui::patch().chromeless(true).background(tokens::kRowSelectFill);
  ::ui::StyleStatePatch s{};
  s.base = selected ? selected_fill : tokens::chromeless_clear_patch();
  return s;
}


// Select-Map filename rows (create-game mode), capped at what the cell shows
// without scrolling (golden lists ~13). origin kMapListLineH = 14 virtual px
// -> 21 logical row slots; rows inset text 4 virtual (6) with a 2 top bias so
// the ink-centered pen lands on origin's cell (94+14k).

// SIL-216 / SIL-231: the cursor-following map preview. origin's
// BuildHoverPreviewOverlay (game_create_panel_map_form.cpp) stacks three
// chromeless elements TOP_TO_BOTTOM — name (BodySm, no wrap) -> 172x62 minimap
// -> word-wrapped description (BodySm) — directly on the lobby backdrop (NO
// panel/border), pinned to the screen root at pointer + (-185,-30) and clamped
// to the screen. All origin-virtual values are scaled x1.5 onto the cppx logical
// canvas (the rest of the lobby uses the same factor). The name/desc render in
// origin's dim grey LegacyPalette(129,160) ramp (== tokens::kTextTechSlots).
// Returns empty when nothing is hovered or the texture isn't baked.

// The stepped-pane cockpit grid (origin ResolveSteppedPaneLayout): left stack
// (agent card + upper-right swap over the chat row) beside the right tall
// cell, joined by the elbow/column hairline seams.

// origin security label (game_select_panel): the u8 → text mapping shown in the
// Game Options panel. Internal — only the create-options rows use it.
const char *security_label(uint8_t security) {
  switch (security) {
  case 0:
    return "None";
  case 1:
    return "Low";
  case 2:
    return "Medium";
  case 3:
    return "High";
  default:
    return "Medium";
  }
}


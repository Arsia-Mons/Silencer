    </Box>
    <Box
      key="pwl"
      layout={::ui::LayoutStyle{
        .position = ::ui::PositionType::Absolute,
        .position_inset = ::ui::EdgeSizes{9.0f, {}, 487.0f, {}}}}
    >
      <ScreenTitle key="t" variant={ScreenTitleVariant::Console} value="Password (optional):" />
    </Box>
    <Box
      key="pwv"
      layout={::ui::LayoutStyle{
        .position = ::ui::PositionType::Absolute,
        .width = ::ui::Length::points(264.0f),

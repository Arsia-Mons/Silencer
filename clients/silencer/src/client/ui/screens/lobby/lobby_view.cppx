struct RightUpperPanelProps {
	const char * key = nullptr;
};

::ui::UiElement RightUpperPanel(const RightUpperPanelProps& props) {
	(void)props;
	const LobbySurface& surface = UseLobbySurface();
	if(surface.game_create_active){
		return <GameCreateUpper key="create-upper-root" />
	}
	if(surface.game_join_active){
		return <GameJoinUpper key="join-upper-root" />
	}
	if(surface.game_tech_active){
		return <GameTechUpper key="tech-upper-root" />
	}
	return <GameSelectUpper key="select-upper-root" />
}

struct RightTallPanelProps {
	const char * key = nullptr;
};

::ui::UiElement RightTallPanel(const RightTallPanelProps& props) {
	(void)props;
	const LobbySurface& surface = UseLobbySurface();
	if(surface.game_create_active){
		return <GameCreateTall key="create-tall-root" />
	}
	if(surface.game_join_active){
		return <GameJoinTall key="join-tall-root" />
	}
	if(surface.game_tech_active){
		return <GameTechTall key="tech-tall-root" />
	}
	return <GameSelectTall key="select-tall-root" />
}

struct LobbyBodyProps {
	const char * key = nullptr;
};

::ui::UiElement LobbyBody(const LobbyBodyProps& props) {
	(void)props;
	return <Box key="body" layout={body_layout()}>
		<Box key="left" layout={left_stack_layout()}>
			<Box key="upper-row" layout={upper_row_layout()}>
				<CharacterPanel key="character" />
				<RightUpperPanel key="right-upper" />
			</Box>
			<ChatPanel key="chat" />
		</Box>
		<RightTallPanel key="right-tall" />
	</Box>
}

}  // namespace

::ui::UiElement LobbyFrame(const LobbyFrameProps& props) {
	(void)props;
	return <Box key="root" layout={root_layout()} style={root_style()}>
		<TitleBar key="title" />
		<LobbyBody key="body" />
	</Box>
}

}  // namespace silencer::client_ui::lobby

constexpr int kVisibleChatLines = 8;
constexpr int kVisiblePresenceLines = 7;

const char * kAgencyNames[] = {
	"Noxis",
	"Lazarus",
	"Caliber",
	"Static",
	"Black Rose",
};

const char * safe_text(const char * value) {
	return value ? value : "";
}

const char * agency_name(int agency) {
	if(agency < 0 || agency >= static_cast<int>(sizeof(kAgencyNames) / sizeof(kAgencyNames[0]))){
		return "Unknown";
	}
	return kAgencyNames[agency];
}

std::function<void(const ::ui::ActivationEvent&)> action_callback(
	std::function<void()> action) {
	return [action](const ::ui::ActivationEvent&) {
		if(action) action();
	};
}

std::function<void(const ::ui::ActivationEvent&)> index_action_callback(
	std::function<void(int)> action,
	int index) {
	return [action, index](const ::ui::ActivationEvent&) {
		if(action) action(index);
	};
}

std::function<void(const ::ui::FocusEvent&)> index_focus_callback(
	std::function<void(int)> action,
	int index) {
	return [action, index](const ::ui::FocusEvent&) {
		if(action) action(index);
	};
}

std::function<void(const ::ui::KeyEvent&)> action_on_enter(std::function<void()> action) {
	return [action](const ::ui::KeyEvent& event) {
		if(event.key == ::ui::UiKey::Enter && action) action();
	};
}

::ui::Border panel_border(::ui::Color color) {
	return ::ui::Border{
		.width = {1.0f, 1.0f, 1.0f, 1.0f},
		.color = {color, color, color, color},
	};
}

::ui::StyleStatePatch root_style() {
	return ::ui::patch().background(::ui::Color{9, 13, 18, 255});
}

::ui::StyleStatePatch panel_style() {
	return ::ui::patch()
		.background(::ui::Color{25, 31, 38, 245})
		.border(panel_border(::ui::Color{78, 92, 108, 255}));
}

::ui::StyleStatePatch inner_panel_style() {
	return ::ui::patch()
		.background(::ui::Color{16, 21, 27, 232})
		.border(panel_border(::ui::Color{52, 63, 76, 255}));
}

::ui::StyleStatePatch row_style(bool selected) {
	if(!selected) return {};
	return ::ui::patch()
		.background(::ui::Color{64, 82, 92, 255})
		.border(panel_border(::ui::Color{178, 198, 142, 255}));
}

::ui::StyleStatePatch text_style(::ui::Color color,
                                 ::ui::TextAlign align = ::ui::TextAlign::Left,
                                 ::ui::TextWrap wrap = ::ui::TextWrap::None,
                                 int font_size = 7) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = color,
		.font_id = 133,
		.font_size = static_cast<uint16_t>(font_size),
		.align = align,
		.wrap = wrap,
	});
}

::ui::StyleStatePatch heading_style() {
	return text_style(::ui::Color{236, 214, 116, 255}, ::ui::TextAlign::Left, ::ui::TextWrap::None, 8);
}

::ui::StyleStatePatch muted_style() {
	return text_style(::ui::Color{156, 169, 181, 255});
}


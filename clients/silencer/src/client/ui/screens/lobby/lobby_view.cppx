		  id="lobby.game_create.security"
		  label={security_label(snapshot->securityIndex)}
		  onActivate={action_callback(gameCreate.cycle_security)}
		  layout={row_button_layout(25.0f)}
		/>
		<Button
		  key="spectatable"
		  id="lobby.game_create.spectatable"
		  label={snapshot->spectatable ? "Spectatable: Yes" : "Spectatable: No"}
		  onActivate={action_callback(gameCreate.toggle_spectatable)}
		  layout={row_button_layout(25.0f)}
		/>
	</Box>
}

struct GameCreateTallProps {
	const char * key = nullptr;
};

::ui::UiElement GameCreateTall(const GameCreateTallProps& props) {
	(void)props;
	const LobbyGameCreate& gameCreate = UseLobbyGameCreate();
	const GameCreatePanelState * snapshot = gameCreate.snapshot;
	if(!snapshot) return ::ui::empty();
	return <Box key="create-tall" layout={side_panel_layout()} style={panel_style()}>
		<SectionHeading key="heading" value="SELECT MAP" />
		<Box key="map-scroll" layout={compact_actions_layout()}>
			<Button
			  key="prev"
			  id="lobby.game_create.map.prev"
			  label="Prev"
			  onActivate={index_action_callback(gameCreate.scroll_maps, -kGameCreateVisibleMapRows)}
			  layout={compact_button_layout()}
			/>
			<Button
			  key="next"
			  id="lobby.game_create.map.next"
			  label="Next"
			  onActivate={index_action_callback(gameCreate.scroll_maps, kGameCreateVisibleMapRows)}
			  layout={compact_button_layout()}
			/>
		</Box>
		<MapRow key="map-0" slot={0} />
		<MapRow key="map-1" slot={1} />
		<MapRow key="map-2" slot={2} />
		<MapRow key="map-3" slot={3} />
		<MapRow key="map-4" slot={4} />
		<MapRow key="map-5" slot={5} />
		<MapRow key="map-6" slot={6} />
		<Box
		  key="fields"
		  id={kGameCreateOptionsScrollId}
		  accessibility={::ui::components::AccessibilityProps{.label = kGameCreateOptionsScrollLabel, .description = "scroll"}}
		  layout={game_create_options_viewport_layout()}
		  style={inner_panel_style()}
		>
			<Box
			  key="fields-content"
			  layout={game_create_options_content_layout(snapshot->optionsScrollPosition)}
			>
				<Input
				  key="name"
				  id="lobby.game_create.name"
				  value={snapshot->name}
				  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Game name"}}
				  onChange={gameCreate.set_name}
				  layout={row_button_layout(26.0f)}
				/>
				<Input
				  key="password"
				  id="lobby.game_create.password"
				  value={snapshot->password}
				  password={true}
				  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Game password"}}
				  onChange={gameCreate.set_password}
				  layout={row_button_layout(26.0f)}
				/>
				<Input
				  key="min-level"
				  id="lobby.game_create.min_level"
				  value={snapshot->minLevel}
				  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Min level"}}
				  onChange={gameCreate.set_min_level}
				  layout={row_button_layout(24.0f)}
				/>
				<Input
				  key="max-level"
				  id="lobby.game_create.max_level"
				  value={snapshot->maxLevel}
				  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Max level"}}
				  onChange={gameCreate.set_max_level}
				  layout={row_button_layout(24.0f)}
				/>
				<Input
				  key="max-players"
				  id="lobby.game_create.max_players"
				  value={snapshot->maxPlayers}
				  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Max players"}}
				  onChange={gameCreate.set_max_players}
				  layout={row_button_layout(24.0f)}
				/>
				<Input
				  key="max-teams"
				  id="lobby.game_create.max_teams"
				  value={snapshot->maxTeams}
				  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Max teams"}}
				  onChange={gameCreate.set_max_teams}
				  layout={row_button_layout(24.0f)}
				/>
			</Box>
		</Box>
		<Button
		  key="create"
		  id="lobby.game_create.create"
		  label="Create"
		  onActivate={action_callback(gameCreate.submit)}
		  layout={row_button_layout(28.0f)}
		/>
	</Box>
}


::ui::EdgeSizes game_create_options_content_position(Uint16 scrollPosition) {
	::ui::EdgeSizes inset;
	inset.top = ::ui::StyleValue::points(-30.0f * static_cast<float>(scrollPosition));
	return inset;
}

::ui::LayoutStyle game_create_options_content_layout(Uint16 scrollPosition) {
	return ::ui::LayoutStyle{
		.position = ::ui::PositionType::Relative,
		.position_inset = game_create_options_content_position(scrollPosition),
		.direction = ::ui::FlexDirection::Column,
		.width = ::ui::Length::percent(100.0f),
		.gap = 6.0f,
	};
}

const char * security_label(Uint8 index) {
	switch(index){
		case LobbyGame::SECLOW: return "Security: Low";
		case LobbyGame::SECMEDIUM: return "Security: Medium";
		case LobbyGame::SECHIGH: return "Security: High";
		default: return "Security: Off";
	}
}

struct SectionHeadingProps {
	const char * key = nullptr;
	const char * value = nullptr;
};

::ui::UiElement SectionHeading(const SectionHeadingProps& props) {
	return <Text
	  key={props.key}
	  value={props.value}
	  layout={text_line_layout(18.0f)}
	  style={heading_style()}
	/>
}

struct FieldTextProps {
	const char * key = nullptr;
	const char * value = nullptr;
	::ui::LayoutStyle layout = {};
	::ui::StyleStatePatch style = {};
};

::ui::UiElement FieldText(const FieldTextProps& props) {
	return <Text
	  key={props.key}
	  value={safe_text(props.value)}
	  layout={props.layout.width.kind == ::ui::LengthKind::Undefined ? text_line_layout() : props.layout}
	  style={props.style.base.text.set ? props.style : muted_style()}
	/>
}

struct TitleBarProps {
	const char * key = nullptr;
};

::ui::UiElement TitleBar(const TitleBarProps& props) {
	(void)props;
	const LobbyChrome& chrome = UseLobbyChrome();
	const LobbyNavigation& navigation = UseLobbyNavigation();
	const char * meta = chrome.map_name && chrome.map_name[0] != '\0'
		? use_text_storage("%s    %s", chrome.version, chrome.map_name)
		: safe_text(chrome.version);
	return <Box key="title-bar" layout={title_bar_layout()} style={panel_style()}>
		<Text
		  key="title"
		  value="Silencer"
		  layout={title_layout()}
		  style={text_style(::ui::Color{238, 242, 246, 255}, ::ui::TextAlign::Left, ::ui::TextWrap::None, 16)}
		/>
		<Text key="meta" value={meta} layout={title_meta_layout()} style={muted_style()} />
		<Button
		  key="back"
		  id="lobby.go_back"
		  label="Go Back"
		  onActivate={action_callback(navigation.go_back)}
		  layout={small_button_layout(94.0f)}
		/>
	</Box>
}

struct CharacterPanelProps {
	const char * key = nullptr;
};

::ui::UiElement CharacterPanel(const CharacterPanelProps& props) {
	(void)props;
	const LobbyCharacter& character = UseLobbyCharacter();
	const CharacterPanelState * snapshot = character.snapshot;
	if(!snapshot) return ::ui::empty();
	const bool locked = snapshot->agentSelectionLocked;
	return <Box key="character" layout={character_panel_layout()} style={panel_style()}>
		<SectionHeading key="heading" value="AGENT" />
		<FieldText key="name" value={snapshot->agentName.c_str()} />
		<FieldText key="agency" value={agency_name(snapshot->selectedAgency)} />
		<FieldText key="level" value={snapshot->levelText.c_str()} />
		<FieldText key="record" value={snapshot->recordText.c_str()} />
		<FieldText key="stats-a" value={snapshot->statsLineA.c_str()} />
		<FieldText key="stats-b" value={snapshot->statsLineB.c_str()} />
		<Button
		  key="agents"
		  id="lobby.character.agents"
		  label={locked ? "Agent Locked" : "Change Agent"}
		  disabled={locked}
		  onActivate={action_callback(character.change_agent)}
		  layout={row_button_layout(26.0f)}
		/>
	</Box>
}

struct ChatLineRowProps {
	const char * key = nullptr;
	int slot = 0;
	bool presence = false;
};

::ui::UiElement ChatLineRow(const ChatLineRowProps& props) {
	const LobbyChat& chat = UseLobbyChat();
	const ChatPanelState * snapshot = chat.snapshot;
	if(!snapshot) return ::ui::empty();
	if(props.presence){
		int start = static_cast<int>(snapshot->presenceLines.size()) - kVisiblePresenceLines;
		if(start < 0) start = 0;
		int index = start + props.slot;
		if(index < 0 || index >= static_cast<int>(snapshot->presenceLines.size())) return ::ui::empty();
		return <Text
		  key={props.key}
		  value={snapshot->presenceLines[static_cast<size_t>(index)].text.c_str()}
		  layout={text_line_layout(15.0f)}
		  style={muted_style()}
		/>
	}
	int start = static_cast<int>(snapshot->chatLines.size()) - kVisibleChatLines;
	if(start < 0) start = 0;
	int index = start + props.slot;
	if(index < 0 || index >= static_cast<int>(snapshot->chatLines.size())) return ::ui::empty();
	return <Text
	  key={props.key}
	  value={snapshot->chatLines[static_cast<size_t>(index)].text.c_str()}
	  layout={text_line_layout(15.0f)}
	  style={text_style(::ui::Color{222, 231, 238, 255})}
	/>
}

struct ChatPanelProps {
	const char * key = nullptr;
};

::ui::UiElement ChatPanel(const ChatPanelProps& props) {
	(void)props;
	const LobbyChat& chat = UseLobbyChat();
	const ChatPanelState * snapshot = chat.snapshot;
	if(!snapshot) return ::ui::empty();
	const char * channel = snapshot->channel.empty() ? "Lobby" : snapshot->channel.c_str();
	return <Box key="chat" layout={chat_panel_layout()} style={panel_style()}>
		<SectionHeading key="heading" value={channel} />
		<Box key="body" layout={chat_body_layout()}>
			<Box key="log" layout={chat_log_layout()} style={inner_panel_style()}>
				<ChatLineRow key="chat-0" slot={0} />
				<ChatLineRow key="chat-1" slot={1} />
				<ChatLineRow key="chat-2" slot={2} />
				<ChatLineRow key="chat-3" slot={3} />
				<ChatLineRow key="chat-4" slot={4} />
				<ChatLineRow key="chat-5" slot={5} />
				<ChatLineRow key="chat-6" slot={6} />
				<ChatLineRow key="chat-7" slot={7} />
			</Box>
			<Box key="presence" layout={presence_layout()} style={inner_panel_style()}>
				<ChatLineRow key="presence-0" slot={0} presence={true} />
				<ChatLineRow key="presence-1" slot={1} presence={true} />
				<ChatLineRow key="presence-2" slot={2} presence={true} />
				<ChatLineRow key="presence-3" slot={3} presence={true} />
				<ChatLineRow key="presence-4" slot={4} presence={true} />
				<ChatLineRow key="presence-5" slot={5} presence={true} />
				<ChatLineRow key="presence-6" slot={6} presence={true} />
			</Box>
		</Box>
		<Box key="input-row" layout={input_row_layout()}>
			<Input
			  key="input"
			  id="lobby.chat.input"
			  value={snapshot->inputBuffer}
			  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Chat message"}}
			  onChange={chat.set_text}
			  onKey={action_on_enter(chat.send)}
			  layout={input_grow_layout()}
			/>
			<Button
			  key="send"
			  id="lobby.chat.send"
			  label="Send"
			  onActivate={action_callback(chat.send)}
			  layout={small_button_layout(72.0f)}
			/>
		</Box>
	</Box>
}

struct GameRowProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement GameRow(const GameRowProps& props) {
	const LobbyGameSelect& gameSelect = UseLobbyGameSelect();
	const GameSelectPanelState * snapshot = gameSelect.snapshot;
	if(!snapshot) return ::ui::empty();
	int start = snapshot->scrollPos;
	int index = start + props.slot;
	if(index < 0 || index >= static_cast<int>(snapshot->rows.size())) return ::ui::empty();
	bool selected = index == snapshot->selectedIndex;
	return <Button
	  key={props.key}
	  id="lobby.game_select.row"
	  idOffset={index}
	  label={snapshot->rows[static_cast<size_t>(index)].name.c_str()}
	  selected={selected}
	  onActivate={index_action_callback(gameSelect.select, index)}
	  layout={row_button_layout(24.0f)}
	  style={row_style(selected)}
	/>
}

struct GameSelectUpperProps {
	const char * key = nullptr;
};

::ui::UiElement GameSelectUpper(const GameSelectUpperProps& props) {
	(void)props;
	const LobbyGameSelect& gameSelect = UseLobbyGameSelect();
	const GameSelectPanelState * snapshot = gameSelect.snapshot;
	if(!snapshot) return ::ui::empty();
	return <Box key="select-upper" layout={upper_panel_layout()} style={panel_style()}>
		<SectionHeading key="heading" value="GAME SELECT" />
		<Button
		  key="create"
		  id="lobby.game_select.create"
		  label="Create Game"
		  onActivate={action_callback(gameSelect.create)}
		  layout={row_button_layout(30.0f)}
		/>
		<FieldText
		  key="count"
		  value={use_text_storage("%d active games", static_cast<int>(snapshot->rows.size()))}
		/>
	</Box>
}

struct GameSelectTallProps {
	const char * key = nullptr;
};

::ui::UiElement GameSelectTall(const GameSelectTallProps& props) {
	(void)props;
	const LobbyGameSelect& gameSelect = UseLobbyGameSelect();
	const GameSelectPanelState * snapshot = gameSelect.snapshot;
	if(!snapshot) return ::ui::empty();
	return <Box key="select-tall" layout={side_panel_layout()} style={panel_style()}>
		<SectionHeading key="heading" value="ACTIVE GAMES" />
		<Box key="game-scroll" layout={compact_actions_layout()}>
			<Button
			  key="prev"
			  id="lobby.game_select.prev"
			  label="Prev"
			  onActivate={index_action_callback(gameSelect.scroll, -kGameSelectVisibleRows)}
			  layout={compact_button_layout()}
			/>
			<Button
			  key="next"
			  id="lobby.game_select.next"
			  label="Next"
			  onActivate={index_action_callback(gameSelect.scroll, kGameSelectVisibleRows)}
			  layout={compact_button_layout()}
			/>
		</Box>
		<GameRow key="game-0" slot={0} />
		<GameRow key="game-1" slot={1} />
		<GameRow key="game-2" slot={2} />
		<GameRow key="game-3" slot={3} />
		<GameRow key="game-4" slot={4} />
		<GameRow key="game-5" slot={5} />
		<GameRow key="game-6" slot={6} />
		<GameRow key="game-7" slot={7} />
		<Box key="info" layout={create_options_layout()} style={inner_panel_style()}>
			<FieldText key="name" value={snapshot->infoName.c_str()} />
			<FieldText key="map" value={snapshot->infoMap.c_str()} />
			<FieldText key="security" value={snapshot->infoSecurity.c_str()} />
			<FieldText key="creator" value={snapshot->infoCreator.c_str()} />
			<FieldText key="limits" value={snapshot->infoLimits.c_str()} />
		</Box>
		<Button
		  key="spectate"
		  id="lobby.game_select.spectate"
		  label="Spectate"
		  disabled={!snapshot->spectateVisible}
		  onActivate={action_callback(gameSelect.spectate)}
		  layout={row_button_layout(27.0f)}
		/>
		<Button
		  key="join"
		  id="lobby.game_select.join"
		  label="Join"
		  disabled={!snapshot->joinVisible}
		  onActivate={action_callback(gameSelect.join)}
		  layout={row_button_layout(27.0f)}
		/>
	</Box>
}

struct MapRowProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement MapRow(const MapRowProps& props) {
	const LobbyGameCreate& gameCreate = UseLobbyGameCreate();
	const GameCreatePanelState * snapshot = gameCreate.snapshot;
	if(!snapshot) return ::ui::empty();
	int start = snapshot->mapScrollPos;
	int index = start + props.slot;
	if(index < 0 || index >= static_cast<int>(snapshot->maps.size())) return ::ui::empty();
	return <Button
	  key={props.key}
	  id="lobby.game_create.map"
	  idOffset={index}
	  label={snapshot->maps[static_cast<size_t>(index)].c_str()}
	  selected={index == snapshot->mapSelectedIndex}
	  onActivate={index_action_callback(gameCreate.select_map, index)}
	  layout={row_button_layout(23.0f)}
	  style={row_style(index == snapshot->mapSelectedIndex)}
	/>
}

struct GameCreateUpperProps {
	const char * key = nullptr;

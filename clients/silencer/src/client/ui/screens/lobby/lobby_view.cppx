struct RosterRowProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement RosterRow(const RosterRowProps& props) {
	const LobbyGameJoin& gameJoin = UseLobbyGameJoin();
	const GameJoinPanelState * snapshot = gameJoin.snapshot;
	if(!snapshot) return ::ui::empty();
	if(props.slot < 0 || props.slot >= static_cast<int>(snapshot->rosterRows.size())) return ::ui::empty();
	const GameJoinRosterRow& row = snapshot->rosterRows[static_cast<size_t>(props.slot)];
	return <Text
	  key={props.key}
	  value={use_text_storage("%s T%u %s %s", row.ready ? "Ready" : "Wait", row.teamNumber, agency_name(row.agency), row.name.c_str())}
	  layout={text_line_layout(17.0f)}
	  style={text_style(::ui::Color{226, 234, 242, 255})}
	/>
}


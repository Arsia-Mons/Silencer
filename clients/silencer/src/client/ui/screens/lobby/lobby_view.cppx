struct TechRowProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement TechRow(const TechRowProps& props) {
	const LobbyGameTech& gameTech = UseLobbyGameTech();
	const GameTechPanelState * snapshot = gameTech.snapshot;
	if(!snapshot) return ::ui::empty();
	if(props.slot < 0 || props.slot >= static_cast<int>(snapshot->techRows.size())) return ::ui::empty();
	const GameTechRow& row = snapshot->techRows[static_cast<size_t>(props.slot)];
	if(!row.visible) return ::ui::empty();
	return <Button
	  key={props.key}
	  id="lobby.game_tech.toggle"
	  idOffset={props.slot}
	  label={row.label.c_str()}
	  selected={row.selected}
	  onFocus={index_focus_callback(gameTech.preview, props.slot)}
	  onActivate={index_action_callback(gameTech.toggle, props.slot)}
	  layout={row_button_layout(23.0f)}
	  style={row_style(row.selected)}
	/>
}


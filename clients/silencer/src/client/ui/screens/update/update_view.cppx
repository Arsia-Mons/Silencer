#include "client/ui/screens/update/update_view.h"

#include "client/ui/hooks/use_navigation.h"
#include "client/ui/screens/main_menu/main_menu_screen.h"
#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/dialog.h"
#include "ui/components/text.h"

#include <memory>

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Dialog;
using ::ui::components::DialogProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::LayoutStyle dialog_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(352.0f),
		.height = ::ui::Length::points(178.0f),
		.padding = {34.0f, 34.0f, 42.0f, 42.0f},
		.gap = 12.0f,
	};
}

::ui::LayoutStyle status_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(284.0f),
		.height = ::ui::Length::points(42.0f),
	};
}

::ui::LayoutStyle progress_layout(bool visible) {
	if(!visible){
		return ::ui::LayoutStyle{ .display = ::ui::Display::None };
	}
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(284.0f),
		.height = ::ui::Length::points(18.0f),
	};
}

::ui::LayoutStyle actions_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.gap = 6.0f,
	};
}

::ui::LayoutStyle button_layout(bool visible) {
	if(!visible){
		return ::ui::LayoutStyle{ .display = ::ui::Display::None };
	}
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(96.0f),
		.height = ::ui::Length::points(30.0f),
		.padding = {14.0f, 14.0f, 6.0f, 6.0f},
	};
}

::ui::StyleStatePatch status_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 12,
		.align = ::ui::TextAlign::Center,
		.wrap = ::ui::TextWrap::Words,
	});
}

::ui::StyleStatePatch progress_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {178, 210, 242, 255},
		.font_id = 133,
		.font_size = 10,
		.align = ::ui::TextAlign::Center,
	});
}

const char * primary_id(UpdatePrimaryAction action) {
	switch(action){
		case UpdatePrimaryAction::Update:
			return "update.update";
		case UpdatePrimaryAction::Retry:
			return "update.retry";
		case UpdatePrimaryAction::Download:
			return "update.download";
		case UpdatePrimaryAction::None:
		default:
			return nullptr;
	}
}

const char * primary_label(UpdatePrimaryAction action) {
	switch(action){
		case UpdatePrimaryAction::Update:
			return "Update";
		case UpdatePrimaryAction::Retry:
			return "Retry";
		case UpdatePrimaryAction::Download:
			return "Download";
		case UpdatePrimaryAction::None:
		default:
			return nullptr;
	}
}

bool has_progress(const UpdateStatus& update) {
	return update.progress && update.progress[0] != '\0';
}

bool has_primary_action(const UpdateStatus& update) {
	return update.primary_action != UpdatePrimaryAction::None;
}

}  // namespace

::ui::UiElement UpdateFrame(const UpdateFrameProps& props) {
	const UpdateStatus& update = UseUpdateStatus();
	Navigation navigation = use_navigation();
	const bool primary_visible = has_primary_action(update);
	std::function<void(const ::ui::ActivationEvent&)> primary_activate = {};
	switch(update.primary_action){
		case UpdatePrimaryAction::Update:
			primary_activate = [start_update = update.start_update](
				const ::ui::ActivationEvent&) {
				if(start_update) start_update();
			};
			break;
		case UpdatePrimaryAction::Retry:
			primary_activate = [retry = update.retry](const ::ui::ActivationEvent&) {
				if(retry) retry();
			};
			break;
		case UpdatePrimaryAction::Download:
			primary_activate = [download = update.download, navigation](
				const ::ui::ActivationEvent&) {
				const bool opened = download ? download() : false;
				if(opened && navigation.reset_to){
					navigation.reset_to(std::make_unique<MainMenuScreen>());
				}
			};
			break;
		case UpdatePrimaryAction::None:
		default:
			break;
	}
	std::function<void(const ::ui::ActivationEvent&)> cancel_activate =
		[cancel = update.cancel, navigation](const ::ui::ActivationEvent&) {
			const bool cancelled = cancel ? cancel() : false;
			if(cancelled && navigation.reset_to){
				navigation.reset_to(std::make_unique<MainMenuScreen>());
			}
		};
	return <Box key={props.key} layout={root_layout()}>
		<Dialog key="dialog" modal={true} layout={dialog_layout()}>
			<Text key="status" value={update.status} layout={status_layout()} style={status_style()} />
			<Text
			  key="progress"
			  value={update.progress}
			  disabled={!has_progress(update)}
			  layout={progress_layout(has_progress(update))}
			  style={progress_style()}
			/>
			<Box key="actions" layout={actions_layout()}>
				<Button
				  key="primary"
				  id={primary_id(update.primary_action)}
				  label={primary_label(update.primary_action)}
				  disabled={!primary_visible}
				  autofocus={primary_visible}
				  onActivate={primary_activate}
				  layout={button_layout(primary_visible)}
				/>
				<Button
				  key="cancel"
				  id="update.cancel"
				  label="Cancel"
				  disabled={!update.show_cancel}
				  autofocus={!primary_visible && update.show_cancel}
				  onActivate={cancel_activate}
				  layout={button_layout(update.show_cancel)}
				/>
			</Box>
		</Dialog>
	</Box>
}

}  // namespace silencer::client_ui

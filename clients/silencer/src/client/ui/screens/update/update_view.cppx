#include "client/ui/screens/update/update_view.h"

#include "client/ui/navigation/NavigationProvider.h"
#include "game_state.h"
#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/dialog.h"
#include "ui/components/text.h"

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Dialog;
using ::ui::components::DialogProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::LayoutStyle dialog_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(352.0f),
		.height = ::ui::Length::points(178.0f),
		.padding = {34.0f, 34.0f, 42.0f, 42.0f},
		.gap = 12.0f,
	};
}

::ui::LayoutStyle status_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(284.0f),
		.height = ::ui::Length::points(42.0f),
	};
}

::ui::LayoutStyle progress_layout(bool visible) {
	if(!visible){
		return ::ui::LayoutStyle{ .display = ::ui::Display::None };
	}
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(284.0f),
		.height = ::ui::Length::points(18.0f),
	};
}

::ui::LayoutStyle actions_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.gap = 6.0f,
	};
}

::ui::LayoutStyle button_layout(bool visible) {
	if(!visible){
		return ::ui::LayoutStyle{ .display = ::ui::Display::None };
	}
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(96.0f),
		.height = ::ui::Length::points(30.0f),
		.padding = {14.0f, 14.0f, 6.0f, 6.0f},
	};
}

::ui::StyleStatePatch status_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 12,
		.align = ::ui::TextAlign::Center,
		.wrap = ::ui::TextWrap::Words,
	});
}

::ui::StyleStatePatch progress_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {178, 210, 242, 255},
		.font_id = 133,
		.font_size = 10,
		.align = ::ui::TextAlign::Center,
	});
}

const char * primary_id(UpdatePrimaryAction action) {
	switch(action){
		case UpdatePrimaryAction::Update:
			return "update.update";
		case UpdatePrimaryAction::Retry:
			return "update.retry";
		case UpdatePrimaryAction::Download:
			return "update.download";
		case UpdatePrimaryAction::None:
		default:
			return nullptr;
	}
}

const char * primary_label(UpdatePrimaryAction action) {
	switch(action){
		case UpdatePrimaryAction::Update:
			return "Update";
		case UpdatePrimaryAction::Retry:
			return "Retry";
		case UpdatePrimaryAction::Download:
			return "Download";
		case UpdatePrimaryAction::None:
		default:
			return nullptr;
	}
}

bool has_progress(const UpdateState& state) {
	return state.progress && state.progress[0] != '\0';
}

bool has_primary_action(const UpdateState& state) {
	return state.primary_action != UpdatePrimaryAction::None;
}

struct UpdateFrameProps {
	const char * key = nullptr;
};

struct PrimaryActionButtonProps {
	const char * key = nullptr;
};

::ui::UiElement PrimaryActionButton(const PrimaryActionButtonProps& props) {
	const UpdateContextValue& update = UseUpdate();
	Navigation navigation = UseNavigation();
	const UpdateState& state = update.state;
	const UpdateActions& actions = update.actions;
	const bool visible = has_primary_action(state);
	std::function<void(const ::ui::ActivationEvent&)> on_activate = {};
	switch(state.primary_action){
		case UpdatePrimaryAction::Update:
			on_activate = [actions](const ::ui::ActivationEvent&) {
				if(actions.start_update) actions.start_update();
			};
			break;
		case UpdatePrimaryAction::Retry:
			on_activate = [actions](const ::ui::ActivationEvent&) {
				if(actions.retry) actions.retry();
			};
			break;
		case UpdatePrimaryAction::Download:
			on_activate = [actions, navigation](const ::ui::ActivationEvent&) {
				const bool opened = actions.download ? actions.download() : false;
				if(opened && navigation.goToState) navigation.goToState(GameState::MAINMENU);
			};
			break;
		case UpdatePrimaryAction::None:
		default:
			break;
	}
	return <Button
	  key={props.key}
	  id={primary_id(state.primary_action)}
	  label={primary_label(state.primary_action)}
	  disabled={!visible}
	  autofocus={visible}
	  onActivate={on_activate}
	  layout={button_layout(visible)}
	/>
}

struct CancelButtonProps {
	const char * key = nullptr;
};

::ui::UiElement CancelButton(const CancelButtonProps& props) {
	const UpdateContextValue& update = UseUpdate();
	Navigation navigation = UseNavigation();
	const UpdateState& state = update.state;
	const UpdateActions& actions = update.actions;
	const bool primary_visible = has_primary_action(state);
	std::function<void(const ::ui::ActivationEvent&)> on_activate =
		[actions, navigation](const ::ui::ActivationEvent&) {
			const bool cancelled = actions.cancel ? actions.cancel() : false;
			if(cancelled && navigation.goToState) navigation.goToState(GameState::MAINMENU);
		};
	return <Button
	  key={props.key}
	  id="update.cancel"
	  label="Cancel"
	  disabled={!state.show_cancel}
	  autofocus={!primary_visible && state.show_cancel}
	  onActivate={on_activate}
	  layout={button_layout(state.show_cancel)}
	/>
}

::ui::UiElement UpdateFrame(const UpdateFrameProps& props) {
	const UpdateContextValue& update = UseUpdate();
	const UpdateState& state = update.state;
	return <Box key={props.key} layout={root_layout()}>
		<Dialog key="dialog" modal={true} layout={dialog_layout()}>
			<Text key="status" value={state.status} layout={status_layout()} style={status_style()} />
			<Text
			  key="progress"
			  value={state.progress}
			  disabled={!has_progress(state)}
			  layout={progress_layout(has_progress(state))}
			  style={progress_style()}
			/>
			<Box key="actions" layout={actions_layout()}>
				<PrimaryActionButton key="primary" />
				<CancelButton key="cancel" />
			</Box>
		</Dialog>
	</Box>
}

}  // namespace

namespace {
::ReactContext UpdateContext = {};
const UpdateContextValue kEmptyUpdate = {};
}

const UpdateContextValue& UseUpdate() {
	const auto * value = static_cast<const UpdateContextValue *>(
		::use_context(&UpdateContext));
	return value ? *value : kEmptyUpdate;
}

::ui::UiElement UpdateView(const UpdateViewProps& props) {
	return ::ui::provider(
		"UpdateProvider",
		&UpdateContext,
		const_cast<UpdateContextValue *>(props.value),
		children({
			::ui::component("UpdateFrame",
			                UpdateFrameProps{ .key = "frame" },
			                UpdateFrame),
		}),
		props.key);
}

}  // namespace silencer::client_ui

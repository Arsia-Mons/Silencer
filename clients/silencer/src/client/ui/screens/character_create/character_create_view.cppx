#include "client/ui/screens/character_create/character_create_view.h"

#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/input.h"
#include "ui/components/text.h"
#include "ui/runtime/react.h"

namespace silencer::client_ui {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Input;
using ::ui::components::InputProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

namespace {

struct AgencyView {
	const char * name = "";
	const char * advantages = "";
	const char * description = "";
};

const AgencyView kAgencies[kCharacterCreateAgencyCount] = {
	{"Noxis", "Endurance +3, Jump +5, Health Packs", "Resilient agents trained for hostile environments."},
	{"Lazarus", "Resurrection Ability", "Agents who can return from otherwise fatal mistakes."},
	{"Caliber", "Contacts +3, Security Passes", "Procurement specialists with unusually deep access."},
	{"Static", "Satellite Ability, Hacking +3, Virus", "Technical operators with superior intrusion tools."},
	{"Black Rose", "Stealth Ability, Shield +2, Poison Flare", "Solo agents focused on concealment and poison."},
};

const AgencyView& agency_at(int index) {
	if(index < 0 || index >= kCharacterCreateAgencyCount) return kAgencies[0];
	return kAgencies[index];
}

bool is_alias_step(const CharacterCreate& character) {
	return character.step == CharacterCreateViewStep::EnterAlias;
}

bool is_agency_step(const CharacterCreate& character) {
	return character.step == CharacterCreateViewStep::SelectAgency;
}

const char * agent_label(const CharacterCreate& character, int index) {
	if(!character.agent_rows ||
	   index < 0 ||
	   index >= static_cast<int>(character.agent_rows->size())) return "";
	return (*character.agent_rows)[static_cast<size_t>(index)].c_str();
}

bool agent_row_visible(const CharacterCreate& character, int index) {
	return character.agent_rows &&
		index >= 0 &&
		index < static_cast<int>(character.agent_rows->size());
}

const char * agent_id(int index) {
	return ::ui::copy_string(use_text_storage("character_create.agent.%d", index));
}

const char * rename_id(int index) {
	return ::ui::copy_string(use_text_storage("character_create.rename.%d", index));
}

const char * agency_id(int index) {
	return ::ui::copy_string(use_text_storage("character_create.agency.%d", index));
}

std::function<void(const ::ui::ActivationEvent&)> activate_index(
	std::function<void(int index)> handler,
	int index) {
	return [handler, index](const ::ui::ActivationEvent&) {
		if(handler) handler(index);
	};
}

std::function<void(const ::ui::FocusEvent&)> preview_index(
	std::function<void(int index)> handler,
	int index) {
	return [handler, index](const ::ui::FocusEvent&) {
		if(handler) handler(index);
	};
}

std::function<void(const ::ui::ActivationEvent&)> action_callback(
	std::function<void()> action) {
	return [action](const ::ui::ActivationEvent&) {
		if(action) action();
	};
}

::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::StyleStatePatch root_style() {
	return ::ui::patch().background(::ui::Color{14, 18, 25, 255});
}

::ui::LayoutStyle panel_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Row,
		.align_items = ::ui::AlignItems::Start,
		.width = ::ui::Length::points(628.0f),
		.height = ::ui::Length::points(441.0f),
		.padding = {55.0f, 22.0f, 18.0f, 34.0f},
		.gap = 78.0f,
	};
}

::ui::StyleStatePatch panel_style() {
	return ::ui::patch()
		.background(::ui::Color{31, 36, 44, 248})
		.border(::ui::Border{
			.width = {1.0f, 1.0f, 1.0f, 1.0f},
			.color = {
				{74, 86, 102, 255},
				{74, 86, 102, 255},
				{74, 86, 102, 255},
				{74, 86, 102, 255},
			},
		});
}

::ui::LayoutStyle column_layout(float width) {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(width),
		.gap = 5.0f,
	};
}

::ui::LayoutStyle title_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(236.0f),
		.height = ::ui::Length::points(33.0f),
	};
}

::ui::LayoutStyle rows_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.width = ::ui::Length::points(236.0f),
		.height = ::ui::Length::points(272.0f),
		.gap = 5.0f,
	};
}

::ui::LayoutStyle row_button_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(236.0f),
		.height = ::ui::Length::points(27.0f),
		.padding = {18.0f, 18.0f, 5.0f, 5.0f},
	};
}

::ui::LayoutStyle detail_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Stretch,
		.width = ::ui::Length::points(196.0f),
		.padding = {22.0f, 0.0f, 42.0f, 0.0f},
		.gap = 8.0f,
	};
}

::ui::LayoutStyle detail_line_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(174.0f),
		.height = ::ui::Length::points(15.0f),
	};
}

::ui::LayoutStyle detail_paragraph_layout() {
	return ::ui::LayoutStyle{
		.width = ::ui::Length::points(174.0f),
		.height = ::ui::Length::points(64.0f),
	};
}

::ui::LayoutStyle rename_button_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(112.0f),
		.height = ::ui::Length::points(27.0f),
		.padding = {12.0f, 12.0f, 5.0f, 5.0f},
	};
}

::ui::LayoutStyle alias_modal_layout(bool visible) {
	if(!visible){
		return ::ui::LayoutStyle{ .display = ::ui::Display::None };
	}
	return ::ui::LayoutStyle{
		.position = ::ui::PositionType::Absolute,
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.width = ::ui::Length::points(284.0f),
		.height = ::ui::Length::points(108.0f),
		.padding = {24.0f, 24.0f, 18.0f, 18.0f},
		.gap = 16.0f,
	};
}

::ui::LayoutStyle alias_input_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Stretch,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(236.0f),
		.height = ::ui::Length::points(27.0f),
		.padding = {7.0f, 7.0f, 5.0f, 5.0f},
	};
}

::ui::StyleStatePatch title_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {236, 241, 247, 255},
		.font_id = 135,
		.font_size = 12,
		.align = ::ui::TextAlign::Center,
	});
}

::ui::StyleStatePatch detail_heading_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {238, 210, 98, 255},
		.font_id = 133,
		.font_size = 8,
	});
}

::ui::StyleStatePatch detail_style(::ui::TextWrap wrap = ::ui::TextWrap::None) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 6,
		.wrap = wrap,
	});
}

struct AgentRowProps {
	const char * key = nullptr;
	int slot = 0;
};

::ui::UiElement AgentRow(const AgentRowProps& props) {
	const CharacterCreate& character = UseCharacterCreate();
	const int index = character.agent_scroll + props.slot;
	const char * id = agent_id(index);
	if(is_agency_step(character)) return ::ui::empty();
	if(!agent_row_visible(character, index)) return ::ui::empty();
	return <Button
	  key={props.key}
	  id={id}
	  label={agent_label(character, index)}
	  selected={index == character.selected_agent_index}
	  disabled={is_alias_step(character)}
	  onFocus={preview_index(character.preview_agent, index)}
	  onActivate={activate_index(character.activate_agent, index)}
	  layout={row_button_layout()}
	/>
}

struct AgencyRowProps {
	const char * key = nullptr;
	int index = 0;
};

::ui::UiElement AgencyRow(const AgencyRowProps& props) {
	const CharacterCreate& character = UseCharacterCreate();
	const char * id = agency_id(props.index);
	if(!is_agency_step(character)) return ::ui::empty();
	const AgencyView& agency = agency_at(props.index);
	return <Button
	  key={props.key}
	  id={id}
	  label={agency.name}
	  selected={props.index == character.selected_agency_index}
	  disabled={character.waiting}
	  onFocus={preview_index(character.preview_agency, props.index)}
	  onActivate={activate_index(character.activate_agency, props.index)}
	  layout={row_button_layout()}
	/>
}

struct AgentOrAgencyColumnProps {
	const char * key = nullptr;
};

::ui::UiElement AgentOrAgencyColumn(const AgentOrAgencyColumnProps& props) {
	(void)props;
	const CharacterCreate& character = UseCharacterCreate();
	return <Box key="left" layout={column_layout(236.0f)}>
		<Text
		  key="title"
		  value={is_agency_step(character) ? "SELECT AGENCY" : "SELECT AGENT"}
		  layout={title_layout()}
		  style={title_style()}
		/>
		<Box key="rows" layout={rows_layout()}>
			<AgentRow key="agent-0" slot={0} />
			<AgentRow key="agent-1" slot={1} />
			<AgentRow key="agent-2" slot={2} />
			<AgentRow key="agent-3" slot={3} />
			<AgentRow key="agent-4" slot={4} />
			<AgentRow key="agent-5" slot={5} />
			<AgentRow key="agent-6" slot={6} />
			<AgentRow key="agent-7" slot={7} />
			<AgencyRow key="agency-0" index={0} />
			<AgencyRow key="agency-1" index={1} />
			<AgencyRow key="agency-2" index={2} />
			<AgencyRow key="agency-3" index={3} />
			<AgencyRow key="agency-4" index={4} />
		</Box>
	</Box>
}

struct DetailPanelProps {
	const char * key = nullptr;
};

::ui::UiElement DetailPanel(const DetailPanelProps& props) {
	(void)props;
	const CharacterCreate& character = UseCharacterCreate();
	const int agency_detail_index = is_agency_step(character)
		? (character.preview_agency_index >= 0
			? character.preview_agency_index
			: character.selected_agency_index)
		: character.detail_agency_index;
	const AgencyView& detail_agency = agency_at(agency_detail_index);
	return <Box key="detail" layout={detail_layout()}>
		<Text
		  key="agency-heading"
		  value="Agency"
		  layout={detail_line_layout()}
		  style={detail_heading_style()}
		/>
		<Text
		  key="agency"
		  value={detail_agency.name}
		  layout={detail_line_layout()}
		  style={detail_style()}
		/>
		<Text
		  key="advantages-heading"
		  value="Advantages"
		  layout={detail_line_layout()}
		  style={detail_heading_style()}
		/>
		<Text
		  key="advantages"
		  value={detail_agency.advantages}
		  layout={detail_paragraph_layout()}
		  style={detail_style(::ui::TextWrap::Words)}
		/>
		<Text
		  key="security"
		  value={character.detail_stats[0]}
		  disabled={is_agency_step(character) || character.detail_agent_index < 0}
		  layout={detail_line_layout()}
		  style={detail_style()}
		/>
		<Text
		  key="stat-1"
		  value={character.detail_stats[1]}
		  disabled={is_agency_step(character) || character.detail_agent_index < 0}
		  layout={detail_line_layout()}
		  style={detail_style()}
		/>
		<Text
		  key="stat-2"
		  value={character.detail_stats[2]}
		  disabled={is_agency_step(character) || character.detail_agent_index < 0}
		  layout={detail_line_layout()}
		  style={detail_style()}
		/>
		<Text
		  key="stat-3"
		  value={character.detail_stats[3]}
		  disabled={is_agency_step(character) || character.detail_agent_index < 0}
		  layout={detail_line_layout()}
		  style={detail_style()}
		/>
		<Button
		  key="rename"
		  id={rename_id(character.detail_agent_index)}
		  label="Rename Once"
		  disabled={!character.detail_rename_available || is_agency_step(character) || is_alias_step(character)}
		  onActivate={activate_index(character.rename_agent, character.detail_agent_index)}
		  layout={rename_button_layout()}
		/>
		<Text
		  key="description-heading"
		  value="Description"
		  disabled={!is_agency_step(character)}
		  layout={detail_line_layout()}
		  style={detail_heading_style()}
		/>
		<Text
		  key="description"
		  value={detail_agency.description}
		  disabled={!is_agency_step(character)}
		  layout={detail_paragraph_layout()}
		  style={detail_style(::ui::TextWrap::Words)}
		/>
	</Box>
}

struct AliasModalProps {
	const char * key = nullptr;
};

::ui::UiElement AliasModal(const AliasModalProps& props) {
	(void)props;
	const CharacterCreate& character = UseCharacterCreate();
	const bool alias_step = is_alias_step(character);
	return <Box key="alias-modal" layout={alias_modal_layout(alias_step)} style={panel_style()}>
		<Text
		  key="alias-title"
		  value={character.alias_renaming ? "ONE-TIME RENAME" : "SILENCER ALIAS"}
		  layout={title_layout()}
		  style={title_style()}
		/>
		<Input
		  key="alias-input"
		  id="character_create.alias"
		  value={character.alias}
		  disabled={!alias_step || character.waiting}
		  autofocus={alias_step}
		  accessibility={::ui::components::AccessibilityProps{.role = ::ui::SemanticRole::TextBox, .label = "Alias"}}
		  onActivate={action_callback(character.submit_alias)}
		  onChange={character.set_alias}
		  layout={alias_input_layout()}
		/>
		<Button
		  key="alias-submit"
		  id="character_create.alias.submit"
		  label={character.alias_renaming ? "Rename" : "Continue"}
		  disabled={!alias_step || character.waiting}
		  onActivate={action_callback(character.submit_alias)}
		  layout={rename_button_layout()}
		/>
	</Box>
}

}  // namespace

::ui::UiElement CharacterCreateFrame(const CharacterCreateFrameProps& props) {
	return <Box key={props.key} layout={root_layout()} style={root_style()}>
		<Box key="panel" layout={panel_layout()} style={panel_style()}>
			<AgentOrAgencyColumn key="chooser" />
			<DetailPanel key="detail" />
			<AliasModal key="alias" />
		</Box>
	</Box>
}

}  // namespace silencer::client_ui

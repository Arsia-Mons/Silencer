	struct DetailLineProps {
		const char * key = nullptr;
		const char * value = nullptr;
	};

	::ui::UiElement DetailLine(const DetailLineProps& props) {
		if(!props.value || props.value[0] == '\0') return ::ui::empty();
		return <LabelText
		  key={props.key}
		  value={props.value}
		  style={detail_text_patch()}
		  height={12.0f}
		/>
	}


	struct RenameButtonProps {
		const char * key = nullptr;
		bool available = false;
		int detail_agent = 0;
	};

	::ui::UiElement RenameButton(const RenameButtonProps& props) {
		if(!props.available) return ::ui::empty();
		return <RowButton
		  key={props.key}
		  id={copied_action_id(kActionRenamePrefix, props.detail_agent)}
		  label="Rename Once"
		  enabled={true}
		  selected={false}
		  selectedVisual={false}
		/>
	}

	struct AgentDetailsProps {
		const char * key = nullptr;
		const CharacterCreateFrameProps * frame = nullptr;
	};

	::ui::UiElement AgentDetails(const AgentDetailsProps& props) {
		if(!props.frame) return ::ui::empty();
		const CharacterCreateFrameProps& frame = *props.frame;
		const std::vector<LobbyAgentSummary>& agentList = agents(frame);
		const int detailAgent = frame.preview_agent >= 0
			? frame.preview_agent
			: frame.selected_agent;
		if(detailAgent < 0 || detailAgent >= static_cast<int>(agentList.size())){
			return <Box
			  key={props.key}
			  layout={::ui::LayoutStyle{
					.width = ::ui::Length::points(static_cast<float>(kRightColumnW)),
					.height = ::ui::Length::grow(1.0f),
			}}
			/>
		}
		const LobbyAgentSummary& agent =
			agentList[static_cast<size_t>(detailAgent)];
		const int agency = agency_index_for_id(frame, agent.agency);
		const AgencyDef& def = agency_def(agency);
		std::string level = std::string("Security Level ") +
			std::to_string(agent.stats.level);
	std::string slots = std::string("Technology Slots: ") +
		std::to_string(agent.stats.techslots);
	std::string xp = std::string("Agency Points: ") +
		std::to_string(agent.stats.xp);
	std::string next = std::string("Next Level At: ") +
		std::to_string((agent.stats.level + 1) * 100);
	std::string wins = std::string("Successful Missions: ") +
			std::to_string(agent.stats.wins);
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Column,
				.width = ::ui::Length::points(static_cast<float>(kRightColumnW)),
			.height = ::ui::Length::grow(1.0f),
			.padding = {static_cast<float>(kAgentDetailPadLeft), 0.0f, static_cast<float>(kDetailTopPad), 0.0f},
				.gap = 5.0f,
			}}
		>
			<LabelText key="agency-heading" value="Agency" style={detail_text_patch(8)} height={15.0f} />
			<Box
			  key="agency-row"
			  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Row,
				.align_items = ::ui::AlignItems::Center,
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::points(32.0f),
					.gap = 10.0f,
				}}
			>
				<AgencyIcon key="icon" agencyId={agent.agency} />
				<LabelText
				  key="agency-name"
				  value={def.displayName}
				  style={detail_text_patch(8)}
				  height={15.0f}
				/>
			</Box>
			<LabelText key="level" value={level.c_str()} style={detail_text_patch(8)} height={15.0f} />
			<DetailLine key="slots" value={slots.c_str()} />
			<DetailLine key="xp" value={xp.c_str()} />
			<DetailLine key="next" value={next.c_str()} />
			<DetailLine key="wins" value={wins.c_str()} />
			<RenameButton key="rename" available={agent.rename_available} detailAgent={detailAgent} />
			<LabelText key="advantages" value="Advantages" style={detail_text_patch(8)} height={15.0f} />
			<DetailLine key="advantage-0" value={def.advantages[0]} />
			<DetailLine key="advantage-1" value={def.advantages[1]} />
			<DetailLine key="advantage-2" value={def.advantages[2]} />
		</Box>
	}

	struct AgencyDetailsProps {
		const char * key = nullptr;
		const CharacterCreateFrameProps * frame = nullptr;
	};

	::ui::UiElement AgencyDetails(const AgencyDetailsProps& props) {
		if(!props.frame) return ::ui::empty();
		const CharacterCreateFrameProps& frame = *props.frame;
		const AgencyDef& def = agency_def(detail_agency_index(frame));
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Column,
				.width = ::ui::Length::points(static_cast<float>(kRightColumnW)),
			.height = ::ui::Length::grow(1.0f),
			.padding = {0.0f, 0.0f, static_cast<float>(kDetailTopPad), 0.0f},
				.gap = 6.0f,
			}}
		>
			<LabelText
			  key="advantages-title"
			  value="Advantages"
			  style={detail_text_patch(8)}
			  height={15.0f}
			/>
			<DetailLine key="advantage-0" value={def.advantages[0]} />
			<DetailLine key="advantage-1" value={def.advantages[1]} />
			<DetailLine key="advantage-2" value={def.advantages[2]} />
			<LabelText
			  key="description-title"
			  value="Description"
			  style={detail_text_patch(8)}
			  height={15.0f}
			/>
			<DetailLine key="description-0" value={def.description[0]} />
			<DetailLine key="description-1" value={def.description[1]} />
			<DetailLine key="description-2" value={def.description[2]} />
			<DetailLine key="description-3" value={def.description[3]} />
			<DetailLine key="description-4" value={def.description[4]} />
		</Box>
	}

	struct AliasModalProps {
		const char * key = nullptr;
		const CharacterCreateFrameProps * frame = nullptr;
	};

	::ui::UiElement AliasModal(const AliasModalProps& props) {
		if(!props.frame || props.frame->step != CharacterCreateFrameStep::EnterAlias){
			return ::ui::empty();
		}
		const CharacterCreateFrameProps& frame = *props.frame;
		const char * title = frame.alias_renaming ? "ONE-TIME RENAME" : "SILENCER ALIAS";
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.position = ::ui::PositionType::Absolute,
				.direction = ::ui::FlexDirection::Column,
			.align_items = ::ui::AlignItems::Center,
			.width = ::ui::Length::points(static_cast<float>(kAliasModalW)),
			.height = ::ui::Length::points(static_cast<float>(kAliasModalH)),
			.position_inset = inset_left_top(
				static_cast<float>((kStageW - kAliasModalW) / 2),
				static_cast<float>(kAliasModalTop)),
		}}
		  style={image_patch(40, 2)}
		>
		<Box
		  key="title-wrap"
		  layout={::ui::LayoutStyle{
				.align_items = ::ui::AlignItems::Center,
				.justify_content = ::ui::JustifyContent::Center,
				.width = ::ui::Length::points(static_cast<float>(kAliasModalW)),
					.height = ::ui::Length::points(static_cast<float>(kAliasTitleH)),
				}}
		>
				<LabelText
				  key="title"
				  value={title}
				  style={text_patch(tokens::kTextTitle, tokens::kFontTitleBank, 11, ::ui::TextAlign::Center)}
				  height={19.0f}
				/>
			</Box>
			<TextInput
			  key="input"
			  id={kActionAlias}
			  idOffset={kAliasInputUid}
			  accessibility={{.label = "Alias"}}
			  value={frame.alias ? frame.alias : ""}
			  layout={::ui::LayoutStyle{
					.position = ::ui::PositionType::Absolute,
					.width = ::ui::Length::points(static_cast<float>(kAliasInputFrameW)),
				.height = ::ui::Length::points(static_cast<float>(kRowH)),
				.padding = {static_cast<float>(kAliasInputFrameW - kAliasInputW), 6.0f, 4.0f, 4.0f},
				.position_inset = inset_left_top(static_cast<float>(kAliasInputX), static_cast<float>(kAliasInputY)),
			}}
			  style={::ui::StyleStatePatch(::ui::StylePatch{
				.background = ::ui::opt(input_visual().background),
				.border = ::ui::opt(input_visual().border),
				.text = ::ui::opt(input_visual().text),
			})}
			/>
		</Box>
	}

	struct BodyProps {
		const char * key = nullptr;
		const CharacterCreateFrameProps * frame = nullptr;
	};

	::ui::UiElement Body(const BodyProps& props) {
		if(!props.frame) return ::ui::empty();
		if(props.frame->step == CharacterCreateFrameStep::SelectAgency){
			return <Box
			  key={props.key}
			  layout={::ui::LayoutStyle{
					.direction = ::ui::FlexDirection::Row,
					.width = ::ui::Length::grow(1.0f),
					.height = ::ui::Length::grow(1.0f),
					.gap = static_cast<float>(kColumnGap),
				}}
			>
				<AgencyColumn key="agency-column" frame={props.frame} />
				<AgencyDetails key="agency-info" frame={props.frame} />
			</Box>
		}
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Row,
				.width = ::ui::Length::grow(1.0f),
				.height = ::ui::Length::grow(1.0f),
				.gap = static_cast<float>(kColumnGap),
			}}
		>
			<AgentColumn key="agent-column" frame={props.frame} />
			<AgentDetails key="details" frame={props.frame} />
			<AliasModal key="alias-modal" frame={props.frame} />
		</Box>
	}

}  // namespace character_create_frame_detail

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using character_create_frame_detail::Body;
using character_create_frame_detail::BodyProps;

::ui::UiElement CharacterCreateFrame(const CharacterCreateFrameProps& props) {
	return <Box
	  key={props.key}
	  layout={::ui::LayoutStyle{
			.align_items = ::ui::AlignItems::Center,
			.justify_content = ::ui::JustifyContent::Center,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::percent(100.0f),
		}}
	  style={character_create_frame_detail::image_patch(6, 0)}
	>
		<Box
		  key="stage"
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::points(static_cast<float>(character_create_frame_detail::kStageW)),
				.height = ::ui::Length::points(static_cast<float>(character_create_frame_detail::kStageH)),
				.padding = {
					static_cast<float>(character_create_frame_detail::kFrameMarginLeft),
					static_cast<float>(character_create_frame_detail::kFrameMarginRight),
					static_cast<float>(character_create_frame_detail::kFrameMarginTop),
					static_cast<float>(character_create_frame_detail::kFrameMarginBottom),
				},
			}}
		>
			<Box
			  key="panel"
			  layout={::ui::LayoutStyle{
					.direction = ::ui::FlexDirection::Row,
					.width = ::ui::Length::points(static_cast<float>(character_create_frame_detail::kPanelMinW)),
					.height = ::ui::Length::points(static_cast<float>(character_create_frame_detail::kPanelMinH)),
					.padding = {
						static_cast<float>(character_create_frame_detail::kContentPadLeft),
						static_cast<float>(character_create_frame_detail::kContentPadRight),
						static_cast<float>(character_create_frame_detail::kContentPadTop),
						static_cast<float>(character_create_frame_detail::kContentPadBottom),
					},
					.gap = static_cast<float>(character_create_frame_detail::kColumnGap),
				}}
			  style={character_create_frame_detail::image_patch(7, 5)}
			>
					<Body key="body" frame={&props} />
				</Box>
			</Box>
		</Box>
}

}  // namespace client_ui

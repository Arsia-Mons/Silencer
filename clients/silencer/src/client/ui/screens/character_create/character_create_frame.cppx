	struct AgencyRowProps {
		const char * key = nullptr;
		int agency = 0;
		int selected_agency = 0;
		int preview_agency = -1;
		bool waiting_for_create = false;
		std::function<void(int)> focus_agency = {};
		std::function<void(int)> activate_agency = {};
	};

	::ui::UiElement AgencyRow(const AgencyRowProps& props) {
		const bool selected = props.agency == props.selected_agency;
		const bool selectedVisual = selected && props.preview_agency == props.agency;
		return <RowButton
		  key={props.key}
		  id={copied_action_id(kActionAgencyPrefix, props.agency)}
		  label={agency_def(props.agency).displayName}
		  enabled={!props.waiting_for_create}
		  selected={selected}
		  selectedVisual={selectedVisual}
		  onFocus={indexed_callback(props.focus_agency, props.agency)}
		  onPress={indexed_callback(props.activate_agency, props.agency)}
		/>
	}


inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch image_patch(std::uint8_t bank, std::uint16_t index) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(bank, index),
		.tint = {255, 255, 255, 255},
	});
}

inline ::ui::StylePatch text_patch(::ui::Color color,
                                   std::uint16_t font_id,
                                   std::uint16_t font_size,
                                   ::ui::TextAlign align = ::ui::TextAlign::Left) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = color,
		.font_id = font_id,
		.font_size = font_size,
		.align = align,
	});
}

inline ::ui::StylePatch title_text_patch() {
	return text_patch(tokens::kTextTitle,
	                  tokens::kFontTitleBank,
	                  12,
	                  ::ui::TextAlign::Center);
}

inline ::ui::StylePatch detail_text_patch(std::uint16_t font_size = 7) {
	return text_patch({202, 226, 218, 255},
	                  tokens::kFontBodyBank,
	                  font_size,
	                  ::ui::TextAlign::Left);
}

inline ::ui::VisualStyle row_visual(bool selectedVisual, bool disabled) {
	::ui::VisualStyle visual{};
	(void)selectedVisual;
	visual.background = {0, 0, 0, 0};
	if(disabled){
		visual.background = {0, 0, 0, 0};
	}
	visual.image = {
		.texture_id = texture_id(6, 2),
		.tint = {255, 255, 255, 255},
	};
	visual.text = {
		.color = tokens::kTextButton,
		.font_id = 134,
		.font_size = 8,
		.align = ::ui::TextAlign::Center,
	};
	return visual;
}

inline ::ui::VisualStyle input_visual() {
	::ui::VisualStyle visual{};
	visual.background = {0, 0, 0, 0};
	visual.border = ::ui::Border{
		{1.0f, 1.0f, 1.0f, 1.0f},
		{{216, 0, 0, 255},
		 {216, 0, 0, 255},
		 {216, 0, 0, 255},
		 {216, 0, 0, 255}},
	};
	visual.text = {
		.color = tokens::kTextTitle,
		.font_id = tokens::kFontBodyBank,
		.font_size = 7,
	};
	return visual;
}

inline ::ui::EdgeSizes inset_left_top(float left, float top) {
	::ui::EdgeSizes edges;
	edges.left = ::ui::StyleValue::points(left);
	edges.top = ::ui::StyleValue::points(top);
	return edges;
}

inline const std::vector<std::string>& empty_rows() {
	static const std::vector<std::string> rows;
	return rows;
}

inline const std::vector<LobbyAgentSummary>& empty_agents() {
	static const std::vector<LobbyAgentSummary> agents;
	return agents;
}

inline const std::vector<std::string>& agent_rows(
	const std::vector<std::string> * rows) {
	return rows ? *rows : empty_rows();
}

inline const std::vector<std::string>& agent_rows(const CharacterCreateFrameProps& props) {
	return agent_rows(props.agent_rows);
}

inline const std::vector<LobbyAgentSummary>& agents(
	const std::vector<LobbyAgentSummary> * agent_list) {
	return agent_list ? *agent_list : empty_agents();
}

inline const std::vector<LobbyAgentSummary>& agents(const CharacterCreateFrameProps& props) {
	return agents(props.agents);
}

inline int clamp_agency(int value) {
	if(value < 0) return 0;
	if(value >= kAgencyCount) return kAgencyCount - 1;
	return value;
}

inline int agency_index_for_id(const std::uint8_t * agency_ids,
                               std::uint8_t agency) {
	if(!agency_ids) return 0;
	for(int i = 0; i < kAgencyCount; ++i){
		if(agency_ids[i] == agency) return i;
	}
	return 0;
}

inline int agency_index_for_id(const CharacterCreateFrameProps& props,
                               std::uint8_t agency) {
	return agency_index_for_id(props.agency_ids, agency);
}

inline int selected_agency_index(const std::uint8_t * agency_ids,
                                 int selected_agency) {
	return clamp_agency(agency_index_for_id(
		agency_ids, static_cast<std::uint8_t>(selected_agency)));
}

inline int selected_agency_index(const CharacterCreateFrameProps& props) {
	return selected_agency_index(props.agency_ids, props.selected_agency);
}

inline int detail_agency_index(const std::uint8_t * agency_ids,
                               int selected_agency,
                               int preview_agency) {
	return preview_agency >= 0 ? clamp_agency(preview_agency)
	                           : selected_agency_index(agency_ids, selected_agency);
}

inline int detail_agency_index(const CharacterCreateFrameProps& props) {
	return detail_agency_index(
		props.agency_ids, props.selected_agency, props.preview_agency);
}

inline const AgencyDef& agency_def(int agency) {
	return kAgencies[clamp_agency(agency)];
}

inline const char * copied_action_id(const char * prefix, int ordinal) {
	std::string value = std::string(prefix) + "." + std::to_string(ordinal);
	return ::ui::copy_string(value.c_str());
}

inline std::function<void(const ::ui::TextChangeEvent&)>
alias_text_change_callback(std::function<void(const char *)> on_change) {
	return [on_change](const ::ui::TextChangeEvent& event) {
		if(on_change) on_change(event.value);
	};
}

inline std::function<void(const ::ui::TextSubmitEvent&)>
alias_text_submit_callback(std::function<void(const char *)> on_submit) {
	return [on_submit](const ::ui::TextSubmitEvent& event) {
		if(on_submit) on_submit(event.value);
	};
}

inline ::ui::HostCallbacks
row_button_callbacks(std::function<void()> on_press,
                     std::function<void()> on_focus) {
	::ui::HostCallbacks callbacks{};
	if(on_focus){
		callbacks.on_focus =
			[on_focus](const ::ui::FocusEvent&) {
				on_focus();
			};
	}
	if(on_press){
		callbacks.on_activate =
			[on_press](const ::ui::ActivationEvent&) {
				on_press();
			};
	}
	return callbacks;
}

inline std::function<void()>
indexed_callback(std::function<void(int)> callback, int index) {
	if(!callback) return {};
	return [callback, index]() {
		callback(index);
	};
}

	struct LabelTextProps {
		const char * key = nullptr;
		const char * value = nullptr;
		::ui::StylePatch style = {};
		float height = 14.0f;
	};

	::ui::UiElement LabelText(const LabelTextProps& props) {
		return <Text
		  key={props.key}
		  value={props.value ? props.value : ""}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::points(props.height),
			}}
		  style={props.style}
		/>
	}

	struct RowButtonProps {
		const char * key = nullptr;
		const char * id = nullptr;
		const char * label = nullptr;
		bool enabled = true;
		bool selected = false;
		bool selected_visual = false;
		std::function<void()> on_focus = {};
		std::function<void()> on_press = {};
	};

	::ui::UiElement RowButton(const RowButtonProps& props) {
		std::function<void()> onFocus =
			props.enabled ? props.on_focus : std::function<void()>{};
		std::function<void()> onPress =
			props.enabled ? props.on_press : std::function<void()>{};
		return <detail.Host
		  kind={::ui::HostKind::Button}
		  key={props.key}
		  id={props.enabled ? props.id : nullptr}
		  style={::ui::LayoutStyle{
				.align_items = ::ui::AlignItems::Center,
				.justify_content = ::ui::JustifyContent::Center,
			.width = ::ui::Length::points(static_cast<float>(kLeftColumnW)),
			.height = ::ui::Length::points(static_cast<float>(kRowH)),
				.padding = {8.0f, 8.0f, 6.0f, 2.0f},
			}}
		  visual={row_visual(props.selected_visual, !props.enabled)}
		  text={::ui::HostTextProps{.value = props.label ? props.label : ""}}
		  interaction={::ui::NodeInteraction{
				.focusable = props.enabled,
				.disabled = !props.enabled,
				.checked = props.selected,
			}}
		  callbacks={row_button_callbacks(onPress, onFocus)}
		  accessibility={{.role = ::ui::SemanticRole::Button, .label = props.label ? props.label : ""}}
		>
			<LabelText
			  key="label"
			  value={props.label}
			  style={text_patch(tokens::kTextButton, 134, 8, ::ui::TextAlign::Center)}
			  height={15.0f}
			/>
		</detail.Host>
	}

	struct TitleProps {
		const char * key = nullptr;
		const char * value = nullptr;
	};

	::ui::UiElement Title(const TitleProps& props) {
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.align_items = ::ui::AlignItems::Center,
				.justify_content = ::ui::JustifyContent::Center,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::points(static_cast<float>(kTitleH)),
				.padding = {static_cast<float>(kTitleTextPadLeft), 0.0f, 0.0f, 0.0f},
			}}
		>
			<LabelText key="text" value={props.value} style={title_text_patch()} height={19.0f} />
		</Box>
	}

	struct AgentRowProps {
		const char * key = nullptr;
		const std::vector<std::string> * rows = nullptr;
		const std::vector<LobbyAgentSummary> * agents = nullptr;
		int agent_scroll = 0;
		int selected_agent = 0;
		int preview_agent = -1;
		bool selecting_agent = false;
		int visible_row = 0;
		std::function<void(int)> focus_agent = {};
		std::function<void(int)> activate_agent = {};
	};

	::ui::UiElement AgentRow(const AgentRowProps& props) {
		const std::vector<std::string>& rows = agent_rows(props.rows);
		const std::vector<LobbyAgentSummary>& agentList = agents(props.agents);
		const int source = props.agent_scroll + props.visible_row;
		const int count = std::min(static_cast<int>(rows.size()), 32);
		if(source < 0 || source >= count) return ::ui::empty();
		const bool existingAgent = source < static_cast<int>(agentList.size());
		const bool selected = existingAgent && source == props.selected_agent;
		const bool selectedVisual = selected && props.preview_agent == source;
		const char * id = copied_action_id(kActionAgentPrefix, source);
		return <RowButton
		  key={props.key}
		  id={id}
		  label={rows[static_cast<size_t>(source)].c_str()}
		  enabled={props.selecting_agent}
		  selected={selected}
		  selectedVisual={selectedVisual}
		  onFocus={indexed_callback(props.focus_agent, source)}
		  onPress={indexed_callback(props.activate_agent, source)}
		/>
	}


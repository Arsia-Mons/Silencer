inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch image_patch(std::uint8_t bank, std::uint16_t index) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(bank, index),
		.tint = {255, 255, 255, 255},
	});
}

inline ::ui::StylePatch text_patch(::ui::Color color,
                                   std::uint16_t font_id,
                                   std::uint16_t font_size,
                                   ::ui::TextAlign align = ::ui::TextAlign::Left) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = color,
		.font_id = font_id,
		.font_size = font_size,
		.align = align,
	});
}

inline ::ui::StylePatch title_text_patch() {
	return text_patch(tokens::kTextTitle,
	                  tokens::kFontTitleBank,
	                  12,
	                  ::ui::TextAlign::Center);
}

inline ::ui::StylePatch detail_text_patch(std::uint16_t font_size = 7) {
	return text_patch({202, 226, 218, 255},
	                  tokens::kFontBodyBank,
	                  font_size,
	                  ::ui::TextAlign::Left);
}

inline ::ui::VisualStyle row_visual(bool selectedVisual, bool disabled) {
	::ui::VisualStyle visual{};
	visual.background = selectedVisual ? ::ui::Color{44, 92, 128, 230}
	                                   : ::ui::Color{14, 20, 28, 210};
	if(disabled){
		visual.background = {18, 22, 28, 150};
	}
	visual.border = ::ui::Border{
		{1.0f, 1.0f, 1.0f, 1.0f},
		{{86, 112, 126, 255},
		 {86, 112, 126, 255},
		 {86, 112, 126, 255},
		 {86, 112, 126, 255}},
	};
	visual.text = {
		.color = tokens::kTextButton,
		.font_id = tokens::kFontBodyBank,
		.font_size = 7,
		.align = ::ui::TextAlign::Center,
	};
	return visual;
}

inline ::ui::VisualStyle input_visual() {
	::ui::VisualStyle visual{};
	visual.background = {7, 10, 14, 245};
	visual.border = ::ui::Border{
		{1.0f, 1.0f, 1.0f, 1.0f},
		{{92, 128, 144, 255},
		 {92, 128, 144, 255},
		 {92, 128, 144, 255},
		 {92, 128, 144, 255}},
	};
	visual.text = {
		.color = tokens::kTextTitle,
		.font_id = tokens::kFontBodyBank,
		.font_size = 7,
	};
	return visual;
}

inline ::ui::EdgeSizes inset_left_top(float left, float top) {
	::ui::EdgeSizes edges;
	edges.left = ::ui::StyleValue::points(left);
	edges.top = ::ui::StyleValue::points(top);
	return edges;
}

inline const std::vector<std::string>& empty_rows() {
	static const std::vector<std::string> rows;
	return rows;
}

inline const std::vector<LobbyAgentSummary>& empty_agents() {
	static const std::vector<LobbyAgentSummary> agents;
	return agents;
}

inline const std::vector<std::string>& agent_rows(const CharacterCreateFrameProps& props) {
	return props.agent_rows ? *props.agent_rows : empty_rows();
}

inline const std::vector<LobbyAgentSummary>& agents(const CharacterCreateFrameProps& props) {
	return props.agents ? *props.agents : empty_agents();
}

inline int clamp_agency(int value) {
	if(value < 0) return 0;
	if(value >= kAgencyCount) return kAgencyCount - 1;
	return value;
}

inline int agency_index_for_id(const CharacterCreateFrameProps& props,
                               std::uint8_t agency) {
	for(int i = 0; i < kAgencyCount; ++i){
		if(props.agency_ids[i] == agency) return i;
	}
	return 0;
}

inline int selected_agency_index(const CharacterCreateFrameProps& props) {
	return clamp_agency(agency_index_for_id(
		props, static_cast<std::uint8_t>(props.selected_agency)));
}

inline int detail_agency_index(const CharacterCreateFrameProps& props) {
	return props.preview_agency >= 0 ? clamp_agency(props.preview_agency)
	                                 : selected_agency_index(props);
}

inline const AgencyDef& agency_def(int agency) {
	return kAgencies[clamp_agency(agency)];
}

inline const char * copied_action_id(const char * prefix, int ordinal) {
	std::string value = std::string(prefix) + "." + std::to_string(ordinal);
	return ::ui::copy_string(value.c_str());
}

	struct LabelTextProps {
		const char * key = nullptr;
		const char * value = nullptr;
		::ui::StylePatch style = {};
		float height = 14.0f;
	};

	::ui::UiElement LabelText(const LabelTextProps& props) {
		return <Text
		  key={props.key}
		  value={props.value ? props.value : ""}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::percent(100.0f),
				.height = ::ui::Length::points(props.height),
			}}
		  style={props.style}
		/>
	}

	struct RowButtonProps {
		const char * key = nullptr;
		const char * id = nullptr;
		const char * label = nullptr;
		bool enabled = true;
		bool selected = false;
		bool selected_visual = false;
	};

	::ui::UiElement RowButton(const RowButtonProps& props) {
		return <detail.Host
		  kind={::ui::HostKind::Button}
		  key={props.key}
		  id={props.enabled ? props.id : nullptr}
		  style={::ui::LayoutStyle{
				.align_items = ::ui::AlignItems::Center,
				.justify_content = ::ui::JustifyContent::Center,
			.width = ::ui::Length::points(static_cast<float>(kLeftColumnW)),
			.height = ::ui::Length::points(static_cast<float>(kRowH)),
				.padding = {8.0f, 8.0f, 4.0f, 4.0f},
			}}
		  visual={row_visual(props.selected_visual, !props.enabled)}
		  text={::ui::HostTextProps{.value = props.label ? props.label : ""}}
		  interaction={::ui::NodeInteraction{
				.focusable = props.enabled,
				.disabled = !props.enabled,
				.checked = props.selected,
			}}
		  accessibility={{.role = ::ui::SemanticRole::Button, .label = props.label ? props.label : ""}}
		>
			<LabelText
			  key="label"
			  value={props.label}
			  style={text_patch(tokens::kTextButton, tokens::kFontBodyBank, 7, ::ui::TextAlign::Center)}
			  height={13.0f}
			/>
		</detail.Host>
	}

	struct TitleProps {
		const char * key = nullptr;
		const char * value = nullptr;
	};

	::ui::UiElement Title(const TitleProps& props) {
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.align_items = ::ui::AlignItems::Center,
				.justify_content = ::ui::JustifyContent::Center,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::points(static_cast<float>(kTitleH)),
				.padding = {static_cast<float>(kTitleTextPadLeft), 0.0f, 0.0f, 0.0f},
			}}
		>
			<LabelText key="text" value={props.value} style={title_text_patch()} height={19.0f} />
		</Box>
	}

	struct AgentRowProps {
		const char * key = nullptr;
		const CharacterCreateFrameProps * frame = nullptr;
		int visible_row = 0;
	};

	::ui::UiElement AgentRow(const AgentRowProps& props) {
		if(!props.frame) return ::ui::empty();
		const CharacterCreateFrameProps& frame = *props.frame;
		const std::vector<std::string>& rows = agent_rows(frame);
		const std::vector<LobbyAgentSummary>& agentList = agents(frame);
		const int source = frame.agent_scroll + props.visible_row;
		const int count = std::min(static_cast<int>(rows.size()), 32);
		if(source < 0 || source >= count) return ::ui::empty();
		const bool existingAgent = source < static_cast<int>(agentList.size());
		const bool selected = existingAgent && source == frame.selected_agent;
		const bool selectedVisual = selected && frame.preview_agent == source;
		const char * id = copied_action_id(kActionAgentPrefix, source);
		return <RowButton
		  key={props.key}
		  id={id}
		  label={rows[static_cast<size_t>(source)].c_str()}
		  enabled={frame.step == CharacterCreateFrameStep::SelectAgent}
		  selected={selected}
		  selectedVisual={selectedVisual}
		/>
	}

	struct AgentColumnProps {
		const char * key = nullptr;
		const CharacterCreateFrameProps * frame = nullptr;
	};

	::ui::UiElement AgentColumn(const AgentColumnProps& props) {
		return <Box
		  key={props.key}
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Column,
				.align_items = ::ui::AlignItems::Center,
			.width = ::ui::Length::points(static_cast<float>(kLeftColumnW)),
			.height = ::ui::Length::grow(1.0f),
				.gap = static_cast<float>(kRowGap),
			}}
		>
			<Title key="title" value="SELECT AGENT" />
			<Box
			  key="spacer"
			  layout={::ui::LayoutStyle{.height = ::ui::Length::points(static_cast<float>(kTitleToRowsGap))}}
			/>
		<Box
		  key="rows"
		  layout={::ui::LayoutStyle{
				.direction = ::ui::FlexDirection::Column,
				.width = ::ui::Length::points(static_cast<float>(kLeftColumnW)),
				.height = ::ui::Length::points(static_cast<float>(kAgentRowsH)),
				.overflow = ::ui::Overflow::Hidden,
					.gap = static_cast<float>(kRowGap),
				}}
		>
				<AgentRow key="agent-row-0" frame={props.frame} visibleRow={0} />
				<AgentRow key="agent-row-1" frame={props.frame} visibleRow={1} />
				<AgentRow key="agent-row-2" frame={props.frame} visibleRow={2} />
				<AgentRow key="agent-row-3" frame={props.frame} visibleRow={3} />
				<AgentRow key="agent-row-4" frame={props.frame} visibleRow={4} />
				<AgentRow key="agent-row-5" frame={props.frame} visibleRow={5} />
				<AgentRow key="agent-row-6" frame={props.frame} visibleRow={6} />
				<AgentRow key="agent-row-7" frame={props.frame} visibleRow={7} />
			</Box>
		</Box>
	}

	struct AgencyRowProps {
		const char * key = nullptr;
		const CharacterCreateFrameProps * frame = nullptr;
		int agency = 0;
	};

	::ui::UiElement AgencyRow(const AgencyRowProps& props) {
		if(!props.frame) return ::ui::empty();
		const CharacterCreateFrameProps& frame = *props.frame;
		const bool selected = props.agency == selected_agency_index(frame);
		const bool selectedVisual = selected && frame.preview_agency == props.agency;
		return <RowButton
		  key={props.key}
		  id={copied_action_id(kActionAgencyPrefix, props.agency)}
		  label={agency_def(props.agency).displayName}
		  enabled={!frame.waiting_for_create}
		  selected={selected}
		  selectedVisual={selectedVisual}
		/>
	}


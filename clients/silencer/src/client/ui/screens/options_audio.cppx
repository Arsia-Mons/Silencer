#include "client/ui/screens/options_audio.h"

#include "client/ui/components/actions/actions.h"
#include "client/ui/components/layout/layout.h"
#include "client/ui/components/surfaces/surfaces.h"
#include "client/ui/components/text/text.h"
#include "client/ui/hooks/use_navigation.h"
#include "client/ui/hooks/use_settings.h"
#include "ui/components/box.h"
#include "ui/runtime/react.h"

#include <cstdint>
#include <functional>

namespace client::ui {
namespace {

// JSX lowering emits each tag's component function + `<Tag>Props` type
// unqualified, so pull in the silencer semantic layer + the runtime children().
using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;

struct OptionsAudioProps {
  uint32_t unused = 0;
};

// SIL-108: origin/main's Audio screen is the Music on/off toggle — there is NO
// volume slider/stepper (the migration's invented -/+ control was removed for
// parity).
::ui::UiElement OptionsAudioView(const OptionsAudioProps &) {
  Navigation nav = use_navigation();
  Settings settings = use_settings();
  // Covered overlays render nothing (only the top overlay is interactive).
  if (!nav.is_top)
    return ::ui::empty();

  // origin/main: a floating title + the Music toggle + Save/Cancel ovals over the
  // starfield — NO panel container. Save persists, Cancel reverts the live edits.
  std::function<void()> save = [nav, settings]() {
    if (settings.commit)
      settings.commit();
    if (nav.pop_current)
      nav.pop_current();
  };
  std::function<void()> cancel = [nav, settings]() {
    if (settings.revert)
      settings.revert();
    if (nav.pop_current)
      nav.pop_current();
  };

  // origin/main anchors this dialog in the upper third (title baseline ~y168), not
  // screen-centered like the options root.
  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Overlay}>
    <Box key="col" layout={::ui::LayoutStyle{
        .position = ::ui::PositionType::Absolute,
        .position_inset = ::ui::EdgeSizes{0.0f, 0.0f, 168.0f, {}},
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Center,
        .gap = 36.0f}}>
      <ScreenTitle key="title" variant={ScreenTitleVariant::Screen} value="Audio Options" />
      <BooleanSettingRow
        key="music"
        controlId="MusicToggle"
        checked={settings.music}
        label="Music"
        onChange={settings.set_music}
      />
      <ActionRow key="actions">
        <AppButton key="save" controlId="OptionsSave" variant={AppButtonVariant::Oval} label="Save" onPress={save} />
        <AppButton key="cancel" controlId="OptionsCancel" variant={AppButtonVariant::Oval} label="Cancel" onPress={cancel} />
      </ActionRow>
    </Box>
  </ScreenLayout>
}

} // namespace

bool OptionsAudioScreen::build_element(::ui::UiElementFrame &,
                                       ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component("OptionsAudio", OptionsAudioProps{}, OptionsAudioView,
                         "options-audio");
  return true;
}

} // namespace client::ui

#include "client/ui/screens/update_screen.h"

#include "client/ui/components/actions/actions.h"
#include "client/ui/components/layout/layout.h"
#include "client/ui/components/text/text.h"
#include "client/ui/components/tokens.h"
#include "client/ui/hooks/use_chrome.h"
#include "client/ui/hooks/use_updater.h"
#include "ui/components/box.h"
#include "ui/runtime/react.h"

#include <cstddef>
#include <iterator>
#include <string>

namespace client::ui {
namespace {

using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;

struct UpdateScreenProps {
  uint32_t unused = 0;
};

// UpdaterPhase -> status line, indexed by phase.
constexpr const char *kPhaseLabels[] = {
    /* Idle */ "Up to date",
    /* Prompting */ "An update is available",
    /* Downloading */ "Downloading update",
    /* Verifying */ "Verifying update",
    /* Staging */ "Installing update",
    /* Failed */ "Update failed",
    /* Done */ "Update ready - restart to apply",
};

const char *phase_label(UpdaterPhase phase) {
  const size_t i = static_cast<size_t>(phase);
  return i < std::size(kPhaseLabels) ? kPhaseLabels[i] : "";
}

// Conditional children use the fixed-slot ternary-to-empty() idiom (UiChildren
// is non-owning — never a std::vector).
constexpr float kUpdateDialogW = 352.0f;
constexpr float kUpdateDialogH = 178.0f;
constexpr float kUpdateDialogPad = 34.0f;
::ui::UiElement UpdateScreenView(const UpdateScreenProps &) {
  UpdaterModel updater = use_updater();
  const UpdaterPhase phase = updater.phase;
  const int pct = static_cast<int>(updater.progress * 100.0f);
  ChromeTextures chrome = use_chrome();

  std::string status_str;
  if (phase == UpdaterPhase::Downloading)
    status_str = std::string("Downloading update  ") + std::to_string(pct) + "%";
  else if (phase == UpdaterPhase::Failed)
    status_str = updater.error.empty() ? std::string("Update failed")
                                       : ("Update failed: " + updater.error);
  else
    status_str = phase_label(phase);
  const char *status = use_text_storage("%s", status_str.c_str());

  int filled = static_cast<int>(updater.progress * 20.0f + 0.5f);
  if (filled < 0)
    filled = 0;
  if (filled > 20)
    filled = 20;
  std::string bar_str =
      "[" + std::string((size_t)filled, '#') + std::string((size_t)(20 - filled), '.') + "]";
  const char *bar_text = use_text_storage("%s", bar_str.c_str());

  auto chrome_button = [](const char *id, const char *label,
                          std::function<void()> on) -> ::ui::UiElement {
    AppButtonProps p{};
    p.key = id;
    p.control_id = id;
    p.variant = AppButtonVariant::Chrome;
    p.label = label;
    p.on_press = std::move(on);
    return AppButton(p);
  };

  const bool failed = phase == UpdaterPhase::Failed;
  ::ui::UiElement progress_bar =
      phase == UpdaterPhase::Downloading
          ? BodyText(BodyTextProps{.key = "bar",
                                   .variant = BodyTextVariant::Body,
                                   .value = bar_text})
          : ::ui::empty();
  ::ui::UiElement update_btn =
      phase == UpdaterPhase::Prompting
          ? chrome_button("UpdateConsent", "Update", updater.consent)
          : ::ui::empty();
  ::ui::UiElement retry_btn =
      (failed && updater.retry_count < 3)
          ? chrome_button("UpdateRetry", "Retry", updater.retry)
          : ::ui::empty();
  ::ui::UiElement download_btn =
      (failed && updater.retry_count >= 3)
          ? chrome_button("UpdateDownload", "Download",
                          updater.open_download_page)
          : ::ui::empty();
  ::ui::UiElement cancel_btn =
      (phase == UpdaterPhase::Prompting ||
       phase == UpdaterPhase::Downloading || failed)
          ? chrome_button("UpdateCancel", "Cancel", updater.cancel)
          : ::ui::empty();

  // Baked dialog sprite when available, themed panel fallback before it bakes.
  ::ui::StylePatch panel_style =
      chrome.dialog_msg ? tokens::image_patch_cover(chrome.dialog_msg)
                        : tokens::panel_patch(tokens::kSurfacePanel,
                                              tokens::kBorderPanel);

  return <ScreenLayout key="root" variant={ScreenLayoutVariant::CenteredOverlay}>
    <Box
      key="panel"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Center,
        .justify_content = ::ui::JustifyContent::Center,
        .width = ::ui::Length::points(kUpdateDialogW),
        .height = ::ui::Length::points(kUpdateDialogH),
        .padding = {kUpdateDialogPad, kUpdateDialogPad, kUpdateDialogPad,
                    kUpdateDialogPad},
        .gap = 12.0f}}
      style={panel_style}
    >
      <ScreenSubtitle key="status" value={status} />
      {progress_bar}
      <Box
        key="actions"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .justify_content = ::ui::JustifyContent::Center,
          .gap = 6.0f}}
      >
        {update_btn}
        {retry_btn}
        {download_btn}
        {cancel_btn}
      </Box>
    </Box>
  </ScreenLayout>
}

} // namespace

::ui::UiElement UpdateScreen(const char *key) {
  return ::ui::component("UpdateScreen", UpdateScreenProps{}, UpdateScreenView,
                         key);
}

} // namespace client::ui

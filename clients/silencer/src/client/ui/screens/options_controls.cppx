using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::ScrollView;
using ::ui::components::ScrollViewProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

// Keybind-grid geometry, origin options_controls_screen.cpp x1.5: a FIXED
// 729-wide content column centered in the panel; rows are [label 270 | bind
// oval 168 | OR 67.5 | bind oval 168] with 18 column gaps (270+18+168+18+67.5+
// 18+168 = 727.5). Keybind rows flex-grow in origin; the golden resolves to
// an 81px row with a 15px gap (96 pitch, origin 54+10), 4 rows visible.
constexpr float kContentW = 729.0f;
constexpr float kLabelCol = 270.0f;  // kActionNameW 180 x1.5
constexpr float kColGap = 18.0f;     // kColumnGap 12 x1.5
constexpr float kBindCol = 168.0f;   // Oval Sm 112 x1.5
constexpr float kOrCol = 67.5f;      // kOperatorW 45 x1.5
constexpr float kRowContentH = 81.0f;
constexpr float kRowGap = 15.0f;     // kRowGap 10 x1.5
constexpr float kRowH = kRowContentH + kRowGap; // virtualized row pitch
constexpr float kPresetRowH = 64.5f; // kPresetRowH 43 x1.5
constexpr float kSectionGap = 10.5f; // kSectionGap 8 x1.5, -1.5 golden-measured
constexpr float kViewportH = kRowH * 3.0f + kRowContentH; // 4 visible rows

// One left-aligned grid label (origin TextSize::Heading, bank 134).
::ui::UiElement grid_label(const char *value) {
  return <Text
    key="lbl"
    value={value}
    layout={::ui::LayoutStyle{.height = ::ui::Length::points(tokens::kLineLarge)}}
    style={tokens::text_patch(tokens::kTextBody, tokens::kFontLarge, tokens::kFaceLarge, tokens::kLineLarge)}
  />
}

// SIL-108: rebind auto-cancels after this many frames of inactivity (origin/main
// used a 72-tick capture timeout; the capture hook delegates it to the screen).
constexpr int kRebindTimeoutFrames = 72;

// One combo's chips AND-joined (" + "); "" if the combo is absent. Primary =
// combo 0, alternate = combo 1 — origin/main shows two bind slots per action.
std::string combo_display(const KeyMapAction &a, size_t combo_index) {
  if (combo_index >= a.combos.size())
    return "";
  const KeyMapCombo &c = a.combos[combo_index];
  std::string out;
  for (size_t k = 0; k < c.chips.size(); ++k) {
    if (k)
      out += " + ";
    out += c.chips[k].label;
  }
  return out;
}

// Index of the combo a Rebind replaces (0 if the action already has one, else
// -1 to append a fresh combo).
int rebind_combo_index(const KeyMap &km, Action action) {
  for (const KeyMapAction &a : km.actions) {
    if (a.action == action)
      return a.combos.empty() ? -1 : 0;
  }
  return -1;
}

// One selectable binding row: left-aligned label | primary bind oval | "OR" |
// secondary bind oval (an empty oval = BindingWell when the combo is unbound).
// Pressing a bind oval arms capture for that action's combo slot. The fixed
// column widths stack every row's ovals into aligned vertical lanes.
::ui::UiElement make_binding_row(const char *key, const char *primary_id,
                                 const char *secondary_id, const char *label,
                                 const char *primary, const char *secondary,
                                 std::function<void()> rebind_primary,
                                 std::function<void()> rebind_secondary) {
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(kRowH),
      .padding = {0.0f, 0.0f, 0.0f, kRowGap},
      .gap = kColGap}}
  >
    <Box
      key="lblc"
      layout={::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Start,
      .width = ::ui::Length::points(kLabelCol)}}
    >
      {grid_label(label)}
    </Box>
    <AppButton
      key="p"
      controlId={primary_id}
      variant={AppButtonVariant::Oval}
      size={AppButtonSize::Sm}
      label={primary}
      onPress={rebind_primary}
    />
    <Box
      key="orc"
      layout={::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::Center,
      .width = ::ui::Length::points(kOrCol)}}
    >
      <Text
        key="or"
        value="OR"
        layout={::ui::LayoutStyle{.height = ::ui::Length::points(tokens::kLineLarge)}}
        style={tokens::text_patch(tokens::kTextBody, tokens::kFontLarge, tokens::kFaceLarge, tokens::kLineLarge)}
      />
    </Box>
    <AppButton
      key="s"
      controlId={secondary_id}
      variant={AppButtonVariant::Oval}
      size={AppButtonSize::Sm}
      label={secondary}
      onPress={rebind_secondary}
    />
  </Box>
}

// Degenerate row: "Preset:" label + a single wide value oval (origin spans the
// preset oval across both bind lanes) cycling the preset.
::ui::UiElement make_preset_row(const char *label, const char *value,
                                std::function<void()> cycle) {
  return <Box
    key="presetrow"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(kPresetRowH),
      .gap = kColGap}}
  >
    <Box
      key="lblc"
      layout={::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Start,
      .width = ::ui::Length::points(kLabelCol)}}
    >
      {grid_label(label)}
    </Box>
    <AppButton
      key="cycle"
      controlId="CyclePreset"
      variant={AppButtonVariant::Oval}
      size={AppButtonSize::Lg}
      label={value}
      onPress={cycle}
    />
  </Box>
}

struct OptionsControlsProps {
  uint32_t unused = 0;
};

::ui::UiElement OptionsControlsView(const OptionsControlsProps &) {
  Navigation nav = use_navigation();
  KeyMap km = use_key_map();
  KeybindCapture cap = use_keybind_capture();
  if (!nav.is_top)
    return ::ui::empty();

  // 72-tick rebind timeout: a stalled capture auto-cancels. The counter resets
  // whenever capture is inactive or the pending chord grows.
  int *idle = use_state<int>(0);
  size_t *last_chips = use_state<size_t>(0);
  if (cap.capturing) {
    if (cap.pending_chips.size() != *last_chips) {
      *last_chips = cap.pending_chips.size();
      *idle = 0;
    } else if (++*idle > kRebindTimeoutFrames) {
      if (cap.cancel_capture)
        cap.cancel_capture();
      *idle = 0;
    }
  } else {
    *idle = 0;
    *last_chips = 0;
  }

  const int action_count = static_cast<int>(km.actions.size());
  std::function<void()> save = [nav, commit = km.commit]() {
    if (commit)
      commit();
    if (nav.pop_current)
      nav.pop_current();
  };
  std::function<void()> cancel = [nav, revert = km.revert]() {
    if (revert)
      revert();
    if (nav.pop_current)
      nav.pop_current();
  };

  // Build the binding grid: a degenerate Preset row, then one row per action
  // (primary combo 0 + alternate combo 1), as a runtime list for the virtualized
  // ScrollView (only the visible window hits the retained tree / fiber budget).
  std::vector<::ui::UiElement> rows;
  rows.reserve(km.actions.size());
  for (int i = 0; i < action_count; ++i) {
    const KeyMapAction &a = km.actions[i];
    const char *rkey = ::ui::copy_string(("row" + std::to_string(i)).c_str());
    const char *pid = ::ui::copy_string(("BindP" + std::to_string(i)).c_str());
    const char *sid = ::ui::copy_string(("BindS" + std::to_string(i)).c_str());
    const char *label = ::ui::copy_string((a.label + ":").c_str());
    std::string p = combo_display(a, 0);
    std::string s = combo_display(a, 1);
    const char *prim = p.empty() ? nullptr : ::ui::copy_string(p.c_str());
    const char *sec = s.empty() ? nullptr : ::ui::copy_string(s.c_str());
    Action act = a.action;
    std::function<void()> rb0 = [cap, km, act]() {
      if (cap.begin_capture)
        cap.begin_capture(act, rebind_combo_index(km, act));
    };
    std::function<void()> rb1 = [cap, act]() {
      if (cap.begin_capture)
        cap.begin_capture(act, 1);
    };
    rows.push_back(
        make_binding_row(rkey, pid, sid, label, prim, sec, rb0, rb1));
  }
  // Viewport spans the five golden rows (Preset + 4 Move); extra actions scroll
  // through the sprite's baked rail. Full content width so the column lanes land
  // under the baked scrollbar rail at the right edge.
  // Clear the ScrollView viewport's default chrome — the baked sprite already
  // draws the frame. The focusable viewport otherwise paints a focus OUTLINE
  // rectangle (the spurious inner frame at x~54); clear background + border AND
  // outline so only the sprite frame shows.
  // chromeless GATES the builder's injected focus-ring outline (draw_command_builder
  // append_frame: focus ring is injected unless chromeless) — clearing .outline()
  // alone just re-injects it, which is the spurious inner "x54" frame the baked
  // chrome_controls sprite already supplies. chromeless suppresses it.
  ::ui::StyleStatePatch table_style{};
  table_style.base = ::ui::patch().chromeless(true).background({0, 0, 0, 0});
  table_style.focus_visible = table_style.base;
  ::ui::UiElement table = ::ui::component(
      "ScrollView",
      ScrollViewProps{
          .key = "table",
          .id = "ControlsList",
          .viewport_height = kViewportH,
          .content_height = kRowH * static_cast<float>(action_count),
          .step = kRowH,
          .row_height = kRowH,
          .show_scrollbar = false,
          .layout = ::ui::LayoutStyle{.width = ::ui::Length::percent(100.0f)},
          .style = table_style,
          .children = ::ui::children(rows)},
      ScrollView);

  const char *pval = ::ui::copy_string(km.preset_label.c_str());

  return <ScreenLayout
    key="root"
    variant={ScreenLayoutVariant::Overlay}
    stretchedBackdrop={true}
  >
    <Panel key="frame" variant={PanelVariant::ControlsFrame}>
      <Box
        key="titlewrap"
        layout={::ui::LayoutStyle{
          .position = ::ui::PositionType::Absolute,
          .position_inset = ::ui::EdgeSizes{0.0f, 0.0f, 12.0f, {}},
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::Center,
          .justify_content = ::ui::JustifyContent::Center}}
      >
        <ScreenTitle key="title" variant={ScreenTitleVariant::Screen} value="Configure Controls" />
      </Box>
      <Box
        key="content"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Column,
          .width = ::ui::Length::points(kContentW)}}
      >
        {make_preset_row("Preset:", pval, km.cycle_preset)}
        <Box
          key="sectiongap"
          layout={::ui::LayoutStyle{.height = ::ui::Length::points(kSectionGap)}}
        />
        {table}
        <Box key="actiongap" layout={::ui::LayoutStyle{.height = ::ui::Length::points(50.0f)}} />
        <Box
          key="actionwrap"
          layout={::ui::LayoutStyle{
            .align_items = ::ui::AlignItems::Center,
            .justify_content = ::ui::JustifyContent::Center,
            .width = ::ui::Length::percent(100.0f)}}
        >
          <ActionRow key="actions">
            <AppButton
              key="save"
              controlId="SaveBinds"
              variant={AppButtonVariant::Oval}
              label="Save"
              onPress={save}
            />
            <AppButton
              key="cancel"
              controlId="ControlsBack"
              variant={AppButtonVariant::Oval}
              label="Cancel"
              onPress={cancel}
            />
          </ActionRow>
        </Box>
      </Box>
    </Panel>
  </ScreenLayout>
}

} // namespace

bool OptionsControlsScreen::build_element(::ui::UiElementFrame &,
                                          ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component("OptionsControls", OptionsControlsProps{},
                         OptionsControlsView, "options-controls");
  return true;
}

} // namespace client::ui

using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

// One AgentCard stat row (WINS/LOSSES/XP): a fixed-width Body label column with
// the value aligned after it, origin's StatRow convention (Body face, not tiny).
::ui::UiElement stat_kv(const char *key, const char *label, const char *value) {
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .height = ::ui::Length::points(tokens::kLineBody),
      .gap = 12.0f}}
  >
    <Box
      key="lc"
      layout={::ui::LayoutStyle{
        .width = ::ui::Length::points(60.0f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
    >
      <BodyText key="l" variant={BodyTextVariant::Body} value={label} />
    </Box>
    <BodyText key="v" variant={BodyTextVariant::Strong} value={value} />
  </Box>
}

// One game-browser entry as its own row (name + detail), caret-marked when
// selected.
::ui::UiElement game_line(const char *key, const char *value, bool selected) {
  return <BodyText
    key={key}
    variant={selected ? BodyTextVariant::Strong : BodyTextVariant::Body}
    value={value}
  />
}

// A bordered console column that GROWS to fill its flex slot (origin/main tiles
// the lobby panels edge-to-edge).
::ui::LayoutStyle lobby_col_layout(float grow) {
  return {
      .direction = ::ui::FlexDirection::Column,
      .flex_grow = ::ui::StyleFloat::points(grow),
      .flex_basis = ::ui::Length::points(0.0f),
      .min_width = ::ui::Length::points(0.0f),
      .padding = {8.0f, 8.0f, 6.0f, 6.0f},
      .gap = 4.0f};
}
// The right tall column: golden-measured fixed 448.5 wide (origin clamps its
// legacy 640-space width; at 16:9 it lands here).
::ui::LayoutStyle lobby_right_cell_layout() {
  ::ui::LayoutStyle l = {
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::points(448.5f),
      .min_height = ::ui::Length::points(0.0f),
      .padding = {8.0f, 8.0f, 6.0f, 6.0f},
      .gap = 4.0f};
  l.flex_shrink = ::ui::StyleFloat::points(0.0f);
  return l;
}
// A bordered cockpit cell that grows on the MAIN axis inside a row/column whose
// parent owns the cross-axis size (align_items Stretch). Tighter than a column.
::ui::LayoutStyle lobby_cell_layout(float grow) {
  return {
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .flex_grow = ::ui::StyleFloat::points(grow),
      .flex_basis = ::ui::Length::points(0.0f),
      .min_width = ::ui::Length::points(0.0f),
      .min_height = ::ui::Length::points(0.0f),
      .padding = {8.0f, 8.0f, 6.0f, 6.0f},
      .gap = 4.0f};
}
// origin/main lobby panels are connected green hairline frames (vector strokes
// at palette idx216, not sprites) over a transparent interior so the Mars
// backdrop reads through.
inline ::ui::StylePatch lobby_panel_style() {
  return tokens::frame_patch(tokens::kChromeStroke);
}

// One "Endurance        5" loadout stat line: label left, value right.
::ui::UiElement loadout_row(const char *key, const char *label, uint8_t value) {
  const char *val = ::ui::copy_string(std::to_string((unsigned)value).c_str());
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::SpaceBetween,
      .width = ::ui::Length::percent(100.0f),
      .gap = 6.0f}}
  >
    <BodyText key="l" variant={BodyTextVariant::Body} value={label} />
    <BodyText key="v" variant={BodyTextVariant::Strong} value={val} />
  </Box>
}

// --- right-column panels (screen-local swap) ---------------------------------

// The default center region (origin/main): a "Create Game" button floating at the
// top over the backdrop. The "In Lobby" presence lives in the shared Lobby panel
// (so it shows in create/staging modes too), not here.
struct CenterColProps {
  std::function<void()> on_create = {};
};

::ui::UiElement CenterCol(const CenterColProps &props) {
  // origin's RightUpperBox: the Create Game chrome button is the single
  // full-width child at the top of the box (FullWidthUpperButton).
  return <Box
    key="centercol"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .justify_content = ::ui::JustifyContent::Start,
      .flex_grow = ::ui::StyleFloat::points(1.4f),
      .flex_basis = ::ui::Length::points(0.0f),
      .min_width = ::ui::Length::points(0.0f),
      .padding = {4.5f, 6.0f, 4.5f, 6.0f},
      .gap = 10.0f}}
  >
    <AppButton
      key="creategame"
      controlId="NewGame"
      variant={AppButtonVariant::Chrome}
      label="Create Game"
      onPress={props.on_create}
    />
  </Box>
}

// The Active-Games browser body — chromeless (the panel chrome + "Active Games"
// title live on the dedicated right cockpit cell). A flex spacer pushes the
// browse/join actions to the bottom so the list reads sparse like the reference.
struct GameBrowserProps {
  std::vector<GameBrowserEntry> entries = {};
  int selected = 0;
  const char *sel_detail = "";
  bool can_join = false;
  bool can_spectate = false;
  std::function<void()> on_prev = {};
  std::function<void()> on_next = {};
  std::function<void()> on_join = {};
  std::function<void()> on_spectate = {};
};

// Browse/join actions — a separate element so GameBrowser can omit it for an
// empty list (the JSX tag can't live inside a ternary expression).
::ui::UiElement GameBrowserActions(const GameBrowserProps &props) {
  return <Box
    key="acts"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::percent(100.0f),
      .gap = 4.0f}}
  >
    <BodyText key="detail" variant={BodyTextVariant::Detail} value={props.sel_detail} />
    <ActionRow key="browse">
      <AppButton
        key="prev"
        controlId="GamePrev"
        variant={AppButtonVariant::Chrome}
        size={AppButtonSize::Sm}
        label="Prev"
        onPress={props.on_prev}
      />
      <AppButton
        key="next"
        controlId="GameNext"
        variant={AppButtonVariant::Chrome}
        size={AppButtonSize::Sm}
        label="Next"
        onPress={props.on_next}
      />
    </ActionRow>
    <AppButton
      key="join"
      controlId="JoinGame"
      variant={AppButtonVariant::Chrome}
      size={AppButtonSize::Sm}
      disabled={!props.can_join}
      label="Join"
      onPress={props.on_join}
    />
    <AppButton
      key="spectate"
      controlId="SpectateGame"
      variant={AppButtonVariant::Chrome}
      size={AppButtonSize::Sm}
      disabled={!props.can_spectate}
      label="Spectate"
      onPress={props.on_spectate}
    />
  </Box>
}

::ui::UiElement GameBrowser(const GameBrowserProps &props) {
  std::vector<::ui::UiElement> rows;
  // origin/main shows an empty hairline frame when no games are open (no
  // "No open games" placeholder).
  if (!props.entries.empty()) {
    for (int i = 0; i < (int)props.entries.size(); ++i) {
      const bool on = i == props.selected;
      std::string s = std::string(on ? "> " : "  ") + props.entries[i].name;
      rows.push_back(game_line(::ui::copy_string(("gl" + std::to_string(i)).c_str()),
                               ::ui::copy_string(s.c_str()), on));
    }
  }
  ::ui::UiChildren game_rows = ::ui::children(rows);
  // Browse/join actions only when there are games to act on; an empty list reads
  // sparse like the golden (the panel mostly shows the backdrop through).
  ::ui::UiElement actions =
      props.entries.empty() ? ::ui::empty() : GameBrowserActions(props);
  return <Box
    key="browserbody"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .flex_grow = ::ui::StyleFloat::points(1.0f),
      .width = ::ui::Length::percent(100.0f),
      .gap = 4.0f}}
  >
    {game_rows}
    <Box key="spacer" layout={::ui::LayoutStyle{.flex_grow = ::ui::StyleFloat::points(1.0f)}} />
    {actions}
  </Box>
}

// The lobby's right cockpit column: the Active Games browser, or (while creating
// a game) the Select Map filename list (CreateRightCell). Both share the key
// "rightcell" so the slot reconciles in place when the mode swaps.
::ui::UiElement ActiveGamesCell(::ui::UiElement browser) {
  return <Box key="rightcell" layout={lobby_right_cell_layout()} style={lobby_panel_style()}>
    <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value="Active Games" />
    <Box
      key="well"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .flex_grow = ::ui::StyleFloat::points(1.0f),
        .width = ::ui::Length::percent(100.0f),
        .padding = {6.0f, 6.0f, 5.0f, 5.0f},
        .gap = 4.0f}}
      style={tokens::frame_patch(tokens::kInsetStroke)}
    >
      {browser}
    </Box>
  </Box>
}

// One "Label:   value" option line (origin's Game Options table).
::ui::UiElement kv_row(const char *key, const char *label, const char *value) {
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::SpaceBetween,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(21.0f),
      .gap = 6.0f}}
  >
    <BodyText key="l" variant={BodyTextVariant::Body} value={label} />
    <BodyText key="v" variant={BodyTextVariant::Strong} value={value} />
  </Box>
}

// origin/main "Game Options": a pill-notch title over a dense label:value table
// (the values are the CreateGameRequest defaults). The Game name + Password +
// Create live in the right Select-Map cell (CreateRightCell), matching golden.
::ui::UiElement GameCreatePanel() {
  return <Box key="create" layout={lobby_col_layout(2.0f)} style={lobby_panel_style()}>
    <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value="Game Options" />
    <Box
      key="well"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .flex_grow = ::ui::StyleFloat::points(1.0f),
        .width = ::ui::Length::percent(100.0f),
        .padding = {6.0f, 6.0f, 3.0f, 3.0f},
        .gap = 4.5f}}
      style={tokens::frame_patch(tokens::kInsetStroke)}
    >
      {kv_row("o0", "Security:", "Medium")}
      {kv_row("o1", "Min Level:", "0")}
      {kv_row("o2", "Max Level:", "99")}
      {kv_row("o3", "Max Players:", "24")}
      {kv_row("o4", "Max Teams:", "6")}
      {kv_row("o5", "Spectatable:", "Yes")}
    </Box>
  </Box>
}

// The right cockpit cell while creating a game: the Select Map filename list,
// then (pushed to the bottom by a spring) the Game name + Password fields and
// the wide Create button — origin/main stacks the create form under the map list.
struct CreateRightCellProps {
  ::ui::UiChildren rows = {};
  const char *name = "";
  bool can_create = false;
  std::function<void()> on_create = {};
};
::ui::UiElement CreateRightCell(const CreateRightCellProps &props) {
  // origin/main renders the create-form values as plain green text on the
  // backdrop (no input box) — the Input host always paints its control chrome,
  // so the name value is a flat BodyText. Wide rect Create button below.
  return <Box key="rightcell" layout={lobby_right_cell_layout()} style={lobby_panel_style()}>
    <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value="Select Map" />
    <Box
      key="maplist"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Stretch,
        .flex_grow = ::ui::StyleFloat::points(1.0f),
        .width = ::ui::Length::percent(100.0f),
        .overflow = ::ui::Overflow::Hidden,
        .padding = {8.0f, 8.0f, 6.0f, 6.0f},
        .gap = 1.0f}}
      style={tokens::frame_patch(tokens::kInsetStroke)}
    >
      {props.rows}
    </Box>
    <BodyText key="gn" variant={BodyTextVariant::Body} value="Game name:" />
    <BodyText key="gv" variant={BodyTextVariant::Strong} value={props.name} />
    <BodyText key="pwl" variant={BodyTextVariant::Body} value="Password [optional]:" />
    <AppButton
      key="create"
      controlId="CreateGame"
      variant={AppButtonVariant::Chrome}
      disabled={!props.can_create}
      label="Create"
      onPress={props.on_create}
    />
  </Box>
}

struct StagingPanelProps {
  std::vector<StagingRosterRow> roster = {};
  const char *ready_label = "Ready";
  bool ready_blocked = false;
  std::function<void()> on_ready = {};
  std::function<void()> on_team = {};
  std::function<void()> on_tech = {};
};

::ui::UiElement roster_check_row(const char *key, const char *name, bool ready) {
  const ::ui::StylePatch cb =
      ready ? tokens::panel_patch(tokens::kChromeStroke, tokens::kChromeStroke, 1.0f)
            : tokens::frame_patch(tokens::kInsetStroke);
  return <Box
    key={key}
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .height = ::ui::Length::points(24.0f),
      .gap = 8.0f}}
  >
    <Box
      key="cb"
      layout={::ui::LayoutStyle{
        .width = ::ui::Length::points(14.0f),
        .height = ::ui::Length::points(14.0f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
      style={cb}
    />
    <BodyText
      key="n"
      variant={ready ? BodyTextVariant::Strong : BodyTextVariant::Body}
      value={name}
    />
  </Box>
}

// origin staging CENTER column: three stacked full-width chrome buttons spread
// down the upper column (origin gives them generous vertical spacing).
::ui::UiElement StagingPanel(const StagingPanelProps &props) {
  return <Box
    key="centercol"
    layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .justify_content = ::ui::JustifyContent::Start,
      .flex_grow = ::ui::StyleFloat::points(1.4f),
      .flex_basis = ::ui::Length::points(0.0f),
      .min_width = ::ui::Length::points(0.0f),
      .padding = {8.0f, 8.0f, 10.0f, 14.0f},
      .gap = 20.0f}}
  >
    <AppButton
      key="tech"
      controlId="ChooseTech"
      variant={AppButtonVariant::Chrome}
      label="Choose Tech"
      onPress={props.on_tech}
    />
    <AppButton
      key="team"
      controlId="ChangeTeam"
      variant={AppButtonVariant::Chrome}
      label="Change Team"
      onPress={props.on_team}
    />
    <Box key="sp" layout={::ui::LayoutStyle{.flex_grow = ::ui::StyleFloat::points(1.0f)}} />
    <AppButton
      key="ready"
      controlId="StagingReady"
      variant={AppButtonVariant::Chrome}
      disabled={props.ready_blocked}
      label={props.ready_label}
      onPress={props.on_ready}
    />
  </Box>
}

::ui::UiElement StagingRosterCell(const StagingPanelProps &props) {
  std::vector<::ui::UiElement> rows;
  for (int i = 0; i < (int)props.roster.size(); ++i) {
    const StagingRosterRow &r = props.roster[i];
    rows.push_back(roster_check_row(
        ::ui::copy_string(("rr" + std::to_string(i)).c_str()),
        ::ui::copy_string(r.name.c_str()), r.ready));
  }
  return <Box key="rightcell" layout={lobby_right_cell_layout()} style={lobby_panel_style()}>
    {::ui::children(rows)}
  </Box>
}

struct LobbyScreenProps {
  uint32_t unused = 0;
};

::ui::UiElement LobbyScreenView(const LobbyScreenProps &) {
  Characters chars = use_characters();
  LobbyChat chat = use_lobby_chat();
  Games games = use_games();
  Staging staging = use_staging();
  Session session = use_session();
  App app = use_app();
  Progression prog = use_progression();
  client::ui::ChromeTextures chrome = use_chrome();
  std::string *create_name = use_state<std::string>(std::string("New Game"));
  int *sel = use_state<int>(0);
  int *map_index = use_state<int>(0);
  bool *show_create = use_state<bool>(false);
  if (!create_name || !sel || !map_index || !show_create)
    return ::ui::empty();

  // Clamp the screen-local cursors against this frame's lists.
  const int game_count = (int)games.entries.size();
  if (*sel < 0)
    *sel = 0;
  if (game_count > 0 && *sel > game_count - 1)
    *sel = game_count - 1;
  const int map_count = (int)games.bundled_maps.size();
  if (*map_index < 0)
    *map_index = 0;
  if (map_count > 0 && *map_index > map_count - 1)
    *map_index = map_count - 1;

  const uint32_t sel_id = game_count > 0 ? games.entries[*sel].id : 0;
  const bool sel_joinable = game_count > 0 && games.entries[*sel].joinable;
  const bool sel_spectatable = game_count > 0 && games.entries[*sel].spectatable;

  // Per-call-site text scratch (stable order: computed every frame regardless of
  // the active panel so the hook sequence never shifts).
  const char *agent = use_text_storage(
      "%s", chars.selected_summary.empty() ? "Loading agent..."
                                           : chars.selected_summary.c_str());
  const char *scrollback = use_text_storage("%s", chat.scrollback.c_str());
  const char *presence = use_text_storage("%s", chat.presence.c_str());
  const char *sel_detail = use_text_storage(
      "%s", game_count > 0 ? games.entries[*sel].detail.c_str() : "");
  const char *ready_label = use_text_storage("%s", staging.ready_label.c_str());
  const char *chat_title = chat.channel.empty()
                               ? "Lobby"
                               : ::ui::copy_string(chat.channel.c_str());
  // origin staging title bar shows the joined game's map name (Title face).
  ::ui::UiElement map_overlay =
      staging.map_name.empty()
          ? ::ui::empty()
          : Text(TextProps{
                .key = "mapname",
                .value = ::ui::copy_string(staging.map_name.c_str()),
                .layout = {.height = ::ui::Length::points(tokens::kLineHeading)},
                .style = tokens::text_patch(tokens::kTextProse,
                                            tokens::kFontHeading,
                                            tokens::kFaceHeading,
                                            tokens::kLineHeading)});
  const char *version_text =
      use_text_storage("v.%s", app.version ? app.version : "");
  const char *xp_line = use_text_storage("XP %u/100", (unsigned)prog.experience);
  // selected_summary is newline-separated: "<alias>\n<agency>  Level N\n...". The
  // agency name (which may contain a space, e.g. "Black Rose") runs up to the
  // double-space before "Level".
  std::string summary_str = chars.selected_summary;
  size_t nl = summary_str.find('\n');
  std::string name_str = summary_str.substr(0, nl);
  const char *agent_name =
      use_text_storage("%s", name_str.empty() ? "Agent" : name_str.c_str());
  int agency_idx = 0;
  if (nl != std::string::npos) {
    std::string line2 = summary_str.substr(nl + 1);
    std::string ag = line2.substr(0, line2.find("  "));
    for (int i = 0; i < kAgencyCount; ++i)
      if (ag == kAgencies[i].name) {
        agency_idx = i;
        break;
      }
  }
  const uint32_t emblem_tex = chrome.agency_emblem[agency_idx];

  // Right-column selection: connected -> Staging; else the create form when the
  // player opened it; else the games browser. (No screen names a destination —
  // staging.active is the game-owned connection state surfaced by the hook.)
  StagingPanelProps sp;
  sp.roster = staging.roster;
  sp.ready_label = ready_label;
  sp.ready_blocked = staging.ready_blocked;
  sp.on_ready = staging.send_ready;
  sp.on_team = staging.change_team;
  sp.on_tech = []() {}; // SIL-21: the tech-select screen is not yet authored

  ::ui::UiElement right;
  if (staging.active) {
    right = StagingPanel(sp);
  } else if (*show_create) {
    right = GameCreatePanel();
  } else {
    CenterColProps cc;
    cc.on_create = [show_create]() { *show_create = true; };
    right = CenterCol(cc);
  }

  // The Active-Games browser lives in its own tall right cockpit cell, separate
  // from the top-row swap above, so it is always built.
  GameBrowserProps gp;
  gp.entries = games.entries;
  gp.selected = *sel;
  gp.sel_detail = sel_detail;
  gp.can_join = sel_joinable;
  gp.can_spectate = sel_spectatable;
  gp.on_prev = [sel]() { if (*sel > 0) (*sel)--; };
  gp.on_next = [sel, game_count]() { if (*sel < game_count - 1) (*sel)++; };
  gp.on_join = [join = games.join_game, sel_id]() {
    if (join) join(sel_id, std::string());
  };
  gp.on_spectate = [spectate = games.spectate_game, sel_id]() {
    if (spectate) spectate(sel_id);
  };
  ::ui::UiElement right_browser = GameBrowser(gp);

  // The right column is the "Select Map" filename list while creating a game,
  // otherwise the "Active Games" browser. Cap the rows at what the cell shows
  // without scrolling (golden lists ~13).
  constexpr int kMaxMapRows = 14;
  std::vector<::ui::UiElement> map_rows;
  if (*show_create) {
    for (int i = 0; i < map_count && i < kMaxMapRows; ++i) {
      const char *mk = ::ui::copy_string(("m" + std::to_string(i)).c_str());
      const char *mv = ::ui::copy_string(games.bundled_maps[i].c_str());
      map_rows.push_back(BodyText(BodyTextProps{
          .key = mk,
          .variant = i == *map_index ? BodyTextVariant::Strong : BodyTextVariant::Body,
          .value = mv}));
    }
  }
  ::ui::UiElement right_cell;
  if (staging.active) {
    right_cell = StagingRosterCell(sp);
  } else if (*show_create) {
    CreateRightCellProps rc;
    rc.rows = ::ui::children(map_rows);
    rc.name = create_name->c_str();
    rc.can_create = map_count > 0;
    rc.on_create = [create = games.create_game, create_name,
                    show_create, maps = games.bundled_maps, idx = *map_index]() {
      if (create && idx >= 0 && idx < (int)maps.size()) {
        CreateGameRequest req;
        req.name = create_name->empty() ? "New Game" : *create_name;
        req.map = maps[idx];
        create(req);
        *show_create = false; // staging.active takes over once connected
      }
    };
    right_cell = CreateRightCell(rc);
  } else {
    right_cell = ActiveGamesCell(right_browser);
  }

  // Go Back cancels create-mode first (matching origin's single top button),
  // otherwise leaves the lobby. Hoisted out of the JSX (the transpiler can't
  // parse a brace-bodied lambda inside an attribute).
  std::function<void()> on_go_back = [show_create, leave = session.leave_to_menu]() {
    if (*show_create) { *show_create = false; return; }
    if (leave) leave();
  };

  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Game}>
    <Box
      key="titlebar"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Row,
        .align_items = ::ui::AlignItems::Center,
        .width = ::ui::Length::percent(100.0f),
        .height = ::ui::Length::points(44.0f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f),
        .padding = {16.0f, 16.0f, 4.0f, 4.0f},
        .gap = ::ui::StyleValue::points(10.0f)}}
      style={tokens::frame_patch(tokens::kChromeStroke)}
    >
      <Box
        key="brandrow"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Row,
          .align_items = ::ui::AlignItems::End,
          .gap = ::ui::StyleValue::points(10.0f)}}
      >
        <ScreenTitle key="brand" variant={ScreenTitleVariant::Brand} value="Silencer" />
        <BodyText
          key="ver"
          variant={BodyTextVariant::Detail}
          tone={BodyTextTone::Warning}
          value={version_text}
        />
      </Box>
      {map_overlay}
      <Box key="tbspace" layout={::ui::LayoutStyle{.flex_grow = ::ui::StyleFloat::points(1.0f)}} />
      <AppButton
        key="goback"
        controlId="LobbyGoBack"
        variant={AppButtonVariant::Chrome}
        size={AppButtonSize::Sm}
        label="Go Back"
        onPress={on_go_back}
      />
    </Box>
    <Box
      key="body"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Row,
        .align_items = ::ui::AlignItems::Stretch,
        .flex_grow = ::ui::StyleFloat::points(1.0f),
        .width = ::ui::Length::percent(100.0f),
        .gap = ::ui::StyleValue::points(44.5f)}}
    >
      <Box
        key="leftstack"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Column,
          .align_items = ::ui::AlignItems::Stretch,
          .flex_grow = ::ui::StyleFloat::points(1.5f),
          .flex_basis = ::ui::Length::points(0.0f),
          .min_width = ::ui::Length::points(0.0f),
          .gap = ::ui::StyleValue::points(20.5f)}}
      >
        <Box
          key="toprow"
          layout={::ui::LayoutStyle{
            .direction = ::ui::FlexDirection::Row,
            .align_items = ::ui::AlignItems::Stretch,
            .width = ::ui::Length::percent(100.0f),
            .height = ::ui::Length::points(178.5f),
            .flex_shrink = ::ui::StyleFloat::points(0.0f),
            .gap = ::ui::StyleValue::points(20.5f)}}
        >
          <Box
            key="agent"
            layout={::ui::LayoutStyle{
              .direction = ::ui::FlexDirection::Row,
              .align_items = ::ui::AlignItems::Start,
              .width = ::ui::Length::points(436.0f),
              .flex_shrink = ::ui::StyleFloat::points(0.0f),
              .overflow = ::ui::Overflow::Hidden,
              .padding = {9.0f, 9.0f, 9.0f, 9.0f},
              .gap = 10.0f}}
            style={lobby_panel_style()}
          >
            <Box
              key="leftrail"
              layout={::ui::LayoutStyle{
                .direction = ::ui::FlexDirection::Column,
                .align_items = ::ui::AlignItems::Center,
                .width = ::ui::Length::points(64.0f),
                .flex_shrink = ::ui::StyleFloat::points(0.0f),
                .gap = ::ui::StyleValue::points(4.0f)}}
            >
              <Box
                key="avatar"
                layout={::ui::LayoutStyle{
                  .width = ::ui::Length::points(64.0f),
                  .height = ::ui::Length::points(64.0f),
                  .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
                style={emblem_tex ? tokens::image_patch(emblem_tex)
                                  : ::ui::patch().background(::ui::Color{40, 70, 150, 255}).corner_radius(2.0f)}
              />
              <BodyText key="lv" variant={BodyTextVariant::Body} value="LV 0" />
            </Box>
            <Box
              key="infoArea"
              layout={::ui::LayoutStyle{
                .direction = ::ui::FlexDirection::Column,
                .align_items = ::ui::AlignItems::Stretch,
                .flex_grow = ::ui::StyleFloat::points(1.0f),
                .flex_basis = ::ui::Length::points(0.0f),
                .min_width = ::ui::Length::points(0.0f),
                .overflow = ::ui::Overflow::Hidden,
                .gap = ::ui::StyleValue::points(5.0f)}}
            >
              <Text
                key="name"
                value={agent_name}
                layout={{.height = ::ui::Length::points(tokens::kLineLarge)}}
                style={tokens::text_patch(tokens::kTextAgentName, tokens::kFontLarge, tokens::kFaceLarge, tokens::kLineLarge)}
              />
              <Box
                key="detailsArea"
                layout={::ui::LayoutStyle{
                  .direction = ::ui::FlexDirection::Row,
                  .align_items = ::ui::AlignItems::Start,
                  .gap = ::ui::StyleValue::points(8.0f)}}
              >
                <Box
                  key="statsCol"
                  layout={::ui::LayoutStyle{
                    .direction = ::ui::FlexDirection::Column,
                    .width = ::ui::Length::points(150.0f),
                    .flex_shrink = ::ui::StyleFloat::points(0.0f),
                    .gap = ::ui::StyleValue::points(8.0f)}}
                >
                  {stat_kv("wins", "WINS", "0")}
                  {stat_kv("loss", "LOSSES", "0")}
                  <BodyText key="xp" variant={BodyTextVariant::Body} value={xp_line} />
                  <AppButton
                    key="leave"
                    controlId="LeaveLobby"
                    variant={AppButtonVariant::Chrome}
                    label="Agents"
                    onPress={session.leave_to_menu}
                  />
                </Box>
                <Box
                  key="statWell"
                  layout={::ui::LayoutStyle{
                    .direction = ::ui::FlexDirection::Column,
                    .align_items = ::ui::AlignItems::Stretch,
                    .width = ::ui::Length::points(179.0f),
                    .flex_shrink = ::ui::StyleFloat::points(0.0f),
                    .padding = {10.0f, 8.0f, 5.0f, 5.0f},
                    .gap = ::ui::StyleValue::points(2.0f)}}
                  style={tokens::frame_patch(tokens::kInsetStroke)}
                >
                  {loadout_row("s0", "ENDURANCE:", 0)}
                  {loadout_row("s1", "SHIELD:", 0)}
                  {loadout_row("s2", "JETPACK:", 0)}
                  {loadout_row("s3", "TECH SLOTS:", 3)}
                  {loadout_row("s4", "HACKING:", 0)}
                  {loadout_row("s5", "CONTACTS:", 0)}
                </Box>
              </Box>
            </Box>
          </Box>
          {right}
        </Box>
        <Box key="chat" layout={lobby_cell_layout(1.0f)} style={lobby_panel_style()}>
          <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value={chat_title} />
          <Box
            key="logwell"
            layout={::ui::LayoutStyle{
              .direction = ::ui::FlexDirection::Row,
              .overflow = ::ui::Overflow::Hidden,
              .align_items = ::ui::AlignItems::Stretch,
              .flex_grow = ::ui::StyleFloat::points(1.0f),
              .width = ::ui::Length::percent(100.0f),
              .padding = {8.0f, 8.0f, 6.0f, 6.0f},
              .gap = 9.0f}}
            style={tokens::frame_patch(tokens::kInsetStroke)}
          >
            <Box
              key="logcol"
              layout={::ui::LayoutStyle{
                .overflow = ::ui::Overflow::Hidden,
                .align_items = ::ui::AlignItems::Start,
                .flex_grow = ::ui::StyleFloat::points(1.0f),
                .flex_basis = ::ui::Length::points(0.0f),
                .min_width = ::ui::Length::points(0.0f)}}
            >
              <BodyText key="log" variant={BodyTextVariant::Message} value={scrollback} />
            </Box>
            <Box
              key="prescol"
              layout={::ui::LayoutStyle{
                .direction = ::ui::FlexDirection::Column,
                .align_items = ::ui::AlignItems::Start,
                .width = ::ui::Length::points(110.0f),
                .flex_shrink = ::ui::StyleFloat::points(0.0f),
                .gap = 1.0f}}
            >
              <BodyText
                key="il"
                variant={BodyTextVariant::Detail}
                tone={BodyTextTone::Muted}
                value="In Lobby"
              />
              <BodyText key="p" variant={BodyTextVariant::Detail} value={presence} />
            </Box>
          </Box>
          <Box
            key="inputstrip"
            layout={::ui::LayoutStyle{
              .width = ::ui::Length::percent(100.0f),
              .height = ::ui::Length::points(28.0f),
              .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
            style={tokens::frame_patch(tokens::kInsetStroke)}
          />
        </Box>
      </Box>
      {right_cell}
    </Box>
  </ScreenLayout>
}

} // namespace

::ui::UiElement LobbyScreen(const char *key) {
  return ::ui::component("LobbyScreen", LobbyScreenProps{}, LobbyScreenView,
                         key);
}

} // namespace client::ui

      .padding = {8.0f, 9.0f, 5.5f, 6.0f},
      .gap = ::ui::StyleValue::points(10.5f)}}
    style={tokens::frame_patch(tokens::kChromeStroke)}
  >
    <Box
      key="brandslot"
      layout={::ui::LayoutStyle{
        .height = ::ui::Length::points(31.5f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f),
        .padding = {0.0f, 0.0f, 4.5f, 0.0f}}}
    >
      <ScreenTitle key="brand" variant={ScreenTitleVariant::Brand} value="Silencer" />
    </Box>
    <Box
      key="verslot"
      layout={::ui::LayoutStyle{
        .height = ::ui::Length::points(31.5f),
        .flex_shrink = ::ui::StyleFloat::points(0.0f),
        .padding = {0.0f, 0.0f, 13.5f, 0.0f}}}
    >
      <BodyText
        key="ver"

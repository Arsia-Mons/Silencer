namespace client::ui {
namespace {

using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Input;
using ::ui::components::InputProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

// A tiny single-line label (bank-132 face) for the dense AgentCard identity +
// StatColumn, matching origin/main's small lobby stat type.
::ui::UiElement tiny_line(const char *key, const char *value, ::ui::Color color) {
  return <Text
    key={key}
    value={value}
    layout={{.height = ::ui::Length::points(tokens::kLineTiny)}}
    style={tokens::text_patch(color, tokens::kFontTiny, tokens::kFaceTiny,
                              tokens::kLineTiny)}
  />
}

// One AgentCard stat row: label in a fixed-width column, value aligned after it
// (origin lines the WINS/LOSSES/XP values into one column).
::ui::UiElement stat_kv(const char *key, const char *label, const char *value) {
  return <Box key={key} layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .width = ::ui::Length::percent(100.0f),
      .height = ::ui::Length::points(tokens::kLineTiny),
      .gap = 2.0f}}>
    <Box key="lc" layout={::ui::LayoutStyle{.width = ::ui::Length::points(64.0f)}}>
      {tiny_line("l", label, tokens::kTextBody)}
    </Box>
    {tiny_line("v", value, tokens::kTextBody)}
  </Box>
}

// One staging-roster row as its own vector element (SIL-104: the structured,
// multi-row roster — each peer on its own line, ready peers in the bright face).
// A plain helper whose body is JSX transpiles cleanly.
::ui::UiElement roster_line(const char *key, const char *value, bool ready) {
  return <BodyText
    key={key}
    variant={ready ? BodyTextVariant::Strong : BodyTextVariant::Body}
    value={value}
  />
}

// One game-browser entry as its own row (name + detail), caret-marked when
// selected.
::ui::UiElement game_line(const char *key, const char *value, bool selected) {
  return <BodyText
    key={key}
    variant={selected ? BodyTextVariant::Strong : BodyTextVariant::Body}
    value={value}
  />
}

// A bordered console column that GROWS to fill its flex slot (origin/main tiles
// the lobby panels edge-to-edge).
::ui::LayoutStyle lobby_col_layout(float grow) {
  return {
      .direction = ::ui::FlexDirection::Column,
      .flex_grow = ::ui::StyleFloat::points(grow),
      .flex_basis = ::ui::Length::points(0.0f),
      .min_width = ::ui::Length::points(0.0f),
      .padding = {8.0f, 8.0f, 6.0f, 6.0f},
      .gap = 4.0f};
}
// A bordered cockpit cell that grows on the MAIN axis inside a row/column whose
// parent owns the cross-axis size (align_items Stretch). Tighter than a column.
::ui::LayoutStyle lobby_cell_layout(float grow) {
  return {
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .flex_grow = ::ui::StyleFloat::points(grow),
      .flex_basis = ::ui::Length::points(0.0f),
      .min_width = ::ui::Length::points(0.0f),
      .min_height = ::ui::Length::points(0.0f),
      .padding = {8.0f, 8.0f, 6.0f, 6.0f},
      .gap = 4.0f};
}
// origin/main lobby panels are connected ~1px dim-green hairline frames whose
// interior is mostly transparent so the Mars/starfield backdrop reads through
// (not opaque cards). Faint dark-green wash + a thin green-dim border.
inline ::ui::StylePatch lobby_panel_style() {
  // Bright green hairline frame over a faint wash that lets the backdrop read
  // through (origin's connected-HUD panels read as clear bright frames).
  return tokens::panel_patch(::ui::Color{4, 12, 6, 55}, ::ui::Color{58, 168, 90, 255});
}

// One "Endurance        5" loadout stat line: label left, value right.
::ui::UiElement loadout_row(const char *key, const char *label, uint8_t value) {
  const char *val = ::ui::copy_string(std::to_string((unsigned)value).c_str());
  return <Box key={key} layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Center,
      .justify_content = ::ui::JustifyContent::SpaceBetween,
      .width = ::ui::Length::percent(100.0f),
      .gap = 6.0f}}>
    <BodyText key="l" variant={BodyTextVariant::Body} value={label} />
    <BodyText key="v" variant={BodyTextVariant::Strong} value={val} />
  </Box>
}

// --- right-column panels (screen-local swap) ---------------------------------

// The default center region (origin/main): a small "Create Game" oval floating at
// the top over the backdrop + the "In Lobby" presence float below it (who is in
// the lobby right now). NOT a stat panel — the agent's stats live in the
// AgentCard's StatColumn. controlId "NewGame" keeps the create intent targetable.
struct CenterColProps {
  const char *presence = "";
  std::function<void()> on_create = {};
};

::ui::UiElement CenterCol(const CenterColProps &props) {
  return <Box key="centercol" layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Center,
      .flex_grow = ::ui::StyleFloat::points(1.4f),
      .flex_basis = ::ui::Length::points(0.0f),
      .min_width = ::ui::Length::points(0.0f),
      .gap = 10.0f}}>
    <AppButton key="creategame" controlId="NewGame" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Create Game" onPress={props.on_create} />
    <Box key="inlobby" layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Start,
        .overflow = ::ui::Overflow::Hidden,
        .padding = {5.0f, 10.0f, 5.0f, 10.0f},
        .gap = 2.0f}} style={lobby_panel_style()}>
      <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value="In Lobby" />
      <BodyText key="p" variant={BodyTextVariant::Detail} value={props.presence} />
    </Box>
  </Box>
}

// The Active-Games browser body — chromeless (the panel chrome + "Active Games"
// title live on the dedicated right cockpit cell). A flex spacer pushes the
// browse/join actions to the bottom so the list reads sparse like the reference.
struct GameBrowserProps {
  std::vector<GameBrowserEntry> entries = {};
  int selected = 0;
  const char *sel_detail = "";
  bool can_join = false;
  bool can_spectate = false;
  std::function<void()> on_prev = {};
  std::function<void()> on_next = {};
  std::function<void()> on_join = {};
  std::function<void()> on_spectate = {};
};

// Browse/join actions — a separate element so GameBrowser can omit it for an
// empty list (the JSX tag can't live inside a ternary expression).
::ui::UiElement GameBrowserActions(const GameBrowserProps &props) {
  return <Box key="acts" layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .width = ::ui::Length::percent(100.0f),
      .gap = 4.0f}}>
    <BodyText key="detail" variant={BodyTextVariant::Detail} value={props.sel_detail} />
    <ActionRow key="browse">
      <AppButton key="prev" controlId="GamePrev" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Prev" onPress={props.on_prev} />
      <AppButton key="next" controlId="GameNext" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Next" onPress={props.on_next} />
    </ActionRow>
    <AppButton key="join" controlId="JoinGame" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} disabled={!props.can_join} label="Join" onPress={props.on_join} />
    <AppButton key="spectate" controlId="SpectateGame" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} disabled={!props.can_spectate} label="Spectate" onPress={props.on_spectate} />
  </Box>
}

::ui::UiElement GameBrowser(const GameBrowserProps &props) {
  std::vector<::ui::UiElement> rows;
  // origin/main shows an empty hairline frame when no games are open (no
  // "No open games" placeholder).
  if (!props.entries.empty()) {
    for (int i = 0; i < (int)props.entries.size(); ++i) {
      const bool on = i == props.selected;
      std::string s = std::string(on ? "> " : "  ") + props.entries[i].name;
      rows.push_back(game_line(::ui::copy_string(("gl" + std::to_string(i)).c_str()),
                               ::ui::copy_string(s.c_str()), on));
    }
  }
  ::ui::UiChildren game_rows = ::ui::children(rows);
  // Browse/join actions only when there are games to act on; an empty list reads
  // sparse like the golden (the panel mostly shows the backdrop through).
  ::ui::UiElement actions =
      props.entries.empty() ? ::ui::empty() : GameBrowserActions(props);
  return <Box key="browserbody" layout={::ui::LayoutStyle{
      .direction = ::ui::FlexDirection::Column,
      .align_items = ::ui::AlignItems::Stretch,
      .flex_grow = ::ui::StyleFloat::points(1.0f),
      .width = ::ui::Length::percent(100.0f),
      .gap = 4.0f}}>
    {game_rows}
    <Box key="spacer" layout={::ui::LayoutStyle{.flex_grow = ::ui::StyleFloat::points(1.0f)}} />
    {actions}
  </Box>
}

struct GameCreatePanelProps {
  const char *name = "";
  const char *map_text = "";
  bool can_create = false;
  std::function<void(const std::string &)> on_name = {};
  std::function<void()> on_prev_map = {};
  std::function<void()> on_next_map = {};
  std::function<void()> on_create = {};
  std::function<void()> on_back = {};
};

::ui::UiElement GameCreatePanel(const GameCreatePanelProps &props) {
  return <Box key="create" layout={lobby_col_layout(2.0f)} style={lobby_panel_style()}>
    <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value="Create Game" />
    <Input
      key="name"
      id="GameName"
      accessibility={{.label = "Game Name"}}
      value={props.name}
      onChange={props.on_name}
    />
    <BodyText key="map" variant={BodyTextVariant::Strong} value={props.map_text} />
    <ActionRow key="maps">
      <AppButton
        key="prevmap"
        controlId="MapPrev"
        variant={AppButtonVariant::Rect}
        size={AppButtonSize::Sm}
        disabled={!props.can_create}
        label="< Map"
        onPress={props.on_prev_map}
      />
      <AppButton
        key="nextmap"
        controlId="MapNext"
        variant={AppButtonVariant::Rect}
        size={AppButtonSize::Sm}
        disabled={!props.can_create}
        label="Map >"
        onPress={props.on_next_map}
      />
    </ActionRow>
    <ActionRow key="actions">
      <AppButton
        key="create"
        controlId="CreateGame"
        variant={AppButtonVariant::Rect}
        size={AppButtonSize::Sm}
        disabled={!props.can_create}
        label="Create"
        onPress={props.on_create}
      />
      <AppButton key="back" controlId="CreateBack" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Back" onPress={props.on_back} />
    </ActionRow>
  </Box>
}

struct StagingPanelProps {
  std::vector<StagingRosterRow> roster = {};
  const char *ready_label = "Ready";
  bool ready_blocked = false;
  std::function<void()> on_ready = {};
  std::function<void()> on_team = {};
  std::function<void()> on_leave = {};
};

::ui::UiElement StagingPanel(const StagingPanelProps &props) {
  std::vector<::ui::UiElement> rows;
  if (props.roster.empty()) {
    rows.push_back(roster_line("empty", "Waiting for players...", false));
  } else {
    for (int i = 0; i < (int)props.roster.size(); ++i) {
      const StagingRosterRow &r = props.roster[i];
      std::string s = std::string(r.ready ? "[R] " : "[ ] ") + r.name;
      if (!r.detail.empty()) {
        s += "   ";
        s += r.detail;
      }
      rows.push_back(roster_line(::ui::copy_string(("rr" + std::to_string(i)).c_str()),
                                 ::ui::copy_string(s.c_str()), r.ready));
    }
  }
  ::ui::UiChildren roster_rows = ::ui::children(rows);
  return <Box key="staging" layout={lobby_col_layout(2.0f)} style={lobby_panel_style()}>
    <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value="Staging" />
    {roster_rows}
    <ActionRow key="actions">
      <AppButton
        key="ready"
        controlId="StagingReady"
        variant={AppButtonVariant::Rect}
        disabled={props.ready_blocked}
        label={props.ready_label}
        onPress={props.on_ready}
      />
      <AppButton key="team" controlId="ChangeTeam" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Change Team" onPress={props.on_team} />
      <AppButton key="leave" controlId="LeaveGame" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Leave" onPress={props.on_leave} />
    </ActionRow>
  </Box>
}

struct LobbyScreenProps {
  uint32_t unused = 0;
};

::ui::UiElement LobbyScreenView(const LobbyScreenProps &) {
  Characters chars = use_characters();
  LobbyChat chat = use_lobby_chat();
  Games games = use_games();
  Staging staging = use_staging();
  Session session = use_session();
  App app = use_app();
  Progression prog = use_progression();
  client::ui::ChromeTextures chrome = use_chrome();
  std::string *draft = use_state<std::string>(std::string());
  std::string *create_name = use_state<std::string>(std::string("Game"));
  int *sel = use_state<int>(0);
  int *map_index = use_state<int>(0);
  bool *show_create = use_state<bool>(false);
  if (!draft || !create_name || !sel || !map_index || !show_create)
    return ::ui::empty();

  // Clamp the screen-local cursors against this frame's lists.
  const int game_count = (int)games.entries.size();
  if (*sel < 0)
    *sel = 0;
  if (game_count > 0 && *sel > game_count - 1)
    *sel = game_count - 1;
  const int map_count = (int)games.bundled_maps.size();
  if (*map_index < 0)
    *map_index = 0;
  if (map_count > 0 && *map_index > map_count - 1)
    *map_index = map_count - 1;

  const uint32_t sel_id = game_count > 0 ? games.entries[*sel].id : 0;
  const bool sel_joinable = game_count > 0 && games.entries[*sel].joinable;
  const bool sel_spectatable = game_count > 0 && games.entries[*sel].spectatable;

  // Per-call-site text scratch (stable order: computed every frame regardless of
  // the active panel so the hook sequence never shifts).
  const char *agent = use_text_storage(
      "%s", chars.selected_summary.empty() ? "Loading agent..."
                                           : chars.selected_summary.c_str());
  const char *scrollback = use_text_storage("%s", chat.scrollback.c_str());
  const char *presence = use_text_storage("%s", chat.presence.c_str());
  const char *sel_detail = use_text_storage(
      "%s", game_count > 0 ? games.entries[*sel].detail.c_str() : "");
  const char *map_text = use_text_storage(
      "Map: %s",
      map_count > 0 ? games.bundled_maps[*map_index].c_str() : "(no maps)");
  const char *ready_label = use_text_storage("%s", staging.ready_label.c_str());
  const char *version_text =
      use_text_storage("v.%s", app.version ? app.version : "");
  const char *xp_text = use_text_storage("%u/100", (unsigned)prog.experience);
  // selected_summary is newline-separated: "<alias>\n<agency>  Level N\n...". The
  // agency name (which may contain a space, e.g. "Black Rose") runs up to the
  // double-space before "Level".
  std::string summary_str = chars.selected_summary;
  size_t nl = summary_str.find('\n');
  std::string name_str = summary_str.substr(0, nl);
  const char *agent_name =
      use_text_storage("%s", name_str.empty() ? "Agent" : name_str.c_str());
  int agency_idx = 0;
  if (nl != std::string::npos) {
    std::string line2 = summary_str.substr(nl + 1);
    std::string ag = line2.substr(0, line2.find("  "));
    for (int i = 0; i < kAgencyCount; ++i)
      if (ag == kAgencies[i].name) {
        agency_idx = i;
        break;
      }
  }
  const uint32_t emblem_tex = chrome.agency_emblem[agency_idx];

  std::function<void(const std::string &)> set_draft =
      [draft](const std::string &next) { *draft = next; };
  std::function<void()> send = [send = chat.send, draft]() {
    if (send && !draft->empty()) {
      send(*draft);
      draft->clear();
    }
  };
  std::function<void(const ::ui::ActivationEvent &)> on_activate =
      [send](const ::ui::ActivationEvent &) { send(); };

  // The chat field is a thin square-cornered hairline bar flush with the Send
  // button (origin/main draws one connected input strip, not a rounded card).
  auto chat_field_layout = ::ui::LayoutStyle{
      .align_items = ::ui::AlignItems::Center,
      .flex_grow = ::ui::StyleFloat::points(1.0f),
      .min_width = ::ui::Length::points(0.0f),
      .padding = {6.0f, 6.0f, 2.0f, 2.0f}};
  ::ui::StyleStatePatch chat_field_style{};
  chat_field_style.base =
      ::ui::patch()
          .background(::ui::Color{0, 8, 2, 210})
          .gradient(::ui::Gradient{})
          .corner_radius(0.0f)
          .border(::ui::Border{{1, 1, 1, 1},
                               {tokens::kBorderPanel, tokens::kBorderPanel,
                                tokens::kBorderPanel, tokens::kBorderPanel}});

  // Right-column selection: connected -> Staging; else the create form when the
  // player opened it; else the games browser. (No screen names a destination —
  // staging.active is the game-owned connection state surfaced by the hook.)
  ::ui::UiElement right;
  if (staging.active) {
    StagingPanelProps sp;
    sp.roster = staging.roster;
    sp.ready_label = ready_label;
    sp.ready_blocked = staging.ready_blocked;
    sp.on_ready = staging.send_ready;
    sp.on_team = staging.change_team;
    sp.on_leave = staging.leave;
    right = StagingPanel(sp);
  } else if (*show_create) {
    GameCreatePanelProps cp;
    cp.name = create_name->c_str();
    cp.map_text = map_text;
    cp.can_create = map_count > 0;
    cp.on_name = [create_name](const std::string &next) { *create_name = next; };
    cp.on_prev_map = [map_index]() { if (*map_index > 0) (*map_index)--; };
    cp.on_next_map = [map_index, map_count]() {
      if (*map_index < map_count - 1) (*map_index)++;
    };
    cp.on_create = [create = games.create_game, create_name, show_create,
                    maps = games.bundled_maps, idx = *map_index]() {
      if (create && idx >= 0 && idx < (int)maps.size()) {
        CreateGameRequest req;
        req.name = create_name->empty() ? "Game" : *create_name;
        req.map = maps[idx];
        create(req);
        *show_create = false; // staging.active takes over once connected
      }
    };
    cp.on_back = [show_create]() { *show_create = false; };
    right = GameCreatePanel(cp);
  } else {
    CenterColProps cc;
    cc.presence = presence;
    cc.on_create = [show_create]() { *show_create = true; };
    right = CenterCol(cc);
  }

  // The Active-Games browser lives in its own tall right cockpit cell, separate
  // from the top-row swap above, so it is always built.
  GameBrowserProps gp;
  gp.entries = games.entries;
  gp.selected = *sel;
  gp.sel_detail = sel_detail;
  gp.can_join = sel_joinable;
  gp.can_spectate = sel_spectatable;
  gp.on_prev = [sel]() { if (*sel > 0) (*sel)--; };
  gp.on_next = [sel, game_count]() { if (*sel < game_count - 1) (*sel)++; };
  gp.on_join = [join = games.join_game, sel_id]() {
    if (join) join(sel_id, std::string());
  };
  gp.on_spectate = [spectate = games.spectate_game, sel_id]() {
    if (spectate) spectate(sel_id);
  };
  ::ui::UiElement right_browser = GameBrowser(gp);

  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Game}>
    <Box key="titlebar" layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Row,
        .align_items = ::ui::AlignItems::Center,
        .width = ::ui::Length::percent(100.0f),
        .gap = ::ui::StyleValue::points(10.0f)}}>
      <ScreenTitle key="brand" variant={ScreenTitleVariant::Brand} value="Silencer" />
      <BodyText key="ver" variant={BodyTextVariant::Detail} tone={BodyTextTone::Warning} value={version_text} />
      <Box key="tbspace" layout={::ui::LayoutStyle{.flex_grow = ::ui::StyleFloat::points(1.0f)}} />
      <AppButton key="goback" controlId="LobbyGoBack" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Go Back" onPress={session.leave_to_menu} />
    </Box>
    <Box key="body" layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Row,
        .align_items = ::ui::AlignItems::Stretch,
        .flex_grow = ::ui::StyleFloat::points(1.0f),
        .width = ::ui::Length::percent(100.0f),
        .gap = ::ui::StyleValue::points(6.0f)}}>
      <Box key="leftstack" layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Column,
          .align_items = ::ui::AlignItems::Stretch,
          .flex_grow = ::ui::StyleFloat::points(1.5f),
          .flex_basis = ::ui::Length::points(0.0f),
          .min_width = ::ui::Length::points(0.0f),
          .gap = ::ui::StyleValue::points(6.0f)}}>
        <Box key="toprow" layout={::ui::LayoutStyle{
            .direction = ::ui::FlexDirection::Row,
            .align_items = ::ui::AlignItems::Stretch,
            .width = ::ui::Length::percent(100.0f),
            .gap = ::ui::StyleValue::points(6.0f)}}>
          <Box key="agent" layout={::ui::LayoutStyle{
              .direction = ::ui::FlexDirection::Column,
              .align_items = ::ui::AlignItems::Start,
              .width = ::ui::Length::points(330.0f),
              .overflow = ::ui::Overflow::Hidden,
              .padding = {6.0f, 8.0f, 6.0f, 8.0f},
              .gap = 4.0f}} style={lobby_panel_style()}>
            <Box key="idrow" layout={::ui::LayoutStyle{
                .direction = ::ui::FlexDirection::Row,
                .align_items = ::ui::AlignItems::Start,
                .width = ::ui::Length::percent(100.0f),
                .overflow = ::ui::Overflow::Hidden,
                .gap = ::ui::StyleValue::points(8.0f)}}>
              <Box key="avatar" layout={::ui::LayoutStyle{
                  .width = ::ui::Length::points(42.0f),
                  .height = ::ui::Length::points(42.0f),
                  .flex_shrink = ::ui::StyleFloat::points(0.0f)}}
                style={emblem_tex ? tokens::image_patch(emblem_tex)
                                  : ::ui::patch().background(::ui::Color{40, 70, 150, 255}).corner_radius(2.0f)} />
              <Box key="idcol" layout={::ui::LayoutStyle{
                  .direction = ::ui::FlexDirection::Column,
                  .align_items = ::ui::AlignItems::Start,
                  .flex_grow = ::ui::StyleFloat::points(1.0f),
                  .flex_basis = ::ui::Length::points(0.0f),
                  .min_width = ::ui::Length::points(0.0f),
                  .overflow = ::ui::Overflow::Hidden,
                  .gap = ::ui::StyleValue::points(1.0f)}}>
                <Text key="name" value={agent_name}
                  layout={{.height = ::ui::Length::points(tokens::kLineLarge)}}
                  style={tokens::text_patch(tokens::kTextAgentName, tokens::kFontLarge, tokens::kFaceLarge, tokens::kLineLarge)} />
                {stat_kv("wins", "WINS", "0")}
                {stat_kv("loss", "LOSSES", "0")}
                {stat_kv("xp", "XP", xp_text)}
              </Box>
              <Box key="statcol" layout={::ui::LayoutStyle{
                  .direction = ::ui::FlexDirection::Column,
                  .align_items = ::ui::AlignItems::Start,
                  .width = ::ui::Length::points(82.0f),
                  .flex_shrink = ::ui::StyleFloat::points(0.0f),
                  .overflow = ::ui::Overflow::Hidden,
                  .gap = ::ui::StyleValue::points(1.0f)}}>
                {tiny_line("s0", "ENDURANCE", tokens::kTextBodyMuted)}
                {tiny_line("s1", "SHIELD", tokens::kTextBodyMuted)}
                {tiny_line("s2", "JETPACK", tokens::kTextBodyMuted)}
                {tiny_line("s3", "TECH SLOTS", tokens::kTextBodyMuted)}
                {tiny_line("s4", "HACKING", tokens::kTextBodyMuted)}
                {tiny_line("s5", "CONTACTS", tokens::kTextBodyMuted)}
              </Box>
            </Box>
            <AppButton key="leave" controlId="LeaveLobby" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Agents" onPress={session.leave_to_menu} />
          </Box>
          {right}
        </Box>
        <Box key="chat" layout={lobby_cell_layout(1.0f)} style={lobby_panel_style()}>
          <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value="Lobby" />
          <Box key="logclip" layout={::ui::LayoutStyle{
              .overflow = ::ui::Overflow::Hidden,
              .align_items = ::ui::AlignItems::Start,
              .flex_grow = ::ui::StyleFloat::points(1.0f),
              .width = ::ui::Length::percent(100.0f)}}>
            <BodyText key="log" variant={BodyTextVariant::Message} value={scrollback} />
          </Box>
          <Box key="inputrow" layout={::ui::LayoutStyle{
              .direction = ::ui::FlexDirection::Row,
              .align_items = ::ui::AlignItems::Stretch,
              .width = ::ui::Length::percent(100.0f),
              .gap = ::ui::StyleValue::points(4.0f)}}>
            <Input
              key="draft"
              id="ChatInput"
              accessibility={{.label = "Chat"}}
              value={draft->c_str()}
              onChange={set_draft}
              onActivate={on_activate}
              layout={chat_field_layout}
              style={chat_field_style}
            />
            <AppButton key="send" controlId="SendChat" variant={AppButtonVariant::Rect} size={AppButtonSize::Sm} label="Send" onPress={send} />
          </Box>
        </Box>
      </Box>
      <Box key="activegames" layout={lobby_cell_layout(1.0f)} style={lobby_panel_style()}>
        <ScreenTitle key="h" variant={ScreenTitleVariant::Console} value="Active Games" />
        {right_browser}
      </Box>
    </Box>
  </ScreenLayout>
}

} // namespace

::ui::UiElement LobbyScreen(const char *key) {
  return ::ui::component("LobbyScreen", LobbyScreenProps{}, LobbyScreenView,
                         key);
}

} // namespace client::ui

}

::ui::LayoutStyle done_button_layout() {
	return ::ui::LayoutStyle{
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::points(196.0f),
		.height = ::ui::Length::points(33.0f),
		.padding = {24.0f, 24.0f, 7.0f, 7.0f},
	};
}

::ui::StyleStatePatch title_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {236, 241, 247, 255},
		.font_id = 135,
		.font_size = 12,
		.align = ::ui::TextAlign::Center,
	});
}

::ui::StyleStatePatch prompt_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {198, 218, 240, 255},
		.font_id = 136,
		.font_size = 16,
		.align = ::ui::TextAlign::Center,
	});
}

::ui::StyleStatePatch body_style(::ui::TextAlign align = ::ui::TextAlign::Left) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {226, 234, 242, 255},
		.font_id = 133,
		.font_size = 6,
		.align = align,
	});
}

::ui::StyleStatePatch banner_style() {
	return ::ui::patch().text(::ui::TextVisual{
		.color = {238, 210, 98, 255},
		.font_id = 133,
		.font_size = 6,
		.align = ::ui::TextAlign::Center,
	});
}

const char * upgrade_key(int index) {
	return ::ui::copy_string(use_text_storage("upgrade-%d", index));
}

const char * upgrade_id(int index) {
	return ::ui::copy_string(use_text_storage("mission_summary.upgrade.%d", index));
}

struct UpgradeRowProps {
	const char * key = nullptr;
	int index = 0;
	int level = 0;
	bool available = false;
	std::function<void(int)> upgrade = {};
};

std::function<void(const ::ui::ActivationEvent&)> upgrade_callback(
	std::function<void(int)> upgrade,
	int index) {
	return [upgrade, index](const ::ui::ActivationEvent&) {
		if(upgrade) upgrade(index);
	};
}

::ui::UiElement UpgradeRow(const UpgradeRowProps& props) {
	return <Box key={props.key ? props.key : upgrade_key(props.index)} layout={upgrade_row_layout()}>
		<Box key="level" layout={level_row_layout()}>
			<Text
			  key="label"
			  value={kLevelLabels[props.index]}
			  layout={level_label_layout()}
			  style={body_style()}
			/>
			<Text
			  key="value"
			  value={::ui::copy_string(use_text_storage("%d", props.level))}
			  layout={level_value_layout()}
			  style={body_style(::ui::TextAlign::Right)}
			/>
		</Box>
		<Button
		  key="button"
		  id={upgrade_id(props.index)}
		  label={kUpgradeLabels[props.index]}
		  disabled={!props.available}
		  onActivate={upgrade_callback(props.upgrade, props.index)}
		  layout={upgrade_button_layout(props.available)}
		/>
	</Box>
}

Uint8 destination_state(MissionSummaryDestination destination) {
	switch(destination){
		case MissionSummaryDestination::Lobby:
			return GameState::LOBBY;
		case MissionSummaryDestination::MainMenu:
		default:
			return GameState::MAINMENU;
	}
}

std::function<void(const ::ui::ActivationEvent&)> done_callback(
	const MissionSummaryActions& actions,
	Navigation navigation) {
	return [actions, navigation](const ::ui::ActivationEvent&) {
		MissionSummaryDestination destination = MissionSummaryDestination::MainMenu;
		if(actions.done) destination = actions.done();
		if(navigation.goToState) navigation.goToState(destination_state(destination));
	};
}

}  // namespace


::ui::LayoutStyle root_layout() {
	return ::ui::LayoutStyle{
		.direction = ::ui::FlexDirection::Column,
		.align_items = ::ui::AlignItems::Center,
		.justify_content = ::ui::JustifyContent::Center,
		.width = ::ui::Length::percent(100.0f),
		.height = ::ui::Length::percent(100.0f),
	};
}

::ui::StyleStatePatch root_style() {
	return ::ui::patch().background(::ui::Color{14, 18, 25, 255});
}

::ui::LayoutStyle panel_layout() {
	return ::ui::LayoutStyle{

	  layout={::ui::LayoutStyle{
			.align_items = ::ui::AlignItems::Center,
			.justify_content = ::ui::JustifyContent::Center,
			.width = ::ui::Length::percent(100.0f),
			.height = ::ui::Length::percent(100.0f),
		}}
	  style={mission_summary_frame_detail::image_patch(6, 0)}
	>
		<Box
		  key="stage"
		  layout={::ui::LayoutStyle{
				.position = ::ui::PositionType::Relative,
				.width = ::ui::Length::points(static_cast<float>(mission_summary_frame_detail::kStageW)),
				.height = ::ui::Length::points(static_cast<float>(mission_summary_frame_detail::kStageH)),
			}}
		>
			<Box
			  key="panel"
			  layout={mission_summary_frame_detail::absolute_layout(mission_summary_frame_detail::kPanelX, mission_summary_frame_detail::kPanelY, mission_summary_frame_detail::kPanelW, mission_summary_frame_detail::kPanelH)}
			  style={mission_summary_frame_detail::image_patch(7, 5)}
			/>
			<Text
			  key="title"
			  value="Mission Summary"
			  layout={mission_summary_frame_detail::absolute_layout(mission_summary_frame_detail::kTitleCenterX - mission_summary_frame_detail::kTitleW / 2, mission_summary_frame_detail::kTitleY, mission_summary_frame_detail::kTitleW, mission_summary_frame_detail::kTitleH)}
			  style={mission_summary_frame_detail::text_patch(tokens::kTextTitle, tokens::kFontTitleBank, 12, ::ui::TextAlign::Center)}
			/>
			<Box
			  key="summary"
			  layout={::ui::LayoutStyle{
					.position = ::ui::PositionType::Absolute,
					.direction = ::ui::FlexDirection::Column,
					.position_inset = mission_summary_frame_detail::inset_left_top(
						mission_summary_frame_detail::kSummaryX,
						mission_summary_frame_detail::kSummaryY),
					.width = ::ui::Length::points(mission_summary_frame_detail::kSummaryW),
					.height = ::ui::Length::points(mission_summary_frame_detail::kSummaryRenderH),
				}}
			>
					<SummaryTextLine key="summary-line-0" frame={&props} index={0} />
					<SummaryTextLine key="summary-line-1" frame={&props} index={1} />
					<SummaryTextLine key="summary-line-2" frame={&props} index={2} />
					<SummaryTextLine key="summary-line-3" frame={&props} index={3} />
					<SummaryTextLine key="summary-line-4" frame={&props} index={4} />
					<SummaryTextLine key="summary-line-5" frame={&props} index={5} />
					<SummaryTextLine key="summary-line-6" frame={&props} index={6} />
					<SummaryTextLine key="summary-line-7" frame={&props} index={7} />
					<SummaryTextLine key="summary-line-8" frame={&props} index={8} />
					<SummaryTextLine key="summary-line-9" frame={&props} index={9} />
					<SummaryTextLine key="summary-line-10" frame={&props} index={10} />
					<SummaryTextLine key="summary-line-11" frame={&props} index={11} />
					<SummaryTextLine key="summary-line-12" frame={&props} index={12} />
					<SummaryTextLine key="summary-line-13" frame={&props} index={13} />
					<SummaryTextLine key="summary-line-14" frame={&props} index={14} />
					<SummaryTextLine key="summary-line-15" frame={&props} index={15} />
					<SummaryTextLine key="summary-line-16" frame={&props} index={16} />
					<SummaryTextLine key="summary-line-17" frame={&props} index={17} />
					<SummaryTextLine key="summary-line-18" frame={&props} index={18} />
					<SummaryTextLine key="summary-line-19" frame={&props} index={19} />
					<SummaryTextLine key="summary-line-20" frame={&props} index={20} />
					<SummaryTextLine key="summary-line-21" frame={&props} index={21} />
					<SummaryTextLine key="summary-line-22" frame={&props} index={22} />
					<SummaryTextLine key="summary-line-23" frame={&props} index={23} />
					<SummaryTextLine key="summary-line-24" frame={&props} index={24} />
					<SummaryTextLine key="summary-line-25" frame={&props} index={25} />
					<SummaryTextLine key="summary-line-26" frame={&props} index={26} />
					<SummaryTextLine key="summary-line-27" frame={&props} index={27} />
				</Box>
			<Text
			  key="xp"
			  value={xp.c_str()}

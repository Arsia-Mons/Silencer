inline std::uint32_t texture_id(std::uint8_t bank, std::uint16_t index) {
	return (static_cast<std::uint32_t>(bank) << 16) |
	       static_cast<std::uint32_t>(index);
}

inline ::ui::StylePatch image_patch(std::uint8_t bank, std::uint16_t index) {
	return ::ui::patch().image(::ui::BackgroundImage{
		.texture_id = texture_id(bank, index),
		.tint = {255, 255, 255, 255},
	});
}

inline ::ui::EdgeSizes inset_left_top(float left, float top) {
	::ui::EdgeSizes edges;
	edges.left = ::ui::StyleValue::points(left);
	edges.top = ::ui::StyleValue::points(top);
	return edges;
}

inline ::ui::StylePatch text_patch(::ui::Color color,
                                   std::uint16_t font_id,
                                   std::uint16_t font_size,
                                   ::ui::TextAlign align = ::ui::TextAlign::Left,
                                   float line_height = 0.0f) {
	return ::ui::patch().text(::ui::TextVisual{
		.color = color,
		.font_id = font_id,
		.font_size = font_size,
		.align = align,
		.line_height = line_height,
	});
}

inline ::ui::LayoutStyle absolute_layout(float left,
                                         float top,
                                         float width,
                                         float height) {
	return {
		.position = ::ui::PositionType::Absolute,
		.position_inset = inset_left_top(left, top),
		.width = ::ui::Length::points(width),
		.height = ::ui::Length::points(height),
	};
}

const char * SummaryLine(const char * const * lines,
                         int line_count,
                         int index) {
	if(!lines || index < 0 || index >= line_count){
		return "";
	}
	return lines[index] ? lines[index] : "";
}

	struct SummaryTextLineProps {
		const char * key = nullptr;
		const char * value = nullptr;
	};

	::ui::UiElement SummaryTextLine(const SummaryTextLineProps& props) {
		return <Text
		  key={props.key}
		  value={props.value ? props.value : ""}
		  layout={::ui::LayoutStyle{
				.width = ::ui::Length::points(kSummaryW),
				.height = ::ui::Length::points(kLineH),
			}}
		  style={text_patch(tokens::kTextTitle, tokens::kFontBodyBank, 6, ::ui::TextAlign::Left, static_cast<float>(kLineH))}
		/>
	}

	struct ButtonLabelProps {
		const char * key = nullptr;
		const char * label = nullptr;
	};

	::ui::UiElement ButtonLabel(const ButtonLabelProps& props) {
		return <Text
		  key={props.key}
		  value={props.label ? props.label : ""}
		  layout={::ui::LayoutStyle{
				.height = ::ui::Length::points(19.0f),
			}}
		  style={text_patch(tokens::kTextButton, tokens::kFontTitleBank, 11, ::ui::TextAlign::Center)}
		/>
	}

	struct UpgradeButtonProps {
		const char * key = nullptr;
		bool show = false;
		int index = 0;
		int button_y = 0;
		std::function<void(int)> apply_upgrade = {};
	};

	::ui::UiElement UpgradeButton(const UpgradeButtonProps& props) {
		if(!props.show){
			return ::ui::empty();
		}
		std::string actionId = std::string("mission_summary.upgrade.") +
			std::to_string(props.index);
		std::string textKey = std::string("upgrade-button-text-") +
			std::to_string(props.index);
		return <Box
		  key={props.key}
		  layout={absolute_layout(kUpgradeButtonX, static_cast<float>(props.button_y), kButtonW, kButtonH)}
		>
			<AppButton
			  key="button"
			  controlId={actionId.c_str()}
			  size={AppButtonSize::MainMenu}
			  accessibilityLabel={kUpgradeLabels[props.index]}
			  onPress={[applyUpgrade = props.apply_upgrade, index = props.index]() {
					if(applyUpgrade) applyUpgrade(index);
				}}
			>
				<ButtonLabel key={textKey.c_str()} label={kUpgradeLabels[props.index]} />
			</AppButton>
		</Box>
	}

	struct UpgradeRowProps {
		const char * key = nullptr;
		int index = 0;
		int level = 0;
		bool upgrade_available = false;
		std::function<void(int)> apply_upgrade = {};
	};

	::ui::UiElement UpgradeRow(const UpgradeRowProps& props) {
		const int rowY = kLevelStartY + props.index * kLevelRowGap;
		const int buttonY = kUpgradeButtonY + props.index * kLevelRowGap;
		std::string value = std::to_string(props.level);
		std::string buttonKey = std::string("upgrade-button-") +
			std::to_string(props.index);
		return <Box key={props.key}>
			<Text
			  key="label"
			  value={kLevelLabels[props.index]}
			  layout={absolute_layout(kLevelLabelX, static_cast<float>(rowY), kLevelLabelW, kTextLineH)}
			  style={text_patch(tokens::kTextTitle, tokens::kFontBodyBank, 6)}
			/>
		<Text
		  key="value"
		  value={value.c_str()}
		  layout={absolute_layout(kLevelValueX, static_cast<float>(rowY), kLevelValueW, kTextLineH)}
		  style={text_patch(tokens::kTextTitle, tokens::kFontBodyBank, 6, ::ui::TextAlign::Right)}
		/>
			<UpgradeButton
			  key={buttonKey.c_str()}
			  show={props.upgrade_available}
			  index={props.index}
			  buttonY={buttonY}
			  applyUpgrade={props.apply_upgrade}
			/>
		</Box>
	}

	struct UpgradeBannerProps {
		const char * key = nullptr;
		bool show = false;
	};

	::ui::UiElement UpgradeBanner(const UpgradeBannerProps& props) {
		if(!props.show) return ::ui::empty();
		return <Text
		  key={props.key}
		  value="*NEW UPGRADE AVAILABLE*"
		  layout={absolute_layout(kXpCenterX - kBannerW / 2, kUpgradeBannerY, kBannerW, kBannerH)}
		  style={text_patch(tokens::kAccent, tokens::kFontBodyBank, 6, ::ui::TextAlign::Center)}
		/>
}


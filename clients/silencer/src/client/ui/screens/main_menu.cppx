#include "client/ui/screens/main_menu.h"

#include "client/ui/components/actions/actions.h"
#include "client/ui/components/layout/layout.h"
#include "client/ui/components/text/text.h"
#include "client/ui/components/tokens.h"
#include "client/ui/hooks/use_app.h"
#include "client/ui/hooks/use_chrome.h"
#include "client/ui/hooks/use_clock.h"
#include "client/ui/hooks/use_navigation.h"
#include "client/ui/hooks/use_session.h"
#include "client/ui/screens/options_screen.h"
#include "ui/components/box.h"
#include "ui/runtime/react.h"

#include <functional>
#include <memory>

namespace client::ui {
namespace {

using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;

struct MainMenuProps {
  uint32_t unused = 0;
};

// SIL-96: origin/main main menu — starfield root (ScreenLayout Menu), a left
// SILENCER logo sprite + a right-anchored staggered stack of green oval buttons
// with the legacy labels, and a bottom-left version footer. No slate card.
::ui::UiElement MainMenuView(const MainMenuProps &) {
  Session session = use_session();
  App app = use_app();
  Navigation nav = use_navigation();
  ChromeTextures chrome = use_chrome();

  // SIL-107: the SILENCER logo reveal/hold/retract loop over the baked bank-208
  // reveal frames (individual textures — the ticket's "accept the texture
  // budget" path; the atlas/UV route had a bake issue). Step a frame index from
  // the per-frame wall clock at the legacy ~24fps (42ms) cadence: reveal
  // 0..N-1 -> hold on the full logo -> retract. Falls back to the static logo.
  Clock clock = use_clock();
  uint32_t *logo_accum = use_state<uint32_t>(0u);
  int *logo_step = use_state<int>(0);
  *logo_accum += clock.delta_ms;
  const uint32_t kLogoFrameMs = 42;
  const int lf = chrome.logo_frame_count;
  const int hold = 24; // ticks dwelling on the full logo (frame 0) before retract
  const int loop = lf > 1 ? (2 * lf + hold) : 1;
  while (*logo_accum >= kLogoFrameMs) {
    *logo_accum -= kLogoFrameMs;
    *logo_step = (*logo_step + 1) % (loop > 0 ? loop : 1);
  }
  // logo_frame[0] is the full logo; later entries step back through the reveal.
  // Map the loop phase to a frame: hold full, reveal toward sparse, retract.
  uint32_t logo_tex = chrome.logo;
  if (lf > 0) {
    const int s = *logo_step;
    int idx;
    if (s < hold)
      idx = 0; // hold on the full logo
    else if (s < hold + (lf - 1))
      idx = s - hold; // retract 0 -> lf-1 (logo recedes)
    else
      idx = (lf - 1) - (s - hold - (lf - 1)); // reveal lf-1 -> 0 (logo returns)
    if (idx < 0)
      idx = 0;
    if (idx >= lf)
      idx = lf - 1;
    logo_tex = chrome.logo_frame[idx];
  }
  ::ui::StylePatch logo_style = tokens::image_patch(logo_tex);

  std::function<void()> open_options = [nav]() {
    if (nav.push)
      nav.push(std::make_unique<OptionsScreen>());
  };

  // The SILENCER wordmark is the bank-208 logo sprite (drawn in a ~350px slot
  // that flex-shrinks so the right oval stack stays in-bounds on narrow/portrait
  // windows — the image stretches into the shrunk slot). Falls back to the
  // Hero-title text if the sprite has not baked yet so the menu never blanks.
  ::ui::UiElement logo =
      chrome.logo
          ? Box(BoxProps{
                .key = "logoimg",
                .layout = ::ui::LayoutStyle{
                    .flex_shrink = ::ui::StyleFloat::points(1.0f),
                    .width = ::ui::Length::points(350.0f),
                    .min_width = ::ui::Length::points(0.0f),
                    .height = ::ui::Length::points((float)chrome.logo_h)},
                .style = logo_style})
          : ScreenTitle(ScreenTitleProps{.key = "logotxt",
                                         .variant = ScreenTitleVariant::Hero,
                                         .value = "SILENCER"});

  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Menu}>
    <Box
      key="row"
      layout={::ui::LayoutStyle{
        .direction = ::ui::FlexDirection::Row,
        .align_items = ::ui::AlignItems::Center,
        .justify_content = ::ui::JustifyContent::SpaceBetween,
        .width = ::ui::Length::percent(100.0f),
        .height = ::ui::Length::percent(100.0f)}}>
      {logo}
      <Box
        key="stack"
        layout={::ui::LayoutStyle{
          .direction = ::ui::FlexDirection::Column,
          .align_items = ::ui::AlignItems::Start,
          .flex_shrink = ::ui::StyleFloat::points(0.0f),
          .gap = 34.0f}}>
        <Box key="w0" layout={::ui::LayoutStyle{.margin = ::ui::EdgeSizes{20.0f, 0.0f, 0.0f, 0.0f}}}>
          <AppButton key="tutorial" controlId="Tutorial" variant={AppButtonVariant::Oval} label="Tutorial" onPress={session.start_tutorial} />
        </Box>
        <Box key="w1" layout={::ui::LayoutStyle{.margin = ::ui::EdgeSizes{-40.0f, 0.0f, 0.0f, 0.0f}}}>
          <AppButton key="connect" controlId="ConnectToLobby" variant={AppButtonVariant::Oval} label="Connect To Lobby" onPress={session.play_online} />
        </Box>
        <Box key="w2" layout={::ui::LayoutStyle{.margin = ::ui::EdgeSizes{40.0f, 0.0f, 0.0f, 0.0f}}}>
          <AppButton key="options" controlId="Options" variant={AppButtonVariant::Oval} label="Options" onPress={open_options} />
        </Box>
        <AppButton key="exit" controlId="Exit" variant={AppButtonVariant::Oval} disabled={!app.can_quit} label="Exit" onPress={app.quit} />
      </Box>
    </Box>
    <Box
      key="footer"
      layout={::ui::LayoutStyle{
        .position = ::ui::PositionType::Absolute,
        .position_inset = ::ui::EdgeSizes{10.0f, {}, {}, 17.0f}}}>
      <BodyText key="ver" variant={BodyTextVariant::Body} value={use_text_storage("Silencer v%s", app.version ? app.version : "")} />
    </Box>
  </ScreenLayout>
}

} // namespace

::ui::UiElement MainMenu(const char *key) {
  return ::ui::component("MainMenu", MainMenuProps{}, MainMenuView, key);
}

} // namespace client::ui

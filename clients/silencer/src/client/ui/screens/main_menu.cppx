namespace client::ui {
namespace {

using namespace silencer;
using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

const char *version_text(const char *v) {
  std::string s = std::string("Silencer v") + (v ? v : "");
  return ::ui::copy_string(s.c_str());
}

struct MainMenuProps {
  uint32_t unused = 0;
};

constexpr float kLogoScale = 1.5f;
constexpr float kLogoStageCenterX = 431.0f;
constexpr float kLogoStageCenterY = 364.2f;
constexpr uint32_t kLogoLegacyTickMs = 42;
constexpr uint32_t kLogoRevealTicks = 60;
constexpr uint32_t kLogoHeldEndTicks = 180;
constexpr uint32_t kLogoCycleTicks = 240;

uint32_t current_logo_frame(uint32_t now_ms, uint32_t start_ms) {
  if (!start_ms || now_ms <= start_ms)
    return ChromeTextures::kLogoFirstFrame;

  const uint32_t legacy_tick =
      ((now_ms - start_ms) / kLogoLegacyTickMs) % kLogoCycleTicks;
  if (legacy_tick < kLogoRevealTicks)
    return ChromeTextures::kLogoFirstFrame + legacy_tick / 2;
  if (legacy_tick < kLogoHeldEndTicks)
    return ChromeTextures::kLogoHeldFrame;

  const int frame =
      120 - static_cast<int>(legacy_tick / 2) + ChromeTextures::kLogoFirstFrame;
  return frame <= ChromeTextures::kLogoFirstFrame
             ? ChromeTextures::kLogoFirstFrame
             : static_cast<uint32_t>(frame);
}

bool has_logo_animation(const ChromeTextures &chrome) {
  return chrome.logo_stage_w > 0 && chrome.logo_stage_h > 0 &&
         chrome.logo_frame_count == ChromeTextures::kLogoFrames;
}

// SIL-96: origin/main main menu — starfield root (ScreenLayout Menu), a left
// SILENCER logo sprite + a right-anchored staggered stack of green oval buttons
// with the legacy labels, and a bottom-left version footer. No slate card.
::ui::UiElement MainMenuView(const MainMenuProps &) {
  Session session = use_session();
  App app = use_app();
  Navigation nav = use_navigation();
  ChromeTextures chrome = use_chrome();

  Clock clock = use_clock();
  uint32_t *logo_start_ms = use_state<uint32_t>(0u);
  if (!*logo_start_ms && clock.now_ms)
    *logo_start_ms = clock.now_ms;

  std::function<void()> open_options = [nav]() {
    if (nav.push)
      nav.push(std::make_unique<OptionsScreen>());
  };

  ::ui::UiElement logo = ScreenTitle(ScreenTitleProps{.key = "logotxt",
                                                      .variant = ScreenTitleVariant::Hero,
                                                      .value = "SILENCER"});
  if (has_logo_animation(chrome)) {
    const uint32_t frame_no = current_logo_frame(clock.now_ms, *logo_start_ms);
    const int frame_index =
        static_cast<int>(frame_no) - ChromeTextures::kLogoFirstFrame;
    const ChromeTextures::LogoFrame &frame = chrome.logo_frame[frame_index];
    if (frame.id && frame.w > 0 && frame.h > 0) {
      const float stage_w = static_cast<float>(chrome.logo_stage_w) * kLogoScale;
      const float stage_h = static_cast<float>(chrome.logo_stage_h) * kLogoScale;
      const float frame_w = static_cast<float>(frame.w) * kLogoScale;
      const float frame_h = static_cast<float>(frame.h) * kLogoScale;
      logo = Box(BoxProps{
          .key = "logostage",
          .layout = ::ui::LayoutStyle{
              .position = ::ui::PositionType::Absolute,
              .always_forms_containing_block = true,
              .position_inset = ::ui::EdgeSizes{kLogoStageCenterX - stage_w * 0.5f, {},
                                                kLogoStageCenterY - stage_h * 0.5f, {}},
              .width = ::ui::Length::points(stage_w),
              .height = ::ui::Length::points(stage_h)},
          .style = tokens::chromeless_clear_patch(),
          .children = children({Box(BoxProps{
              .key = "logoimg",
              .layout = ::ui::LayoutStyle{
                  .position = ::ui::PositionType::Absolute,
                  .position_inset = ::ui::EdgeSizes{static_cast<float>(frame.x) * kLogoScale,
                                                    {},
                                                    static_cast<float>(frame.y) * kLogoScale,
                                                    {}},
                  .width = ::ui::Length::points(frame_w),
                  .height = ::ui::Length::points(frame_h)},
              .style = tokens::image_patch(frame.id)})})});
    }
  } else if (chrome.logo) {
    const float logo_w = static_cast<float>(chrome.logo_w) * kLogoScale;
    const float logo_h = static_cast<float>(chrome.logo_h) * kLogoScale;
    logo = Box(BoxProps{
        .key = "logoimg",
        .layout = ::ui::LayoutStyle{
            .position = ::ui::PositionType::Absolute,
            .position_inset = ::ui::EdgeSizes{431.0f - logo_w * 0.5f, {},
                                              364.2f - logo_h * 0.5f, {}},
            .width = ::ui::Length::points(logo_w),
            .height = ::ui::Length::points(logo_h)},
        .style = tokens::image_patch(chrome.logo)});
  }

  // origin/main's right button column is a LEGACY POSITIONAL FAN: uniform-width
  // ovals at staggered centers (Connect pushed out, Exit pulled in). Flex
  // alignment can't express same-width-different-center, so the fan is the one
  // place we pin coordinates — the visual-parity gate fails a uniform stack. Each
  // row's left margin is its golden center offset from Exit (the leftmost pill):
  // Tutorial/Options +60, Connect +120, Exit 0. The 48.75% inset = x624 exactly
  // at 1280 logical, landing every pill on origin's 4-virtual-px grid
  // (vx 416/456/496) so the per-phase oval bake matches the golden cells.
  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Menu}>
    {logo}
    <Box
      key="stack"
      layout={::ui::LayoutStyle{
        .position = ::ui::PositionType::Absolute,
        .position_inset = ::ui::EdgeSizes{::ui::StyleValue::percent(48.75f), {}, 231.0f, {}},
        .direction = ::ui::FlexDirection::Column,
        .align_items = ::ui::AlignItems::Start,
        .gap = 51.0f}}
    >
      <Box key="w0" layout={::ui::LayoutStyle{.margin = ::ui::EdgeSizes{60.0f, {}, {}, {}}}}>
        <AppButton
          key="tutorial"
          controlId="Tutorial"
          variant={AppButtonVariant::Oval}
          label="Tutorial"
          onPress={session.start_tutorial}
        />
      </Box>
      <Box key="w1" layout={::ui::LayoutStyle{.margin = ::ui::EdgeSizes{120.0f, {}, {}, {}}}}>
        <AppButton
          key="connect"
          controlId="ConnectToLobby"
          variant={AppButtonVariant::Oval}
          label="Connect To Lobby"
          onPress={session.play_online}
        />
      </Box>
      <Box key="w2" layout={::ui::LayoutStyle{.margin = ::ui::EdgeSizes{60.0f, {}, {}, {}}}}>
        <AppButton
          key="options"
          controlId="Options"
          variant={AppButtonVariant::Oval}
          label="Options"
          onPress={open_options}
        />
      </Box>
      <AppButton
        key="exit"
        controlId="Exit"
        variant={AppButtonVariant::Oval}
        disabled={!app.can_quit}
        label="Exit"
        onPress={app.quit}
      />
    </Box>
    <Box
      key="footer"
      layout={::ui::LayoutStyle{
        .position = ::ui::PositionType::Absolute,
        .position_inset = ::ui::EdgeSizes{15.0f, {}, 694.5f, {}}}}
    >
      <Text
        key="ver"
        value={version_text(app.version)}
        layout={::ui::LayoutStyle{.height = ::ui::Length::points(tokens::kLineBody)}}
        style={tokens::text_patch(tokens::kTextBody, tokens::kFontBodyEm, tokens::kFaceFooter, tokens::kLineBody)}
      />
    </Box>
  </ScreenLayout>
}

} // namespace

::ui::UiElement MainMenu(const char *key) {
  return ::ui::component("MainMenu", MainMenuProps{}, MainMenuView, key);
}

} // namespace client::ui

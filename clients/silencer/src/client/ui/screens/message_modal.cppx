#include "client/ui/screens/message_modal.h"

#include "client/ui/components/actions/actions.h"
#include "client/ui/components/layout/layout.h"
#include "client/ui/components/surfaces/surfaces.h"
#include "client/ui/components/text/text.h"
#include "client/ui/hooks/use_navigation.h"
#include "ui/runtime/react.h"

#include <functional>
#include <utility>

namespace client::ui {
namespace {

// The JSX lowering emits each tag's component function + `<Tag>Props` type
// unqualified, so the silencer semantic layer (functions + Props + variant
// enums) is pulled wholesale into this TU-local namespace, plus the runtime's
// `children()` child-list builder.
using namespace silencer;
using ::ui::children;

struct MessageModalProps {
  const char *title = "";
  const char *message = "";
  std::function<void()> on_dismiss = {};
};

::ui::UiElement MessageModalView(const MessageModalProps &props) {
  Navigation nav = use_navigation();
  std::function<void()> dismiss = [nav, on_dismiss = props.on_dismiss]() {
    if (nav.pop_current)
      nav.pop_current();
    if (on_dismiss)
      on_dismiss();
  };

  return <ScreenLayout key="root" variant={ScreenLayoutVariant::CenteredOverlay}>
    <Panel key="panel" variant={PanelVariant::Overlay}>
      <ScreenTitle key="title" variant={ScreenTitleVariant::Dialog} value={props.title} />
      <BodyText key="message" variant={BodyTextVariant::Message} value={props.message} />
      <AppButton
        key="ok"
        controlId="MessageModalOk"
        defaultFocused={true}
        label="OK"
        onPress={dismiss}
      />
    </Panel>
  </ScreenLayout>
}

} // namespace

bool MessageModalScreen::build_element(::ui::UiElementFrame &,
                                       ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component(
      "MessageModal",
      MessageModalProps{
          .title = title_.c_str(),
          .message = message_.c_str(),
          .on_dismiss = on_dismiss_,
      },
      MessageModalView, "message-modal");
  return true;
}

} // namespace client::ui

#include "panel_components.h"

UiElement BuildPauseMenu(Actions &actions) {
  return <Panel key="pause" style={Style{.width = Length::points(320)}} modal>
    <Panel.Header>
      <Text value="Paused" />
    </Panel.Header>
    <Panel.Body>
      <Button id="ResumeButton" onActivate={actions.resume}>Resume</Button>
      <Button id="OptionsButton" onActivate={actions.options} />
    </Panel.Body>
  </Panel>
}

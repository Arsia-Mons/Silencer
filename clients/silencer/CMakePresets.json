{
    "version": 4,
    "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
    "configurePresets": [
        {
            "name": "win-ninja",
            "displayName": "Windows / Ninja / Debug",
            "description": "Ninja generator + vcpkg toolchain. Saturates all cores, ~10x faster clean builds than the default Visual Studio generator.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "SILENCER_BUILD_TESTS": "ON",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "win-ninja-release",
            "inherits": "win-ninja",
            "displayName": "Windows / Ninja / Release",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SILENCER_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "win-ninja-unity",
            "inherits": "win-ninja-release",
            "displayName": "Windows / Ninja / Release / Unity (fastest clean build)",
            "binaryDir": "${sourceDir}/build-unity",
            "cacheVariables": { "SILENCER_UNITY_BUILD": "ON" }
        }
    ],
    "buildPresets": [
        {
            "name": "win-ninja",
            "configurePreset": "win-ninja",
            "targets": [ "silencer", "silencer_tests" ]
        },
        {
            "name": "win-ninja-release",
            "configurePreset": "win-ninja-release",
            "targets": [ "silencer" ]
        },
        {
            "name": "win-ninja-unity",
            "configurePreset": "win-ninja-unity",
            "targets": [ "silencer" ]
        }
    ]
}

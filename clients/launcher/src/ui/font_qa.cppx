#include "ui/font_qa.h"

#include "ui/primitives.h"
#include "ui/tokens.h"

#include "ui/components/box.h"
#include "ui/components/scroll_view.h"

#include <cstdio>
#include <string>
#include <vector>

namespace launcher {
namespace {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::ScrollView;
using ::ui::components::ScrollViewProps;

struct Face {
  const char *bank;
  const char *name;
  uint16_t id;
  int native;
};

constexpr Face kFaces[] = {
    {"bank 133", "Body", 0, 11},  {"bank 134", "Large", 1, 15},
    {"bank 136", "Title", 2, 23}, {"bank 132", "Tiny", 3, 7},
    {"bank 135", "Heading", 4, 19},
};
constexpr int kSizes[] = {7, 11, 14, 15, 19, 22, 23, 28, 33, 38, 46};

// One face at one size: the tag in the gutter, the specimen beside it.
struct SpecimenProps {
  const char *key = nullptr;
  const char *tag = "";
  float size = 11.0f;
  uint16_t face = kFaceBody;
};

::ui::UiElement Specimen(const SpecimenProps &props) {
  return <Box key={props.key} layout={row_full(12)}>
    <Label key="qa-t" value={props.tag} color={kTextFaint} width={Length::points(90)} />
    <Label
      key="qa-s"
      value="SILENCER agents ready 0123456789"
      size={props.size}
      face={props.face}
    />
  </Box>
}

} // namespace

::ui::UiElement FontQaPanel(const FontQaPanelProps &props) {
  // "*" marks integer multiples of the face's native line height (pixel-perfect
  // 1:1 blits of the origin bank glyphs; everything else nearest-scales).
  std::vector<::ui::UiElement> rows = {
      Label(LabelProps{.key = "qa-legend",
                       .value = "FONT QA - every face x size ramp. * = integer multiple "
                                "of the native line height (pixel-perfect).",
                       .color = kTextFaint}),
      Divider(DividerProps{.key = "qa-legend-div"}),
  };

  for (const Face &f : kFaces) {
    char head[96];
    snprintf(head, sizeof(head), "%s  (%s, native %dpx)", f.bank, f.name, f.native);
    rows.push_back(Label(LabelProps{.key = dup(std::string("qa-head-") + f.name),
                                    .value = dup(head),
                                    .color = kAccent}));
    for (int sz : kSizes) {
      char tag[32];
      snprintf(tag, sizeof(tag), "%s %d%s", f.name, sz, (sz % f.native == 0) ? " *" : "");
      rows.push_back(Specimen(
          SpecimenProps{.key = dup(std::string("qa-") + f.name + "-" + std::to_string(sz)),
                        .tag = dup(tag),
                        .size = (float)sz,
                        .face = f.id}));
    }
    rows.push_back(Divider(DividerProps{.key = dup(std::string("qa-div-") + f.name)}));
  }

  return <Box
    key={props.key}
    layout={LayoutStyle{.overflow = ::ui::Overflow::Hidden,
                        .width = Length::percent(100.0f),
                        .flex_grow = 1.0f,
                        .padding = EdgeSizes{16, 16, 14, 14},
                        .gap = 10}}
    style={panel_style(kPanel, kBorder, 4.0f)}
  >
    <ScrollView
      key="qa-scroll"
      id="qa-scroll"
      layout={LayoutStyle{.width = Length::percent(100.0f), .flex_grow = 1.0f}}
    >
      <Box key="qa-track" layout={col_full(8)} children={::ui::children(rows)} />
    </ScrollView>
  </Box>
}

} // namespace launcher

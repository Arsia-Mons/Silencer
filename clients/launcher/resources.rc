// Windows resources for the launcher: the taskbar/Explorer icon and the
// VERSIONINFO block Explorer's Details tab reads.
//
// launcher_version.h is generated into the build dir by CMake, which also puts
// that dir on the RC include path. The icon path is relative to THIS file, the
// same way clients/silencer/resources.rc does it.
#include "launcher_version.h"

// Lowest ID wins as the application icon, so keep this first.
1 ICON "../../shared/icons/icon.ico"

// Resource ID 1 is VS_VERSION_INFO. Spelled numerically on purpose: the symbol
// only exists if this file includes winver.h/windows.h, and it does not need to.
1 VERSIONINFO
FILEVERSION    LAUNCHER_VERSION_QUAD
PRODUCTVERSION LAUNCHER_VERSION_QUAD
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Arsia Mons"
            VALUE "FileDescription",  "Silencer Launcher"
            VALUE "FileVersion",      LAUNCHER_VERSION_STRING
            VALUE "InternalName",     "silencer-launcher"
            VALUE "LegalCopyright",   "Copyright (c) Arsia Mons. All rights reserved."
            VALUE "OriginalFilename", "silencer-launcher.exe"
            VALUE "ProductName",      "Silencer Launcher"
            VALUE "ProductVersion",   LAUNCHER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

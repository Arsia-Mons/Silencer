+ChatPanelLayoutMetrics ResolveChatPanelLayout(Uint16 panelWidth,
+                                              Uint16 panelHeight) {
+	ChatPanelLayoutMetrics metrics;
+	const int contentW = std::max(
+		0,
+		static_cast<int>(panelWidth) - static_cast<int>(chat_panel_detail::kRootPadX) * 2);
